+}
+
+export function reduceRecursor(env:Environment,e:Expr,whnf:(x:Expr)=>Expr,infer:(x:Expr)=>Expr,isDefEq:(a:Expr,b:Expr)=>boolean,isProp:(x:Expr)=>boolean):Expr|null{
