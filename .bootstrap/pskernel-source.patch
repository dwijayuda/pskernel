+    (x : α) (tag : String)
+    (getM : S → HashMap α Nat)
+    (setM : S → HashMap α Nat → S)
+    (mk : M Json) : M Nat := do
+  let m := getM (← get)
+  if let some i := m[x]? then return i
+  let payload ← mk
+  let m := getM (← get)
+  let i := m.size
+  IO.println (payload.setObjVal! tag i).compress
+  modify fun s => setM s ((getM s).insert x i)
+  return i
