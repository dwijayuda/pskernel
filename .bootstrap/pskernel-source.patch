+      setEmitted group
+      clearActive group
+    | .axiomInfo av =>
+      setActive [name]
+      dumpConstants env ci.getUsedConstantsAsSet
+      dumpAxiom av
+      setEmitted [name]
+      clearActive [name]
+    | .thmInfo tv =>
+      setActive [name]
+      dumpConstants env ci.getUsedConstantsAsSet
+      dumpTheorem tv
+      setEmitted [name]
+      clearActive [name]
+    | .opaqueInfo ov =>
+      setActive [name]
+      dumpConstants env ci.getUsedConstantsAsSet
+      dumpOpaque ov
+      setEmitted [name]
+      clearActive [name]
+    | .quotInfo qv =>
+      setActive [name]
+      dumpConstants env ci.getUsedConstantsAsSet
+      dumpQuot qv
+      setEmitted [name]
+      clearActive [name]
