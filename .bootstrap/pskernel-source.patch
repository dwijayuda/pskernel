+
+def semanticDeps (n : Name) : List Name :=
+  if n == "Nat.div".toName then
+    ["Nat.div.go".toName, "Nat.div_rec_fuel_lemma".toName, "Nat.lt_succ_self".toName] ++ natLeConditionDeps
+  else if n == "Nat.mod".toName then
