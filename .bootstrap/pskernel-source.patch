+   forallE(nameFromDotted('b'),bvar(4),
+     forallE(anon,mkAppN(bvar(4),[bvar(1),bvar(0)]),
+       mkAppN(constant(N.Eq,[v]),[bvar(4),app(bvar(3),bvar(2)),app(bvar(3),bvar(1))]))));
