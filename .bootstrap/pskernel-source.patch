+  let obj := Json.mkObj [("thm", Json.mkObj [
+    ("name", ← dumpName ci.name),
+    ("levelParams", ← dumpUparams ci.levelParams),
+    ("type", ← dumpExpr ci.type),
+    ("value", ← dumpExpr ci.value),
