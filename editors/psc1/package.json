{
  "name": "psc1-editor-development",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Independent PSC1 editor tooling; outside all compiler self-hosting cycles",
  "engines": { "node": ">=22.23.3" },
  "scripts": {
    "prepare:compiler": "node scripts/prepare-compiler.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "package": "node scripts/package.mjs",
    "test:vscode": "node test/run-vscode.mjs",
    "test:packed": "node test/npm-smoke.mjs",
    "test:performance": "node test/performance.mjs"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "vscode-languageclient": "11.0.0",
    "vscode-languageserver": "11.0.0",
    "vscode-languageserver-textdocument": "1.0.16"
  },
  "license": "Apache-2.0"
}
