{
  "$schema":"https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name":"ProofScript",
  "scopeName":"source.proofscript",
  "patterns":[
    {"include":"#comments"},
    {"include":"#strings"},
    {"include":"#declarations"},
    {"include":"#keywords"},
    {"include":"#tactics"},
    {"include":"#types"},
    {"include":"#numbers"},
    {"include":"#operators"}
  ],
  "repository":{
    "comments":{"patterns":[
      {"name":"comment.block.proofscript","begin":"/-","end":"-/"},
      {"name":"comment.line.double-dash.proofscript","begin":"--","end":"$"}
    ]},
    "strings":{"patterns":[
      {"name":"string.quoted.double.proofscript","begin":"\"","end":"\"","patterns":[
        {"name":"constant.character.escape.proofscript","match":"\\\\."}
      ]}
    ]},
    "declarations":{"patterns":[
      {"match":"\\b(theorem)\\s+([A-Za-z_][A-Za-z0-9_']*)","captures":{"1":{"name":"storage.type.theorem.proofscript"},"2":{"name":"entity.name.function.theorem.proofscript"}}},
      {"match":"\\b(const|function|def)\\s+([A-Za-z_][A-Za-z0-9_']*)","captures":{"1":{"name":"storage.type.function.proofscript"},"2":{"name":"entity.name.function.proofscript"}}},
      {"match":"\\b(inductive|structure|class)\\s+([A-Za-z_][A-Za-z0-9_']*)","captures":{"1":{"name":"storage.type.type.proofscript"},"2":{"name":"entity.name.type.proofscript"}}}
    ]},
    "keywords":{"patterns":[
      {"name":"keyword.declaration.proofscript","match":"\\b(theorem|def|const|function|inductive|structure|class|where)\\b"},
      {"name":"keyword.control.proofscript","match":"\\b(fun|let|match|if|then|else)\\b"}
    ]},
    "tactics":{"patterns":[
      {"name":"keyword.control.tactic.proofscript","match":"\\b(by|exact|assumption)\\b"}
    ]},
    "types":{"patterns":[
      {"name":"support.type.proofscript","match":"\\b(Prop|Type|Nat|Int|Bool|String|Unit)\\b"}
    ]},
    "numbers":{"patterns":[{"name":"constant.numeric.proofscript","match":"\\b[0-9]+\\b"}]},
    "operators":{"patterns":[{"name":"keyword.operator.proofscript","match":":=|=>|→|->|=|==|!=|\\+|\\-|\\*|/|<|>|<=|>="}]}
  }
}
