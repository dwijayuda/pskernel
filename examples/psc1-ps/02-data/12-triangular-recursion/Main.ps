-- Nat has zero and successor constructors. In the successor branch,
-- previous is the structurally smaller natural number.
def triangular(value : Nat) : Nat :=
  match value with {
    | Nat.zero => 0
    | Nat.succ previous => value + triangular(previous)
  }

-- This is the sum 1 + 2 + 3 + 4 + 5 + 6.
def sample : Nat := triangular(6)
