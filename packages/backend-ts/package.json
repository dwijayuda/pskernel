{
  "name": "@proofscript/backend-ts",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "description": "ProofScript checked executable IR to TypeScript source, compiled to JavaScript by TypeScript.",
  "proofscript": {
    "status": "software-lambda-typescript-mvp",
    "phase": "C",
    "trust": "untrusted-support",
    "sourceLanguage": "typescript"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build --silent && node dist/test/index.test.js"
  },
  "dependencies": {
    "typescript": "5.8.3",
    "@proofscript/compiler-ir": "file:../compiler-ir"
  }
}
