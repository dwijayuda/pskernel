{
  "name": "@proofscript/browser",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "description": "Web Worker/browser host wrapper for streaming kernel verification.",
  "proofscript": {
    "status": "foundation",
    "phase": "A",
    "trust": "untrusted-support",
    "sourceLanguage": "typescript"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build --silent && node dist/test/index.test.js"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
