        "../syntax/dist/src/index.d.ts"
      ],
      "@proofscript/language": [
        "../language/dist/src/index.d.ts"
      ],
      "@proofscript/compiler-ir": [
        "../compiler-ir/dist/src/index.d.ts"
      ],
      "@proofscript/backend-ts": [
        "../backend-ts/dist/src/index.d.ts"
      ],
      "@proofscript/elab": [
        "../elab/dist/src/index.d.ts"
      ],
      "@proofscript/compiler": [
        "../compiler/dist/src/index.d.ts"
