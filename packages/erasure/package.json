{
  "name": "@proofscript/erasure",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "description": "Lean-aware erasure from kernel-admitted ProofScript checked core to verified compiler IR.",
  "proofscript": {
    "status": "generic-function-erasure-mvp",
    "phase": "C",
    "trust": "untrusted-support",
    "sourceLanguage": "typescript"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build --silent && node dist/test/index.test.js"
  },
  "dependencies": {
    "lean-ts-kernel": "file:../..",
    "@proofscript/checked-core": "file:../checked-core",
    "@proofscript/compiler-ir": "file:../compiler-ir"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
