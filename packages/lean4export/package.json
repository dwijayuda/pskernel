{
  "name": "@proofscript/lean4export",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "description": "Cross-platform pinned Lean exporter process/stream transport for pskernel and ProofScript.",
  "proofscript": {
    "status": "mvp",
    "phase": "A",
    "trust": "untrusted-support",
    "sourceLanguage": "typescript"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "proofscript-lean4export": "./dist/bin/proofscript-lean4export.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build --silent && node dist/test/lean4export.test.js"
  },
  "dependencies": {
    "@proofscript/module": "file:../module",
    "lean-ts-kernel": "file:../.."
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.8.3"
  }
}
