{
  "name": "@proofscript/lsp",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "description": "Thin Language Server Protocol transport over the proof-aware ProofScript language service.",
  "proofscript": {
    "status": "proof-aware-stdio-mvp",
    "phase": "D",
    "trust": "untrusted-support",
    "sourceLanguage": "typescript"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build --silent && node dist/test/index.test.js"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.8.3"
  },
  "bin": {
    "proofscript-lsp": "./dist/src/bin.js"
  },
  "dependencies": {
    "@proofscript/language-service": "file:../language-service",
    "lean-ts-kernel": "file:../.."
  }
}
