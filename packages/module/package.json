{
  "name": "@proofscript/module",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "description": "Portable deterministic ProofScript checked-module artifacts with integrity and kernel replay.",
  "proofscript": {
    "status": "checked-admission-artifact-v2",
    "phase": "B",
    "trust": "untrusted-support",
    "artifactFormat": "proofscript-module@1|2",
    "sourceLanguage": "typescript"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build --silent && node dist/test/module.test.js"
  },
  "dependencies": {
    "lean-ts-kernel": "file:../..",
    "@proofscript/checked-core": "file:../checked-core"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.8.3"
  }
}
