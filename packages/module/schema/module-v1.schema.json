{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofscript.dev/schema/module-v1.json",
  "title": "ProofScript Module Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format","version","module","kernel","dependencies","payload","integrity"],
  "properties": {
    "format": {"const": "proofscript-module"},
    "version": {"const": 1},
    "module": {"type": "string", "minLength": 1},
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantics","leanVersion","apiVersion"],
      "properties": {
        "semantics": {"const": "lean4"},
        "leanVersion": {"type": "string"},
        "apiVersion": {"type": "string"}
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module","integrity"],
        "properties": {
          "module": {"type": "string","minLength": 1},
          "integrity": {"type": "string","pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind","formatVersion","integrity","text"],
      "properties": {
        "kind": {"const": "lean4export-ndjson"},
        "formatVersion": {"const": "3.1.0"},
        "integrity": {"type": "string","pattern": "^sha256:[0-9a-f]{64}$"},
        "text": {"type": "string"}
      }
    },
    "metadata": {},
    "integrity": {"type": "string","pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
