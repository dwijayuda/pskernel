{
  "name": "@proofscript/runtime",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "description": "JavaScript runtime semantics and executable support primitives.",
  "proofscript": {
    "status": "foundation",
    "phase": "C",
    "trust": "untrusted-support",
    "sourceLanguage": "typescript"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./lean4": {
      "types": "./dist/src/lean4.d.ts",
      "import": "./dist/src/lean4.js"
    },
    "./lean4/eval": {
      "types": "./dist/src/lean4-eval.d.ts",
      "import": "./dist/src/lean4-eval.js"
    },
    "./lean4/metadata": {
      "types": "./dist/src/lean4-metadata.d.ts",
      "import": "./dist/src/lean4-metadata.js"
    },
    "./lean4/init": {
      "types": "./dist/src/lean4-init.d.ts",
      "import": "./dist/src/lean4-init.js"
    },
    "./lean4/name": {
      "types": "./dist/src/lean4-name.d.ts",
      "import": "./dist/src/lean4-name.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build --silent && node dist/test/index.test.js"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "dependencies": {
    "lean-ts-kernel": "file:../.."
  }
}
