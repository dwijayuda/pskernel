{
  "name": "@proofscript/syntax",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "description": "ProofScript v0.7 source positions, trivia-preserving tokens, lexical errors, and feature identifiers.",
  "proofscript": {
    "status": "v061-structure-parser-mvp",
    "phase": "B",
    "trust": "untrusted-support",
    "sourceLanguage": "typescript",
    "specVersion": "0.7.0",
    "leanSemantics": "4.34.0",
    "implementedFeatures": [
      "L-CORE-LEAN",
      "D-CALL",
      "D-EXPLICIT-PARAMS",
      "D-DECL-SEMI",
      "D-CONST-ALIAS",
      "D-FUNCTION-ALIAS",
      "E-IF-BRACE",
      "E-MATCH-BODY",
      "E-STRUCT-BODY"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build --silent && node dist/test/syntax.test.js"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
