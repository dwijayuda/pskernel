{
  "name": "@proofscript/wasm-lowering",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "description": "Fail-closed lowering from pskernel-derived verified runtime IR to ProofScript WasmIR.",
  "proofscript": {
    "status": "w1-bool-unit-lowering-mvp",
    "phase": "C",
    "trust": "untrusted-support",
    "sourceLanguage": "typescript"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build --silent && node dist/test/index.test.js"
  },
  "dependencies": {
    "@proofscript/compiler-ir": "file:../compiler-ir",
    "@proofscript/wasm-ir": "file:../wasm-ir"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
