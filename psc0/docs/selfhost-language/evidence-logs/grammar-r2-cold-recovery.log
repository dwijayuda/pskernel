const selected = successorSeedSelection(manifest);
assert.equal(selected.sourceRef, context.sha, 'PSC0_SH1_COLD_SOURCE_REF');
assert.equal(String(manifest.qualification.runId), process.env.GITHUB_RUN_ID,
  'PSC0_SH1_COLD_QUALIFICATION_RUN');
const parentPath = path.join(workspace, 'recovery-input', selected.parent.compilerPath);
assert(await verifyAuthoringSeedCache(path.dirname(parentPath), selected.parent.manifest),
  'PSC0_SH1_COLD_PARENT_CACHE_REQUIRED');
const cachePath = path.join(workspace, 'psc0', selected.cacheDirectory);
const outputPath = path.join(workspace, 'psc0/dist/sh1-successor-cold');
assert(!existsSync(cachePath), 'PSC0_SH1_COLD_CACHE_MUST_BE_ABSENT');
assert(!existsSync(outputPath), 'PSC0_SH1_COLD_OUTPUT_MUST_BE_ABSENT');
for (const [name, value] of Object.entries({
  'manifest-path': manifestPath, 'parent-compiler-path': parentPath,
  'cache-path': cachePath, 'cache-directory': selected.cacheDirectory,
  'cache-key': selected.cacheKey, 'output-path': outputPath,
})) core.setOutput(name, value);

