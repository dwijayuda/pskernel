2026-10-09T13:37:05.6244372Z ##[group]Run actions/github-script@v7
2026-10-09T13:37:05.6244688Z with:
2026-10-09T13:37:05.6249917Z   script: const assert = (await import('node:assert/strict')).default;
const { readFile, copyFile } = await import('node:fs/promises');
const { createHash } = await import('node:crypto');
const path = await import('node:path');
const { successorSeedSelection, verifyAuthoringSeedCache } = await import(
  process.env.GITHUB_WORKSPACE + '/psc0/scripts/sh1-successor-seed.mjs');
const manifest = JSON.parse(await readFile(process.env.PSC0_SUCCESSOR_MANIFEST, 'utf8'));
const selected = successorSeedSelection(manifest);
const bytes = await readFile(path.join(process.env.PSC0_RECOVERY_OUTPUT, 'receipt.json'));
const receipt = JSON.parse(bytes.toString('utf8'));
assert.equal(receipt.evidence, 'qualified-successor-cold-recovery');
assert.equal(receipt.passed, true);
assert.equal(receipt.coldSuccessorRecovery, true);
assert.equal(receipt.selectedSeedChanged, false);
assert.equal(receipt.sourceRef, selected.sourceRef);
assert.equal(receipt.successorIdentitySha256, selected.identitySha256);
assert.deepEqual(receipt.actualFirstGenerationArtifacts, manifest.expectedFirstGenerationArtifacts);
assert.deepEqual(receipt.actualArtifacts, manifest.expectedArtifacts);
assert(await verifyAuthoringSeedCache(process.env.PSC0_SUCCESSOR_CACHE, manifest),
  'PSC0_SH1_COLD_RECOVERED_CACHE_REQUIRED');
await copyFile(process.env.PSC0_SUCCESSOR_MANIFEST,
  path.join(process.env.PSC0_RECOVERY_OUTPUT, 'seed-promotion.json'));
core.setOutput('receipt-sha256', createHash('sha256').update(bytes).digest('hex'));
core.setOutput('recovered', true);

