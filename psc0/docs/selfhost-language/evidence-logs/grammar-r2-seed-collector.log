2026-10-09T13:39:38.1525922Z with:
2026-10-09T13:39:38.1545831Z   script: const expected = {
  "schemaVersion": 1,
  "kind": "psc0-sh1-seed-evidence-request",
  "repository": "dwijayuda/pskernel",
  "runId": 37925722635,
  "runAttempt": 1,
  "sourceRef": "fe2560aba0f347b1caf8d000d371464642d44f23",
  "sourceBranch": "psc0/sh1-projection-grammar-v1",
  "workflowId": 378853677,
  "workflowPath": ".github/workflows/psc0-sh1.yml",
  "requiredJobs": [
    "compiler",
    "successor-recovery",
    "kernel-admissions"
  ],
  "purpose": "Collect authenticated file evidence and a proposed selection; never activate the seed."
};

const assert = (await import('node:assert/strict')).default;
const { mkdir, readFile, writeFile } = await import('node:fs/promises');
const path = await import('node:path');
const workspace = process.env.GITHUB_WORKSPACE;
const requestBytes = await readFile(path.join(workspace,
  'request-source/docs/psc0-sh1-seed-evidence-request.json'));
const request = JSON.parse(requestBytes.toString('utf8'));
assert.deepEqual(request, expected, 'PSC0_SH1_EVIDENCE_FIXED_REQUEST');
assert.equal(context.repo.owner + '/' + context.repo.repo, expected.repository);
const api = { owner: context.repo.owner, repo: context.repo.repo };
const run = (await github.rest.actions.getWorkflowRun({
  ...api, run_id: expected.runId,
})).data;
assert.equal(run.id, expected.runId);
assert.equal(run.run_attempt, expected.runAttempt);
assert.equal(run.repository.full_name, expected.repository);
assert.equal(run.head_repository.full_name, expected.repository);
assert.equal(run.workflow_id, expected.workflowId);
assert.equal(run.path, expected.workflowPath);
assert.equal(run.event, 'push');
assert.equal(run.head_sha, expected.sourceRef);
assert.equal(run.head_branch, expected.sourceBranch);
assert.equal(run.status, 'completed', 'PSC0_SH1_EVIDENCE_RUN_NOT_COMPLETE');
assert.equal(run.conclusion, 'success', 'PSC0_SH1_EVIDENCE_RUN_NOT_SUCCESSFUL');
const jobs = await github.paginate(github.rest.actions.listJobsForWorkflowRun, {
  ...api, run_id: expected.runId, filter: 'latest', per_page: 100,
});
assert.deepEqual(jobs.map((job) => job.name).sort(), [...expected.requiredJobs].sort(),
  'PSC0_SH1_EVIDENCE_EXACT_JOB_SET');
for (const job of jobs) {
  assert.equal(job.run_id, expected.runId);
  assert.equal(job.run_attempt, expected.runAttempt);
  assert.equal(job.status, 'completed');
  assert.equal(job.conclusion, 'success', 'PSC0_SH1_EVIDENCE_JOB_' + job.name);
}
const requiredSteps = [
  ['compiler', 'Qualify exact current-source C2/C3 at a promotion checkpoint'],
  ['successor-recovery', 'Authenticate the cold recovery receipt and the rebuilt successor bytes'],
  ['kernel-admissions', 'Obtain actual provider decisions for the qualified admission streams'],
];
for (const [jobName, stepName] of requiredSteps) {
  const matches = jobs.find((job) => job.name === jobName).steps
    .filter((step) => step.name === stepName);
  assert.equal(matches.length, 1, 'PSC0_SH1_EVIDENCE_REQUIRED_STEP_' + jobName);
  assert.equal(matches[0].status, 'completed');
  assert.equal(matches[0].conclusion, 'success');
}
const allArtifacts = await github.paginate(github.rest.actions.listWorkflowRunArtifacts, {
  ...api, run_id: expected.runId, per_page: 100,
});
const names = {
  compiler: 'psc0-sh1-ts7.0.2-' + expected.sourceRef,
  provider: 'psc0-sh1-kernel-ts7.0.2-' + expected.sourceRef,
  cold: 'psc0-sh1-successor-recovery-ts7.0.2-' + expected.sourceRef,
};
const artifacts = {};
for (const [kind, name] of Object.entries(names)) {
  const matches = allArtifacts.filter((artifact) => artifact.name === name);
  assert.equal(matches.length, 1, 'PSC0_SH1_EVIDENCE_UNIQUE_ARTIFACT_' + kind);
  const artifact = matches[0];
  assert(Number.isSafeInteger(artifact.id) && artifact.id > 0);
  assert.equal(artifact.expired, false);
  assert.equal(artifact.workflow_run.id, expected.runId);
  assert.equal(artifact.workflow_run.repository_id, run.repository.id);
  assert.equal(artifact.workflow_run.head_repository_id, run.head_repository.id);
  assert.equal(artifact.workflow_run.head_sha, expected.sourceRef);
  assert.equal(artifact.workflow_run.head_branch, expected.sourceBranch);
  if (artifact.digest !== undefined && artifact.digest !== null) {
    assert.match(artifact.digest, /^sha256:[a-f0-9]{64}$/u);
  }
  artifacts[kind] = artifact;
  core.setOutput(kind + '-artifact-id', String(artifact.id));
}
core.setOutput('source-ref', expected.sourceRef);
core.setOutput('run-id', String(expected.runId));
const output = path.join(workspace, 'seed-evidence-output');
await mkdir(output, { recursive: true });
await writeFile(path.join(output, 'request.json'), requestBytes);
await writeFile(path.join(output, 'run-provenance.json'), JSON.stringify({
  schemaVersion: 1,
  evidence: 'github-api-run-job-artifact-binding',
  request,
  collector: { runId: context.runId, sourceRef: context.sha },
  run, jobs, artifacts,
  note: 'Artifact archive digests are transport metadata; receipt hashes are computed from the extracted receipt file bytes.',
}, null, 2) + '\n');
core.info('PSC0_SH1_EVIDENCE_RUN_AUTHENTICATED: ' + JSON.stringify({
  runId: run.id, runAttempt: run.run_attempt, sourceRef: run.head_sha,
  artifactIds: Object.fromEntries(Object.entries(artifacts)
    .map(([kind, artifact]) => [kind, artifact.id])),
}));

