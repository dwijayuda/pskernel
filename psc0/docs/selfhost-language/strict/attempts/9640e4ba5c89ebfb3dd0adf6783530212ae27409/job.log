2026-10-09T23:55:07.1923392Z   script: const { mkdir, writeFile } = await import('node:fs/promises');
const path = await import('node:path');
const root = process.env.GITHUB_WORKSPACE + '/psc0';
const recovery = await import(root + '/scripts/sh1-native-seed-recovery.mjs');
const { selected, policySha256, recipeSha256 } = await recovery.readNativeSeedRecoveryPolicy({ root });
const directory = path.join(root, 'dist/sh1-seed-selection');
await mkdir(directory, { recursive: true });
await writeFile(path.join(directory, 'selected-native-recovery.json'), JSON.stringify({
  sourceRef: selected.sourceRef, identitySha256: selected.identitySha256,
  policySha256, recipeSha256, recipe: recovery.nativeSeedRecoveryRecipe,
  parentMetadataRetained: Boolean(selected.parent),
  parentExecutionRequired: false, typescriptVersion: '7.0.2',
}, null, 2) + '\n');
for (const [name, value] of Object.entries({
  mode: selected.mode,
  'full-qualification': process.env.PSC0_SH1_FULL_QUALIFICATION === 'true',
  'node-version': selected.nodeVersion,
  'source-ref': selected.sourceRef,
  'compiler-path': selected.compilerPath,
  'cache-key': selected.cacheKey,
  'cache-directory': selected.cacheDirectory,
  'artifact-run-id': selected.artifactRunId,
  'artifact-name': selected.artifactName,
  'recovery-typescript-version': '7.0.2',
  'has-parent': Boolean(selected.parent),
})) core.setOutput(name, value);

