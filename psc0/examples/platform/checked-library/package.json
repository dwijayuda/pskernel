{
  "name": "proofscript-checked-library-example",
  "private": true,
  "type": "module",
  "scripts": {
    "ps:check": "node ./node_modules/proofscript/bin/psc.mjs check",
    "ps:build": "node ./node_modules/proofscript/bin/psc.mjs build",
    "build": "node ./node_modules/proofscript/bin/psc.mjs build && node ./node_modules/typescript/bin/tsc --project tsconfig.json",
    "start": "node dist/consumer.js"
  },
  "devDependencies": {
    "proofscript": "0.1.0-preview.3",
    "typescript": "7.0.2"
  },
  "proofscript": {
    "profile": "checked",
    "entry": "src/Main.ps",
    "out": "src/generated/library.ts",
    "exports": {
      "src/Quantity.ps": [
        "Quantity",
        "makeQuantity"
      ],
      "src/Main.ps": [
        "readQuantity",
        "sameQuantity"
      ]
    },
    "extensions": []
  }
}
