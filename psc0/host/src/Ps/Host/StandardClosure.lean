/-
Native authoring audit for selected Standard dependencies; never imported by
the portable compiler. Traversal follows Lean 4.35.0 CollectAxioms.lean's
visited-before-descending invariant, extended to recursor rule RHSs and mutual
families. This reports dependencies, not admission or equivalence.
-/
import Ps.Host.PrimitiveAudit
import Lean.Util.CollectAxioms

namespace PsV7Native

-- Lean 4.35.0 src/Lean/Expr.lean defines autoParam as a type annotation,
-- erased by Expr.consumeTypeAnnotations. Elaboration tactics are NOT kernel
-- dependencies. Keep optParam/outParam intact: their source elaboration and
-- instance-selection behavior belongs to a separate import contract.
-- This rewrite is opt-in; native kernel alias replay certifies transformed
-- declaration types before exported Core is ever offered for publication.
partial def standardEraseAutoParam (expression : Lean.Expr) : Lean.Expr :=
  if expression.isAutoParam then
    standardEraseAutoParam expression.appFn!.appArg!
  else
    match expression with
    | .app fn arg => .app (standardEraseAutoParam fn) (standardEraseAutoParam arg)
    | .lam name type body binder =>
        .lam name (standardEraseAutoParam type) (standardEraseAutoParam body) binder
    | .forallE name type body binder =>
        .forallE name (standardEraseAutoParam type) (standardEraseAutoParam body) binder
    | .letE name type value body nonDep =>
        .letE name (standardEraseAutoParam type) (standardEraseAutoParam value)
          (standardEraseAutoParam body) nonDep
    | .mdata data value => .mdata data (standardEraseAutoParam value)
    | .proj name index value => .proj name index (standardEraseAutoParam value)
    | other => other

private def closureDependencies (info : Lean.ConstantInfo)
    (eraseAutoParams : Bool := false) : Array Lean.Name :=
  let coreExpr := fun e => if eraseAutoParams then standardEraseAutoParam e else e
  let expressions := (coreExpr info.type).getUsedConstants ++
    ((info.value? true).map (fun e => (coreExpr e).getUsedConstants)).getD #[]
  let family := match info with
    | .inductInfo v => v.all.toArray ++ v.ctors.toArray ++ #[.str v.name "rec"]
    | .ctorInfo v => #[v.induct]
    | .quotInfo _ => #[`Quot, `Quot.mk, `Quot.lift, `Quot.ind]
    | .recInfo v => v.all.toArray ++
        (v.rules.toArray.flatMap fun rule => #[rule.ctor] ++ (coreExpr rule.rhs).getUsedConstants)
    | _ => #[]
  expressions ++ family

private def closureKind : Lean.ConstantInfo → String
  | .axiomInfo _ => "axiom"
  | .defnInfo _ => "definition"
  | .thmInfo _ => "theorem"
  | .opaqueInfo _ => "opaque"
  | .quotInfo _ => "quotient-primitive"
  | .inductInfo _ => "inductive"
  | .ctorInfo _ => "constructor"
  | .recInfo _ => "recursor"

-- Worklist with a visited set handles inductive/constructor/recursor cycles
-- without imposing the compiler's elaboration resource policy on this audit.
def standardDependencyClosure (environment : Lean.Environment) (root : Lean.Name)
    (boundary : Lean.NameSet := {}) (eraseAutoParams : Bool := false) :
    IO (Array Lean.ConstantInfo) := do
  let mut pending := [root]
  let mut seen : Lean.NameSet := {}
  let mut entries := #[]
  while !pending.isEmpty do
    let name := pending.head!
    pending := pending.tail!
    if !seen.contains name then
      seen := seen.insert name
      let some info := environment.find? name
        | throw (IO.userError ("missing upstream closure declaration: " ++ toString name))
      entries := entries.push info
      if !boundary.contains name then
        pending := (closureDependencies info eraseAutoParams).toList ++ pending
  return entries.qsort (fun a b => Lean.Name.lt a.name b.name)

-- Smallest imported dependency path for diagnosing a rejected native
-- declaration. This follows exactly the same type/body/rule edges as the
-- closure collector and stops at the same frozen boundary.
def standardDependencyPath (environment : Lean.Environment)
    (roots : List Lean.Name) (target : Lean.Name)
    (boundary : Lean.NameSet := {}) (eraseAutoParams : Bool := false) : List Lean.Name := Id.run do
  let mut frontier : Array (List Lean.Name) :=
    roots.toArray.map (fun root => [root])
  let mut seen : Lean.NameSet := {}
  let mut cursor := 0
  while cursor < frontier.size do
    let path := frontier[cursor]!
    cursor := cursor + 1
    let some name := path.getLast? | continue
    if name == target then return path
    if seen.contains name then continue
    seen := seen.insert name
    if boundary.contains name then continue
    if let some info := environment.find? name then
      for dependency in closureDependencies info eraseAutoParams do
        unless seen.contains dependency do
          frontier := frontier.push (path ++ [dependency])
  return []

-- Turn upstream checked entries back into kernel submissions. Constructors
-- and recursors are regenerated by inductive admission; no recursor is trusted.
private def nativeSubmission (native : Lean.Environment) (info : Lean.ConstantInfo) :
    Except String (Option Lean.Declaration) := do
  if info.isUnsafe || info.isPartial then throw "unsafe or partial declaration"
  match info with
  | .defnInfo value => return some (.defnDecl value)
  | .thmInfo value => return some (.thmDecl value)
  | .opaqueInfo value => return some (.opaqueDecl value)
  | .inductInfo value =>
    let types ← value.all.mapM fun name => do
      let some (.inductInfo member) := native.checked.get.find? name
        | throw ("missing mutual member " ++ toString name)
      let ctors ← member.ctors.mapM fun name => do
        let some (.ctorInfo ctor) := native.checked.get.find? name
          | throw ("missing constructor " ++ toString name)
        pure ({ name, type := ctor.type } : Lean.Constructor)
      pure ({ name, type := member.type, ctors } : Lean.InductiveType)
    return some (.inductDecl value.levelParams value.numParams types false)
  | .ctorInfo _ | .recInfo _ => return none
  | .axiomInfo _ => throw "new axiom prohibited by this reuse probe"
  | .quotInfo _ => throw "new quotient primitive prohibited by this reuse probe"

private def submissionDependencies (declaration : Lean.Declaration) : Array Lean.Name :=
  Id.run <| declaration.foldExprM
    (fun names expr => pure (names ++ expr.getUsedConstants)) #[]

private def kernelProbeDetails (error : Lean.Kernel.Exception) : Lean.Json :=
  let summary := ("reason", Lean.toJson (PsKernelLean.kernelExceptionSummary error))
  match error with
  | .appTypeMismatch _ _ app functionType argumentType =>
    Lean.Json.mkObj [summary, ("application", Lean.toJson app.dbgToString),
      ("functionType", Lean.toJson functionType.dbgToString),
      ("argumentType", Lean.toJson argumentType.dbgToString)]
  | .declTypeMismatch _ _ type =>
    Lean.Json.mkObj [summary, ("givenType", Lean.toJson type.dbgToString)]
  | _ => Lean.Json.mkObj [summary]

-- Read-only compatibility experiment against a fresh officially checked
-- portable prelude. Its environment is discarded, never used by compilation.
-- A failed kernel check stays failed; dependents are reported as blocked.
private def compatibilityProbe (native : Lean.Environment) (root : Lean.Name)
    (boundary : Lean.NameSet) : IO Lean.Json := do
  let .ok initial ← PsKernelLean.buildLeanPreludeEnvironment
    | throw (IO.userError "cannot construct checked portable prelude for reuse probe")
  let mut environment := initial
  let mut pending := (← standardDependencyClosure native root boundary).filter
    (fun info => !boundary.contains info.name)
  let mut admitted : Array String := #[]
  let mut failures : Array Lean.Json := #[]
  let mut progress := true
  while progress && !pending.isEmpty do
    progress := false
    let mut deferred := #[]
    for info in pending do
      if (environment.find? info.name).isSome then
        progress := true
        continue
      match nativeSubmission native info with
      | .error reason =>
        failures := failures.push (Lean.Json.mkObj [
          ("name", Lean.toJson (toString info.name)), ("reason", Lean.toJson reason)])
        progress := true
      | .ok none => deferred := deferred.push info
      | .ok (some declaration) =>
        let provided := declaration.getNames
        let ready := (submissionDependencies declaration).all fun name =>
          provided.contains name || (environment.find? name).isSome
        if !ready then deferred := deferred.push info else
          progress := true
          let attempt ← PsKernelLean.withFreshKernelHeartbeatScope fun _ =>
            environment.addDeclCore 2000000 20000 declaration none
          match attempt with
          | .ok next =>
            environment := next
            admitted := admitted.push (toString info.name)
          | .error error =>
            failures := failures.push (Lean.Json.mkObj [
              ("name", Lean.toJson (toString info.name)),
              ("kernel", kernelProbeDetails error)])
    pending := deferred
  return Lean.Json.mkObj [
    ("root", Lean.toJson (toString root)),
    ("accepted", Lean.toJson ((environment.find? root).isSome)),
    ("admitted", Lean.toJson admitted),
    ("failures", .arr failures),
    ("blocked", Lean.toJson (pending.map (fun info => toString info.name)))]

def standardClosureAudit : IO Lean.Json := do
  Lean.initSearchPath (← Lean.findSysroot)
  let native ← Lean.importModules #[{ module := `Init }] {}
  -- F0: read-only pinned model, bits, equality and scientific closure.
  -- No source Float declarations are enabled by this inventory.
  let roots := [`Nat.mod_lt, `BitVec.ofNat, `UInt64.ofNat, `UInt64.xor,
    `mixHash, `String.hash, `Float, `Float32,
    `Float.ofBits, `Float.toBits, `Float.beq, `Float.ofScientific,
    `Float32.ofBits, `Float32.toBits, `Float32.beq,
    `OfScientific.ofScientific]
  let portableNames := psSelfHostProdPreludeEnvironment.declarations.foldl
    (fun (names : Lean.NameSet) d => names.insert (PsKernelLean.toLeanName (psDeclarationName d))) {}
  let reports ← roots.mapM fun root => do
    let entries ← standardDependencyClosure native root
    let summarize := fun (info : Lean.ConstantInfo) => Lean.Json.mkObj [
      ("name", Lean.toJson (toString info.name)),
      ("kind", Lean.toJson (closureKind info)),
      ("existingPortableName", Lean.toJson (portableNames.contains info.name))]
    pure (Lean.Json.mkObj [
      ("root", Lean.toJson (toString root)),
      ("count", Lean.toJson entries.size),
      ("axioms", Lean.toJson ((entries.filter Lean.ConstantInfo.isAxiom).map (fun x => toString x.name))),
      ("entries", .arr (entries.map summarize))])
  return Lean.Json.mkObj [
    ("schema", Lean.toJson ("pscv0-standard-dependency-audit/1" : String)),
    ("leanCommit", Lean.toJson Lean.githash),
    ("limitation", Lean.toJson ("Read-only upstream closure. Existing names are collision boundaries, not compatible imports. No declarations are admitted, no proof bodies replaced by axioms, and no runtime equivalence is asserted." : String)),
    ("roots", Lean.toJson reports),
    ("arithmeticReuseProbe", ← compatibilityProbe native `Nat.mod_lt portableNames)]

-- Core-first source ownership is read from imported module metadata. Declaration
-- names and literal strings are never used to guess which code is portable.
def coreNativeCompilerImports : Array Lean.Import :=
  #[{ module := `Ps.Compiler.Pscv0Modules },
    { module := `Ps.BackendTs.Readable },
    { module := `Ps.BackendRust.Module },
    { module := `Ps.BackendWasm.Module },
    { module := `Ps.CompilerIr.Checked },
    { module := `Ps.Codegen.Api },
    { module := `Ps.Codegen.Provenance }]

private def coreNativeNameParts : Lean.Name → List Lean.Json
  | .anonymous => []
  | .str parent value =>
      coreNativeNameParts parent ++
        [Lean.Json.mkObj [("str", Lean.toJson value)]]
  | .num parent value =>
      coreNativeNameParts parent ++
        [Lean.Json.mkObj [("num", Lean.toJson value)]]

private def coreNativeNameJson (name : Lean.Name) : Lean.Json :=
  Lean.Json.mkObj [
    ("display", Lean.toJson (toString name)),
    ("parts", .arr (coreNativeNameParts name).toArray)]

private def coreNativeOwner? (native : Lean.Environment)
    (name : Lean.Name) : Option Lean.Name := do
  let index ← native.getModuleIdxFor? name
  native.header.moduleNames[index.toNat]?

private def coreNativeSourceModule (name : Lean.Name) : Bool :=
  (`Ps : Lean.Name).isPrefixOf name

private def coreNativeFamilyDependencies (info : Lean.ConstantInfo) :
    Array Lean.Name :=
  match info with
  | .inductInfo value =>
      value.all.toArray ++ value.ctors.toArray ++ #[.str value.name "rec"]
  | .ctorInfo value => #[value.induct]
  | .quotInfo _ => #[`Quot, `Quot.mk, `Quot.lift, `Quot.ind]
  | .recInfo value =>
      value.all.toArray ++
        (value.rules.toArray.flatMap fun rule =>
          #[rule.ctor] ++ rule.rhs.getUsedConstants)
  | _ => #[]

structure CoreNativeClosure where
  sourceModules : Array Lean.Name
  sourceDeclarations : Nat
  roots : List Lean.Name
  entries : Array Lean.ConstantInfo
  report : Lean.Json

-- Source compilation needs every declaration in each owned source module,
-- including private helpers and generated equations. External roots are the
-- actual constants referenced by those checked types, values and rule bodies.
-- The report records the raw graph: it does not erase annotations or admit
-- declarations, and it does not select a portable Standard environment.
def collectCoreNativeClosure : IO CoreNativeClosure := do
  Lean.initSearchPath (← Lean.findSysroot)
  unless Lean.githash == "eb6cafb7290e8bd5f2937522d8d804f58f02bafc" do
    throw (IO.userError "Core ownership audit requires pinned Lean 4.35.0")
  let native ← Lean.importModules coreNativeCompilerImports {}
  let sourceModules := native.header.moduleNames.filter coreNativeSourceModule
  for imported in coreNativeCompilerImports do
    unless sourceModules.contains imported.module do
      throw (IO.userError
        ("missing native source-module owner: " ++ toString imported.module))
  let sourceEntries := (native.checked.get.constants.fold
    (fun (entries : Array Lean.ConstantInfo) _ info =>
      if (coreNativeOwner? native info.name).any coreNativeSourceModule then
        entries.push info
      else entries) #[]).qsort (fun a b => Lean.Name.lt a.name b.name)
  unless !sourceEntries.isEmpty do
    throw (IO.userError "native source ownership audit found no declarations")
  let mut roots : Lean.NameSet := {}
  let mut witnesses : Array Lean.Json := #[]
  for info in sourceEntries do
    let some owner := coreNativeOwner? native info.name
      | throw (IO.userError "source declaration lost its module owner")
    let edges : List (String × Array Lean.Name) :=
      [("type", info.type.getUsedConstants),
       ("value", ((info.value? true).map (fun value => value.getUsedConstants)).getD #[]),
       ("family-or-rule", coreNativeFamilyDependencies info)]
    for (kind, dependencies) in edges do
      for dependency in dependencies do
        let some target := native.checked.get.find? dependency
          | throw (IO.userError
              ("missing checked dependency: " ++ toString dependency))
        if (coreNativeOwner? native target.name).any coreNativeSourceModule then
          continue
        unless roots.contains dependency do
          roots := roots.insert dependency
          witnesses := witnesses.push (Lean.Json.mkObj [
            ("root", coreNativeNameJson dependency),
            ("source", coreNativeNameJson info.name),
            ("sourceModule", coreNativeNameJson owner),
            ("edge", Lean.toJson kind)])
  let mut entries : Array Lean.ConstantInfo := #[]
  let mut seen : Lean.NameSet := {}
  let orderedRoots := (native.checked.get.constants.fold
    (fun (names : Array Lean.Name) name _ =>
      if roots.contains name then names.push name else names) #[]).qsort Lean.Name.lt
  unless orderedRoots.size == witnesses.size do
    throw (IO.userError "native external-root roster did not resolve exactly")
  let mut pending := orderedRoots.toList
  while !pending.isEmpty do
    let name := pending.head!
    pending := pending.tail!
    unless seen.contains name do
      seen := seen.insert name
      let some info := native.checked.get.find? name
        | throw (IO.userError
            ("missing native Core closure declaration: " ++ toString name))
      if (coreNativeOwner? native info.name).any coreNativeSourceModule then
        throw (IO.userError
          ("native library closure re-enters source module: " ++ toString info.name))
      entries := entries.push info
      pending := (closureDependencies info).toList ++ pending
  entries := entries.qsort (fun a b => Lean.Name.lt a.name b.name)
  for info in entries do
    for dependency in closureDependencies info do
      unless seen.contains dependency do
        throw (IO.userError
          ("open native Core dependency: " ++ toString info.name ++
            " -> " ++ toString dependency))
  let entryJson := fun (info : Lean.ConstantInfo) => Lean.Json.mkObj [
    ("name", coreNativeNameJson info.name),
    ("kind", Lean.toJson (closureKind info)),
    ("typeDependencies", .arr (info.type.getUsedConstants.map coreNativeNameJson)),
    ("valueDependencies", .arr
      ((((info.value? true).map (fun value => value.getUsedConstants)).getD #[]).map
        coreNativeNameJson)),
    ("familyOrRuleDependencies", .arr
      ((coreNativeFamilyDependencies info).map coreNativeNameJson)),
    ("dependencies", .arr ((closureDependencies info).map coreNativeNameJson)),
    ("module", match coreNativeOwner? native info.name with
      | some name => coreNativeNameJson name
      | none => Lean.Json.null)]
  let report := Lean.Json.mkObj [
    ("schema", Lean.toJson ("pscv0-core-native-closure/1" : String)),
    ("leanCommit", Lean.toJson Lean.githash),
    ("importRoots", .arr (coreNativeCompilerImports.map fun item =>
      coreNativeNameJson item.module)),
    ("sourceModules", .arr (sourceModules.map coreNativeNameJson)),
    ("sourceDeclarations", Lean.toJson sourceEntries.size),
    ("externalRootCount", Lean.toJson orderedRoots.size),
    ("externalRoots", .arr (orderedRoots.map coreNativeNameJson)),
    ("rootWitnesses", .arr witnesses),
    ("closureDeclarationCount", Lean.toJson entries.size),
    ("closureDeclarations", .arr (entries.map entryJson)),
    ("axioms", .arr ((entries.filter Lean.ConstantInfo.isAxiom).map entryJson)),
    ("unsafe", .arr ((entries.filter Lean.ConstantInfo.isUnsafe).map entryJson)),
    ("partial", .arr ((entries.filter Lean.ConstantInfo.isPartial).map entryJson)),
    ("emptyBoundary", Lean.toJson true),
    ("annotationsErased", Lean.toJson false),
    ("candidateKernelAdmitted", Lean.toJson false)]
  return {
    sourceModules
    sourceDeclarations := sourceEntries.size
    roots := orderedRoots.toList
    entries
    report
  }

end PsV7Native
