/-
Native authoring audit for selected Standard dependencies; never imported by
the portable compiler. Traversal follows Lean 4.35.0 CollectAxioms.lean's
visited-before-descending invariant, extended to recursor rule RHSs and mutual
families. This reports dependencies, not admission or equivalence.
-/
import Ps.Host.PrimitiveAudit
import Lean.Util.CollectAxioms

namespace PsV7Native

private def closureDependencies (info : Lean.ConstantInfo) : Array Lean.Name :=
  let expressions := info.type.getUsedConstants ++
    ((info.value? true).map Lean.Expr.getUsedConstants).getD #[]
  let family := match info with
    | .inductInfo v => v.all.toArray ++ v.ctors.toArray ++ #[.str v.name "rec"]
    | .ctorInfo v => #[v.induct]
    | .recInfo v => v.all.toArray ++
        (v.rules.toArray.flatMap fun rule => #[rule.ctor] ++ rule.rhs.getUsedConstants)
    | _ => #[]
  expressions ++ family

private def closureKind : Lean.ConstantInfo → String
  | .axiomInfo _ => "axiom"
  | .defnInfo _ => "definition"
  | .thmInfo _ => "theorem"
  | .opaqueInfo _ => "opaque"
  | .quotInfo _ => "quotient-primitive"
  | .inductInfo _ => "inductive"
  | .ctorInfo _ => "constructor"
  | .recInfo _ => "recursor"

-- Worklist with a visited set handles inductive/constructor/recursor cycles
-- without imposing the compiler's elaboration resource policy on this audit.
def standardDependencyClosure (environment : Lean.Environment) (root : Lean.Name)
    (boundary : Lean.NameSet := {}) :
    IO (Array Lean.ConstantInfo) := do
  let mut pending := [root]
  let mut seen : Lean.NameSet := {}
  let mut entries := #[]
  while !pending.isEmpty do
    let name := pending.head!
    pending := pending.tail!
    if !seen.contains name then
      seen := seen.insert name
      let some info := environment.checked.get.find? name
        | throw (IO.userError ("missing upstream closure declaration: " ++ toString name))
      entries := entries.push info
      if !boundary.contains name then
        pending := (closureDependencies info).toList ++ pending
  return entries.qsort (fun a b => Lean.Name.lt a.name b.name)

-- Turn upstream checked entries back into kernel submissions. Constructors
-- and recursors are regenerated by inductive admission; no recursor is trusted.
private def nativeSubmission (native : Lean.Environment) (info : Lean.ConstantInfo) :
    Except String (Option Lean.Declaration) := do
  if info.isUnsafe || info.isPartial then throw "unsafe or partial declaration"
  match info with
  | .defnInfo value => return some (.defnDecl value)
  | .thmInfo value => return some (.thmDecl value)
  | .opaqueInfo value => return some (.opaqueDecl value)
  | .inductInfo value =>
    let types ← value.all.mapM fun name => do
      let some (.inductInfo member) := native.checked.get.find? name
        | throw ("missing mutual member " ++ toString name)
      let ctors ← member.ctors.mapM fun name => do
        let some (.ctorInfo ctor) := native.checked.get.find? name
          | throw ("missing constructor " ++ toString name)
        pure ({ name, type := ctor.type } : Lean.Constructor)
      pure ({ name, type := member.type, ctors } : Lean.InductiveType)
    return some (.inductDecl value.levelParams value.numParams types false)
  | .ctorInfo _ | .recInfo _ => return none
  | .axiomInfo _ => throw "new axiom prohibited by this reuse probe"
  | .quotInfo _ => throw "new quotient primitive prohibited by this reuse probe"

private def submissionDependencies (declaration : Lean.Declaration) : Array Lean.Name :=
  Id.run <| declaration.foldExprM
    (fun names expr => pure (names ++ expr.getUsedConstants)) #[]

private def kernelProbeDetails (error : Lean.Kernel.Exception) : Lean.Json :=
  let summary := ("reason", Lean.toJson (PsKernelLean.kernelExceptionSummary error))
  match error with
  | .appTypeMismatch _ _ app functionType argumentType =>
    Lean.Json.mkObj [summary, ("application", Lean.toJson app.dbgToString),
      ("functionType", Lean.toJson functionType.dbgToString),
      ("argumentType", Lean.toJson argumentType.dbgToString)]
  | .declTypeMismatch _ _ type =>
    Lean.Json.mkObj [summary, ("givenType", Lean.toJson type.dbgToString)]
  | _ => Lean.Json.mkObj [summary]

-- Read-only compatibility experiment against a fresh officially checked
-- portable prelude. Its environment is discarded, never used by compilation.
-- A failed kernel check stays failed; dependents are reported as blocked.
private def compatibilityProbe (native : Lean.Environment) (root : Lean.Name)
    (boundary : Lean.NameSet) : IO Lean.Json := do
  let .ok initial ← PsKernelLean.buildLeanPreludeEnvironment
    | throw (IO.userError "cannot construct checked portable prelude for reuse probe")
  let mut environment := initial
  let mut pending := (← standardDependencyClosure native root boundary).filter
    (fun info => !boundary.contains info.name)
  let mut admitted : Array String := #[]
  let mut failures : Array Lean.Json := #[]
  let mut progress := true
  while progress && !pending.isEmpty do
    progress := false
    let mut deferred := #[]
    for info in pending do
      if (environment.checked.get.find? info.name).isSome then
        progress := true
        continue
      match nativeSubmission native info with
      | .error reason =>
        failures := failures.push (Lean.Json.mkObj [
          ("name", Lean.toJson (toString info.name)), ("reason", Lean.toJson reason)])
        progress := true
      | .ok none => deferred := deferred.push info
      | .ok (some declaration) =>
        let provided := declaration.getNames
        let ready := (submissionDependencies declaration).all fun name =>
          provided.contains name || (environment.checked.get.find? name).isSome
        if !ready then deferred := deferred.push info else
          progress := true
          match environment.addDeclCore 2000000 20000 declaration none true with
          | .ok next =>
            environment := next
            admitted := admitted.push (toString info.name)
          | .error error =>
            failures := failures.push (Lean.Json.mkObj [
              ("name", Lean.toJson (toString info.name)),
              ("kernel", kernelProbeDetails error)])
    pending := deferred
  return Lean.Json.mkObj [
    ("root", Lean.toJson (toString root)),
    ("accepted", Lean.toJson ((environment.checked.get.find? root).isSome)),
    ("admitted", Lean.toJson admitted),
    ("failures", .arr failures),
    ("blocked", Lean.toJson (pending.map (fun info => toString info.name)))]

def standardClosureAudit : IO Lean.Json := do
  Lean.initSearchPath (← Lean.findSysroot)
  let native ← Lean.importModules #[{ module := `Init }] {}
  let roots := [`Nat.mod_lt, `BitVec.ofNat, `UInt64.ofNat, `UInt64.xor,
    `mixHash, `String.hash, `Float, `Float.ofScientific]
  let portableNames := psSelfHostProdPreludeEnvironment.declarations.foldl
    (fun (names : Lean.NameSet) d => names.insert (PsKernelLean.toLeanName (psDeclarationName d))) {}
  let reports ← roots.mapM fun root => do
    let entries ← standardDependencyClosure native root
    let summarize := fun (info : Lean.ConstantInfo) => Lean.Json.mkObj [
      ("name", Lean.toJson (toString info.name)),
      ("kind", Lean.toJson (closureKind info)),
      ("existingPortableName", Lean.toJson (portableNames.contains info.name))]
    pure (Lean.Json.mkObj [
      ("root", Lean.toJson (toString root)),
      ("count", Lean.toJson entries.size),
      ("axioms", Lean.toJson ((entries.filter Lean.ConstantInfo.isAxiom).map (fun x => toString x.name))),
      ("entries", .arr (entries.map summarize))])
  return Lean.Json.mkObj [
    ("schema", Lean.toJson ("pscv0-standard-dependency-audit/1" : String)),
    ("leanCommit", Lean.toJson Lean.githash),
    ("limitation", Lean.toJson ("Read-only upstream closure. Existing names are collision boundaries, not compatible imports. No declarations are admitted, no proof bodies replaced by axioms, and no runtime equivalence is asserted." : String)),
    ("roots", Lean.toJson reports),
    ("arithmeticReuseProbe", ← compatibilityProbe native `Nat.mod_lt portableNames)]

end PsV7Native
