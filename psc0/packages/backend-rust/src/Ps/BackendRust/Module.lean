import Ps.BackendRust.Tail
import Ps.BackendRust.Runtime
import Ps.Codegen.Artifact

def psRustGenericNames (ps : List PsVerifiedIrTypeParameter) (bounds : Bool) : String :=
  if ps.isEmpty then "" else
    "<" ++ String.intercalate ", " (ps.map fun p =>
      p.name ++ if bounds then ": Clone + 'static" else "") ++ ">"

def psRustMarker (ps : List PsVerifiedIrTypeParameter) : List PsDoc :=
  if ps.isEmpty then [] else
    [.text ("__ps_marker: std::marker::PhantomData<fn() -> (" ++
      String.intercalate ", " (ps.map (·.name)) ++ ",)>,")]

def psRustField (name : String) (type : PsVerifiedIrType) (visible : Bool) :
    Except String PsDoc := do
  return .text ((if visible then "pub " else "") ++ name ++ ": " ++
    (← psRustResult (psRustEmitType type)) ++ ",")

def psRustLayoutDoc (shared : List String) (name : String)
    (ps : List PsVerifiedIrTypeParameter) (body : PsDoc) : PsDoc :=
  let alias := if shared.contains name then
    [PsDoc.text ("pub type " ++ name ++ psRustGenericNames ps true ++
      " = std::rc::Rc<" ++ psRustNodeName shared name ++ psRustGenericNames ps false ++ ">;")]
    else []
  .origin name (psDocJoin .hardline (alias ++ [.text "#[derive(Clone)]", body]))

def psRustStructureDoc (shared : List String) (s : PsVerifiedIrStructure) :
    Except String PsDoc := do
  let fields ← s.fields.mapM fun f => psRustField f.name f.type true
  return psRustLayoutDoc shared s.name s.typeParameters
    (psDocBlock ("pub struct " ++ psRustNodeName shared s.name ++ psRustGenericNames s.typeParameters true)
      (fields ++ psRustMarker s.typeParameters))

def psRustInductiveDoc (shared : List String) (i : PsVerifiedIrInductive) :
    Except String PsDoc := do
  let constructors ← i.constructors.mapM fun c => do
    let fields ← c.fields.mapM fun f => psRustField f.name f.type false
    return PsDoc.append (psDocBlock c.name (fields ++ psRustMarker i.typeParameters)) (.text ",")
  -- Rust requires generic parameters to occur even for empty PSC families.
  -- Infallible preserves uninhabitability; no fabricated inhabitant is added.
  let constructors := if i.constructors.isEmpty && !i.typeParameters.isEmpty then
    [PsDoc.text ("__ps_uninhabited(std::convert::Infallible, std::marker::PhantomData<fn() -> (" ++
      String.intercalate ", " (i.typeParameters.map (·.name)) ++ ",)>),")] else constructors
  return psRustLayoutDoc shared i.name i.typeParameters
    (psDocBlock ("pub enum " ++ psRustNodeName shared i.name ++ psRustGenericNames i.typeParameters true) constructors)

def psRustDeclarationDoc (ctx : PsRustContext) (d : PsVerifiedIrDeclaration) :
    Except String PsDoc := do
  let parameters ← d.parameters.mapM psRustParameter
  let resultType ← psRustResult (psRustEmitType d.resultType)
  let body ← psRustDeclarationBody ctx d
  let header := "pub fn " ++ d.name ++ psRustGenericNames d.typeParameters true ++
    "(" ++ String.intercalate ", " parameters ++ ") -> " ++ resultType
  if d.parameters.isEmpty then
    if !d.typeParameters.isEmpty then throw ("PSCV0-RUST: uninstantiated generic value " ++ d.name)
    -- Closed pure values are initialized once per thread. They may contain Rc
    -- closures/data; requiring Sync statics would change the source language.
    let initialization : PsDoc := .append
      (.text ("static __PS_VALUE: std::cell::LazyCell<" ++ resultType ++ "> = std::cell::LazyCell::new(|| "))
      (.append (psDocBlock "" [body]) (.text ");"))
    return .origin d.name (psDocBlock header [
      psDocBlock "std::thread_local!" [initialization],
      .text "__PS_VALUE.with(|value| (**value).clone())"])
  return .origin d.name (psDocBlock header [body])

def psRustEmitReadable (ir : PsVerifiedIrModule) : Except String PsEmissionArtifact := do
  if !ir.imports.isEmpty then throw "PSCV0-RUST: external capabilities are not qualified"
  let (view, names) ← psCodegenNamesFor ir psRustReservedNames
  let shared ← psRustSharedLayouts view
  let ctx : PsRustContext := { declarations := view.declarations, shared }
  let structures ← view.structures.mapM (psRustStructureDoc shared)
  let inductives ← view.inductives.mapM (psRustInductiveDoc shared)
  let declarations ← view.declarations.mapM (psRustDeclarationDoc ctx)
  let header := [
    PsDoc.text "// Generated by native PSCV0; kernel/IR provenance is in the emission manifest.",
    .text "#![forbid(unsafe_code)]",
    .text "#![allow(non_snake_case, non_camel_case_types, unused_variables, unused_mut, dead_code, type_alias_bounds)]",
    .text "#[path = \"pscv0_runtime.rs\"] mod __ps_runtime;",
    .text "pub use __ps_runtime::{PsNat, PsInt, PsArray};",
    .text "use __ps_runtime::*;"]
  let source ← psRenderDoc (.append
    (psDocJoin (.append .hardline .hardline) (header ++ structures ++ inductives ++ declarations)) .hardline)
  return { target := .rust, source, symbols := names.symbols.reverse, runtime := psRustRuntimePrelude }
