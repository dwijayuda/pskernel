import Ps.BackendTs.Module
import Ps.Codegen.Artifact

def psTsPrintResult {α : Type} (result : Except PsTsEmitError α) : Except String α :=
  result.mapError (fun _ => "PSCV0-TYPESCRIPT-EMISSION-FAILED")

def psTsDeclarationDoc (brands tags : List (String × String))
    (d : PsVerifiedIrDeclaration) : Except String PsDoc := do
  -- Keep the established tail optimizations; their structured layout follows
  -- the general declaration path as the printer grows.
  if let some loop := psTsEmitCountLoop tags d then return .origin d.name (.text loop)
  if let some loop := psTsEmitTailLoop brands tags d then return .origin d.name (.text loop)
  let resultType ← psTsPrintResult (psTsEmitType d.resultType)
  let body ← psTsPrintResult (psTsEmitExpr brands tags (psTsInlineEtaApplication d.body))
  let generic := psTsGenericNames d.typeParameters
  if d.parameters.isEmpty then
    if !d.typeParameters.isEmpty then throw ("PSCV0-TYPESCRIPT: generic value " ++ d.name)
    return .origin d.name (.append
      (.text ("export const " ++ d.name ++ ": " ++ resultType ++ " = __ps$run((function*(): __ps$Computation<" ++ resultType ++ "> "))
      (.append (psDocBlock "" [.text ("return " ++ body ++ ";")]) (.text ")());")))
  let parameters ← d.parameters.mapM fun p => do
    return p.name ++ ": " ++ (← psTsPrintResult (psTsEmitType p.type))
  let arguments := String.intercalate ", " (d.parameters.map (·.name))
  let implementation := "__ps$impl$" ++ d.name
  let signature := generic ++ "(" ++ String.intercalate ", " parameters ++ ")"
  return .origin d.name (psDocJoin .hardline [
    psDocBlock ("export function " ++ d.name ++ signature ++ ": " ++ resultType)
      [.text ("return __ps$run(" ++ implementation ++ generic ++ "(" ++ arguments ++ "));")],
    psDocBlock ("function* " ++ implementation ++ signature ++ ": __ps$Computation<" ++ resultType ++ ">")
      [.text ("return " ++ body ++ ";")],
    .text ("__ps$implementations.set(" ++ d.name ++ ", " ++ implementation ++ ");")])

def psTsEmitReadable (ir : PsVerifiedIrModule) (stem : String := "module") : Except String PsEmissionArtifact := do
  let (view, names) ← psCodegenNamesFor ir psTsReservedNames
  let brands := psTsBuildBrandMap view
  let tags := psTsBuildTagMap view
  let structures ← view.structures.mapM fun s => do
    let some brand := psTsLookup brands s.name
      | throw ("PSCV0-TYPESCRIPT: missing structure " ++ s.name)
    let fields ← s.fields.mapM fun field => do
      return PsDoc.text ("readonly " ++ field.name ++ ": " ++ (← psTsPrintResult (psTsEmitType field.type)) ++ ";")
    return PsDoc.origin s.name (psDocJoin .hardline [
      .text ("const " ++ brand ++ ": unique symbol = Symbol(" ++ psJsonQuote s.name ++ ");"),
      psDocBlock ("export interface " ++ s.name ++ psTsGenericNames s.typeParameters)
        (.text ("readonly [" ++ brand ++ "]: true;") :: fields)])
  let inductives ← view.inductives.mapM fun i => do
    let lines ← psTsPrintResult (psTsEmitInductive tags i)
    return PsDoc.origin i.name (psDocJoin .hardline (lines.map PsDoc.text))
  let declarations ← view.declarations.mapM (psTsDeclarationDoc brands tags)
  let docs := [PsDoc.text "// Generated by the native PSCV0 compiler; see the emission manifest.",
      .text psTsRuntimeSupport] ++
    (view.imports.map fun item => .text (psTsEmitImport item)) ++ structures ++ inductives ++ declarations
  let source ← psRenderDoc (.append (psDocJoin (.append .hardline .hardline) docs) .hardline)
  psValidateArtifact {
    target := .typescript
    source := source
    symbols := names.symbols.reverse
    files := [{ path := stem ++ ".ts", role := .implementation, payload := .text source.text }] }
