import Ps.Foundation.Source

-- Identity is independent of a target's spelling and generated byte offsets.
-- Declaration IDs are qualified semantic names; occurrence paths are reserved
-- for finer-grained origins and never participate in Core equality.
structure PsSourceIdentity where
  file : String
  declaration : String
  occurrence : List Nat := []

-- The emission boundary retains source command ownership independently of
-- target symbol spelling. Member spans stay on PsSourceOrigin itself.
structure PsSourceMutualGroupOrigin where
  firstSourceIndex : Nat
  memberIndex : Nat
  memberCount : Nat
  span : PsSourceSpan

structure PsSourceOrigin where
  identity : PsSourceIdentity
  span : PsSourceSpan
  generatedReason : Option String := none
  sourceIndex : Option Nat := none
  mutualGroup : Option PsSourceMutualGroupOrigin := none

structure PsEmissionContext where
  sourceName : String := "application.ps"
  sourceText : String := ""
  outputStem : String := "module"
  origins : List (String × PsSourceOrigin) := []
  -- Empty selects the legacy single-file source map. In project mode this
  -- contains each named source exactly once, preserving per-file offsets.
  sourceFiles : List (String × String) := []

def psSourceOriginFor (context : PsEmissionContext) (semanticName : String) :
    Option PsSourceOrigin :=
  (context.origins.find? (fun entry => entry.fst == semanticName)).map Prod.snd

-- Source parser coordinates are UTF-8 bytes / scalar columns. Source maps use
-- zero-based UTF-16 columns. Build the conversion table once per input.
structure PsSourceCoordinate where
  byteOffset : Nat
  line : Nat
  column : Nat
  deriving Inhabited

def psSourceCoordinates (source : String) : Array PsSourceCoordinate :=
  let (_, _, _, entries) := source.toList.foldl
    (fun (state : Nat × Nat × Nat × Array PsSourceCoordinate) c =>
      let (offset, line, column, entries) := state
      let next := offset + (String.singleton c).utf8ByteSize
      let (line, column) := if c == '\n' then (line + 1, 0)
        else (line, column + (if c.toNat > 0xffff then 2 else 1))
      (next, line, column, entries.push { byteOffset := next, line, column }))
    (0, 0, 0, #[{ byteOffset := 0, line := 0, column := 0 }])
  entries

def psSourceCoordinateAt (coordinates : Array PsSourceCoordinate) (offset : Nat) :
    Except String PsSourceCoordinate := do
  -- Binary search; the returned position must be an exact scalar boundary.
  let result := (List.range (coordinates.size + 1).log2.succ).foldl
    (fun (bounds : Nat × Nat) _ =>
      let middle := (bounds.fst + bounds.snd) / 2
      if (coordinates[middle]!).byteOffset < offset then (middle + 1, bounds.snd)
      else (bounds.fst, middle)) (0, coordinates.size)
  let some position := coordinates[result.fst]? | throw "PSCV0-SOURCE: offset outside input"
  if position.byteOffset != offset then throw "PSCV0-SOURCE: offset is not a scalar boundary"
  return position

