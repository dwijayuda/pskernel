import Ps.Environment.StandardOption
import Ps.Core.Equality
import Ps.Environment.ReprExpr

-- Lean 4.35.0 List.rec: result sort first, then element universe.
def psStandardListRecursor (element : PsLevel := .zero)
    (result : PsLevel := .succ .zero) : PsExpr :=
  .constE psSelfHostListRecName [result, element]

def psStandardListLengthDeclaration : PsDeclaration :=
  let u := PsLevel.param (psRootName "u")
  let alpha := PsExpr.fvar 0
  let listAlpha := psSelfHostListOf alpha u
  let nat := PsExpr.constE psNatName []
  let motive := psLogicLam 2 "_" listAlpha nat
  let step := psLogicLam 3 "head" alpha
    (psLogicLam 4 "tail" listAlpha
      (psLogicLam 5 "ih" nat
        (.app (.constE psNatSuccName []) (.fvar 5))))
  let type := psLogicPi 0 "α" (.sortE (.succ u))
    (psLogicPi 1 "xs" listAlpha nat) .implicit
  let body := psLogicApply (psStandardListRecursor u (.succ .zero))
    [alpha, motive, .lit (.natural 0), step, .fvar 1]
  let value := psLogicLam 0 "α" (.sortE (.succ u))
    (psLogicLam 1 "xs" listAlpha body) .implicit
  .definitionDecl (psNameAppendStr psListName "length") [psRootName "u"] type value

def psStandardListMapDeclaration : PsDeclaration :=
  let u := PsLevel.param (psRootName "u")
  let v := PsLevel.param (psRootName "v")
  let alpha := PsExpr.fvar 0
  let beta := PsExpr.fvar 1
  let listAlpha := psSelfHostListOf alpha u
  let listBeta := psSelfHostListOf beta v
  let arrow := psLogicPi 5 "element" alpha beta
  let motive := psLogicLam 5 "_" listAlpha listBeta
  let step := psLogicLam 6 "head" alpha
    (psLogicLam 7 "tail" listAlpha
      (psLogicLam 8 "ih" listBeta
        (psSelfHostListConsOf beta (.app (.fvar 2) (.fvar 6)) (.fvar 8) v)))
  let type := psLogicPi 0 "α" (.sortE (.succ u))
    (psLogicPi 1 "β" (.sortE (.succ v))
      (psLogicPi 2 "f" arrow
        (psLogicPi 3 "xs" listAlpha listBeta)) .implicit) .implicit
  let body := psLogicApply (psStandardListRecursor u (.succ v))
    [alpha, motive, psSelfHostListNilOf beta v, step, .fvar 3]
  let value := psLogicLam 0 "α" (.sortE (.succ u))
    (psLogicLam 1 "β" (.sortE (.succ v))
      (psLogicLam 2 "f" arrow
        (psLogicLam 3 "xs" listAlpha body)) .implicit) .implicit
  .definitionDecl (psNameAppendStr psListName "map") [psRootName "u", psRootName "v"] type value

def psStandardListAppendDeclaration : PsDeclaration :=
  let u := PsLevel.param (psRootName "u")
  let alpha := PsExpr.fvar 0
  let listAlpha := psSelfHostListOf alpha u
  let motive := psLogicLam 6 "_" listAlpha listAlpha
  let step := psLogicLam 3 "head" alpha
    (psLogicLam 4 "tail" listAlpha
      (psLogicLam 5 "ih" listAlpha
        (psSelfHostListConsOf alpha (.fvar 3) (.fvar 5) u)))
  let type := psLogicPi 0 "α" (.sortE (.succ u))
    (psLogicPi 1 "xs" listAlpha
      (psLogicPi 2 "ys" listAlpha listAlpha)) .implicit
  let body := psLogicApply (psStandardListRecursor u (.succ u))
    [alpha, motive, .fvar 2, step, .fvar 1]
  let value := psLogicLam 0 "α" (.sortE (.succ u))
    (psLogicLam 1 "xs" listAlpha
      (psLogicLam 2 "ys" listAlpha body)) .implicit
  .definitionDecl (psNameAppendStr psListName "append") [psRootName "u"] type value

def psStandardListFilterDeclaration : PsDeclaration :=
  let u := PsLevel.param (psRootName "u")
  let alpha := PsExpr.fvar 0
  let listAlpha := psSelfHostListOf alpha u
  let bool := PsExpr.constE psBoolName []
  let predicate := psLogicPi 6 "value" alpha bool
  let motive := psLogicLam 6 "_" listAlpha listAlpha
  let boolMotive := psLogicLam 7 "_" bool listAlpha
  let step := psLogicLam 3 "head" alpha
    (psLogicLam 4 "tail" listAlpha
      (psLogicLam 5 "ih" listAlpha
        (psLogicApply (.constE (psNameAppendStr psBoolName "rec") [.succ u])
          [boolMotive, .fvar 5, psSelfHostListConsOf alpha (.fvar 3) (.fvar 5) u,
           .app (.fvar 1) (.fvar 3)])))
  let type := psLogicPi 0 "α" (.sortE (.succ u))
    (psLogicPi 1 "p" predicate
      (psLogicPi 2 "xs" listAlpha listAlpha)) .implicit
  let body := psLogicApply (psStandardListRecursor u (.succ u))
    [alpha, motive, psSelfHostListNilOf alpha u, step, .fvar 2]
  let value := psLogicLam 0 "α" (.sortE (.succ u))
    (psLogicLam 1 "p" predicate
      (psLogicLam 2 "xs" listAlpha body)) .implicit
  .definitionDecl (psNameAppendStr psListName "filter") [psRootName "u"] type value

-- Structural recursion must own its decreasing major at the executable
-- function boundary. A named worker whose result is β → β has precisely the
-- inductive hypothesis generated by List.rec. The public Lean-compatible
-- foldl API supplies the initial accumulator afterward. Captured f is stable,
-- and the erasure layer can reuse its existing checked recursive-call plan.
def psStandardListFoldlWorkerName : PsName :=
  psNameAppendStr (psRootName "$psc0Standard") "listFoldlWorker"

def psStandardListFoldlWorkerDeclaration : PsDeclaration :=
  let u := PsLevel.param (psRootName "u")
  let v := PsLevel.param (psRootName "v")
  let alpha := PsExpr.fvar 0
  let beta := PsExpr.fvar 1
  let listAlpha := psSelfHostListOf alpha u
  let functionType := psLogicPi 10 "acc" beta
    (psLogicPi 11 "item" alpha beta)
  let accumulatorType := psLogicPi 12 "acc" beta beta
  let motive := psLogicLam 12 "_" listAlpha accumulatorType
  let initial := psLogicLam 5 "acc" beta (.fvar 5)
  let step := psLogicLam 6 "head" alpha
    (psLogicLam 7 "tail" listAlpha
      (psLogicLam 8 "ih" accumulatorType
        (psLogicLam 9 "acc" beta
          (.app (.fvar 8)
            (psLogicApply (.fvar 2) [.fvar 9, .fvar 6])))))
  let type := psLogicPi 0 "α" (.sortE (.succ u))
    (psLogicPi 1 "β" (.sortE (.succ v))
      (psLogicPi 2 "f" functionType
        (psLogicPi 3 "xs" listAlpha accumulatorType)) .implicit) .implicit
  let body := psLogicApply (psStandardListRecursor u (.succ v))
    [alpha, motive, initial, step, .fvar 3]
  let value := psLogicLam 0 "α" (.sortE (.succ u))
    (psLogicLam 1 "β" (.sortE (.succ v))
      (psLogicLam 2 "f" functionType
        (psLogicLam 3 "xs" listAlpha body)) .implicit) .implicit
  .definitionDecl psStandardListFoldlWorkerName [psRootName "u", psRootName "v"] type value

-- Native public order: accumulator α : Type u, element β : Type v.
-- The private worker retains its list-first telescope for structural lowering.
def psStandardListFoldlDeclaration : PsDeclaration :=
  let u := PsLevel.param (psRootName "u")
  let v := PsLevel.param (psRootName "v")
  let alpha := PsExpr.fvar 0
  let beta := PsExpr.fvar 1
  let listBeta := psSelfHostListOf beta v
  let functionType := psLogicPi 10 "acc" alpha
    (psLogicPi 11 "item" beta alpha)
  let type := psLogicPi 0 "α" (.sortE (.succ u))
    (psLogicPi 1 "β" (.sortE (.succ v))
      (psLogicPi 2 "f" functionType
        (psLogicPi 3 "init" alpha
          (psLogicPi 4 "xs" listBeta alpha))) .implicit) .implicit
  let body := psLogicApply (.constE psStandardListFoldlWorkerName [v, u])
    [beta, alpha, .fvar 2, .fvar 4, .fvar 3]
  let value := psLogicLam 0 "α" (.sortE (.succ u))
    (psLogicLam 1 "β" (.sortE (.succ v))
      (psLogicLam 2 "f" functionType
        (psLogicLam 3 "init" alpha
          (psLogicLam 4 "xs" listBeta body))) .implicit) .implicit
  .definitionDecl (psNameAppendStr psListName "foldl") [psRootName "u", psRootName "v"] type value

-- The safe-indexing worker is total and has no validity-proof axiom.
-- Its List-recursive hypothesis is itself a Nat → Option α function, so
-- reaching the tail reuses the existing checked root recursion plan.
-- Nat.rec performs the zero/successor index split without a partial get.
def psStandardListGetWorkerName : PsName :=
  psNameAppendStr (psRootName "$psc0Standard") "listGetWorker"

def psStandardListGetWorkerDeclaration : PsDeclaration :=
  let u := PsLevel.param (psRootName "u")
  let alpha := PsExpr.fvar 0
  let listAlpha := psSelfHostListOf alpha u
  let nat := PsExpr.constE psNatName []
  let optionAlpha := psSelfHostOptionOf alpha u
  let resultArrow := psLogicPi 20 "index" nat optionAlpha
  let motive := psLogicLam 21 "_" listAlpha resultArrow
  let nilBranch := psLogicLam 22 "index" nat (psSelfHostOptionNoneOf alpha u)
  let natMotive := psLogicLam 23 "_" nat optionAlpha
  let consBranch := psLogicLam 5 "head" alpha
    (psLogicLam 6 "tail" listAlpha
      (psLogicLam 7 "ih" resultArrow
        (psLogicLam 8 "index" nat
          (psLogicApply (.constE psNatRecName [.succ u])
            [natMotive,
             psSelfHostOptionSomeOf alpha (.fvar 5) u,
             psLogicLam 9 "previous" nat
               (psLogicLam 10 "_" optionAlpha (.app (.fvar 7) (.fvar 9))),
             .fvar 8]))))
  let type := psLogicPi 0 "α" (.sortE (.succ u))
    (psLogicPi 1 "xs" listAlpha resultArrow) .implicit
  let body := psLogicApply (psStandardListRecursor u (.succ u))
    [alpha, motive, nilBranch, consBranch, .fvar 1]
  let value := psLogicLam 0 "α" (.sortE (.succ u))
    (psLogicLam 1 "xs" listAlpha body) .implicit
  .definitionDecl psStandardListGetWorkerName [psRootName "u"] type value

def psStandardListGetQuestionDeclaration : PsDeclaration :=
  let u := PsLevel.param (psRootName "u")
  let alpha := PsExpr.fvar 0
  let listAlpha := psSelfHostListOf alpha u
  let nat := PsExpr.constE psNatName []
  let optionAlpha := psSelfHostOptionOf alpha u
  let type := psLogicPi 0 "α" (.sortE (.succ u))
    (psLogicPi 1 "xs" listAlpha
      (psLogicPi 2 "index" nat optionAlpha)) .implicit
  let body := psLogicApply (.constE psStandardListGetWorkerName [u])
    [alpha, .fvar 1, .fvar 2]
  let value := psLogicLam 0 "α" (.sortE (.succ u))
    (psLogicLam 1 "xs" listAlpha
      (psLogicLam 2 "index" nat body)) .implicit
  .definitionDecl (psNameAppendStr psListName "get?") [psRootName "u"] type value

-- Standard List.take/drop are entirely checked structural programs, sharing
-- the List.rec / Nat.rec worker architecture used for the qualified List.get?.
-- The recursive hypothesis has type Nat → List α; the index split is performed
-- by Nat.rec, with no implicit index validity assumption, unchecked projection
-- or new trusted runtime primitive.
def psStandardListTakeWorkerName : PsName :=
  psNameAppendStr (psRootName "$psc0Standard") "listTakeWorker"

def psStandardListDropWorkerName : PsName :=
  psNameAppendStr (psRootName "$psc0Standard") "listDropWorker"

def psStandardListSliceWorkerDeclaration (take : Bool) : PsDeclaration :=
  let u := PsLevel.param (psRootName "u")
  let alpha := PsExpr.fvar 0
  let listAlpha := psSelfHostListOf alpha u
  let nat := PsExpr.constE psNatName []
  let resultArrow := psLogicPi 20 "count" nat listAlpha
  let motive := psLogicLam 21 "_" listAlpha resultArrow
  let nilBranch := psLogicLam 22 "count" nat (psSelfHostListNilOf alpha u)
  let natMotive := psLogicLam 23 "_" nat listAlpha
  let consBranch := psLogicLam 5 "head" alpha
    (psLogicLam 6 "tail" listAlpha
      (psLogicLam 7 "ih" resultArrow
        (psLogicLam 8 "count" nat
          (psLogicApply (.constE psNatRecName [.succ u])
            [natMotive,
             if take then psSelfHostListNilOf alpha u
             else psSelfHostListConsOf alpha (.fvar 5) (.fvar 6) u,
             psLogicLam 9 "previous" nat
               (psLogicLam 10 "_" listAlpha
                 (if take then
                   psSelfHostListConsOf alpha (.fvar 5) (.app (.fvar 7) (.fvar 9)) u
                 else .app (.fvar 7) (.fvar 9))),
             .fvar 8]))))
  let type := psLogicPi 0 "α" (.sortE (.succ u))
    (psLogicPi 1 "xs" listAlpha resultArrow) .implicit
  let body := psLogicApply (psStandardListRecursor u (.succ u))
    [alpha, motive, nilBranch, consBranch, .fvar 1]
  let value := psLogicLam 0 "α" (.sortE (.succ u))
    (psLogicLam 1 "xs" listAlpha body) .implicit
  .definitionDecl
    (if take then psStandardListTakeWorkerName else psStandardListDropWorkerName)
    [psRootName "u"] type value

def psStandardListSliceDeclaration (take : Bool) : PsDeclaration :=
  let u := PsLevel.param (psRootName "u")
  let alpha := PsExpr.fvar 0
  let nat := PsExpr.constE psNatName []
  let listAlpha := psSelfHostListOf alpha u
  let type := psLogicPi 0 "α" (.sortE (.succ u))
    (psLogicPi 1 "count" nat
      (psLogicPi 2 "xs" listAlpha listAlpha)) .implicit
  let worker := if take then psStandardListTakeWorkerName else
    psStandardListDropWorkerName
  let body := psLogicApply (.constE worker [u]) [alpha, .fvar 2, .fvar 1]
  let value := psLogicLam 0 "α" (.sortE (.succ u))
    (psLogicLam 1 "count" nat
      (psLogicLam 2 "xs" listAlpha body)) .implicit
  .definitionDecl
    (psNameAppendStr psListName (if take then "take" else "drop"))
    [psRootName "u"] type value

def psStandardListFoldrDeclaration : PsDeclaration :=
  let u := PsLevel.param (psRootName "u")
  let v := PsLevel.param (psRootName "v")
  let alpha := PsExpr.fvar 0
  let beta := PsExpr.fvar 1
  let listAlpha := psSelfHostListOf alpha u
  let functionType := psLogicPi 8 "head" alpha
    (psLogicPi 9 "acc" beta beta)
  let motive := psLogicLam 10 "_" listAlpha beta
  let step := psLogicLam 5 "head" alpha
    (psLogicLam 6 "tail" listAlpha
      (psLogicLam 7 "ih" beta
        (psLogicApply (.fvar 2) [.fvar 5, .fvar 7])))
  let type := psLogicPi 0 "α" (.sortE (.succ u))
    (psLogicPi 1 "β" (.sortE (.succ v))
      (psLogicPi 2 "f" functionType
        (psLogicPi 3 "init" beta
          (psLogicPi 4 "xs" listAlpha beta))) .implicit) .implicit
  let body := psLogicApply (psStandardListRecursor u (.succ v))
    [alpha, motive, .fvar 3, step, .fvar 4]
  let value := psLogicLam 0 "α" (.sortE (.succ u))
    (psLogicLam 1 "β" (.sortE (.succ v))
      (psLogicLam 2 "f" functionType
        (psLogicLam 3 "init" beta
          (psLogicLam 4 "xs" listAlpha body))) .implicit) .implicit
  .definitionDecl (psNameAppendStr psListName "foldr") [psRootName "u", psRootName "v"] type value

-- Pinned Init/Data/List/Basic: the accumulator is an argument to the
-- recursive result. Both the open reverseAux equations and reverse's public
-- definition must compute exactly; a merely extensionally equal fold is not
-- a compatible boundary for native proofs that unfold these definitions.
def psStandardListReverseAuxDeclaration : PsDeclaration :=
  let u := PsLevel.param (psRootName "u")
  let alpha := PsExpr.fvar 0
  let list := psSelfHostListOf alpha u
  let arrow := psLogicPi 2 "acc" list list
  let motive := psLogicLam 3 "_" list arrow
  let initial := psLogicLam 2 "acc" list (.fvar 2)
  let step := psLogicLam 4 "head" alpha
    (psLogicLam 5 "tail" list (psLogicLam 6 "ih" arrow
      (psLogicLam 2 "acc" list
        (.app (.fvar 6) (psSelfHostListConsOf alpha (.fvar 4) (.fvar 2) u)))))
  let type := psLogicPi 0 "α" (.sortE (.succ u))
    (psLogicPi 1 "xs" list arrow) .implicit
  let body := psLogicApply (psStandardListRecursor u (.succ u))
    [alpha, motive, initial, step, .fvar 1]
  let value := psLogicLam 0 "α" (.sortE (.succ u))
    (psLogicLam 1 "xs" list body) .implicit
  .definitionDecl (psNameAppendStr psListName "reverseAux") [psRootName "u"] type value

def psStandardListReverseDeclaration : PsDeclaration :=
  let u := PsLevel.param (psRootName "u")
  let alpha := PsExpr.fvar 0
  let list := psSelfHostListOf alpha u
  let type := psLogicPi 0 "α" (.sortE (.succ u))
    (psLogicPi 1 "xs" list list) .implicit
  let body := psStandardListCall "reverseAux"
    [alpha, .fvar 1, psSelfHostListNilOf alpha u] [u]
  let value := psLogicLam 0 "α" (.sortE (.succ u))
    (psLogicLam 1 "xs" list body) .implicit
  .definitionDecl (psNameAppendStr psListName "reverse") [psRootName "u"] type value

def psStandardListDeclarations : List PsDeclaration :=
  [psStandardListLengthDeclaration, psStandardListMapDeclaration,
   psStandardListAppendDeclaration, psStandardListFilterDeclaration,
   psStandardListFoldlWorkerDeclaration, psStandardListFoldlDeclaration,
   psStandardListGetWorkerDeclaration, psStandardListGetQuestionDeclaration,
   psStandardListSliceWorkerDeclaration true,
    psStandardListSliceWorkerDeclaration false,
    psStandardListSliceDeclaration true,
    psStandardListSliceDeclaration false,
    psStandardListFoldrDeclaration, psStandardListReverseAuxDeclaration,
    psStandardListReverseDeclaration]

def psStandardPreludeDeclarationsWithList : List PsDeclaration :=
  psStandardPreludeDeclarationsWithOption ++ psStandardListDeclarations

def psStandardListExtend (environment : PsEnvironment) : PsEnvironment :=
  let environment := psStandardOptionExtend environment
  psStandardListDeclarations.foldl (fun env decl =>
    (psEnvironmentAdd env decl).getD env) environment

-- Fail closed when the selected Standard declaration/instance registry drifts.
-- This is a portable structural inventory gate, not yet the final pinned
-- RC4 content digest or proof/effect/axiom closure certification.
-- A Standard name alone is not sufficient assurance: a former checked
-- definition replaced by an axiom, or a changed type/body, must be detected
-- before the prepared graph reaches proof checking and executable erasure.
def psStandardSameDeclarationKind (left right : PsDeclaration) : Bool :=
  match left, right with
  | .axiomDecl .., .axiomDecl .. => true
  | .definitionDecl .., .definitionDecl .. => true
  | .theoremDecl .., .theoremDecl .. => true
  | .partialDecl .., .partialDecl .. => true
  | .opaqueDecl .., .opaqueDecl .. => true
  | .inductiveDecl .., .inductiveDecl .. => true
  | .constructorDecl .., .constructorDecl .. => true
  | .recursorDecl .., .recursorDecl .. => true
  | _, _ => false

def psStandardNamesEqual (left right : List PsName) : Bool :=
  left.length == right.length &&
    (left.zip right).all (fun pair => psNameEq pair.fst pair.snd)

def psStandardSameDeclarationMetadata (expected actual : PsDeclaration) : Bool :=
  match expected, actual with
  | .inductiveDecl a, .inductiveDecl b =>
      a.numParams == b.numParams && a.numIndices == b.numIndices &&
      a.isStructure == b.isStructure &&
      psStandardNamesEqual a.constructors b.constructors
  | .constructorDecl a, .constructorDecl b =>
      a.numParams == b.numParams && a.numFields == b.numFields &&
      a.constructorIndex == b.constructorIndex &&
      a.recursiveFields == b.recursiveFields &&
      psNameEq a.inductiveName b.inductiveName
  | .recursorDecl a, .recursorDecl b =>
      a.numParams == b.numParams && a.numIndices == b.numIndices &&
      a.numMotives == b.numMotives && a.numMinors == b.numMinors &&
      psStandardNamesEqual a.inductiveNames b.inductiveNames
  | _, _ => true

def psStandardAuditDeclaration (environment : PsEnvironment)
    (expected : PsDeclaration) : Except String Unit := do
  let name := psDeclarationName expected
  let some actual := psEnvironmentFind environment name
    | throw ("PSCV0-STANDARD: missing declaration " ++ psNameToString name)
  if !psStandardSameDeclarationKind expected actual then
    throw ("PSCV0-STANDARD: declaration kind drift " ++ psNameToString name)
  if !psStandardNamesEqual (psDeclarationLevelParams expected)
      (psDeclarationLevelParams actual) ||
      !psExprAlphaEq (psDeclarationType expected) (psDeclarationType actual) ||
      !psStandardSameDeclarationMetadata expected actual then
    throw ("PSCV0-STANDARD: signature drift " ++ psNameToString name)
  let valueEqual := match psDeclarationValue expected, psDeclarationValue actual with
    | some a, some b => psExprAlphaEq a b
    | none, none => true
    | _, _ => false
  if !valueEqual then
    throw ("PSCV0-STANDARD: checked body drift " ++ psNameToString name)

def psStandardAuditInstance (environment : PsEnvironment)
    (expected : PsDeclaration) : Except String Unit := do
  let name := psDeclarationName expected
  let registrations := environment.instances.entries.filter (fun entry =>
    match entry.value with
    | .constE actual _ => psNameEq actual name
    | _ => false)
  let [actual] := registrations
    | throw ("PSCV0-STANDARD: missing or duplicate instance " ++ psNameToString name)
  if actual.priority != 1000 ||
      !psExprAlphaEq actual.type (psDeclarationType expected) then
    throw ("PSCV0-STANDARD: instance signature/priority drift " ++ psNameToString name)

def psStandardRegistryAudit (environment : PsEnvironment) : Except String Unit := do
  let names := psStandardPreludeDeclarationsWithList.map psDeclarationName
  let distinct := names.foldl (fun acc name =>
    if acc.any (psNameEq name) then acc else name :: acc) ([] : List PsName)
  if distinct.length != names.length then
    throw "PSCV0-STANDARD: duplicate declaration identity"
  for declaration in psStandardPreludeDeclarationsWithList do
    psStandardAuditDeclaration environment declaration
  let classes := (psStandardBinarySpecs.map fun spec =>
    psRootName spec.className) ++
    [psRootName "Neg", psRootName "BEq", psRootName "ToString"]
  for className in classes do
    if !environment.classes.any (psNameEq className) ||
        !environment.classParameters.any (fun entry => psNameEq entry.fst className) then
      throw ("PSCV0-STANDARD: missing class registration " ++ psNameToString className)
  -- Homogeneous operator registrations are audited at their final selected
  -- stage, after the immutable native proof assets have been installed.
  let instances := psStandardBEqInstances ++
    [psStandardBEqListInstance] ++ psStandardToStringInstances
  let instanceNames := instances.map psDeclarationName ++
    [psNameAppendStr (psRootName "PsStandard") "instNegInt"]
  for declaration in instances do
    psStandardAuditInstance environment declaration
  for name in instanceNames do
    unless environment.instances.entries.any (fun entry =>
        match entry.value with
        | .constE actual _ => psNameEq actual name
        | _ => false) do
      throw ("PSCV0-STANDARD: missing instance " ++ psNameToString name)
  return ()
