{
  "name": "proofscript",
  "version": "0.1.0-psc0.0",
  "description": "ProofScript PSC0 npm compiler and scoped kernel/language modules",
  "private": false,
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "psc": "./bin/psc.js"
  },
  "engines": {
    "node": ">=22.23.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwijayuda/pskernel.git",
    "directory": "psc0/packages/proofscript"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "README.md",
    "MANIFEST.json"
  ],
  "dependencies": {
    "@proofscript/backend-js": "0.1.0-psc0.0",
    "@proofscript/backend-rust": "0.1.0-psc0.0",
    "@proofscript/backend-ts": "0.1.0-psc0.0",
    "@proofscript/backend-wasm": "0.1.0-psc0.0",
    "@proofscript/bootstrap": "0.1.0-psc0.0",
    "@proofscript/bridge": "0.1.0-psc0.0",
    "@proofscript/cli": "0.1.0-psc0.0",
    "@proofscript/compiler-ir": "0.1.0-psc0.0",
    "@proofscript/compiler": "0.1.0-psc0.0",
    "@proofscript/core": "0.1.0-psc0.0",
    "@proofscript/elab": "0.1.0-psc0.0",
    "@proofscript/environment": "0.1.0-psc0.0",
    "@proofscript/erasure": "0.1.0-psc0.0",
    "@proofscript/foundation": "0.1.0-psc0.0",
    "@proofscript/meta": "0.1.0-psc0.0",
    "@proofscript/pskernel-core": "0.1.0-psc0.0",
    "@proofscript/pskernel-lean-wasm": "0.1.0-psc0.0",
    "@proofscript/pskernel-lean": "0.1.0-psc0.0",
    "@proofscript/syntax": "0.1.0-psc0.0",
    "typescript": "7.0.2"
  },
  "bundledDependencies": [
    "@proofscript/backend-js",
    "@proofscript/backend-rust",
    "@proofscript/backend-ts",
    "@proofscript/backend-wasm",
    "@proofscript/bootstrap",
    "@proofscript/bridge",
    "@proofscript/cli",
    "@proofscript/compiler-ir",
    "@proofscript/compiler",
    "@proofscript/core",
    "@proofscript/elab",
    "@proofscript/environment",
    "@proofscript/erasure",
    "@proofscript/foundation",
    "@proofscript/meta",
    "@proofscript/pskernel-core",
    "@proofscript/pskernel-lean-wasm",
    "@proofscript/pskernel-lean",
    "@proofscript/syntax",
    "typescript"
  ],
  "proofscript": {
    "distribution": "psc0/npm-bundled-platform/1",
    "sourceVariants": [
      "ps",
      "lean"
    ],
    "kernelForBuild": "@proofscript/pskernel-lean-wasm",
    "newJsCoreTrust": "candidate",
    "requiresQualification": true
  }
}
