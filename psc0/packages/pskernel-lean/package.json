{
  "name": "@proofscript/pskernel-lean",
  "version": "0.1.0-psc0.0",
  "description": "ProofScript PSC0 pskernel-lean kernel provider",
  "type": "module",
  "private": false,
  "main": "./index.mjs",
  "types": "./dist/index.d.ts",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.23.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwijayuda/pskernel.git",
    "directory": "psc0/packages/pskernel-lean"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.mjs",
    "./node": "./host/node-provider.mjs",
    "./metadata": "./LEAN_SOURCE_PIN.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "host/",
    "wasm/",
    "provider/",
    "kernel/",
    "source/",
    "scripts/",
    "patches/",
    "LEAN_LICENSE",
    "*.json",
    "README.md",
    "BUILDING.md"
  ],
  "proofscript": {
    "npmArchitecture": "psc0-monolithic-runtime-with-scoped-source-packages/1",
    "sourceVariants": [
      "ps",
      "lean"
    ],
    "publishingRequiresBuild": true,
    "nonPortableProviderSources": true,
    "leanSemanticVersion": "4.34.0"
  }
}
