        "typed-io.php",
        "generated-php-transport.php"
      ]
    }
  },
  "wireEncoding": "native Lean ToJson/FromJson, exact compiler-source and Lean identity pinned; not portable psc1-ir/1",
  "limits": {
    "requestBytes": 67108864,
    "responseBytes": 67108864,
    "identityTimeoutMs": 10000,
    "executionTimeoutMs": 120000
  },
  "authority": {
    "provider": "candidate-only",
    "admission": "independent official Lean 4.35.0 in core host",
    "strictOriginalAndTransformedIr": true,
    "publication": "core-host"
  },
  "qualification": "Installed offline core plus explicit add-ons; retained emitter payloads; both grammars; all-seven existing regressions; does not confer new self-host G2/G3 qualification",
  "generatedHostDispatch": {
    "schema": "psc1-checked-optional-provider/1",
    "wire": "psc1-portable-backend-provider/1",
    "command": "emit-portable",
    "requestShape": [
      "protocol",
      "target",
      "psc1-ir/1 module",
      "public names",
      "ioDispatcherAbi Bool"
    ],
    "limits": {
      "requestBytes": 33554432,
      "responseBytes": 33554432,
      "executionTimeoutMs": 240000,
      "addressSpaceBytes": 4294967296,
      "stackBytes": 8388608,
      "parentLifetime": "Linux parent-death signal and host parent PID binding"
    },
    "compilerTarget": "js",
    "logicalAdmission": "mandatory in core host before emitter invocation",
    "canonicalRoundTrip": "exact equality with existing psIrEncodeModule",
    "strictOriginalAndTransformedIr": true,
    "nativeStrictIrAndTargetAbiRecheck": true,
    "providerAuthority": "candidate-only",
    "publicationAuthority": "single-use checked core host",
    "defaultPackageAbsence": true,
    "platformQualification": "qualified actual Linux x64 at the exact package source in docs/PSC1_CHECKED_DISPATCH_QUALIFICATION_2026-10-26.json; other platforms refuse",
    "arbitraryProviderRegistration": false
  }
}
