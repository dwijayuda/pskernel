      "code": 0,
      "stdout": "ok\n"
    },
    {
      "id": "expected-plus",
      "input": "1 2;",
      "code": 2,
      "stdout": "expected-plus@2:1:3\n"
    },
    {
      "id": "expected-number",
      "input": "1+;",
      "code": 2,
      "stdout": "expected-number@2:1:3\n"
    },
    {
      "id": "expected-semicolon",
      "input": "1+2 3;",
      "code": 2,
      "stdout": "expected-semicolon@4:1:5\n"
    },
    {
      "id": "unexpected-end",
      "input": "1+2",
      "code": 2,
      "stdout": "unexpected-end@3:1:4\n"
    },
    {
      "id": "unicode-location",
      "input": "1+😀;",
      "code": 2,
      "stdout": "unexpected-token@2:1:3\n"
    },
    {
      "id": "second-line-location",
      "input": "1+2;\n3 4;",
      "code": 2,
      "stdout": "expected-plus@7:2:3\n"
    },
    {
      "id": "unexpected-token",
      "input": "1&2;",
