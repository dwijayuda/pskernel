{
  "schema": "psc1-language-backend-case-contract/1",
  "id": "checked-nat-int-order-v1",
  "completeFamily": false,
  "grammars": [
    "lean",
    "ps"
  ],
  "targets": [
    "js",
    "ts",
    "rust",
    "wasm-core",
    "wasm-component",
    "python",
    "php"
  ],
  "cases": [
    {
      "id": "natOrderCase",
      "features": [
        "true",
        "false",
        "equal",
        "zero",
        "unicode",
        "lt-le-gt-ge"
      ]
    },
    {
      "id": "intOrderCase",
      "features": [
        "negative",
        "zero",
        "positive",
        "reversed-negative-magnitudes"
      ]
    },
    {
      "id": "largeOrderCase",
      "features": [
        "beyond-64-bit",
        "no-unary-runtime-recursion"
      ]
    },
    {
      "id": "controlOrderCase",
      "features": [
        "stored-proposition",
        "do-branch",
        "loop-condition",
        "operand-order"
      ]
    }
  ],
  "flags": [
    false,
    true
  ],
  "requiredRefusals": [
    "mixed-domain",
    "bool-order",
    "prop-as-bool",
    "chained",
    "duplicate-prelude",
    "verified"
  ],
  "oracleLibraries": [
    "option",
    "prod",
    "result",
    "effect",
    "list",
    "array"
  ]
}
