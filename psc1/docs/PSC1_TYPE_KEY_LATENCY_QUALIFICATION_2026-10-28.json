      "beforeDefinition": "def psIrSpecializeTypeKeyWithFuel(fuel : Nat) : (_ : PsVerifiedIrType) -> Option(String) := match fuel with {\n  | _root_.Nat.zero => fun (type : PsVerifiedIrType) => Option.none\n  | _root_.Nat.succ remaining => let smaller : (_ : PsVerifiedIrType) -> Option(String) := (psIrSpecializeTypeKeyWithFuel(remaining))\nfun (type : PsVerifiedIrType) => match type with {\n  | PsVerifiedIrType.unknown => Option.none\n  | PsVerifiedIrType.typeParameter _ => Option.none\n  | PsVerifiedIrType.primitive primitive => Option.some((psIrSpecializePrimitiveKey(primitive)))\n  | PsVerifiedIrType.function parameters result => let parameterKeys : List((Option(String))) := (psListMap(smaller, parameters))\nmatch (psIrSpecializeJoinKeys(parameterKeys)) with {\n  | Option.none => Option.none\n  | Option.some parameterKey => match (smaller(result)) with {\n  | Option.none => Option.none\n  | Option.some resultKey => Option.some((psIrSpecializeConcat4(\"Fn$\", parameterKey, \"$To$\", resultKey)))\n}\n}\n  | PsVerifiedIrType.named name arguments => let argumentKeys : List((Option(String))) := (psListMap(smaller, arguments))\nmatch (psIrSpecializeJoinKeys(argumentKeys)) with {\n  | Option.none => Option.none\n  | Option.some keys => if (psStringEq(keys, \"\")) { Option.some((String.Internal.append(\"N$\", name))) } else { Option.some((psIrSpecializeConcat4(\"N$\", name, \"$\", keys))) }\n}\n}\n}\n",
