{
  "name": "@proofscript/backend-common",
  "version": "0.1.0-psc1.13",
  "private": false,
  "description": "ProofScript PSC1 backend-common: source package and shared compiler API adapter",
  "proofscript": {
    "npmArchitecture": "psc1-existing-packages-shared-root/1",
    "implementationOwner": "@proofscript/compiler",
    "internalCompilerModules": false,
    "packageKind": "source-only",
    "canonicalSources": "src/**/*.ps",
    "sourceVariants": [
      "ps",
      "lean"
    ],
    "publishingRequiresQualification": true,
    "compilerInputGrammars": [
      "lean",
      "ps"
    ],
    "canonicalGrammar": "ps",
    "sourceOwnership": {
      "role": "canonical-editable-proofscript",
      "manifest": "dist/source-manifest.json",
      "repositoryManifest": "psc1/CANONICAL_SOURCES.json"
    },
    "bootstrapReferences": {
      "grammar": "lean",
      "role": "immutable-checked-bootstrap-reference",
      "manifest": "dist/source-manifest.json"
    }
  },
  "dependencies": {
    "@proofscript/compiler": "0.1.0-psc1.13"
  },
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.23.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwijayuda/pskernel.git",
    "directory": "psc1/packages/backend-common"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs build --package backend-common",
    "clean": "node ../../scripts/build-packages.mjs clean --package backend-common"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./sources": "./dist/source-manifest.json",
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.js"
    }
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ]
}
