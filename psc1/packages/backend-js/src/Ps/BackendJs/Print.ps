import Ps.BackendJs.Lower
import Ps.BackendJs.Validate
import Ps.BackendJs.TailAlias
import Ps.Bridge.Json
import Ps.Foundation.List
import Ps.Foundation.Name
import Ps.Foundation.Text

inductive PsJsEmitError where {
  | lower(error : PsJsLowerError)
  | targetValidation(error : PsJsIrValidationError)
  | fuelExhausted
  | malformedIr
}

def psJsJoin(separator : String, values : List(String)) : String := psTextJoin(separator, values)

def psJsConcat2(a : String, b : String) : String := String.Internal.append(a, b)

def psJsConcat3(a : String, b : String, c : String) : String := psJsConcat2((psJsConcat2(a, b)), c)

def psJsConcat4(a : String, b : String, c : String, d : String) : String := psJsConcat2((psJsConcat3(a, b, c)), d)

def psJsConcat5(a : String, b : String, c : String, d : String, e : String) : String := psJsConcat2((psJsConcat4(a, b, c, d)), e)

def psJsConcat6(a : String, b : String, c : String, d : String, e : String, f : String) : String := psJsConcat2((psJsConcat5(a, b, c, d, e)), f)

def psJsConcat7(a : String, b : String, c : String, d : String, e : String, f : String, g : String) : String := psJsConcat2((psJsConcat6(a, b, c, d, e, f)), g)

def psJsPrintMachineIntegerLiteral(type : PsJsIrMachineIntegerType, value : Int) : String := let printed : String := (String.Internal.append((Int.repr(value)), "n"))
match type with {
  | PsJsIrMachineIntegerType.uint8 => psJsJoin("", (_root_.List.cons("Number(BigInt.asUintN(8, ", (_root_.List.cons(printed, (_root_.List.cons("))", _root_.List.nil)))))))
  | PsJsIrMachineIntegerType.uint16 => psJsJoin("", (_root_.List.cons("Number(BigInt.asUintN(16, ", (_root_.List.cons(printed, (_root_.List.cons("))", _root_.List.nil)))))))
  | PsJsIrMachineIntegerType.uint32 => psJsJoin("", (_root_.List.cons("Number(BigInt.asUintN(32, ", (_root_.List.cons(printed, (_root_.List.cons("))", _root_.List.nil)))))))
  | PsJsIrMachineIntegerType.uint64 => psJsJoin("", (_root_.List.cons("BigInt.asUintN(64, ", (_root_.List.cons(printed, (_root_.List.cons(")", _root_.List.nil)))))))
  | PsJsIrMachineIntegerType.int8 => psJsJoin("", (_root_.List.cons("Number(BigInt.asIntN(8, ", (_root_.List.cons(printed, (_root_.List.cons("))", _root_.List.nil)))))))
  | PsJsIrMachineIntegerType.int16 => psJsJoin("", (_root_.List.cons("Number(BigInt.asIntN(16, ", (_root_.List.cons(printed, (_root_.List.cons("))", _root_.List.nil)))))))
  | PsJsIrMachineIntegerType.int32 => psJsJoin("", (_root_.List.cons("Number(BigInt.asIntN(32, ", (_root_.List.cons(printed, (_root_.List.cons("))", _root_.List.nil)))))))
  | PsJsIrMachineIntegerType.int64 => psJsJoin("", (_root_.List.cons("BigInt.asIntN(64, ", (_root_.List.cons(printed, (_root_.List.cons(")", _root_.List.nil)))))))
}

def psJsNormalizeMachineInteger(type : PsJsIrMachineIntegerType, value : String) : String := match type with {
  | PsJsIrMachineIntegerType.uint8 => psJsJoin("", (_root_.List.cons("((", (_root_.List.cons(value, (_root_.List.cons(") & 255)", _root_.List.nil)))))))
  | PsJsIrMachineIntegerType.uint16 => psJsJoin("", (_root_.List.cons("((", (_root_.List.cons(value, (_root_.List.cons(") & 65535)", _root_.List.nil)))))))
  | PsJsIrMachineIntegerType.uint32 => psJsJoin("", (_root_.List.cons("((", (_root_.List.cons(value, (_root_.List.cons(") >>> 0)", _root_.List.nil)))))))
  | PsJsIrMachineIntegerType.uint64 => psJsJoin("", (_root_.List.cons("BigInt.asUintN(64, (", (_root_.List.cons(value, (_root_.List.cons("))", _root_.List.nil)))))))
  | PsJsIrMachineIntegerType.int8 => psJsJoin("", (_root_.List.cons("(((", (_root_.List.cons(value, (_root_.List.cons(") << 24) >> 24)", _root_.List.nil)))))))
  | PsJsIrMachineIntegerType.int16 => psJsJoin("", (_root_.List.cons("(((", (_root_.List.cons(value, (_root_.List.cons(") << 16) >> 16)", _root_.List.nil)))))))
  | PsJsIrMachineIntegerType.int32 => psJsJoin("", (_root_.List.cons("((", (_root_.List.cons(value, (_root_.List.cons(") | 0)", _root_.List.nil)))))))
  | PsJsIrMachineIntegerType.int64 => psJsJoin("", (_root_.List.cons("BigInt.asIntN(64, (", (_root_.List.cons(value, (_root_.List.cons("))", _root_.List.nil)))))))
}

def psJsMachineIntegerBinaryRaw(type : PsJsIrMachineIntegerType, operation : PsJsIrIntegerBinaryOp, left : String, right : String) : String := match operation with {
  | PsJsIrIntegerBinaryOp.add => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" + ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrIntegerBinaryOp.sub => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" - ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrIntegerBinaryOp.mul => match type with {
  | PsJsIrMachineIntegerType.uint8 => psJsJoin("", (_root_.List.cons("Math.imul(", (_root_.List.cons(left, (_root_.List.cons(", ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrMachineIntegerType.uint16 => psJsJoin("", (_root_.List.cons("Math.imul(", (_root_.List.cons(left, (_root_.List.cons(", ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrMachineIntegerType.uint32 => psJsJoin("", (_root_.List.cons("Math.imul(", (_root_.List.cons(left, (_root_.List.cons(", ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrMachineIntegerType.int8 => psJsJoin("", (_root_.List.cons("Math.imul(", (_root_.List.cons(left, (_root_.List.cons(", ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrMachineIntegerType.int16 => psJsJoin("", (_root_.List.cons("Math.imul(", (_root_.List.cons(left, (_root_.List.cons(", ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrMachineIntegerType.int32 => psJsJoin("", (_root_.List.cons("Math.imul(", (_root_.List.cons(left, (_root_.List.cons(", ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | _ => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" * ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
}
  | PsJsIrIntegerBinaryOp.bitAnd => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" & ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrIntegerBinaryOp.bitOr => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" | ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrIntegerBinaryOp.bitXor => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" ^ ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
}

def psJsPrintMachineIntegerBinary(type : PsJsIrMachineIntegerType, operation : PsJsIrIntegerBinaryOp, left : String, right : String) : String := psJsNormalizeMachineInteger(type, (psJsMachineIntegerBinaryRaw(type, operation, left, right)))

def psJsPrintIntegerCompare(operation : PsJsIrIntegerCompareOp, left : String, right : String) : String := match operation with {
  | PsJsIrIntegerCompareOp.eq => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" === ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrIntegerCompareOp.ne => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" !== ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrIntegerCompareOp.lt => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" < ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrIntegerCompareOp.le => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" <= ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrIntegerCompareOp.gt => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" > ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrIntegerCompareOp.ge => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" >= ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
}

def psJsPrintFloatBinary(type : PsJsIrFloatingType, operation : PsJsIrFloatBinaryOp, left : String, right : String) : String := let raw : String := (match operation with {
  | PsJsIrFloatBinaryOp.add => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" + ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrFloatBinaryOp.sub => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" - ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrFloatBinaryOp.mul => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" * ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrFloatBinaryOp.div => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" / ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
})
match type with {
  | PsJsIrFloatingType.float => raw
  | PsJsIrFloatingType.float32 => psJsJoin("", (_root_.List.cons("Math.fround(", (_root_.List.cons(raw, (_root_.List.cons(")", _root_.List.nil)))))))
}

def psJsPrintFloatCompare(operation : PsJsIrFloatCompareOp, left : String, right : String) : String := match operation with {
  | PsJsIrFloatCompareOp.eq => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" === ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrFloatCompareOp.ne => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" !== ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrFloatCompareOp.lt => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" < ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrFloatCompareOp.le => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" <= ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrFloatCompareOp.gt => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" > ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrFloatCompareOp.ge => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" >= ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
}

def psJsPrintLiteral(literal : PsJsIrLiteral) : String := match literal with {
  | PsJsIrLiteral.natural value => String.Internal.append((psNatToString(value)), "n")
  | PsJsIrLiteral.integer value => String.Internal.append((Int.repr(value)), "n")
  | PsJsIrLiteral.machineInteger type value => psJsPrintMachineIntegerLiteral(type, value)
  | PsJsIrLiteral.string value => psJsonQuote(value)
  | PsJsIrLiteral.bool value => if (value) { "true" } else { "false" }
  | PsJsIrLiteral.unit => "(void 0)"
}

def psJsPrintUnary(operation : PsJsIrUnaryOp, value : String) : String := match operation with {
  | PsJsIrUnaryOp.bigintNeg => psJsJoin("", (_root_.List.cons("(-(", (_root_.List.cons(value, (_root_.List.cons("))", _root_.List.nil)))))))
  | PsJsIrUnaryOp.boolNot => psJsJoin("", (_root_.List.cons("(!", (_root_.List.cons(value, (_root_.List.cons(")", _root_.List.nil)))))))
}

def psJsPrintBinary(operation : PsJsIrBinaryOp, left : String, right : String) : String := match operation with {
  | PsJsIrBinaryOp.bigintAdd => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" + ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrBinaryOp.bigintSub => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" - ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrBinaryOp.bigintMul => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" * ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrBinaryOp.bigintEq => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" === ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrBinaryOp.bigintNe => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" !== ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrBinaryOp.bigintLe => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" <= ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrBinaryOp.bigintLt => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" < ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrBinaryOp.boolAnd => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" && ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrBinaryOp.boolOr => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" || ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrBinaryOp.boolEq => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" === ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrBinaryOp.boolNe => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" !== ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrBinaryOp.stringConcat => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" + ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrBinaryOp.stringEq => psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" === ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrBinaryOp.machineInt type integerOperation => psJsPrintMachineIntegerBinary(type, integerOperation, left, right)
  | PsJsIrBinaryOp.machineIntCompare integerOperation => psJsPrintIntegerCompare(integerOperation, left, right)
  | PsJsIrBinaryOp.floatBinary type floatOperation => psJsPrintFloatBinary(type, floatOperation, left, right)
  | PsJsIrBinaryOp.floatCompare floatOperation => psJsPrintFloatCompare(floatOperation, left, right)
}

def psJsRuntimeUnary(operation : PsJsIrRuntimeOp, value : String) : Except(PsJsEmitError, String) := match operation with {
  | PsJsIrRuntimeOp.uint8OfNat => Except.ok((psJsJoin("", (_root_.List.cons("Number(BigInt.asUintN(8, ", (_root_.List.cons(value, (_root_.List.cons("))", _root_.List.nil)))))))))
  | PsJsIrRuntimeOp.intNegSucc => Except.ok((psJsJoin("", (_root_.List.cons("(-(", (_root_.List.cons(value, (_root_.List.cons(" + 1n))", _root_.List.nil)))))))))
  | PsJsIrRuntimeOp.intRepr => Except.ok((psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(value, (_root_.List.cons(").toString()", _root_.List.nil)))))))))
  | PsJsIrRuntimeOp.charOfNat => Except.ok((psJsJoin("", (_root_.List.cons("((__ps_n) => ((__ps_n < 0xd800n || (__ps_n > 0xdfffn && __ps_n < 0x110000n)) ", (_root_.List.cons("? String.fromCodePoint(Number(__ps_n)) : \"\\0\"))(", (_root_.List.cons(value, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | PsJsIrRuntimeOp.charToNat => Except.ok((psJsJoin("", (_root_.List.cons("((__ps_c) => BigInt(__ps_c.codePointAt(0) ?? 0))(", (_root_.List.cons(value, (_root_.List.cons(")", _root_.List.nil)))))))))
  | PsJsIrRuntimeOp.stringLength => Except.ok((psJsJoin("", (_root_.List.cons("((__ps_s) => BigInt(Array.from(__ps_s).length))(", (_root_.List.cons(value, (_root_.List.cons(")", _root_.List.nil)))))))))
  | PsJsIrRuntimeOp.stringUtf8ByteSize => Except.ok((psJsJoin("", (_root_.List.cons("__ps$stringUtf8Size(", (_root_.List.cons(value, (_root_.List.cons(")", _root_.List.nil)))))))))
  | PsJsIrRuntimeOp.arrayEmptyWithCapacity => Except.ok((psJsJoin("", (_root_.List.cons("(() => { void (", (_root_.List.cons(value, (_root_.List.cons("); return []; })()", _root_.List.nil)))))))))
  | PsJsIrRuntimeOp.arraySize => Except.ok((psJsJoin("", (_root_.List.cons("BigInt((", (_root_.List.cons(value, (_root_.List.cons(").length)", _root_.List.nil)))))))))
  | _ => Except.error(PsJsEmitError.malformedIr)
}

def psJsRuntimeBinary(operation : PsJsIrRuntimeOp, left : String, right : String) : Except(PsJsEmitError, String) := match operation with {
  | PsJsIrRuntimeOp.natSub => Except.ok((psJsJoin("", (_root_.List.cons("((__ps_a, __ps_b) => (__ps_a >= __ps_b ? __ps_a - __ps_b : 0n))(", (_root_.List.cons(left, (_root_.List.cons(", ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))))
  | PsJsIrRuntimeOp.natDiv => Except.ok((psJsJoin("", (_root_.List.cons("((__ps_a, __ps_b) => (__ps_b === 0n ? 0n : __ps_a / __ps_b))(", (_root_.List.cons(left, (_root_.List.cons(", ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))))
  | PsJsIrRuntimeOp.natMod => Except.ok((psJsJoin("", (_root_.List.cons("((__ps_a, __ps_b) => (__ps_b === 0n ? __ps_a : __ps_a % __ps_b))(", (_root_.List.cons(left, (_root_.List.cons(", ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))))
  | PsJsIrRuntimeOp.stringNext => Except.ok((psJsJoin("", (_root_.List.cons("__ps$stringNext(", (_root_.List.cons(left, (_root_.List.cons(", ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))))
  | PsJsIrRuntimeOp.stringGet => Except.ok((psJsJoin("", (_root_.List.cons("__ps$stringGet(", (_root_.List.cons(left, (_root_.List.cons(", ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))))
  | PsJsIrRuntimeOp.stringAtEnd => Except.ok((psJsJoin("", (_root_.List.cons("((__ps_s, __ps_p) => __ps_p >= __ps$stringUtf8Size(__ps_s))(", (_root_.List.cons(left, (_root_.List.cons(", ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))))
  | PsJsIrRuntimeOp.arrayPush => Except.ok((psJsJoin("", (_root_.List.cons("[...(", (_root_.List.cons(left, (_root_.List.cons("), ", (_root_.List.cons(right, (_root_.List.cons("]", _root_.List.nil)))))))))))))
  | PsJsIrRuntimeOp.arrayGet => Except.ok((psJsJoin("", (_root_.List.cons("((__ps_a, __ps_i) => __ps_a[Number(__ps_i)])(", (_root_.List.cons(left, (_root_.List.cons(", ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))))
  | PsJsIrRuntimeOp.arrayMap => Except.ok((psJsJoin("", (_root_.List.cons("((__ps_f, __ps_a) => __ps_a.map((__ps_x) => __ps_f(__ps_x)))(", (_root_.List.cons(left, (_root_.List.cons(", ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))))
  | _ => Except.error(PsJsEmitError.malformedIr)
}

def psJsRuntimeTernary(operation : PsJsIrRuntimeOp, first : String, second : String, third : String) : Except(PsJsEmitError, String) := match operation with {
  | PsJsIrRuntimeOp.stringExtract => Except.ok((psJsJoin("", (_root_.List.cons("__ps$stringExtract(", (_root_.List.cons(first, (_root_.List.cons(", ", (_root_.List.cons(second, (_root_.List.cons(", ", (_root_.List.cons(third, (_root_.List.cons(")", _root_.List.nil)))))))))))))))))
  | PsJsIrRuntimeOp.arrayGetD => Except.ok((psJsJoin("", (_root_.List.cons("((__ps_a, __ps_i, __ps_fallback) => (__ps_i < BigInt(__ps_a.length) ? ", (_root_.List.cons("__ps_a[Number(__ps_i)] : __ps_fallback))(", (_root_.List.cons(first, (_root_.List.cons(", ", (_root_.List.cons(second, (_root_.List.cons(", ", (_root_.List.cons(third, (_root_.List.cons(")", _root_.List.nil)))))))))))))))))))
  | PsJsIrRuntimeOp.arraySet => Except.ok((psJsJoin("", (_root_.List.cons("((__ps_a, __ps_i, __ps_v) => { const __ps_out = [...__ps_a]; ", (_root_.List.cons("__ps_out[Number(__ps_i)] = __ps_v; return __ps_out; })(", (_root_.List.cons(first, (_root_.List.cons(", ", (_root_.List.cons(second, (_root_.List.cons(", ", (_root_.List.cons(third, (_root_.List.cons(")", _root_.List.nil)))))))))))))))))))
  | PsJsIrRuntimeOp.arraySetIfInBounds => Except.ok((psJsJoin("", (_root_.List.cons("((__ps_a, __ps_i, __ps_v) => { if (__ps_i >= BigInt(__ps_a.length)) return __ps_a; ", (_root_.List.cons("const __ps_out = [...__ps_a]; __ps_out[Number(__ps_i)] = __ps_v; ", (_root_.List.cons("return __ps_out; })(", (_root_.List.cons(first, (_root_.List.cons(", ", (_root_.List.cons(second, (_root_.List.cons(", ", (_root_.List.cons(third, (_root_.List.cons(")", _root_.List.nil)))))))))))))))))))))
  | _ => Except.error(PsJsEmitError.malformedIr)
}

def psJsRuntimeFive(operation : PsJsIrRuntimeOp, first : String, second : String, third : String, fourth : String, fifth : String) : Except(PsJsEmitError, String) := match operation with {
  | PsJsIrRuntimeOp.arrayFoldl => Except.ok((psJsJoin("", (_root_.List.cons("((__ps_f, __ps_init, __ps_a, __ps_start, __ps_stop) => { ", (_root_.List.cons("const __ps_size = BigInt(__ps_a.length); ", (_root_.List.cons("const __ps_end = __ps_stop <= __ps_size ? __ps_stop : __ps_size; ", (_root_.List.cons("let __ps_acc = __ps_init; ", (_root_.List.cons("for (let __ps_i = __ps_start; __ps_i < __ps_end; __ps_i += 1n) { ", (_root_.List.cons("__ps_acc = __ps_f(__ps_acc, __ps_a[Number(__ps_i)]); } ", (_root_.List.cons("return __ps_acc; })(", (_root_.List.cons(first, (_root_.List.cons(", ", (_root_.List.cons(second, (_root_.List.cons(", ", (_root_.List.cons(third, (_root_.List.cons(", ", (_root_.List.cons(fourth, (_root_.List.cons(", ", (_root_.List.cons(fifth, (_root_.List.cons(")", _root_.List.nil)))))))))))))))))))))))))))))))))))))
  | _ => Except.error(PsJsEmitError.malformedIr)
}

def psJsPrintRuntime(operation : PsJsIrRuntimeOp, arguments : List(String)) : Except(PsJsEmitError, String) := match arguments with {
  | List.nil => Except.error(PsJsEmitError.malformedIr)
  | List.cons first rest => match rest with {
  | List.nil => psJsRuntimeUnary(operation, first)
  | List.cons second tail => match tail with {
  | List.nil => psJsRuntimeBinary(operation, first, second)
  | List.cons third finalTail => match finalTail with {
  | List.nil => psJsRuntimeTernary(operation, first, second, third)
  | List.cons fourth afterFourth => match afterFourth with {
  | List.nil => Except.error(PsJsEmitError.malformedIr)
  | List.cons fifth finalTail => match finalTail with {
  | List.nil => psJsRuntimeFive(operation, first, second, third, fourth, fifth)
  | List.cons _ _ => Except.error(PsJsEmitError.malformedIr)
}
}
}
}
}
}

-- Construct curried recursive helpers only after binding their traversal inputs.
-- Eager setup before that lambda can branch over fuel rather than visited nodes.
def psJsExprUsesNameWithFuelWorker(fuel : Nat, expr : PsJsIrExpr, name : String) : Bool := match fuel with {
  | Nat.zero => true
  | Nat.succ remaining => match expr with {
  | literal _ => false
  | var value => psStringEq(value, name)
  | unary _ value => psJsExprUsesNameWithFuelWorker(remaining, value, name)
  | binary _ left right => if (psJsExprUsesNameWithFuelWorker(remaining, left, name)) { true } else { psJsExprUsesNameWithFuelWorker(remaining, right, name) }
  | runtime _ arguments => psListAny((fun (value : PsJsIrExpr) => psJsExprUsesNameWithFuelWorker(remaining, value, name)), arguments)
  | lambda parameters body => if (psListAny((fun (parameter : String) => psStringEq(parameter, name)), parameters)) { true } else { psJsExprUsesNameWithFuelWorker(remaining, body, name) }
  | call fn arguments => if (psJsExprUsesNameWithFuelWorker(remaining, fn, name)) { true } else { psListAny((fun (value : PsJsIrExpr) => psJsExprUsesNameWithFuelWorker(remaining, value, name)), arguments) }
  | letE localName value body => if (psStringEq(localName, name)) { true } else { if (psJsExprUsesNameWithFuelWorker(remaining, value, name)) { true } else { psJsExprUsesNameWithFuelWorker(remaining, body, name) } }
  | ifE condition left right => if (psJsExprUsesNameWithFuelWorker(remaining, condition, name)) { true } else { if (psJsExprUsesNameWithFuelWorker(remaining, left, name)) { true } else { psJsExprUsesNameWithFuelWorker(remaining, right, name) } }
  | record fields => psListAny((fun (field : _root_.Prod(String, PsJsIrExpr)) => psJsExprUsesNameWithFuelWorker(remaining, field.snd, name)), fields)
  | projection target _ => psJsExprUsesNameWithFuelWorker(remaining, target, name)
  | constructor _ fields => psListAny((fun (field : _root_.Prod(String, PsJsIrExpr)) => psJsExprUsesNameWithFuelWorker(remaining, field.snd, name)), fields)
  | matchE scrutinee alternatives => if (psJsExprUsesNameWithFuelWorker(remaining, scrutinee, name)) { true } else { psListAny((fun (alternative : _root_.Prod(String, (_root_.Prod((List(PsJsIrMatchBinding)), PsJsIrExpr)))) => if (psListAny((fun (binding : PsJsIrMatchBinding) => psStringEq(binding.name, name)), alternative.snd.fst)) { true } else { psJsExprUsesNameWithFuelWorker(remaining, alternative.snd.snd, name) }), alternatives) }
}
}

def psJsExprUsesNameWithFuel(fuel : Nat) : (_ : PsJsIrExpr) -> (_ : String) -> Bool := fun (expr : PsJsIrExpr) (name : String) => psJsExprUsesNameWithFuelWorker(fuel, expr, name)

def psJsFreshMatchTempWorker(expr : PsJsIrExpr, attempts : Nat) : (_ : Nat) -> String := match attempts with {
  | Nat.zero => fun (_index : Nat) => "__ps$match$overflow"
  | Nat.succ remaining => fun (index : Nat) => let smaller : (_ : Nat) -> String := (psJsFreshMatchTempWorker(expr, remaining))
let candidate : String := (String.Internal.append("__ps$match$", (psNatToString(index))))
if (psJsExprUsesNameWithFuel(4096, expr, candidate)) { smaller((Nat.succ(index))) } else { candidate }
}

def psJsFreshMatchTemp(expr : PsJsIrExpr) : String := psJsFreshMatchTempWorker(expr, 4096, 0)

def psJsFreshTailMatchTempWorker(expr : PsJsIrExpr, attempts : Nat) : (_ : Nat) -> String := match attempts with {
  | Nat.zero => fun (index : Nat) => psJsConcat2("__ps$tail$match$", (psNatToString(index)))
  | Nat.succ remaining => fun (index : Nat) => let smaller : (_ : Nat) -> String := (psJsFreshTailMatchTempWorker(expr, remaining))
let candidate : String := (psJsConcat2("__ps$tail$match$", (psNatToString(index))))
if (psJsExprUsesNameWithFuel(4096, expr, candidate)) { smaller((Nat.succ(index))) } else { candidate }
}

def psJsFreshTailMatchTemp(expr : PsJsIrExpr, depth : Nat) : String := psJsFreshTailMatchTempWorker(expr, 4096, depth)

def psJsPrintFieldWith(print : (_ : PsJsIrExpr) -> Except(PsJsEmitError, String), field : _root_.Prod(String, PsJsIrExpr)) : Except(PsJsEmitError, String) := match field with {
  | Prod.mk name value => match (print(value)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedValue => Except.ok((psJsJoin("", (_root_.List.cons("[", (_root_.List.cons((psJsonQuote(name)), (_root_.List.cons("]: ", (_root_.List.cons(printedValue, _root_.List.nil)))))))))))
}
}

def psJsPrintFieldsWith(print : (_ : PsJsIrExpr) -> Except(PsJsEmitError, String), fields : List((_root_.Prod(String, PsJsIrExpr)))) : Except(PsJsEmitError, (List(String))) := match fields with {
  | List.nil => Except.ok(List.nil)
  | List.cons field rest => match (psJsPrintFieldWith(print, field)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedField => match (psJsPrintFieldsWith(print, rest)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedRest => Except.ok((List.cons(printedField, printedRest)))
}
}
}

def psJsPrintMatchBinding(temp : String, binding : PsJsIrMatchBinding) : String := psJsJoin("", (_root_.List.cons("const ", (_root_.List.cons(binding.name, (_root_.List.cons(" = ", (_root_.List.cons(temp, (_root_.List.cons("[\"$ps$fields\"][", (_root_.List.cons((psJsonQuote(binding.field)), (_root_.List.cons("];", _root_.List.nil)))))))))))))))

def psJsPrintMatchBindings(temp : String, bindings : List(PsJsIrMatchBinding)) : List(String) := match bindings with {
  | List.nil => List.nil
  | List.cons binding rest => List.cons((psJsPrintMatchBinding(temp, binding)), (psJsPrintMatchBindings(temp, rest)))
}

def psJsPrintMatchAlternativeWith(print : (_ : PsJsIrExpr) -> Except(PsJsEmitError, String), temp : String, alternative : _root_.Prod(String, (_root_.Prod((List(PsJsIrMatchBinding)), PsJsIrExpr)))) : Except(PsJsEmitError, String) := let constructorName : String := (Prod.fst(alternative))
let detail : _root_.Prod((List(PsJsIrMatchBinding)), PsJsIrExpr) := (Prod.snd(alternative))
let bindings : List(PsJsIrMatchBinding) := (Prod.fst(detail))
let body : PsJsIrExpr := (Prod.snd(detail))
match (print(body)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedBody => let printedBindings : List(String) := (psJsPrintMatchBindings(temp, bindings))
let bindingSeparator : String := (if (psListIsEmpty(printedBindings)) { "" } else { " " })
Except.ok((psJsJoin("", (_root_.List.cons("case ", (_root_.List.cons((psJsonQuote(constructorName)), (_root_.List.cons(": { ", (_root_.List.cons((psJsJoin(" ", printedBindings)), (_root_.List.cons(bindingSeparator, (_root_.List.cons("return ", (_root_.List.cons(printedBody, (_root_.List.cons("; }", _root_.List.nil)))))))))))))))))))
}

def psJsPrintMatchAlternativesWith(print : (_ : PsJsIrExpr) -> Except(PsJsEmitError, String), temp : String, alternatives : List((_root_.Prod(String, (_root_.Prod((List(PsJsIrMatchBinding)), PsJsIrExpr)))))) : Except(PsJsEmitError, (List(String))) := match alternatives with {
  | List.nil => Except.ok(List.nil)
  | List.cons alternative rest => match (psJsPrintMatchAlternativeWith(print, temp, alternative)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedAlternative => match (psJsPrintMatchAlternativesWith(print, temp, rest)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedRest => Except.ok((List.cons(printedAlternative, printedRest)))
}
}
}

def psJsPrintEvery {alpha : Type}(predicate : (_ : alpha) -> Bool, values : List(alpha)) : Bool := match values with {
  | List.nil => true
  | List.cons value rest => if (predicate(value)) { psJsPrintEvery(predicate, rest) } else { false }
}

def psJsCallsUseOnlySelfWithFuel(selfName : String, fuel : Nat) : (_ : PsJsIrExpr) -> Bool := match fuel with {
  | Nat.zero => fun (_expression : PsJsIrExpr) => false
  | Nat.succ remaining => fun (expression : PsJsIrExpr) => let smaller : (_ : PsJsIrExpr) -> Bool := (psJsCallsUseOnlySelfWithFuel(selfName, remaining))
match expression with {
  | literal _ => true
  | var _ => true
  | unary _ value => smaller(value)
  | projection value _ => smaller(value)
  | binary _ left right => (smaller(left) && smaller(right))
  | letE _ value body => (smaller(value) && smaller(body))
  | runtime _ arguments => psJsPrintEvery(smaller, arguments)
  | lambda _ body => smaller(body)
  | call fn arguments => match fn with {
  | var name => (psStringEq(name, selfName) && psJsPrintEvery(smaller, arguments))
  | _ => false
}
  | ifE condition left right => ((smaller(condition) && smaller(left)) && smaller(right))
  | record fields => psJsPrintEvery((fun (field : Prod(String, PsJsIrExpr)) => smaller(field.snd)), fields)
  | constructor _ fields => psJsPrintEvery((fun (field : Prod(String, PsJsIrExpr)) => smaller(field.snd)), fields)
  | matchE scrutinee alternatives => (smaller(scrutinee) && psJsPrintEvery((fun (alternative : Prod(String, (Prod((List(PsJsIrMatchBinding)), PsJsIrExpr)))) => smaller(alternative.snd.snd)), alternatives))
}
}

-- An empty sentinel cannot be an authored JsIR declaration name. With it the
-- same structural visitor recognizes expressions containing no calls at all.
def psJsNeedsCallDriver(expression : PsJsIrExpr) : Bool := if (psJsCallsUseOnlySelfWithFuel("", 4096, expression)) { false } else { true }

-- These three recursive modes must be created inside the expression handler.
-- Before that binder, generated code eagerly builds an exponential worker tree.
-- A call-free closure cannot suspend. Keep its existing lexical
-- captures and ordinary expression evaluation without a driver.
-- The existing driver owns the single dispatch lookup.
-- Object fields preserve callee then left-to-right operands.
def psJsPrintExprWithPositionAndFuel(stackTarget : Option(String), tailPosition : Bool, fuel : Nat) : (_ : PsJsIrExpr) -> Except(PsJsEmitError, String) := match fuel with {
  | Nat.zero => fun (_expr : PsJsIrExpr) => Except.error(PsJsEmitError.fuelExhausted)
  | Nat.succ remaining => fun (expr : PsJsIrExpr) => let smaller : (_ : PsJsIrExpr) -> Except(PsJsEmitError, String) := (psJsPrintExprWithPositionAndFuel(stackTarget, false, remaining))
let inTail : (_ : PsJsIrExpr) -> Except(PsJsEmitError, String) := (psJsPrintExprWithPositionAndFuel(stackTarget, tailPosition, remaining))
let lambdaBody : (_ : PsJsIrExpr) -> Except(PsJsEmitError, String) := (psJsPrintExprWithPositionAndFuel(stackTarget, true, remaining))
let stackContext : Bool := (match stackTarget with {
  | Option.none => false
  | Option.some _ => true
})
match expr with {
  | PsJsIrExpr.literal literal => Except.ok((psJsPrintLiteral(literal)))
  | PsJsIrExpr.var name => Except.ok(name)
  | PsJsIrExpr.unary operation value => match (smaller(value)) with {
  | Except.error error => Except.error(error)
  | Except.ok printed => Except.ok((psJsPrintUnary(operation, printed)))
}
  | PsJsIrExpr.binary operation left right => match (smaller(left)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedLeft => match (smaller(right)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedRight => Except.ok((psJsPrintBinary(operation, printedLeft, printedRight)))
}
}
  | PsJsIrExpr.runtime operation arguments => match (psListMapExcept(smaller, arguments)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedArguments => psJsPrintRuntime(operation, printedArguments)
}
  | PsJsIrExpr.lambda parameters body => let driven : Bool := ((stackContext && psJsNeedsCallDriver(body)))
let printBody : (_ : PsJsIrExpr) -> Except(PsJsEmitError, String) := (if (driven) { lambdaBody } else { psJsPrintExprWithPositionAndFuel(Option.none, true, remaining) })
match (printBody(body)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedBody => if (driven) { Except.ok((psJsJoin("", (_root_.List.cons("__ps$wrap(function*(", (_root_.List.cons((psJsJoin(", ", parameters)), (_root_.List.cons(") { return ", (_root_.List.cons(printedBody, (_root_.List.cons("; })", _root_.List.nil))))))))))))) } else { Except.ok((psJsJoin("", (_root_.List.cons("((", (_root_.List.cons((psJsJoin(", ", parameters)), (_root_.List.cons(") => ", (_root_.List.cons(printedBody, (_root_.List.cons(")", _root_.List.nil))))))))))))) }
}
  | PsJsIrExpr.call fn arguments => match (smaller(fn)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedFn => match (psListMapExcept(smaller, arguments)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedArguments => if (stackContext) { Except.ok((psJsJoin("", (_root_.List.cons("(yield { fn: ", (_root_.List.cons(printedFn, (_root_.List.cons(", args: [", (_root_.List.cons((psJsJoin(", ", printedArguments)), (_root_.List.cons("], tail: ", (_root_.List.cons((if (tailPosition) { "true" } else { "false" }), (_root_.List.cons(" })", _root_.List.nil))))))))))))))))) } else { Except.ok((psJsConcat4(printedFn, "(", (psJsJoin(", ", printedArguments)), ")"))) }
}
}
  | PsJsIrExpr.letE name value body => match (smaller(value)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedValue => match (inTail(body)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedBody => if (stackContext) { Except.ok((psJsJoin("", (_root_.List.cons("(yield* (function*(", (_root_.List.cons(name, (_root_.List.cons(") { return ", (_root_.List.cons(printedBody, (_root_.List.cons("; })(", (_root_.List.cons(printedValue, (_root_.List.cons("))", _root_.List.nil))))))))))))))))) } else { Except.ok((psJsJoin("", (_root_.List.cons("((", (_root_.List.cons(name, (_root_.List.cons(") => ", (_root_.List.cons(printedBody, (_root_.List.cons(")(", (_root_.List.cons(printedValue, (_root_.List.cons(")", _root_.List.nil))))))))))))))))) }
}
}
  | PsJsIrExpr.ifE condition thenBranch elseBranch => match (smaller(condition)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedCondition => match (inTail(thenBranch)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedThen => match (inTail(elseBranch)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedElse => Except.ok((psJsConcat7("(", printedCondition, " ? ", printedThen, " : ", printedElse, ")")))
}
}
}
  | PsJsIrExpr.record fields => match (psJsPrintFieldsWith(smaller, fields)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedFields => Except.ok((psJsJoin("", (_root_.List.cons("({ ", (_root_.List.cons((psJsJoin(", ", printedFields)), (_root_.List.cons(" })", _root_.List.nil)))))))))
}
  | PsJsIrExpr.projection target field => match (smaller(target)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedTarget => Except.ok((psJsJoin("", (_root_.List.cons("(", (_root_.List.cons(printedTarget, (_root_.List.cons(")[", (_root_.List.cons((psJsonQuote(field)), (_root_.List.cons("]", _root_.List.nil)))))))))))))
}
  | PsJsIrExpr.constructor constructorName fields => match (psJsPrintFieldsWith(smaller, fields)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedFields => let payload : String := (psJsJoin("", (_root_.List.cons("{ ", (_root_.List.cons((psJsJoin(", ", printedFields)), (_root_.List.cons(" }", _root_.List.nil))))))))
Except.ok((psJsJoin("", (_root_.List.cons("({ \"$ps$tag\": ", (_root_.List.cons((psJsonQuote(constructorName)), (_root_.List.cons(", \"$ps$fields\": ", (_root_.List.cons(payload, (_root_.List.cons(" })", _root_.List.nil)))))))))))))
}
  | PsJsIrExpr.matchE scrutinee alternatives => match (smaller(scrutinee)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedScrutinee => let temp : String := (psJsFreshMatchTemp(expr))
match (psJsPrintMatchAlternativesWith(inTail, temp, alternatives)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedAlternatives => if (stackContext) { Except.ok((psJsJoin("", (_root_.List.cons("(yield* (function*() { const ", (_root_.List.cons(temp, (_root_.List.cons(" = ", (_root_.List.cons(printedScrutinee, (_root_.List.cons("; switch (", (_root_.List.cons(temp, (_root_.List.cons("[\"$ps$tag\"]) { ", (_root_.List.cons((psJsJoin(" ", printedAlternatives)), (_root_.List.cons(" } throw new Error(\"invalid ProofScript constructor tag\"); })())", _root_.List.nil))))))))))))))))))))) } else { Except.ok((psJsJoin("", (_root_.List.cons("((", (_root_.List.cons(temp, (_root_.List.cons(") => { switch (", (_root_.List.cons(temp, (_root_.List.cons("[\"$ps$tag\"]) { ", (_root_.List.cons((psJsJoin(" ", printedAlternatives)), (_root_.List.cons(" } throw new Error(\"invalid ProofScript constructor tag\"); })(", (_root_.List.cons(printedScrutinee, (_root_.List.cons(")", _root_.List.nil))))))))))))))))))))) }
}
}
}
}

def psJsPrintExprWithModeAndFuel(stackTarget : Option(String), fuel : Nat) : (_ : PsJsIrExpr) -> Except(PsJsEmitError, String) := psJsPrintExprWithPositionAndFuel(stackTarget, false, fuel)

def psJsPrintExpr(expr : PsJsIrExpr) : Except(PsJsEmitError, String) := psJsPrintExprWithModeAndFuel(Option.none, 4096, expr)

def psJsPrintExprStackSafe(recursiveName : String, expr : PsJsIrExpr) : Except(PsJsEmitError, String) := psJsPrintExprWithPositionAndFuel((Option.some(recursiveName)), true, 4096, expr)

def psJsPrintImport(importInfo : PsJsIrImport) : String := let alias : String := (if (psStringEq(importInfo.importedName, importInfo.localName)) { "" } else { String.Internal.append(" as ", importInfo.localName) })
psJsJoin("", (_root_.List.cons("import { ", (_root_.List.cons(importInfo.importedName, (_root_.List.cons(alias, (_root_.List.cons(" } from ", (_root_.List.cons((psJsonQuote(importInfo.source)), (_root_.List.cons(";\n", _root_.List.nil)))))))))))))

def psJsPrintImports(imports : List(PsJsIrImport)) : String := psTextJoin("", (psListMap(psJsPrintImport, imports)))

def psJsParameterName(parameter : PsJsIrParameter) : String := parameter.name

def psJsPrintDeclarationWithVisibility(isPublic : Bool, declaration : PsJsIrDeclaration) : Except(PsJsEmitError, String) := match (psJsPrintExpr(declaration.body)) with {
  | Except.error error => Except.error(error)
  | Except.ok body => match declaration.parameters with {
  | List.nil => Except.ok((psJsConcat4((if (isPublic) { "export const " } else { "const " }), declaration.name, " = ", (psJsConcat2(body, ";\n")))))
  | List.cons _ _ => let parameters := (psListMap(psJsParameterName, declaration.parameters))
Except.ok((psJsConcat6((if (isPublic) { "export function " } else { "function " }), declaration.name, "(", (psJsJoin(", ", parameters)), ") { return ", (psJsConcat2(body, "; }\n")))))
}
}

-- Generated coordinates are separate from parser positions: UTF-8 byte
-- offsets plus zero-based ECMAScript lines and UTF-16 columns.
def psJsPrintDeclaration(declaration : PsJsIrDeclaration) : Except(PsJsEmitError, String) := psJsPrintDeclarationWithVisibility(true, declaration)

structure PsJsGeneratedPosition where {
  byteOffset : Nat
  line : Nat
  column : Nat
  previousCR : Bool
}

def psJsGeneratedPositionZero : PsJsGeneratedPosition := PsJsGeneratedPosition.mk(0, 0, 0, false)

def psJsAdvanceGeneratedChar(position : PsJsGeneratedPosition, char : Char, byteWidth : Nat) : PsJsGeneratedPosition := let codePoint : Nat := (Char.toNat(char))
let nextByte : Nat := (Nat.add(position.byteOffset, byteWidth))
if (Nat.beq(codePoint, 10)) { if (position.previousCR) { PsJsGeneratedPosition.mk(nextByte, position.line, 0, false) } else { PsJsGeneratedPosition.mk(nextByte, (Nat.succ(position.line)), 0, false) } } else { if (Nat.beq(codePoint, 13)) { PsJsGeneratedPosition.mk(nextByte, (Nat.succ(position.line)), 0, true) } else { if (Nat.beq(codePoint, 8232)) { PsJsGeneratedPosition.mk(nextByte, (Nat.succ(position.line)), 0, false) } else { if (Nat.beq(codePoint, 8233)) { PsJsGeneratedPosition.mk(nextByte, (Nat.succ(position.line)), 0, false) } else { if (Nat.ble(codePoint, 65535)) { PsJsGeneratedPosition.mk(nextByte, position.line, (Nat.succ(position.column)), false) } else { PsJsGeneratedPosition.mk(nextByte, position.line, (Nat.add(position.column, 2)), false) } } } } }

def psJsAdvanceGeneratedTextWorker(fuel : Nat) : (_ : String) -> (_ : Nat) -> (_ : PsJsGeneratedPosition) -> Except(PsJsEmitError, PsJsGeneratedPosition) := match fuel with {
  | Nat.zero => fun (text : String) (offset : Nat) (position : PsJsGeneratedPosition) => if (String.Internal.atEnd(text, (String.Pos.Raw.mk(offset)))) { Except.ok(position) } else { Except.error(PsJsEmitError.fuelExhausted) }
  | Nat.succ remaining => fun (text : String) (offset : Nat) (position : PsJsGeneratedPosition) => let smaller : (_ : String) -> (_ : Nat) -> (_ : PsJsGeneratedPosition) -> Except(PsJsEmitError, PsJsGeneratedPosition) := (psJsAdvanceGeneratedTextWorker(remaining))
if (String.Internal.atEnd(text, (String.Pos.Raw.mk(offset)))) { Except.ok(position) } else { let char : Char := (String.Internal.get(text, (String.Pos.Raw.mk(offset))))
let next : Nat := (String.Pos.Raw.byteIdx((String.Internal.next(text, (String.Pos.Raw.mk(offset))))))
smaller(text, next, (psJsAdvanceGeneratedChar(position, char, (Nat.sub(next, offset))))) }
}

def psJsAdvanceGeneratedText(position : PsJsGeneratedPosition, text : String) : Except(PsJsEmitError, PsJsGeneratedPosition) := psJsAdvanceGeneratedTextWorker((Nat.succ((String.utf8ByteSize(text)))), text, 0, position)

structure PsJsGeneratedDeclarationSpan where {
  name : String
  start : PsJsGeneratedPosition
  stop : PsJsGeneratedPosition
}

structure PsJsPrintedModule where {
  text : String
  spans : List(PsJsGeneratedDeclarationSpan)
}

def psJsEncodeGeneratedPosition(position : PsJsGeneratedPosition) : String := psJsonArray((_root_.List.cons((psNatToString(position.byteOffset)), (_root_.List.cons((psNatToString(position.line)), (_root_.List.cons((psNatToString(position.column)), _root_.List.nil)))))))

def psJsEncodeGeneratedSpan(span : PsJsGeneratedDeclarationSpan) : String := psJsonArray((_root_.List.cons((psJsonQuote(span.name)), (_root_.List.cons((psJsEncodeGeneratedPosition(span.start)), (_root_.List.cons((psJsEncodeGeneratedPosition(span.stop)), _root_.List.nil)))))))

def psJsEncodeGeneratedPositions(spans : List(PsJsGeneratedDeclarationSpan)) : String := psJsonArray((_root_.List.cons((psJsonQuote("psc-js-generated-positions/1")), (_root_.List.cons((psJsonQuote("declaration-emission-chunk")), (_root_.List.cons((psJsonArray((psListMap(psJsEncodeGeneratedSpan, spans)))), _root_.List.nil)))))))

-- One actual printing fold. Legacy callers collect no spans and do not scan
-- text for coordinates. Observed callers measure each actual chunk once.
def psJsPrintDeclarationsObservedWith(print : (_ : PsJsIrDeclaration) -> Except(PsJsEmitError, String), declarations : List(PsJsIrDeclaration)) : (_ : Bool) -> (_ : PsTextBuilder) -> (_ : PsJsGeneratedPosition) -> (_ : List(PsJsGeneratedDeclarationSpan)) -> Except(PsJsEmitError, PsJsPrintedModule) := match declarations with {
  | List.nil => fun (_observe : Bool) (builder : PsTextBuilder) (_position : PsJsGeneratedPosition) (spansRev : List(PsJsGeneratedDeclarationSpan)) => Except.ok((PsJsPrintedModule.mk((psTextBuilderFinish(builder)), (psListReverse(spansRev)))))
  | List.cons declaration rest => fun (observe : Bool) (builder : PsTextBuilder) (position : PsJsGeneratedPosition) (spansRev : List(PsJsGeneratedDeclarationSpan)) => let smaller : (_ : Bool) -> (_ : PsTextBuilder) -> (_ : PsJsGeneratedPosition) -> (_ : List(PsJsGeneratedDeclarationSpan)) -> Except(PsJsEmitError, PsJsPrintedModule) := (psJsPrintDeclarationsObservedWith(print, rest))
match (print(declaration)) with {
  | Except.error error => Except.error(error)
  | Except.ok printed => let nextBuilder : PsTextBuilder := (psTextBuilderAppend(builder, printed))
if (observe) { match (psJsAdvanceGeneratedText(position, printed)) with {
  | Except.error error => Except.error(error)
  | Except.ok nextPosition => smaller(true, nextBuilder, nextPosition, (List.cons((PsJsGeneratedDeclarationSpan.mk(declaration.name, position, nextPosition)), spansRev)))
} } else { smaller(false, nextBuilder, position, spansRev) }
}
}

def psJsPrintDeclarationsWith(print : (_ : PsJsIrDeclaration) -> Except(PsJsEmitError, String), declarations : List(PsJsIrDeclaration)) : (_ : PsTextBuilder) -> Except(PsJsEmitError, String) := fun (builder : PsTextBuilder) => match (psJsPrintDeclarationsObservedWith(print, declarations, false, builder, psJsGeneratedPositionZero, List.nil)) with {
  | Except.error error => Except.error(error)
  | Except.ok product => Except.ok(product.text)
}

def psJsPrintDeclarations(declarations : List(PsJsIrDeclaration)) : Except(PsJsEmitError, String) := psJsPrintDeclarationsWith(psJsPrintDeclaration, declarations, psTextBuilderEmpty)

def psJsStringRuntimeSupport : String := "let __ps$lastUtf8;\nlet __ps$previousUtf8;\nfunction __ps$utf8Width(code) { return code <= 0x7f ? 1 : code <= 0x7ff ? 2 : code <= 0xffff ? 3 : 4; }\nfunction __ps$utf8(text) {\n  if (__ps$lastUtf8?.text === text) return __ps$lastUtf8;\n  if (__ps$previousUtf8?.text === text) return __ps$previousUtf8;\n  let size = 0;\n  for (const char of text) size += __ps$utf8Width(char.codePointAt(0) ?? 0);\n  const positions = new Uint32Array(size + 1);\n  let byte = 0, index = 0;\n  for (const char of text) {\n    positions[byte] = index + 1;\n    const __ps_w = __ps$utf8Width(char.codePointAt(0) ?? 0);\n    byte += __ps_w; index += char.length;\n  }\n  positions[size] = text.length + 1;\n  __ps$previousUtf8 = __ps$lastUtf8;\n  return __ps$lastUtf8 = { token: Symbol(), text, size: BigInt(size), positions };\n}\nfunction __ps$stringGet(text, position) {\n  const view = __ps$utf8(text);\n  if (position < 0n || position >= view.size) return \"A\";\n  const index = view.positions[Number(position)];\n  return index === 0 ? \"A\" : String.fromCodePoint(text.codePointAt(index - 1) ?? 65);\n}\nfunction __ps$stringNext(text, position) {\n  const view = __ps$utf8(text);\n  if (position < 0n || position >= view.size) return position + 1n;\n  const index = view.positions[Number(position)];\n  return index === 0 ? position + 1n : position + BigInt(__ps$utf8Width(text.codePointAt(index - 1) ?? 0));\n}\nfunction __ps$utf8Known(text, token) {\n  if (token !== undefined) {\n    if (__ps$lastUtf8?.token === token) return __ps$lastUtf8;\n    if (__ps$previousUtf8?.token === token) return __ps$previousUtf8;\n  }\n  return __ps$utf8(text);\n}\nfunction __ps$stringGetView(view, position) {\n  if (position < 0n || position >= view.size) return \"A\";\n  const index = view.positions[Number(position)];\n  return index === 0 ? \"A\" : String.fromCodePoint(view.text.codePointAt(index - 1) ?? 65);\n}\nfunction __ps$stringNextView(view, position) {\n  if (position < 0n || position >= view.size) return position + 1n;\n  const index = view.positions[Number(position)];\n  return index === 0 ? position + 1n : position + BigInt(__ps$utf8Width(view.text.codePointAt(index - 1) ?? 0));\n}\n\nfunction __ps$stringUtf8Size(text) {\n  if (__ps$lastUtf8?.text === text) return __ps$lastUtf8.size;\n  if (__ps$previousUtf8?.text === text) return __ps$previousUtf8.size;\n  let size = 0;\n  for (const char of text) size += __ps$utf8Width(char.codePointAt(0) ?? 0);\n  return BigInt(size);\n}\nfunction __ps$stringExtract(text, start, stop) {\n  if (start >= stop) return \"\";\n  const view = __ps$lastUtf8?.text === text ? __ps$lastUtf8 :\n    __ps$previousUtf8?.text === text ? __ps$previousUtf8 : undefined;\n  if (view !== undefined && start >= 0n && stop <= view.size) {\n    const first = view.positions[Number(start)], last = view.positions[Number(stop)];\n    if (first > 0 && last > 0) return text.slice(first - 1, last - 1);\n  }\n  // Exact retained scan for cold views and invalid/interior/out-of-range offsets.\n  let position = 0n, started = false, output = \"\";\n  for (const char of text) {\n    const code = char.codePointAt(0) ?? 0;\n    const width = BigInt(code <= 0x7f ? 1 : code <= 0x7ff ? 2 : code <= 0xffff ? 3 : 4);\n    if (!started) {\n      if (position === start) started = true;\n      else { position += width; continue; }\n    }\n    if (position === stop) return output;\n    output += char; position += width;\n  }\n  return output;\n}\n"

def psJsStackRuntimeSupport : String := psJsJoin("", (_root_.List.cons("const __ps$implementations = new WeakMap();\n", (_root_.List.cons("function __ps$run(root) { const pending = [root]; let value = undefined; while (pending.length !== 0) { const next = pending[pending.length - 1].next(value); if (next.done) { pending.pop(); value = next.value; } else { const { fn, args, tail } = next.value; const implementation = __ps$implementations.get(fn); if (implementation) { const child = Reflect.apply(implementation, undefined, args); if (tail) pending[pending.length - 1] = child; else pending.push(child); value = undefined; } else { value = Reflect.apply(fn, undefined, args); if (tail) pending.pop(); } } } return value; }\n", (_root_.List.cons("function __ps$wrap(implementation) { const fn = (...args) => __ps$run(implementation(...args)); __ps$implementations.set(fn, implementation); return fn; }\n", (_root_.List.cons("function* __ps$invoke(fn, ...args) { const implementation = __ps$implementations.get(fn); if (implementation) return (yield { fn, args }); return fn(...args); }\n", (_root_.List.cons("function* __ps$tailInvoke(fn, ...args) { const implementation = __ps$implementations.get(fn); if (implementation) return (yield { fn, args, tail: true }); return fn(...args); }\n", _root_.List.nil)))))))))))

def psJsImplementationName(name : String) : String := psJsConcat2("__ps$impl$", name)

def psJsTailPrintNonRecursive(recursiveName : String, expr : PsJsIrExpr) : Option(String) := if (psJsExprUsesNameWithFuel(4096, expr, recursiveName)) { Option.none } else { match (psJsPrintExpr(expr)) with {
  | Except.error _ => Option.none
  | Except.ok printed => Option.some(printed)
} }

def psJsTailPrintArguments(recursiveName : String, arguments : List(PsJsIrExpr)) : Option((List(String))) := match arguments with {
  | List.nil => Option.some(List.nil)
  | List.cons argument rest => let smaller : Option((List(String))) := (psJsTailPrintArguments(recursiveName, rest))
match (psJsTailPrintNonRecursive(recursiveName, argument)) with {
  | Option.none => Option.none
  | Option.some printed => match smaller with {
  | Option.none => Option.none
  | Option.some printedRest => Option.some((List.cons(printed, printedRest)))
}
}
}

def psJsTailParameterNames(parameters : List(PsJsIrParameter)) : List(String) := psListMap(psJsParameterName, parameters)

def psJsTailBindingsShadow(recursiveName : String, bindings : List(PsJsIrMatchBinding)) : Bool := let shadows : (_ : PsJsIrMatchBinding) -> Bool := (fun (binding : PsJsIrMatchBinding) => psStringEq(binding.name, recursiveName))
psListAny(shadows, bindings)

def psJsTailPrintAlternativeWith(emit : (_ : PsJsIrExpr) -> Option(String), recursiveName : String, temp : String, alternative : _root_.Prod(String, (_root_.Prod((List(PsJsIrMatchBinding)), PsJsIrExpr)))) : Option(String) := let constructorName : String := (Prod.fst(alternative))
let detail : _root_.Prod((List(PsJsIrMatchBinding)), PsJsIrExpr) := (Prod.snd(alternative))
let bindings : List(PsJsIrMatchBinding) := (Prod.fst(detail))
let body : PsJsIrExpr := (Prod.snd(detail))
if (psJsTailBindingsShadow(recursiveName, bindings)) { Option.none } else { match (emit(body)) with {
  | Option.none => Option.none
  | Option.some printedBody => let printedBindings : List(String) := (psJsPrintMatchBindings(temp, bindings))
let separator : String := (if (psListIsEmpty(printedBindings)) { "" } else { " " })
Option.some((psJsJoin("", (_root_.List.cons("case ", (_root_.List.cons((psJsonQuote(constructorName)), (_root_.List.cons(": { ", (_root_.List.cons((psJsJoin(" ", printedBindings)), (_root_.List.cons(separator, (_root_.List.cons(printedBody, (_root_.List.cons(" }", _root_.List.nil)))))))))))))))))
} }

def psJsTailPrintAlternativesWith(emit : (_ : PsJsIrExpr) -> Option(String), recursiveName : String, temp : String, alternatives : List((_root_.Prod(String, (_root_.Prod((List(PsJsIrMatchBinding)), PsJsIrExpr)))))) : Option((List(String))) := match alternatives with {
  | List.nil => Option.some(List.nil)
  | List.cons alternative rest => let smaller : Option((List(String))) := (psJsTailPrintAlternativesWith(emit, recursiveName, temp, rest))
match (psJsTailPrintAlternativeWith(emit, recursiveName, temp, alternative)) with {
  | Option.none => Option.none
  | Option.some printed => match smaller with {
  | Option.none => Option.none
  | Option.some printedRest => Option.some((List.cons(printed, printedRest)))
}
}
}

def psJsTailEmitWithFuel(declaration : PsJsIrDeclaration, available : (_ : String) -> Bool, fuel : Nat) : (_ : Nat) -> (_ : PsJsIrExpr) -> Option(String) := match fuel with {
  | Nat.zero => fun (_matchDepth : Nat) (_expr : PsJsIrExpr) => Option.none
  | Nat.succ remaining => fun (matchDepth : Nat) (expr : PsJsIrExpr) => let smaller : (_ : Nat) -> (_ : PsJsIrExpr) -> Option(String) := (psJsTailEmitWithFuel(declaration, available, remaining))
let sameDepth : (_ : PsJsIrExpr) -> Option(String) := (smaller(matchDepth))
let nested : (_ : PsJsIrExpr) -> Option(String) := (smaller((Nat.succ(matchDepth))))
match expr with {
  | PsJsIrExpr.call fn arguments => match fn with {
  | PsJsIrExpr.var name => if (psStringEq(name, declaration.name)) { if (Nat.beq((psListLength(declaration.parameters)), (psListLength(arguments)))) { match (psJsTailPrintArguments(declaration.name, arguments)) with {
  | Option.none => Option.none
  | Option.some printedArguments => Option.some((psJsJoin("", (_root_.List.cons("__ps$tail$state = [", (_root_.List.cons((psJsJoin(", ", printedArguments)), (_root_.List.cons("]; continue;", _root_.List.nil)))))))))
} } else { Option.none } } else { match (psJsTailPrintNonRecursive(declaration.name, expr)) with {
  | Option.none => Option.none
  | Option.some printed => Option.some((psJsConcat3("return ", printed, ";")))
} }
  | _ => match (psJsTailPrintNonRecursive(declaration.name, expr)) with {
  | Option.none => Option.none
  | Option.some printed => Option.some((psJsConcat3("return ", printed, ";")))
}
}
  | PsJsIrExpr.letE name value body => if (psStringEq(name, declaration.name)) { Option.none } else { match (psJsTailPrintNonRecursive(declaration.name, value)) with {
  | Option.none => Option.none
  | Option.some printedValue => match (sameDepth(body)) with {
  | Option.none => Option.none
  | Option.some printedBody => let temp := (String.Internal.append("__ps$tail$value$", (psNatToString(remaining))))
if (available(temp)) { Option.some((psJsJoin("", (_root_.List.cons("{ const ", (_root_.List.cons(temp, (_root_.List.cons(" = ", (_root_.List.cons(printedValue, (_root_.List.cons("; { const ", (_root_.List.cons(name, (_root_.List.cons(" = ", (_root_.List.cons(temp, (_root_.List.cons("; ", (_root_.List.cons(printedBody, (_root_.List.cons(" } }", _root_.List.nil))))))))))))))))))))))))) } else { Option.none }
}
} }
  | PsJsIrExpr.ifE condition thenBranch elseBranch => match (psJsTailPrintNonRecursive(declaration.name, condition)) with {
  | Option.none => Option.none
  | Option.some printedCondition => match (sameDepth(thenBranch)) with {
  | Option.none => Option.none
  | Option.some printedThen => match (sameDepth(elseBranch)) with {
  | Option.none => Option.none
  | Option.some printedElse => Option.some((psJsJoin("", (_root_.List.cons("if (", (_root_.List.cons(printedCondition, (_root_.List.cons(") { ", (_root_.List.cons(printedThen, (_root_.List.cons(" } else { ", (_root_.List.cons(printedElse, (_root_.List.cons(" }", _root_.List.nil)))))))))))))))))
}
}
}
  | PsJsIrExpr.matchE scrutinee alternatives => match (psJsTailPrintNonRecursive(declaration.name, scrutinee)) with {
  | Option.none => Option.none
  | Option.some printedScrutinee => let temp : String := (psJsFreshTailMatchTemp(expr, matchDepth))
match (psJsTailPrintAlternativesWith(nested, declaration.name, temp, alternatives)) with {
  | Option.none => Option.none
  | Option.some printedAlternatives => Option.some((psJsJoin("", (_root_.List.cons("const ", (_root_.List.cons(temp, (_root_.List.cons(" = ", (_root_.List.cons(printedScrutinee, (_root_.List.cons("; switch (", (_root_.List.cons(temp, (_root_.List.cons("[\"$ps$tag\"]) { ", (_root_.List.cons((psJsJoin(" ", printedAlternatives)), (_root_.List.cons(" } throw new Error(\"invalid ProofScript constructor tag\");", _root_.List.nil)))))))))))))))))))))
}
}
  | _ => match (psJsTailPrintNonRecursive(declaration.name, expr)) with {
  | Option.none => Option.none
  | Option.some printed => Option.some((psJsConcat3("return ", printed, ";")))
}
}
}

-- Generator statements reuse the existing driver for every non-tail call.
-- Tail iterations snapshot every parameter immutably, preserving escaped closures.
def psJsGeneratorTailValue(name : String, tail : Bool, fuel : Nat, expr : PsJsIrExpr) : Option(String) := match (psJsPrintExprWithPositionAndFuel((Option.some(name)), tail, fuel, expr)) with {
  | Except.error _ => Option.none
  | Except.ok printed => Option.some(printed)
}

def psJsGeneratorTailArguments(name : String, fuel : Nat, arguments : List(PsJsIrExpr)) : Option((List(String))) := match arguments with {
  | List.nil => Option.some(_root_.List.nil)
  | List.cons value rest => match (psJsGeneratorTailValue(name, false, fuel, value)) with {
  | Option.none => Option.none
  | Option.some printed => match (psJsGeneratorTailArguments(name, fuel, rest)) with {
  | Option.none => Option.none
  | Option.some others => Option.some((List.cons(printed, others)))
}
}
}

def psJsGeneratorTailEmitWithFuel(declaration : PsJsIrDeclaration, available : (_ : String) -> Bool, fuel : Nat) : (_ : Nat) -> (_ : PsJsIrExpr) -> Option(String) := match fuel with {
  | Nat.zero => fun (_matchDepth : Nat) (_expr : PsJsIrExpr) => Option.none
  | Nat.succ remaining => fun (matchDepth : Nat) (expr : PsJsIrExpr) => let smaller : (_ : Nat) -> (_ : PsJsIrExpr) -> Option(String) := (psJsGeneratorTailEmitWithFuel(declaration, available, remaining))
let sameDepth : (_ : PsJsIrExpr) -> Option(String) := (smaller(matchDepth))
let nested : (_ : PsJsIrExpr) -> Option(String) := (smaller((Nat.succ(matchDepth))))
match expr with {
  | PsJsIrExpr.call fn arguments => match fn with {
  | PsJsIrExpr.var name => if (psStringEq(name, declaration.name)) { if (Nat.beq(remaining, 0)) { Option.none } else { if (Nat.beq((psListLength(declaration.parameters)), (psListLength(arguments)))) { match (psJsGeneratorTailArguments(declaration.name, remaining, arguments)) with {
  | Option.none => Option.none
  | Option.some printedArguments => Option.some((psJsJoin("", (_root_.List.cons("__ps$tail$state = [", (_root_.List.cons((psJsJoin(", ", printedArguments)), (_root_.List.cons("]; continue;", _root_.List.nil)))))))))
} } else { Option.none } } } else { match (psJsGeneratorTailValue(declaration.name, true, fuel, expr)) with {
  | Option.none => Option.none
  | Option.some printed => Option.some((psJsConcat3("return ", printed, ";")))
} }
  | _ => match (psJsGeneratorTailValue(declaration.name, true, fuel, expr)) with {
  | Option.none => Option.none
  | Option.some printed => Option.some((psJsConcat3("return ", printed, ";")))
}
}
  | PsJsIrExpr.letE name value body => if (psStringEq(name, declaration.name)) { Option.none } else { match (psJsGeneratorTailValue(declaration.name, false, remaining, value)) with {
  | Option.none => Option.none
  | Option.some printedValue => match (sameDepth(body)) with {
  | Option.none => Option.none
  | Option.some printedBody => let temp := (String.Internal.append("__ps$tail$value$", (psNatToString(remaining))))
if (available(temp)) { Option.some((psJsJoin("", (_root_.List.cons("{ const ", (_root_.List.cons(temp, (_root_.List.cons(" = ", (_root_.List.cons(printedValue, (_root_.List.cons("; { const ", (_root_.List.cons(name, (_root_.List.cons(" = ", (_root_.List.cons(temp, (_root_.List.cons("; ", (_root_.List.cons(printedBody, (_root_.List.cons(" } }", _root_.List.nil))))))))))))))))))))))))) } else { Option.none }
}
} }
  | PsJsIrExpr.ifE condition thenBranch elseBranch => match (psJsGeneratorTailValue(declaration.name, false, remaining, condition)) with {
  | Option.none => Option.none
  | Option.some printedCondition => match (sameDepth(thenBranch)) with {
  | Option.none => Option.none
  | Option.some printedThen => match (sameDepth(elseBranch)) with {
  | Option.none => Option.none
  | Option.some printedElse => Option.some((psJsJoin("", (_root_.List.cons("if (", (_root_.List.cons(printedCondition, (_root_.List.cons(") { ", (_root_.List.cons(printedThen, (_root_.List.cons(" } else { ", (_root_.List.cons(printedElse, (_root_.List.cons(" }", _root_.List.nil)))))))))))))))))
}
}
}
  | PsJsIrExpr.matchE scrutinee alternatives => match (psJsGeneratorTailValue(declaration.name, false, remaining, scrutinee)) with {
  | Option.none => Option.none
  | Option.some printedScrutinee => let temp : String := (psJsFreshTailMatchTemp(expr, matchDepth))
if (available(temp)) { match (psJsTailPrintAlternativesWith(nested, declaration.name, temp, alternatives)) with {
  | Option.none => Option.none
  | Option.some printedAlternatives => Option.some((psJsJoin("", (_root_.List.cons("const ", (_root_.List.cons(temp, (_root_.List.cons(" = ", (_root_.List.cons(printedScrutinee, (_root_.List.cons("; switch (", (_root_.List.cons(temp, (_root_.List.cons("[\"$ps$tag\"]) { ", (_root_.List.cons((psJsJoin(" ", printedAlternatives)), (_root_.List.cons(" } throw new Error(\"invalid ProofScript constructor tag\");", _root_.List.nil)))))))))))))))))))))
} } else { Option.none }
}
  | _ => match (psJsGeneratorTailValue(declaration.name, true, fuel, expr)) with {
  | Option.none => Option.none
  | Option.some printed => Option.some((psJsConcat3("return ", printed, ";")))
}
}
}

def psJsPrintGeneratorTailLoopWithVisibility(isPublic : Bool, declaration : PsJsIrDeclaration) : Option(String) := match declaration.parameters with {
  | List.nil => Option.none
  | List.cons _ _ => if (psJsNeedsCallDriver(declaration.body)) { let names := (psJsTailParameterNames(declaration.parameters))
let uses : (_ : PsJsIrExpr) -> (_ : String) -> Bool := (psJsExprUsesNameWithFuel(4096))
let available : (_ : String) -> Bool := (fun (name : String) => if (psStringEq(name, declaration.name)) { false } else { if (psJsTailContains(names, name)) { false } else { if (uses(declaration.body, name)) { false } else { true } } })
if (available("__ps$tail$state")) { match (psJsTailRewriteWithFuel(declaration, uses, available, 4096, names, _root_.List.nil, declaration.body)) with {
  | Option.none => Option.none
  | Option.some rewritten => match (psJsGeneratorTailEmitWithFuel(declaration, available, 4096, 0, rewritten)) with {
  | Option.none => Option.none
  | Option.some body => let parameters := (psJsJoin(", ", names))
let implementation := (psJsImplementationName(declaration.name))
Option.some((psJsJoin("", (_root_.List.cons((if (isPublic) { "export function " } else { "function " }), (_root_.List.cons(declaration.name, (_root_.List.cons("(", (_root_.List.cons(parameters, (_root_.List.cons(") { return __ps$run(", (_root_.List.cons(implementation, (_root_.List.cons("(", (_root_.List.cons(parameters, (_root_.List.cons(")); }\n", (_root_.List.cons("function* ", (_root_.List.cons(implementation, (_root_.List.cons("(", (_root_.List.cons(parameters, (_root_.List.cons(") { let __ps$tail$state = [", (_root_.List.cons(parameters, (_root_.List.cons("]; while (true) { const [", (_root_.List.cons(parameters, (_root_.List.cons("] = __ps$tail$state; ", (_root_.List.cons(body, (_root_.List.cons(" } }\n__ps$implementations.set(", (_root_.List.cons(declaration.name, (_root_.List.cons(", ", (_root_.List.cons(implementation, (_root_.List.cons(");\n", _root_.List.nil)))))))))))))))))))))))))))))))))))))))))))))))))))
}
} } else { Option.none } } else { Option.none }
}

-- Lazy view tokens never retain String/index arrays. This path is restricted to
-- pure self-tail loops whose indexed source parameters remain invariant.
def psJsViewLookup(views : List((_root_.Prod(String, String))), name : String) : Option(String) := match views with {
  | List.nil => Option.none
  | List.cons entry rest => if (psStringEq(entry.fst, name)) { Option.some(entry.snd) } else { psJsViewLookup(rest, name) }
}

def psJsViewWithout(views : List((_root_.Prod(String, String))), name : String) : List((_root_.Prod(String, String))) := match views with {
  | List.nil => _root_.List.nil
  | List.cons entry rest => if (psStringEq(entry.fst, name)) { psJsViewWithout(rest, name) } else { List.cons(entry, (psJsViewWithout(rest, name))) }
}

def psJsViewAlias(views : List((_root_.Prod(String, String))), name : String, value : PsJsIrExpr) : List((_root_.Prod(String, String))) := let remaining := (psJsViewWithout(views, name))
match value with {
  | PsJsIrExpr.var original => match (psJsViewLookup(views, original)) with {
  | Option.some getter => List.cons((Prod.mk(name, getter)), remaining)
  | Option.none => remaining
}
  | _ => remaining
}

def psJsViewMap {alpha : Type} {beta : Type}(f : (_ : alpha) -> Option(beta), values : List(alpha)) : Option((List(beta))) := match values with {
  | List.nil => Option.some(_root_.List.nil)
  | List.cons value rest => match (f(value)) with {
  | Option.none => Option.none
  | Option.some mapped => match (psJsViewMap(f, rest)) with {
  | Option.none => Option.none
  | Option.some others => Option.some((List.cons(mapped, others)))
}
}
}

def psJsViewAny(values : List((Option(Bool)))) : Option(Bool) := match values with {
  | List.nil => Option.some(false)
  | List.cons value rest => match value with {
  | Option.none => Option.none
  | Option.some used => match (psJsViewAny(rest)) with {
  | Option.none => Option.none
  | Option.some other => Option.some(((used || other)))
}
}
}

def psJsViewInspectWorker(self : String, source : String, index : Nat, fuel : Nat, aliases : List((_root_.Prod(String, String))), expr : PsJsIrExpr) : Option(Bool) := match fuel with {
  | Nat.zero => Option.none
  | Nat.succ remaining => let recur : (_ : PsJsIrExpr) -> Option(Bool) := (fun (value : PsJsIrExpr) => psJsViewInspectWorker(self, source, index, remaining, aliases, value))
let known : (_ : String) -> Bool := (fun (name : String) => match (psJsViewLookup(aliases, name)) with {
  | Option.some _ => true
  | Option.none => false
})
match expr with {
  | PsJsIrExpr.literal _ => Option.some(false)
  | PsJsIrExpr.var _ => Option.some(false)
  | PsJsIrExpr.unary _ value => recur(value)
  | PsJsIrExpr.projection value _ => recur(value)
  | PsJsIrExpr.binary _ left right => psJsViewAny((_root_.List.cons((recur(left)), (_root_.List.cons((recur(right)), _root_.List.nil)))))
  | PsJsIrExpr.runtime operation arguments => let indexed : Bool := (match operation with {
  | PsJsIrRuntimeOp.stringGet => true
  | PsJsIrRuntimeOp.stringNext => true
  | _ => false
})
let uses : Bool := (match arguments with {
  | List.cons first _ => match first with {
  | PsJsIrExpr.var name => (indexed && known(name))
  | _ => false
}
  | _ => false
})
psJsViewAny((List.cons((Option.some(uses)), (psListMap(recur, arguments)))))
  | PsJsIrExpr.lambda _ _ => Option.none
  | PsJsIrExpr.call fn arguments => match fn with {
  | PsJsIrExpr.var called => if (psStringEq(called, self)) { match (psJsTailDrop(index, arguments)) with {
  | List.cons first _ => match first with {
  | PsJsIrExpr.var name => if (known(name)) { psJsViewAny((psListMap(recur, arguments))) } else { Option.none }
  | _ => Option.none
}
  | _ => Option.none
} } else { Option.none }
  | _ => Option.none
}
  | PsJsIrExpr.letE name value body => if (psStringEq(name, source)) { Option.none } else { psJsViewAny((_root_.List.cons((recur(value)), (_root_.List.cons((psJsViewInspectWorker(self, source, index, remaining, (psJsViewAlias(aliases, name, value)), body)), _root_.List.nil))))) }
  | PsJsIrExpr.ifE condition left right => psJsViewAny((_root_.List.cons((recur(condition)), (_root_.List.cons((recur(left)), (_root_.List.cons((recur(right)), _root_.List.nil)))))))
  | PsJsIrExpr.record fields => psJsViewAny((psListMap((fun (field : Prod(String, PsJsIrExpr)) => recur(field.snd)), fields)))
  | PsJsIrExpr.constructor _ fields => psJsViewAny((psListMap((fun (field : Prod(String, PsJsIrExpr)) => recur(field.snd)), fields)))
  | PsJsIrExpr.matchE scrutinee alternatives => let alternative : (_ : Prod(String, (Prod((List(PsJsIrMatchBinding)), PsJsIrExpr)))) -> Option(Bool) := (fun (entry : _root_.Prod(String, (_root_.Prod((List(PsJsIrMatchBinding)), PsJsIrExpr)))) => if (psListAny((fun (binding : PsJsIrMatchBinding) => (known(binding.name) || psStringEq(binding.name, source))), entry.snd.fst)) { Option.none } else { recur(entry.snd.snd) })
psJsViewAny((List.cons((recur(scrutinee)), (psListMap(alternative, alternatives)))))
}
}

def psJsViewInspect(self : String, source : String, index : Nat, fuel : Nat) : (_ : List((_root_.Prod(String, String)))) -> (_ : PsJsIrExpr) -> Option(Bool) := fun (aliases : List((_root_.Prod(String, String)))) (expr : PsJsIrExpr) => psJsViewInspectWorker(self, source, index, fuel, aliases, expr)

def psJsViewName(index : Nat) : String := psJsJoin("", (_root_.List.cons("__ps$view$", (_root_.List.cons((psNatToString(index)), _root_.List.nil)))))

def psJsViewTokenName(index : Nat) : String := psJsJoin("", (_root_.List.cons("__ps$viewToken$", (_root_.List.cons((psNatToString(index)), _root_.List.nil)))))

def psJsViewPositionName : String := "__ps$view$position"

def psJsViewSelect(declaration : PsJsIrDeclaration, body : PsJsIrExpr, parameters : List(PsJsIrParameter), index : Nat, count : Nat) : Option((List((_root_.Prod(String, String))))) := match parameters with {
  | List.nil => Option.some(List.nil)
  | List.cons parameter rest => match (psJsViewInspect(declaration.name, parameter.name, index, 4096, (_root_.List.cons((Prod.mk(parameter.name, "view")), _root_.List.nil)), body)) with {
  | Option.some used => if (used) { if (Nat.blt(count, 2)) { match (psJsViewSelect(declaration, body, rest, (Nat.succ(index)), (Nat.succ(count)))) with {
  | Option.none => Option.none
  | Option.some others => Option.some((List.cons((Prod.mk(parameter.name, (psJsViewName(count)))), others)))
} } else { Option.none } } else { psJsViewSelect(declaration, body, rest, (Nat.succ(index)), count) }
  | Option.none => psJsViewSelect(declaration, body, rest, (Nat.succ(index)), count)
}
}

-- Preserve position evaluation before the lazy cache lookup.
def psJsViewIntrinsic(views : List((_root_.Prod(String, String))), operation : PsJsIrRuntimeOp, arguments : List(PsJsIrExpr)) : PsJsIrExpr := let ordinary := (PsJsIrExpr.runtime(operation, arguments))
match arguments with {
  | List.cons first rest => match first with {
  | PsJsIrExpr.var name => match (psJsViewLookup(views, name)) with {
  | Option.none => ordinary
  | Option.some getter => let view := (PsJsIrExpr.call((PsJsIrExpr.var(getter)), _root_.List.nil))
match operation with {
  | PsJsIrRuntimeOp.stringUtf8ByteSize => if (psListIsEmpty(rest)) { PsJsIrExpr.projection(view, "size") } else { ordinary }
  | _ => match rest with {
  | List.cons position tail => if (psListIsEmpty(tail)) { let p := (PsJsIrExpr.var(psJsViewPositionName))
let value : Option(PsJsIrExpr) := (match operation with {
  | PsJsIrRuntimeOp.stringGet => Option.some((PsJsIrExpr.call((PsJsIrExpr.var("__ps$stringGetView")), (_root_.List.cons(view, (_root_.List.cons(p, _root_.List.nil)))))))
  | PsJsIrRuntimeOp.stringNext => Option.some((PsJsIrExpr.call((PsJsIrExpr.var("__ps$stringNextView")), (_root_.List.cons(view, (_root_.List.cons(p, _root_.List.nil)))))))
  | PsJsIrRuntimeOp.stringAtEnd => Option.some((PsJsIrExpr.binary(PsJsIrBinaryOp.bigintLe, (PsJsIrExpr.projection(view, "size")), p)))
  | _ => Option.none
})
match value with {
  | Option.none => ordinary
  | Option.some body => PsJsIrExpr.call((PsJsIrExpr.lambda((_root_.List.cons(psJsViewPositionName, _root_.List.nil)), body)), (_root_.List.cons(position, _root_.List.nil)))
} } else { ordinary }
  | _ => ordinary
}
}
}
  | _ => ordinary
}
  | _ => ordinary
}

def psJsViewMapOne {alpha : Type} {beta : Type}(convert : (_ : alpha) -> beta, value : Option(alpha)) : Option(beta) := match value with {
  | Option.none => Option.none
  | Option.some x => Option.some((convert(x)))
}

def psJsViewMapTwo {alpha : Type} {beta : Type} {gamma : Type}(convert : (_ : alpha) -> (_ : beta) -> gamma, left : Option(alpha), right : Option(beta)) : Option(gamma) := match left with {
  | Option.none => Option.none
  | Option.some a => match right with {
  | Option.none => Option.none
  | Option.some b => Option.some((convert(a, b)))
}
}

def psJsViewRewriteWorker(fuel : Nat, views : List((_root_.Prod(String, String))), expr : PsJsIrExpr) : Option(PsJsIrExpr) := match fuel with {
  | Nat.zero => Option.none
  | Nat.succ remaining => let recur : (_ : PsJsIrExpr) -> Option(PsJsIrExpr) := (fun (value : PsJsIrExpr) => psJsViewRewriteWorker(remaining, views, value))
match expr with {
  | PsJsIrExpr.literal _ => Option.some(expr)
  | PsJsIrExpr.var _ => Option.some(expr)
  | PsJsIrExpr.unary operation value => psJsViewMapOne((PsJsIrExpr.unary(operation)), (recur(value)))
  | PsJsIrExpr.projection value field => psJsViewMapOne((fun (target : PsJsIrExpr) => PsJsIrExpr.projection(target, field)), (recur(value)))
  | PsJsIrExpr.binary operation left right => psJsViewMapTwo((PsJsIrExpr.binary(operation)), (recur(left)), (recur(right)))
  | PsJsIrExpr.runtime operation arguments => psJsViewMapOne((psJsViewIntrinsic(views, operation)), (psJsViewMap(recur, arguments)))
  | PsJsIrExpr.lambda _ _ => Option.none
  | PsJsIrExpr.call fn arguments => psJsViewMapTwo(PsJsIrExpr.call, (recur(fn)), (psJsViewMap(recur, arguments)))
  | PsJsIrExpr.letE name value body => psJsViewMapTwo((PsJsIrExpr.letE(name)), (recur(value)), (psJsViewRewriteWorker(remaining, (psJsViewAlias(views, name, value)), body)))
  | PsJsIrExpr.ifE condition left right => match (recur(condition)) with {
  | Option.none => Option.none
  | Option.some c => psJsViewMapTwo((PsJsIrExpr.ifE(c)), (recur(left)), (recur(right)))
}
  | PsJsIrExpr.record fields => let field : (_ : Prod(String, PsJsIrExpr)) -> Option((Prod(String, PsJsIrExpr))) := (fun (entry : _root_.Prod(String, PsJsIrExpr)) => psJsViewMapOne((fun (value : PsJsIrExpr) => Prod.mk(entry.fst, value)), (recur(entry.snd))))
psJsViewMapOne(PsJsIrExpr.record, (psJsViewMap(field, fields)))
  | PsJsIrExpr.constructor name fields => let field : (_ : Prod(String, PsJsIrExpr)) -> Option((Prod(String, PsJsIrExpr))) := (fun (entry : _root_.Prod(String, PsJsIrExpr)) => psJsViewMapOne((fun (value : PsJsIrExpr) => Prod.mk(entry.fst, value)), (recur(entry.snd))))
psJsViewMapOne((PsJsIrExpr.constructor(name)), (psJsViewMap(field, fields)))
  | PsJsIrExpr.matchE scrutinee alternatives => let alternative : (_ : Prod(String, (Prod((List(PsJsIrMatchBinding)), PsJsIrExpr)))) -> Option((Prod(String, (Prod((List(PsJsIrMatchBinding)), PsJsIrExpr))))) := (fun (entry : _root_.Prod(String, (_root_.Prod((List(PsJsIrMatchBinding)), PsJsIrExpr)))) => psJsViewMapOne((fun (body : PsJsIrExpr) => Prod.mk(entry.fst, (Prod.mk(entry.snd.fst, body)))), (recur(entry.snd.snd))))
psJsViewMapTwo(PsJsIrExpr.matchE, (recur(scrutinee)), (psJsViewMap(alternative, alternatives)))
}
}

def psJsViewRewrite(fuel : Nat) : (_ : List((_root_.Prod(String, String)))) -> (_ : PsJsIrExpr) -> Option(PsJsIrExpr) := fun (views : List((_root_.Prod(String, String)))) (expr : PsJsIrExpr) => psJsViewRewriteWorker(fuel, views, expr)

def psJsViewFresh(available : (_ : String) -> Bool, count : Nat) : Bool := match count with {
  | Nat.zero => available(psJsViewPositionName)
  | Nat.succ remaining => ((available((psJsViewName(remaining))) && available((psJsViewTokenName(remaining)))) && psJsViewFresh(available, remaining))
}

def psJsViewPrelude(views : List((_root_.Prod(String, String))), index : Nat) : String := match views with {
  | List.nil => ""
  | List.cons entry rest => let token := (psJsViewTokenName(index))
psJsJoin("", (_root_.List.cons("let ", (_root_.List.cons(token, (_root_.List.cons("; const ", (_root_.List.cons(entry.snd, (_root_.List.cons(" = () => ((view) => { ", (_root_.List.cons(token, (_root_.List.cons(" = view.token; return view; })(__ps$utf8Known(", (_root_.List.cons(entry.fst, (_root_.List.cons(", ", (_root_.List.cons(token, (_root_.List.cons(")); ", (_root_.List.cons((psJsViewPrelude(rest, (Nat.succ(index)))), _root_.List.nil)))))))))))))))))))))))))
}

def psJsViewLoopBody(declaration : PsJsIrDeclaration, available : (_ : String) -> Bool, body : PsJsIrExpr) : Option((_root_.Prod(String, String))) := match (psJsViewSelect(declaration, body, declaration.parameters, 0, 0)) with {
  | Option.none => Option.none
  | Option.some views => if (psListIsEmpty(views)) { Option.none } else { if (psJsViewFresh(available, (psListLength(views)))) { match (psJsViewRewrite(4096, views, body)) with {
  | Option.none => Option.none
  | Option.some rewritten => match (psJsTailEmitWithFuel(declaration, available, 4096, 0, rewritten)) with {
  | Option.none => Option.none
  | Option.some printed => Option.some((Prod.mk((psJsViewPrelude(views, 0)), printed)))
}
} } else { Option.none } }
}

def psJsPrintTailLoopWithVisibility(isPublic : Bool, declaration : PsJsIrDeclaration) : Option(String) := match declaration.parameters with {
  | List.nil => Option.none
  | List.cons _ _ => let names := (psJsTailParameterNames(declaration.parameters))
let uses : (_ : PsJsIrExpr) -> (_ : String) -> Bool := (psJsExprUsesNameWithFuel(4096))
let available : (_ : String) -> Bool := (fun (name : String) => if (psStringEq(name, declaration.name)) { false } else { if (psJsTailContains(names, name)) { false } else { if (uses(declaration.body, name)) { false } else { true } } })
if ((uses(declaration.body, declaration.name) && psJsCallsUseOnlySelfWithFuel(declaration.name, 4096, declaration.body))) { if (available("__ps$tail$state")) { match (psJsTailRewriteWithFuel(declaration, uses, available, 4096, names, List.nil, declaration.body)) with {
  | Option.none => Option.none
  | Option.some rewritten => let viewBody := (psJsViewLoopBody(declaration, available, rewritten))
let emitted : Option((Prod(String, String))) := (match viewBody with {
  | Option.some pair => Option.some(pair)
  | Option.none => match (psJsTailEmitWithFuel(declaration, available, 4096, 0, rewritten)) with {
  | Option.none => Option.none
  | Option.some printed => Option.some((Prod.mk("", printed)))
}
})
match emitted with {
  | Option.none => Option.none
  | Option.some pair => let parameters := (psJsJoin(", ", names))
Option.some((psJsJoin("", (_root_.List.cons((if (isPublic) { "export function " } else { "function " }), (_root_.List.cons(declaration.name, (_root_.List.cons("(", (_root_.List.cons(parameters, (_root_.List.cons(") { ", (_root_.List.cons(pair.fst, (_root_.List.cons("let __ps$tail$state = [", (_root_.List.cons(parameters, (_root_.List.cons("]; while (true) { const [", (_root_.List.cons(parameters, (_root_.List.cons("] = __ps$tail$state; ", (_root_.List.cons(pair.snd, (_root_.List.cons(" } }\n", _root_.List.nil)))))))))))))))))))))))))))))
}
} } else { Option.none } } else { Option.none }
}

def psJsPrintTailLoop(declaration : PsJsIrDeclaration) : Option(String) := psJsPrintTailLoopWithVisibility(true, declaration)

def psJsPrintDeclarationStackSafeWithVisibility(isPublic : Bool, declaration : PsJsIrDeclaration) : Except(PsJsEmitError, String) := match (psJsPrintTailLoopWithVisibility(isPublic, declaration)) with {
  | Option.some printed => Except.ok(printed)
  | Option.none => match (psJsPrintGeneratorTailLoopWithVisibility(isPublic, declaration)) with {
  | Option.some printed => Except.ok(printed)
  | Option.none => if (psJsNeedsCallDriver(declaration.body)) { match (psJsPrintExprStackSafe(declaration.name, declaration.body)) with {
  | Except.error error => Except.error(error)
  | Except.ok body => match declaration.parameters with {
  | List.nil => Except.ok((psJsJoin("", (_root_.List.cons((if (isPublic) { "export const " } else { "const " }), (_root_.List.cons(declaration.name, (_root_.List.cons(" = __ps$run((function*() { return ", (_root_.List.cons(body, (_root_.List.cons("; })());\n", _root_.List.nil)))))))))))))
  | List.cons _ _ => let parameters := (psListMap(psJsParameterName, declaration.parameters))
let joinedParameters : String := (psJsJoin(", ", parameters))
let implementation : String := (psJsImplementationName(declaration.name))
Except.ok((psJsJoin("", (_root_.List.cons((if (isPublic) { "export function " } else { "function " }), (_root_.List.cons(declaration.name, (_root_.List.cons("(", (_root_.List.cons(joinedParameters, (_root_.List.cons(") { return __ps$run(", (_root_.List.cons(implementation, (_root_.List.cons("(", (_root_.List.cons(joinedParameters, (_root_.List.cons(")); }\n", (_root_.List.cons("function* ", (_root_.List.cons(implementation, (_root_.List.cons("(", (_root_.List.cons(joinedParameters, (_root_.List.cons(") { return ", (_root_.List.cons(body, (_root_.List.cons("; }\n", (_root_.List.cons("__ps$implementations.set(", (_root_.List.cons(declaration.name, (_root_.List.cons(", ", (_root_.List.cons(implementation, (_root_.List.cons(");\n", _root_.List.nil)))))))))))))))))))))))))))))))))))))))))))))
}
} } else { psJsPrintDeclarationWithVisibility(isPublic, declaration) }
}
}

def psJsPrintDeclarationStackSafe(declaration : PsJsIrDeclaration) : Except(PsJsEmitError, String) := psJsPrintDeclarationStackSafeWithVisibility(true, declaration)

def psJsPrintDeclarationsStackSafe(declarations : List(PsJsIrDeclaration)) : Except(PsJsEmitError, String) := psJsPrintDeclarationsWith(psJsPrintDeclarationStackSafe, declarations, psTextBuilderEmpty)

/-- The direct printer's two helper groups are selected from structured JsIR. -/
partial def psJsNeedsUtf8Runtime(expression : PsJsIrExpr) : Bool := match expression with {
  | PsJsIrExpr.literal _ => false
  | PsJsIrExpr.var _ => false
  | PsJsIrExpr.unary _ value => psJsNeedsUtf8Runtime(value)
  | PsJsIrExpr.projection value _ => psJsNeedsUtf8Runtime(value)
  | PsJsIrExpr.binary _ left right => (psJsNeedsUtf8Runtime(left) || psJsNeedsUtf8Runtime(right))
  | PsJsIrExpr.letE _ left right => (psJsNeedsUtf8Runtime(left) || psJsNeedsUtf8Runtime(right))
  | PsJsIrExpr.runtime operation arguments => let needsOperation : Bool := (match operation with {
  | PsJsIrRuntimeOp.stringUtf8ByteSize => true
  | PsJsIrRuntimeOp.stringNext => true
  | PsJsIrRuntimeOp.stringGet => true
  | PsJsIrRuntimeOp.stringAtEnd => true
  | PsJsIrRuntimeOp.stringExtract => true
  | _ => false
})
(needsOperation || psListAny(psJsNeedsUtf8Runtime, arguments))
  | PsJsIrExpr.lambda _ body => psJsNeedsUtf8Runtime(body)
  | PsJsIrExpr.call fn arguments => (psJsNeedsUtf8Runtime(fn) || psListAny(psJsNeedsUtf8Runtime, arguments))
  | PsJsIrExpr.ifE condition left right => ((psJsNeedsUtf8Runtime(condition) || psJsNeedsUtf8Runtime(left)) || psJsNeedsUtf8Runtime(right))
  | PsJsIrExpr.record fields => psListAny((fun (field : Prod(String, PsJsIrExpr)) => psJsNeedsUtf8Runtime(field.snd)), fields)
  | PsJsIrExpr.constructor _ fields => psListAny((fun (field : Prod(String, PsJsIrExpr)) => psJsNeedsUtf8Runtime(field.snd)), fields)
  | PsJsIrExpr.matchE scrutinee alternatives => (psJsNeedsUtf8Runtime(scrutinee) || psListAny((fun (alternative : Prod(String, (Prod((List(PsJsIrMatchBinding)), PsJsIrExpr)))) => psJsNeedsUtf8Runtime(alternative.snd.snd)), alternatives))
}

def psJsNeedsStackRuntime(declaration : PsJsIrDeclaration) : Bool := match (psJsPrintTailLoop(declaration)) with {
  | some _ => false
  | none => psJsNeedsCallDriver(declaration.body)
}

def psJsModuleNeedsUtf8Runtime(module : PsJsIrModule) : Bool := psListAny((fun (declaration : PsJsIrDeclaration) => psJsNeedsUtf8Runtime(declaration.body)), module.declarations)

def psJsSelectedRuntimeRequirements(module : PsJsIrModule) : List(String) := let stack : List(String) := (if (psListAny(psJsNeedsStackRuntime, module.declarations)) { _root_.List.cons("generator-stack", _root_.List.nil) } else { _root_.List.nil })
let utf8 : List(String) := (if (psJsModuleNeedsUtf8Runtime(module)) { _root_.List.cons("utf8-byte-index", _root_.List.nil) } else { _root_.List.nil })
psListAppend(stack, utf8)

def psJsSelectedRuntimeSource(module : PsJsIrModule) : String := let utf8 : String := (if (psJsModuleNeedsUtf8Runtime(module)) { psJsStringRuntimeSupport } else { "" })
let stack : String := (if (psListAny(psJsNeedsStackRuntime, module.declarations)) { psJsStackRuntimeSupport } else { "" })
String.Internal.append(utf8, stack)

def psJsPrintStackSafePrelude(module : PsJsIrModule) : String := psJsJoin("", (_root_.List.cons("// generated by ProofScript direct JsIR v1 stack-safe\n", (_root_.List.cons((psJsPrintImports(module.imports)), (_root_.List.cons((psJsSelectedRuntimeSource(module)), _root_.List.nil)))))))

def psJsPrintModuleStackSafeWithPositions(module : PsJsIrModule) : Except(PsJsEmitError, PsJsPrintedModule) := let prelude : String := (psJsPrintStackSafePrelude(module))
match (psJsAdvanceGeneratedText(psJsGeneratedPositionZero, prelude)) with {
  | Except.error error => Except.error(error)
  | Except.ok position => psJsPrintDeclarationsObservedWith(psJsPrintDeclarationStackSafe, module.declarations, true, (psTextBuilderAppend(psTextBuilderEmpty, prelude)), position, List.nil)
}

def psJsPrintModuleStackSafe(module : PsJsIrModule) : Except(PsJsEmitError, String) := match (psJsPrintDeclarationsStackSafe(module.declarations)) with {
  | Except.error error => Except.error(error)
  | Except.ok declarations => Except.ok((psJsConcat2((psJsPrintStackSafePrelude(module)), declarations)))
}

def psJsPrintModule(module : PsJsIrModule) : Except(PsJsEmitError, String) := match (psJsPrintDeclarations(module.declarations)) with {
  | Except.error error => Except.error(error)
  | Except.ok declarations => let imports : String := (psJsPrintImports(module.imports))
Except.ok((psJsJoin("", (_root_.List.cons("// generated by ProofScript direct JsIR v1\n", (_root_.List.cons(imports, (_root_.List.cons(psJsStringRuntimeSupport, (_root_.List.cons(declarations, _root_.List.nil)))))))))))
}

def psJsEmitValidatedModuleStackSafeWithTargetProfile(profile : PsJsTargetProfile, module : PsValidatedIrModule) : Except(PsJsEmitError, String) := match (psJsLowerValidatedModuleWithTargetProfile(profile, module)) with {
  | Except.error error => Except.error((PsJsEmitError.lower(error)))
  | Except.ok jsIr => match (psJsValidateModule(jsIr)) with {
  | Except.error error => Except.error((PsJsEmitError.targetValidation(error)))
  | Except.ok _ => psJsPrintModuleStackSafe(jsIr)
}
}

def psJsEmitValidatedModuleWithTargetProfile(profile : PsJsTargetProfile, module : PsValidatedIrModule) : Except(PsJsEmitError, String) := match (psJsLowerValidatedModuleWithTargetProfile(profile, module)) with {
  | Except.error error => Except.error((PsJsEmitError.lower(error)))
  | Except.ok jsIr => match (psJsValidateModule(jsIr)) with {
  | Except.error error => Except.error((PsJsEmitError.targetValidation(error)))
  | Except.ok _ => psJsPrintModule(jsIr)
}
}

def psJsEmitValidatedModule(module : PsValidatedIrModule) : Except(PsJsEmitError, String) := match (psJsLowerValidatedModule(module)) with {
  | Except.error error => Except.error((PsJsEmitError.lower(error)))
  | Except.ok jsIr => match (psJsValidateModule(jsIr)) with {
  | Except.error error => Except.error((PsJsEmitError.targetValidation(error)))
  | Except.ok _ => psJsPrintModule(jsIr)
}
}

-- Observe the same normal-printer bytes used for DirectJS emission.
-- Source maps must be built from these positions, not from a second
-- best-effort scan of generated text.
def psJsPrintModuleWithPositions(module : PsJsIrModule) : Except(PsJsEmitError, PsJsPrintedModule) := let prelude : String := (psJsJoin("", (_root_.List.cons("// generated by ProofScript direct JsIR v1\n", (_root_.List.cons((psJsPrintImports(module.imports)), (_root_.List.cons(psJsStringRuntimeSupport, _root_.List.nil))))))))
match (psJsAdvanceGeneratedText(psJsGeneratedPositionZero, prelude)) with {
  | Except.error error => Except.error(error)
  | Except.ok position => psJsPrintDeclarationsObservedWith(psJsPrintDeclaration, module.declarations, true, (psTextBuilderAppend(psTextBuilderEmpty, prelude)), position, List.nil)
}

def psJsEmitValidatedModuleWithPositions(module : PsValidatedIrModule) : Except(PsJsEmitError, PsJsPrintedModule) := match (psJsLowerValidatedModule(module)) with {
  | Except.error error => Except.error((PsJsEmitError.lower(error)))
  | Except.ok ir => match (psJsValidateModule(ir)) with {
  | Except.error error => Except.error((PsJsEmitError.targetValidation(error)))
  | Except.ok validated => psJsPrintModuleWithPositions(ir)
}
}
