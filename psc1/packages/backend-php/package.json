{
  "name": "@proofscript/backend-php",
  "version": "0.1.0-psc1.13",
  "private": false,
  "description": "ProofScript PSC1 backend-php: source package and shared compiler API adapter",
  "proofscript": {
    "npmArchitecture": "psc1-existing-packages-shared-root/1",
    "implementationOwner": "@proofscript/compiler",
    "internalCompilerModules": false,
    "packageKind": "shared-backend-adapter",
    "canonicalSources": "src/**/*.ps",
    "sourceVariants": [
      "ps",
      "lean"
    ],
    "publishingRequiresQualification": true,
    "schema": "psc1-checked-dispatch-package/1",
    "target": "php",
    "sourceCommit": "7e63615b0d0713db8b252f194d5740bbb5c5893f",
    "authority": "candidate-only",
    "compilerFrontend": false,
    "admissionAuthority": false,
    "publicationAuthority": false,
    "compilerInputGrammars": [
      "lean",
      "ps"
    ],
    "canonicalGrammar": "ps",
    "sourceOwnership": {
      "role": "canonical-editable-proofscript",
      "manifest": "dist/source-manifest.json",
      "repositoryManifest": "psc1/CANONICAL_SOURCES.json"
    },
    "bootstrapReferences": {
      "grammar": "lean",
      "role": "immutable-checked-bootstrap-reference",
      "manifest": "dist/source-manifest.json"
    }
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwijayuda/pskernel.git",
    "directory": "psc1/packages/backend-php"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs build --package backend-php",
    "clean": "node ../../scripts/build-packages.mjs clean --package backend-php"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./sources": "./dist/source-manifest.json",
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.js"
    }
  },
  "dependencies": {
    "@proofscript/compiler": "0.1.0-psc1.13"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ]
}
