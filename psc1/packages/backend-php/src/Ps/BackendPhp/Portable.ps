  (line((cat((_root_.List.cons((quote(name)), (_root_.List.cons(" => ", (_root_.List.cons(symbol, (_root_.List.cons((if (psBackendNameSeen(name, context.valueNames)) { "()" } else { "" }), (_root_.List.cons(",", _root_.List.nil)))))))))))), state))
