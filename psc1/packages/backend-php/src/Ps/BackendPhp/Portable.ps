namespace PsPhp
def emitParameterFor(nodes : Bool, parameter : PsVerifiedIrParameter) : Emit(ParameterInfo) := psBackendStateBind((psBackendStateLift((typeTextWithCarrier(nodes, 4096, parameter.type)))), (fun (text : String) => psBackendStateBind((fresh(parameter.name)), (fun (name : String) => psBackendStatePure((ParameterInfo.mk(parameter.name, name, text, parameter.type)))))))
