end PsPhp

namespace PsPhp
def emitModule(module : PsVerifiedIrModule, context : Context, publicNames : List(String)) : Emit((List((Prod(String, Nat))))) := fun (state : EmitState) => do {
  let _psc_step_119 <- (psBackendSourceForState(emitGlobal, context.globals, state))
  let state := _psc_step_119.snd
  let blank : Emit(Unit) := (if (psListIsEmpty(context.globals)) { psBackendStatePure(Unit.unit) } else { line("") })
  let _psc_step_120 <- (blank(state))
  let state := _psc_step_120.snd
  let _psc_step_121 <- (psBackendSourceMapState((fun (declaration : PsVerifiedIrDeclaration) => psBackendStateBind((emitDeclaration(context, declaration)), (fun (position : Nat) => psBackendStatePure((Prod.mk(declaration.name, position)))))), module.declarations, state))
  let positions := _psc_step_121.fst
  let state := _psc_step_121.snd
  let _psc_step_122 <- (line("return [", state))
  let state := _psc_step_122.snd
  let _psc_step_123 <- (indent(true, state))
  let state := _psc_step_123.snd
  let _psc_step_124 <- (psBackendSourceForState((emitPublic(context)), publicNames, state))
  let state := _psc_step_124.snd
  let _psc_step_125 <- (indent(false, state))
  let state := _psc_step_125.snd
  let _psc_step_126 <- (line("];", state))
  let state := _psc_step_126.snd
  let _psc_step_127 <- (indent(false, state))
  let state := _psc_step_127.snd
  let _psc_step_128 <- (line("})();", state))
  let state := _psc_step_128.snd
  (Except.ok((Prod.mk(positions, state))))
}
end PsPhp

namespace PsPhp
def withoutNodeRequirements(requirements : List(String)) : List(String) := match requirements with {
  | List.nil => List.nil
  | List.cons helper rest => if (psStringEq(helper, "nodes")) { withoutNodeRequirements(rest) } else { List.cons(helper, (withoutNodeRequirements(rest))) }
}
end PsPhp

def psPhpEmitModuleWithIoAndOptimizations(validated : PsValidatedIrModule, publicNames : List(String), ioAbi : Bool, preciseCaptures : Bool, flatConstructors : Bool, directCalls : Bool, directSlots : Bool) : Except(String, PsPhpPortableModule) := do {
  (match (psStrictValidateModule(validated.raw)) with {
  | Except.error _ => Except.error("PSC1_PHP_IR_VALIDATION_FAILED")
  | Except.ok _ => Except.ok(Unit.unit)
})
  let module : PsVerifiedIrModule := validated.raw
  if ((!psListIsEmpty(module.imports))) {
  (Except.error("PSC1_PHP_EXTERNAL_IMPORT_UNSUPPORTED"))
}
  (psBackendSourceForExcept(PsPhp.checkDeclaration, module.declarations))
  (psBackendSourceForExcept(PsPhp.checkStructure, module.structures))
  (psBackendSourceForExcept(PsPhp.checkInductive, module.inductives))
  (PsPhp.checkPublics(module, ioAbi, publicNames, List.nil))
  let valueNames : List(String) := (PsPhp.valueNamesAcc(module.declarations, List.nil))
  let requested : List(String) := (psBackendSourceFlatMap((fun (declaration : PsVerifiedIrDeclaration) => psListAppend((PsPhp.typeRequirements(4096, declaration.resultType)), (psListAppend((psBackendSourceFlatMap((fun (parameter : PsVerifiedIrParameter) => PsPhp.typeRequirements(4096, parameter.type)), declaration.parameters)), (PsPhp.exprRequirements(valueNames, 4096, (psListMap((fun (parameter : PsVerifiedIrParameter) => parameter.name), declaration.parameters)), declaration.body)))))), module.declarations))
  let requirements : List(String) := (psPhpRuntimeClosureWithExtractionPolicy((if (flatConstructors) { requested } else { PsPhp.withoutNodeRequirements(requested) }), flatConstructors))
  let runtimeSource : String := (psPhpSelectedRuntimeSourceWithExtractionPolicy(requirements, flatConstructors))
  let globals : List((Prod(String, String))) := (psListMap(PsPhp.globalEntry, (psBackendSourceZipIndex(module.declarations))))
  let context : PsPhp.Context := (PsPhp.Context.mk(globals, valueNames, List.nil, (psPhpRuntimeVariables(requirements)), (psBackendNameSeen("calls", requirements)), preciseCaptures, flatConstructors, module.inductives, (if ((flatConstructors && directCalls)) { psBackendDirectCallNames(module.declarations) } else { PsStringSet.empty }), directSlots))
  let sourcePrefix : String := (PsPhp.cat((_root_.List.cons("<?php\n", (_root_.List.cons("// Generated by ProofScript PSC1 DirectPHP. Public API: return value of require.\n", (_root_.List.cons("declare(strict_types=1);\n\nreturn (static function (): array {\n", (_root_.List.cons(runtimeSource, _root_.List.nil))))))))))
  let initial : PsPhp.EmitState := (PsPhp.EmitState.mk(List.nil, (PsPhp.countNewlines((psJsonStringToChars(sourcePrefix)), 0)), 0, 1))
  let _psc_step_129 <- (PsPhp.emitModule(module, context, publicNames, initial))
  let positions := _psc_step_129.fst
  let state := _psc_step_129.snd
  let composer : String := (PsPhp.cat((_root_.List.cons("{\n  \"type\": \"library\",\n  \"require\": {\n    \"php\": \">=8.5\"", (_root_.List.cons((if (psBackendNameSeen("gmp", requirements)) { ",\n    \"ext-gmp\": \"*\"" } else { "" }), (_root_.List.cons("\n  }\n}\n", _root_.List.nil))))))))
  (Except.ok((PsPhpPortableModule.mk((PsPhp.cat((_root_.List.cons(sourcePrefix, (_root_.List.cons((psTextJoin("\n", (psListReverse(state.linesRev)))), (_root_.List.cons("\n", _root_.List.nil)))))))), composer, runtimeSource, psPhpRuntimeVersion, requirements, globals, positions))))
}

-- Retained indexed-node access remains a policy of this same emitter.
def psPhpEmitModuleWithIoAndPoliciesAndDirectCalls(validated : PsValidatedIrModule, publicNames : List(String), ioAbi : Bool, preciseCaptures : Bool, flatConstructors : Bool, directCalls : Bool) : Except(String, PsPhpPortableModule) := psPhpEmitModuleWithIoAndOptimizations(validated, publicNames, ioAbi, preciseCaptures, flatConstructors, directCalls, true)

-- Independent retained scheduler policy supports exact differential tests.
def psPhpEmitModuleWithIoAndPolicies(validated : PsValidatedIrModule, publicNames : List(String), ioAbi : Bool, preciseCaptures : Bool, flatConstructors : Bool) : Except(String, PsPhpPortableModule) := psPhpEmitModuleWithIoAndPoliciesAndDirectCalls(validated, publicNames, ioAbi, preciseCaptures, flatConstructors, true)

-- Retained layout is a testable policy of the same emitter, not another compiler.
def psPhpEmitModuleWithIoAndCapturePolicy(validated : PsValidatedIrModule, publicNames : List(String), ioAbi : Bool, preciseCaptures : Bool) : Except(String, PsPhpPortableModule) := psPhpEmitModuleWithIoAndPolicies(validated, publicNames, ioAbi, preciseCaptures, false)

-- Native compatibility and generated service use the same optimized emitter.
def psPhpEmitModuleWithIo(validated : PsValidatedIrModule, publicNames : List(String), ioAbi : Bool) : Except(String, PsPhpPortableModule) := psPhpEmitModuleWithIoAndPolicies(validated, publicNames, ioAbi, true, true)
