import Ps.CompilerIr.Validate
import Ps.Bridge.Json
import Ps.BackendPhp.Runtime
import Ps.BackendCommon.Plan
import Ps.BackendCommon.Source
import Ps.BackendCommon.DirectCalls

structure PsPhpPortableModule where {
  source : String
  composer : String
  runtimeSource : String
  runtimeVersion : String
  runtimeRequirements : List(String)
  declarations : List((Prod(String, String)))
  declarationLines : List((Prod(String, Nat)))
}

namespace PsPhp
def cat(parts : List(String)) : String := psTextJoin("", parts)
end PsPhp

namespace PsPhp
def decimal(value : Nat) : String := Int.repr((Int.ofNat(value)))
end PsPhp

namespace PsPhp
def quoteAcc(chars : List(Char), builder : PsTextBuilder) : String := match chars with {
  | List.nil => cat((_root_.List.cons((psTextBuilderFinish(builder)), (_root_.List.cons("\"", _root_.List.nil)))))
  | List.cons char rest => let code : Nat := (Char.toNat(char))
let text : String := (if (Nat.beq(code, 92)) { "\\\\" } else { if (Nat.beq(code, 34)) { "\\\"" } else { if (Nat.beq(code, 36)) { "\\$" } else { if (Nat.beq(code, 10)) { "\\n" } else { if (Nat.beq(code, 13)) { "\\r" } else { if (Nat.beq(code, 9)) { "\\t" } else { if (Nat.blt(code, 32)) { cat((_root_.List.cons("\\x", (_root_.List.cons((psJsonHexDigit((Nat.div(code, 16)))), (_root_.List.cons((psJsonHexDigit((Nat.mod(code, 16)))), _root_.List.nil))))))) } else { String.singleton(char) } } } } } } })
quoteAcc(rest, (psTextBuilderAppend(builder, text)))
}
end PsPhp

namespace PsPhp
def quote(value : String) : String := quoteAcc((psJsonStringToChars(value)), (psTextBuilderAppend(psTextBuilderEmpty, "\"")))
end PsPhp

namespace PsPhp
def asciiLetter(code : Nat) : Bool := ((Nat.ble(65, code) && Nat.ble(code, 90)) || (Nat.ble(97, code) && Nat.ble(code, 122)))
end PsPhp

namespace PsPhp
def asciiDigit(code : Nat) : Bool := (Nat.ble(48, code) && Nat.ble(code, 57))
end PsPhp

namespace PsPhp
def stemAcc(chars : List(Char), builder : PsTextBuilder) : String := match chars with {
  | List.nil => psTextBuilderFinish(builder)
  | List.cons char rest => let code : Nat := (Char.toNat(char))
let text : String := (if (((asciiLetter(code) || asciiDigit(code)) || Nat.beq(code, 95))) { String.singleton(char) } else { cat((_root_.List.cons("_u", (_root_.List.cons((decimal(code)), (_root_.List.cons("_", _root_.List.nil))))))) })
stemAcc(rest, (psTextBuilderAppend(builder, text)))
}
end PsPhp

namespace PsPhp
def stem(value : String) : String := stemAcc((psJsonStringToChars(value)), psTextBuilderEmpty)
end PsPhp

namespace PsPhp
def typeTextWithCarrier(nodes : Bool, fuel : Nat) : (_ : PsVerifiedIrType) -> Except(String, String) := match fuel with {
  | Nat.zero => fun (_type : PsVerifiedIrType) => Except.error("PSC1_PHP_TYPE_BUDGET")
  | Nat.succ remaining => fun (type : PsVerifiedIrType) => let check : (_ : PsVerifiedIrType) -> Except(String, String) := (typeTextWithCarrier(nodes, remaining))
match type with {
  | PsVerifiedIrType.primitive scalar => match scalar with {
  | PsVerifiedIrPrimitiveType.nat => Except.ok("\\GMP")
  | PsVerifiedIrPrimitiveType.int => Except.ok("\\GMP")
  | PsVerifiedIrPrimitiveType.bool => Except.ok("bool")
  | PsVerifiedIrPrimitiveType.string => Except.ok("string")
  | PsVerifiedIrPrimitiveType.char => Except.ok("string")
  | PsVerifiedIrPrimitiveType.unit => Except.ok("null")
  | _ => Except.error("PSC1_PHP_TYPE_UNSUPPORTED: machine scalars, floats and unresolved types are not qualified")
}
  | PsVerifiedIrType.function parameters result => do {
  let _ <- (psListMapExcept(check, parameters))
  let _ <- (check(result))
  (Except.ok("\\Closure"))
}
  | PsVerifiedIrType.named _ arguments => do {
  let _ <- (psListMapExcept(check, arguments))
  (Except.ok((if (nodes) { "array|\\ArrayAccess" } else { "array" })))
}
  | _ => Except.error("PSC1_PHP_TYPE_UNSUPPORTED: machine scalars, floats and unresolved types are not qualified")
}
}
end PsPhp

namespace PsPhp
def typeText(fuel : Nat, type : PsVerifiedIrType) : Except(String, String) := typeTextWithCarrier(false, fuel, type)
end PsPhp

namespace PsPhp
def typeRequirements(fuel : Nat) : (_ : PsVerifiedIrType) -> List(String) := match fuel with {
  | Nat.zero => fun (_type : PsVerifiedIrType) => List.nil
  | Nat.succ remaining => fun (type : PsVerifiedIrType) => let visit : (_ : PsVerifiedIrType) -> List(String) := (typeRequirements(remaining))
match type with {
  | PsVerifiedIrType.primitive scalar => match scalar with {
  | PsVerifiedIrPrimitiveType.nat => _root_.List.cons("gmp", _root_.List.nil)
  | PsVerifiedIrPrimitiveType.int => _root_.List.cons("gmp", _root_.List.nil)
  | _ => List.nil
}
  | PsVerifiedIrType.function parameters result => psListAppend((psBackendSourceFlatMap(visit, parameters)), (visit(result)))
  | PsVerifiedIrType.named _ arguments => psBackendSourceFlatMap(visit, arguments)
  | _ => List.nil
}
}
end PsPhp

namespace PsPhp
def intrinsicRequirements(operation : PsVerifiedIrIntrinsic) : List(String) := match operation with {
  | PsVerifiedIrIntrinsic.boolNot => List.nil
  | PsVerifiedIrIntrinsic.boolAnd => List.nil
  | PsVerifiedIrIntrinsic.boolOr => List.nil
  | PsVerifiedIrIntrinsic.boolEq => List.nil
  | PsVerifiedIrIntrinsic.boolNe => List.nil
  | PsVerifiedIrIntrinsic.stringPush => List.nil
  | PsVerifiedIrIntrinsic.stringSingleton => List.nil
  | PsVerifiedIrIntrinsic.stringAppend => List.nil
  | PsVerifiedIrIntrinsic.stringEq => List.nil
  | PsVerifiedIrIntrinsic.charOfNat => _root_.List.cons("charOfNat", _root_.List.nil)
  | PsVerifiedIrIntrinsic.charToNat => _root_.List.cons("charToNat", _root_.List.nil)
  | PsVerifiedIrIntrinsic.stringLength => _root_.List.cons("unicodeChars", (_root_.List.cons("gmp", _root_.List.nil)))
  | PsVerifiedIrIntrinsic.stringGet => _root_.List.cons("stringGet", _root_.List.nil)
  | PsVerifiedIrIntrinsic.stringNext => _root_.List.cons("stringNext", _root_.List.nil)
  | PsVerifiedIrIntrinsic.stringExtract => _root_.List.cons("stringExtract", _root_.List.nil)
  | PsVerifiedIrIntrinsic.arrayMap => _root_.List.cons("calls", _root_.List.nil)
  | PsVerifiedIrIntrinsic.arrayFoldl => _root_.List.cons("calls", (_root_.List.cons("gmp", _root_.List.nil)))
  | _ => _root_.List.cons("gmp", _root_.List.nil)
}
end PsPhp

namespace PsPhp
def exprRequirements(valueNames : List(String), fuel : Nat) : (_ : List(String)) -> (_ : PsVerifiedIrExpr) -> List(String) := match fuel with {
  | Nat.zero => fun (_bound : List(String)) (_expr : PsVerifiedIrExpr) => List.nil
  | Nat.succ remaining => fun (bound : List(String)) (expr : PsVerifiedIrExpr) => let smaller : (_ : List(String)) -> (_ : PsVerifiedIrExpr) -> List(String) := (exprRequirements(valueNames, remaining))
let visit : (_ : PsVerifiedIrExpr) -> List(String) := (smaller(bound))
match expr with {
  | PsVerifiedIrExpr.literal value => match value with {
  | PsVerifiedIrLiteral.natural _ => _root_.List.cons("gmp", _root_.List.nil)
  | PsVerifiedIrLiteral.integer _ => _root_.List.cons("gmp", _root_.List.nil)
  | _ => List.nil
}
  | PsVerifiedIrExpr.var name => if ((psBackendNameSeen(name, valueNames) && (!psBackendNameSeen(name, bound)))) { _root_.List.cons("calls", _root_.List.nil) } else { List.nil }
  | PsVerifiedIrExpr.intrinsic operation types arguments => psListAppend((intrinsicRequirements(operation)), (psListAppend((psBackendSourceFlatMap((typeRequirements(remaining)), types)), (psBackendSourceFlatMap(visit, arguments)))))
  | PsVerifiedIrExpr.lambda parameters result body => psListAppend((psBackendSourceFlatMap((fun (parameter : PsVerifiedIrParameter) => typeRequirements(remaining, parameter.type)), parameters)), (psListAppend((typeRequirements(remaining, result)), (smaller((psListAppend((psListMap((fun (parameter : PsVerifiedIrParameter) => parameter.name), parameters)), bound)), body)))))
  | PsVerifiedIrExpr.call fn _ arguments => List.cons("calls", (psListAppend((visit(fn)), (psBackendSourceFlatMap(visit, arguments)))))
  | PsVerifiedIrExpr.letE name type value body => psListAppend((typeRequirements(remaining, type)), (psListAppend((visit(value)), (smaller((List.cons(name, bound)), body)))))
  | PsVerifiedIrExpr.ifE condition yes no => psListAppend((visit(condition)), (psListAppend((visit(yes)), (visit(no)))))
  | PsVerifiedIrExpr.record _ _ fields => psBackendSourceFlatMap((fun (field : Prod(String, PsVerifiedIrExpr)) => visit(field.snd)), fields)
  | PsVerifiedIrExpr.constructor _ _ _ fields => List.cons("nodes", (psBackendSourceFlatMap((fun (field : Prod(String, PsVerifiedIrExpr)) => visit(field.snd)), fields)))
  | PsVerifiedIrExpr.projection _ _ target _ => visit(target)
  | PsVerifiedIrExpr.matchE _ _ target alternatives => psListAppend((visit(target)), (psBackendSourceFlatMap((fun (alternative : Prod(String, (Prod((List(PsVerifiedIrMatchBinding)), PsVerifiedIrExpr)))) => smaller((psListAppend((psListMap((fun (binding : PsVerifiedIrMatchBinding) => binding.name), alternative.snd.fst)), bound)), alternative.snd.snd)), alternatives)))
}
}
end PsPhp

namespace PsPhp
structure Context where {
  globals : List((Prod(String, String)))
  valueNames : List(String)
  locals : List((Prod(String, String)))
  helpers : List(String)
  scheduled : Bool
  preciseCaptures : Bool
  flatConstructors : Bool
  inductives : List(PsVerifiedIrInductive)
  directNames : PsStringSet
  directSlots : Bool
}
end PsPhp

namespace PsPhp
structure EmitState where {
  linesRev : List(String)
  lineCount : Nat
  counter : Nat
  indent : Nat
}
end PsPhp

namespace PsPhp
def Emit(Value : Type) : Type := PsBackendStateExcept(EmitState, String, Value)
end PsPhp

namespace PsPhp
def withLocals(context : Context, locals : List((Prod(String, String)))) : Context := Context.mk(context.globals, context.valueNames, locals, context.helpers, context.scheduled, context.preciseCaptures, context.flatConstructors, context.inductives, context.directNames, context.directSlots)
end PsPhp

namespace PsPhp
def withScheduling(context : Context, scheduled : Bool) : Context := Context.mk(context.globals, context.valueNames, context.locals, context.helpers, scheduled, context.preciseCaptures, context.flatConstructors, context.inductives, context.directNames, context.directSlots)
end PsPhp

namespace PsPhp
def padding(count : Nat, builder : PsTextBuilder) : String := match count with {
  | Nat.zero => psTextBuilderFinish(builder)
  | Nat.succ remaining => padding(remaining, (psTextBuilderAppend(builder, "    ")))
}
end PsPhp

namespace PsPhp
def line(text : String) : Emit(Unit) := psBackendStateModify((fun (state : EmitState) => EmitState.mk((List.cons((cat((_root_.List.cons((padding(state.indent, psTextBuilderEmpty)), (_root_.List.cons(text, _root_.List.nil)))))), state.linesRev)), (Nat.succ(state.lineCount)), state.counter, state.indent)))
end PsPhp

namespace PsPhp
def indent(increase : Bool) : Emit(Unit) := psBackendStateModify((fun (state : EmitState) => EmitState.mk(state.linesRev, state.lineCount, state.counter, (if (increase) { Nat.succ(state.indent) } else { Nat.sub(state.indent, 1) }))))
end PsPhp

namespace PsPhp
def fresh(hint : String) : Emit(String) := psBackendStateBind((psBackendStateGet(Unit.unit)), (fun (state : EmitState) => psBackendStateBind((psBackendStateSet((EmitState.mk(state.linesRev, state.lineCount, (Nat.succ(state.counter)), state.indent)))), (fun (_unit : Unit) => psBackendStatePure((cat((_root_.List.cons("$v", (_root_.List.cons((decimal(state.counter)), (_root_.List.cons("_", (_root_.List.cons((stem(hint)), _root_.List.nil)))))))))))))))
end PsPhp

namespace PsPhp
def bindValue(expression : String) : Emit(String) := psBackendStateBind((fresh("tmp")), (fun (name : String) => psBackendStateBind((line((cat((_root_.List.cons(name, (_root_.List.cons(" = ", (_root_.List.cons(expression, (_root_.List.cons(";", _root_.List.nil)))))))))))), (fun (_unit : Unit) => psBackendStatePure(name)))))
end PsPhp

namespace PsPhp
def captureValues(values : List(String), seen : List(String)) : List(String) := match values with {
  | List.nil => seen
  | List.cons value rest => captureValues(rest, (if (psBackendNameSeen(value, seen)) { seen } else { psListAppend(seen, (_root_.List.cons(value, _root_.List.nil))) }))
}
end PsPhp

namespace PsPhp
def capture(context : Context) : String := let refs : List(String) := (psListMap((fun (pair : Prod(String, String)) => cat((_root_.List.cons("&", (_root_.List.cons(pair.snd, _root_.List.nil)))))), context.globals))
let values : List(String) := (captureValues((psListAppend((psListMap((fun (pair : Prod(String, String)) => pair.snd), context.locals)), context.helpers)), List.nil))
let captures : List(String) := (psListAppend(refs, values))
if (psListIsEmpty(captures)) { "" } else { cat((_root_.List.cons(" use (", (_root_.List.cons((psTextJoin(", ", captures)), (_root_.List.cons(")", _root_.List.nil))))))) }
end PsPhp

namespace PsPhp
-- Conservative lexical global-demand analysis. Exhausted analysis retains the
-- original complete capture set; compiler and source execution fuel are unchanged.
def collectChunks(chunks : List((List(String)))) : List(String) := psBackendSourceFlatMap((fun (chunk : List(String)) => chunk), chunks)
end PsPhp

namespace PsPhp
def collectMany {Value : Type}(visit : (_ : Value) -> Except(Unit, (List(String))), values : List(Value)) : Except(Unit, (List(String))) := match (psListMapExcept(visit, values)) with {
  | Except.error error => Except.error(error)
  | Except.ok chunks => Except.ok((collectChunks(chunks)))
}
end PsPhp

namespace PsPhp
def collectJoin(left : Except(Unit, (List(String))), right : Except(Unit, (List(String)))) : Except(Unit, (List(String))) := match left with {
  | Except.error error => Except.error(error)
  | Except.ok names => match right with {
  | Except.error error => Except.error(error)
  | Except.ok others => Except.ok((psListAppend(names, others)))
}
}
end PsPhp

namespace PsPhp
def freeGlobalNames(fuel : Nat) : (_ : List(String)) -> (_ : PsVerifiedIrExpr) -> Except(Unit, (List(String))) := match fuel with {
  | Nat.zero => fun (_bound : List(String)) (_expr : PsVerifiedIrExpr) => Except.error(Unit.unit)
  | Nat.succ remaining => fun (bound : List(String)) (expr : PsVerifiedIrExpr) => let smaller : (_ : List(String)) -> (_ : PsVerifiedIrExpr) -> Except(Unit, (List(String))) := (freeGlobalNames(remaining))
let visit : (_ : PsVerifiedIrExpr) -> Except(Unit, (List(String))) := (smaller(bound))
match expr with {
  | PsVerifiedIrExpr.literal _ => Except.ok(List.nil)
  | PsVerifiedIrExpr.var name => Except.ok((if (psBackendNameSeen(name, bound)) { List.nil } else { _root_.List.cons(name, _root_.List.nil) }))
  | PsVerifiedIrExpr.intrinsic _ _ arguments => collectMany(visit, arguments)
  | PsVerifiedIrExpr.lambda parameters _ body => smaller((psListAppend((psListMap((fun (parameter : PsVerifiedIrParameter) => parameter.name), parameters)), bound)), body)
  | PsVerifiedIrExpr.call fn _ arguments => collectJoin((visit(fn)), (collectMany(visit, arguments)))
  | PsVerifiedIrExpr.letE name _ value body => collectJoin((visit(value)), (smaller((List.cons(name, bound)), body)))
  | PsVerifiedIrExpr.ifE condition yes no => collectJoin((visit(condition)), (collectJoin((visit(yes)), (visit(no)))))
  | PsVerifiedIrExpr.record _ _ fields => collectMany((fun (field : Prod(String, PsVerifiedIrExpr)) => visit(field.snd)), fields)
  | PsVerifiedIrExpr.projection _ _ target _ => visit(target)
  | PsVerifiedIrExpr.constructor _ _ _ fields => collectMany((fun (field : Prod(String, PsVerifiedIrExpr)) => visit(field.snd)), fields)
  | PsVerifiedIrExpr.matchE _ _ target alternatives => collectJoin((visit(target)), (collectMany((fun (alternative : Prod(String, (Prod((List(PsVerifiedIrMatchBinding)), PsVerifiedIrExpr)))) => smaller((psListAppend((psListMap((fun (binding : PsVerifiedIrMatchBinding) => binding.name), alternative.snd.fst)), bound)), alternative.snd.snd)), alternatives)))
}
}
end PsPhp

namespace PsPhp
def selectedGlobalsAcc(names : List(String), globals : List((Prod(String, String))), reversed : List((Prod(String, String)))) : List((Prod(String, String))) := match globals with {
  | List.nil => psListReverse(reversed)
  | List.cons entry rest => selectedGlobalsAcc(names, rest, (if (psBackendNameSeen(entry.fst, names)) { List.cons(entry, reversed) } else { reversed }))
}
end PsPhp

namespace PsPhp
def captureForWithFuel(fuel : Nat, context : Context, parameters : List(PsVerifiedIrParameter), body : PsVerifiedIrExpr) : String := let bound : List(String) := (psListAppend((psListMap((fun (parameter : PsVerifiedIrParameter) => parameter.name), parameters)), (psListMap((fun (entry : Prod(String, String)) => entry.fst), context.locals))))
if ((!context.preciseCaptures)) { capture(context) } else { match (freeGlobalNames(fuel, bound, body)) with {
  | Except.error _ => capture(context)
  | Except.ok names => capture((Context.mk((selectedGlobalsAcc(names, context.globals, List.nil)), context.valueNames, context.locals, context.helpers, context.scheduled, context.preciseCaptures, context.flatConstructors, context.inductives, context.directNames, context.directSlots)))
} }
end PsPhp

namespace PsPhp
def captureFor(context : Context, parameters : List(PsVerifiedIrParameter), body : PsVerifiedIrExpr) : String := captureForWithFuel(4096, context, parameters, body)
end PsPhp

namespace PsPhp
def guardCondition(context : Context, name : String, type : PsVerifiedIrType) : String := match type with {
  | PsVerifiedIrType.primitive scalar => match scalar with {
  | PsVerifiedIrPrimitiveType.nat => cat((_root_.List.cons("!(", (_root_.List.cons(name, (_root_.List.cons(" instanceof \\GMP) || gmp_cmp(", (_root_.List.cons(name, (_root_.List.cons(", 0) < 0", _root_.List.nil)))))))))))
  | PsVerifiedIrPrimitiveType.int => cat((_root_.List.cons("!(", (_root_.List.cons(name, (_root_.List.cons(" instanceof \\GMP)", _root_.List.nil)))))))
  | PsVerifiedIrPrimitiveType.bool => cat((_root_.List.cons("!is_bool(", (_root_.List.cons(name, (_root_.List.cons(")", _root_.List.nil)))))))
  | PsVerifiedIrPrimitiveType.string => if (psBackendNameSeen("$__ps_utf8Valid", context.helpers)) { cat((_root_.List.cons("!is_string(", (_root_.List.cons(name, (_root_.List.cons(") || !$__ps_utf8Valid(", (_root_.List.cons(name, (_root_.List.cons(")", _root_.List.nil))))))))))) } else { cat((_root_.List.cons("!is_string(", (_root_.List.cons(name, (_root_.List.cons(") || preg_match('//u', ", (_root_.List.cons(name, (_root_.List.cons(") !== 1", _root_.List.nil))))))))))) }
  | PsVerifiedIrPrimitiveType.char => cat((_root_.List.cons("!is_string(", (_root_.List.cons(name, (_root_.List.cons(") || preg_match('/\\A.\\z/us', ", (_root_.List.cons(name, (_root_.List.cons(") !== 1", _root_.List.nil)))))))))))
  | PsVerifiedIrPrimitiveType.unit => cat((_root_.List.cons(name, (_root_.List.cons(" !== null", _root_.List.nil)))))
  | _ => "true"
}
  | PsVerifiedIrType.function _ _ => cat((_root_.List.cons("!(", (_root_.List.cons(name, (_root_.List.cons(" instanceof \\Closure)", _root_.List.nil)))))))
  | PsVerifiedIrType.named _ _ => if (context.flatConstructors) { cat((_root_.List.cons("!(is_array(", (_root_.List.cons(name, (_root_.List.cons(") || ", (_root_.List.cons(name, (_root_.List.cons(" instanceof \\ArrayAccess)", _root_.List.nil))))))))))) } else { cat((_root_.List.cons("!is_array(", (_root_.List.cons(name, (_root_.List.cons(")", _root_.List.nil))))))) }
  | _ => "true"
}
end PsPhp

namespace PsPhp
def guard(context : Context, name : String, type : PsVerifiedIrType) : Emit(Unit) := fun (state : EmitState) => do {
  let _psc_step_0 <- (line((cat((_root_.List.cons("if (", (_root_.List.cons((guardCondition(context, name, type)), (_root_.List.cons(") {", _root_.List.nil)))))))), state))
  let state := _psc_step_0.snd
  let _psc_step_1 <- (indent(true, state))
  let state := _psc_step_1.snd
  let _psc_step_2 <- (line("throw new \\TypeError('PSC1_PHP_ARGUMENT_TYPE');", state))
  let state := _psc_step_2.snd
  let _psc_step_3 <- (indent(false, state))
  let state := _psc_step_3.snd
  (line("}", state))
}
end PsPhp

namespace PsPhp
def invoke(context : Context, fn : String, args : List(String)) : String := if (context.scheduled) { cat((_root_.List.cons("(yield [", (_root_.List.cons(fn, (_root_.List.cons(", [", (_root_.List.cons((psTextJoin(", ", args)), (_root_.List.cons("]])", _root_.List.nil))))))))))) } else { cat((_root_.List.cons(fn, (_root_.List.cons("(", (_root_.List.cons((psTextJoin(", ", args)), (_root_.List.cons(")", _root_.List.nil))))))))) }
end PsPhp

namespace PsPhp
def callText(name : String, args : List(String)) : String := cat((_root_.List.cons(name, (_root_.List.cons("(", (_root_.List.cons((psTextJoin(", ", args)), (_root_.List.cons(")", _root_.List.nil)))))))))
end PsPhp

namespace PsPhp
def callBind(name : String, arity : Nat, args : List(String)) : Emit(String) := if (Nat.beq((psListLength(args)), arity)) { bindValue((callText(name, args))) } else { psBackendStateThrow("PSC1_PHP_INTRINSIC_UNSUPPORTED_OR_ARITY") }
end PsPhp

namespace PsPhp
def binary(args : List(String), symbol : String) : Emit(String) := psBackendSourceArgs2((fun (a : String) (b : String) => bindValue((cat((_root_.List.cons("(", (_root_.List.cons(a, (_root_.List.cons(" ", (_root_.List.cons(symbol, (_root_.List.cons(" ", (_root_.List.cons(b, (_root_.List.cons(")", _root_.List.nil)))))))))))))))))), (psBackendStateThrow("PSC1_PHP_INTRINSIC_UNSUPPORTED_OR_ARITY")), args)
end PsPhp

namespace PsPhp
def intrinsic(context : Context, operation : PsVerifiedIrIntrinsic, args : List(String)) : Emit(String) := match operation with {
  | PsVerifiedIrIntrinsic.natAdd => callBind("gmp_add", 2, args)
  | PsVerifiedIrIntrinsic.intAdd => callBind("gmp_add", 2, args)
  | PsVerifiedIrIntrinsic.natMul => callBind("gmp_mul", 2, args)
  | PsVerifiedIrIntrinsic.intMul => callBind("gmp_mul", 2, args)
  | PsVerifiedIrIntrinsic.intSub => callBind("gmp_sub", 2, args)
  | PsVerifiedIrIntrinsic.natSub => psBackendSourceArgs2((fun (a : String) (b : String) => bindValue((cat((_root_.List.cons("(gmp_cmp(", (_root_.List.cons(a, (_root_.List.cons(", ", (_root_.List.cons(b, (_root_.List.cons(") < 0 ? gmp_init(0) : gmp_sub(", (_root_.List.cons(a, (_root_.List.cons(", ", (_root_.List.cons(b, (_root_.List.cons("))", _root_.List.nil)))))))))))))))))))))), (psBackendStateThrow("PSC1_PHP_INTRINSIC_UNSUPPORTED_OR_ARITY")), args)
  | PsVerifiedIrIntrinsic.natDiv => psBackendSourceArgs2((fun (a : String) (b : String) => bindValue((cat((_root_.List.cons("(gmp_cmp(", (_root_.List.cons(b, (_root_.List.cons(", 0) === 0 ? gmp_init(0) : gmp_div_q(", (_root_.List.cons(a, (_root_.List.cons(", ", (_root_.List.cons(b, (_root_.List.cons(", GMP_ROUND_ZERO))", _root_.List.nil)))))))))))))))))), (psBackendStateThrow("PSC1_PHP_INTRINSIC_UNSUPPORTED_OR_ARITY")), args)
