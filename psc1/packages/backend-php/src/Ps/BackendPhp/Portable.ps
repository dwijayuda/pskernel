end PsPhp

namespace PsPhp
def emitGlobal(entry : Prod(String, String)) : Emit(Unit) := line((cat((_root_.List.cons(entry.snd, (_root_.List.cons(" = null;", _root_.List.nil)))))))
end PsPhp

namespace PsPhp
def emitPublic(context : Context, name : String) : Emit(Unit) := fun (state : EmitState) => do {
  let symbol <- (match (psBackendSourceFind((fun (entry : Prod(String, String)) => psStringEq(entry.fst, name)), context.globals)) with {
  | Option.some entry => Except.ok(entry.snd)
  | Option.none => Except.error("PSC1_PHP_INTERNAL_PUBLIC_SYMBOL")
