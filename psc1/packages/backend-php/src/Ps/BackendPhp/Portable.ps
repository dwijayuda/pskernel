end PsPhp

namespace PsPhp
def globalEntry(entry : Prod(PsVerifiedIrDeclaration, Nat)) : Prod(String, String) := Prod.mk(entry.fst.name, (cat((_root_.List.cons("$g", (_root_.List.cons((decimal(entry.snd)), (_root_.List.cons("_", (_root_.List.cons((stem(entry.fst.name)), _root_.List.nil)))))))))))
end PsPhp

namespace PsPhp
def valueNamesAcc(declarations : List(PsVerifiedIrDeclaration), reversed : List(String)) : List(String) := match declarations with {
  | List.nil => psListReverse(reversed)
  | List.cons declaration rest => valueNamesAcc(rest, (if (psListIsEmpty(declaration.parameters)) { List.cons(declaration.name, reversed) } else { reversed }))
