namespace PsPython
def parameterCheck(name : String, type : PsVerifiedIrType) : Except(String, String) := match type with {
  | PsVerifiedIrType.primitive scalar => match scalar with {
  | PsVerifiedIrPrimitiveType.nat => Except.ok((cat((_root_.List.cons("_psc_b.type(", (_root_.List.cons(name, (_root_.List.cons(") is _psc_b.int and ", (_root_.List.cons(name, (_root_.List.cons(" >= 0", _root_.List.nil)))))))))))))
  | PsVerifiedIrPrimitiveType.int => Except.ok((cat((_root_.List.cons("_psc_b.type(", (_root_.List.cons(name, (_root_.List.cons(") is _psc_b.int", _root_.List.nil)))))))))
  | PsVerifiedIrPrimitiveType.bool => Except.ok((cat((_root_.List.cons("_psc_b.type(", (_root_.List.cons(name, (_root_.List.cons(") is _psc_b.bool", _root_.List.nil)))))))))
  | PsVerifiedIrPrimitiveType.string => Except.ok((cat((_root_.List.cons("_psc_b.type(", (_root_.List.cons(name, (_root_.List.cons(") is _psc_b.str and not _psc_b.any(0xD800 <= _psc_b.ord(_psc_c) <= 0xDFFF for _psc_c in ", (_root_.List.cons(name, (_root_.List.cons(")", _root_.List.nil)))))))))))))
