namespace PsPython
def publicParameterCheck(ioAbi : Bool, publicName : String, parameter : Prod(String, (Prod(String, PsVerifiedIrType)))) : Emit(Unit) := fun (state : EmitState) => do {
  let check <- (if ((ioAbi && psBackendIoDispatcherType(parameter.snd.snd))) { Except.ok((cat((_root_.List.cons("_psc_b.callable(", (_root_.List.cons(parameter.fst, (_root_.List.cons(")", _root_.List.nil))))))))) } else { parameterCheck(parameter.fst, parameter.snd.snd) })
  let _psc_step_47 <- (line((cat((_root_.List.cons("if not (", (_root_.List.cons(check, (_root_.List.cons("):", _root_.List.nil)))))))), state))
  let state := _psc_step_47.snd
  (withIndent((line((cat((_root_.List.cons("raise _psc_b.TypeError(", (_root_.List.cons((psJsonQuote((cat((_root_.List.cons("PSC1_PYTHON_ARGUMENT_TYPE: ", (_root_.List.cons(publicName, (_root_.List.cons(":", (_root_.List.cons(parameter.fst, _root_.List.nil)))))))))))), (_root_.List.cons(")", _root_.List.nil)))))))))), state))
}
end PsPython

namespace PsPython
def emitPublicFunction(name : String, parameters : List((Prod(String, (Prod(String, PsVerifiedIrType))))), ioAbi : Bool, calls : Bool) : Emit(Unit) := fun (state : EmitState) => do {
  let _psc_step_48 <- (psBackendSourceForState((publicParameterCheck(ioAbi, name)), parameters, state))
  let state := _psc_step_48.snd
  let args : String := (psTextJoin(", ", (psListMap((fun (parameter : Prod(String, (Prod(String, PsVerifiedIrType)))) => parameter.fst), parameters))))
  let call : String := (if (calls) { cat((_root_.List.cons("_psc_run(", (_root_.List.cons((globalName(name)), (_root_.List.cons(", ", (_root_.List.cons(args, (_root_.List.cons(")", _root_.List.nil))))))))))) } else { cat((_root_.List.cons((globalName(name)), (_root_.List.cons("(", (_root_.List.cons(args, (_root_.List.cons(")", _root_.List.nil))))))))) })
  (line((cat((_root_.List.cons("return ", (_root_.List.cons(call, _root_.List.nil)))))), state))
}
end PsPython

namespace PsPython
def emitPublics(module : PsVerifiedIrModule, ioAbi : Bool, calls : Bool, names : List(String), seen : List(String), stubsRev : List(String), state : EmitState) : Except(String, (Prod((List(String)), EmitState))) := match names with {
  | List.nil => Except.ok((Prod.mk((psListReverse(stubsRev)), state)))
  | List.cons name rest => do {
  if (psBackendNameSeen(name, seen)) {
  (Except.error((cat((_root_.List.cons("PSC1_PYTHON_DUPLICATE_PUBLIC_DECLARATION: ", (_root_.List.cons(name, _root_.List.nil))))))))
}
  if ((!publicNameAllowed(name))) {
  (Except.error((cat((_root_.List.cons("PSC1_PYTHON_PUBLIC_NAME_UNSUPPORTED: ", (_root_.List.cons(name, _root_.List.nil))))))))
}
  let declaration <- (match (psBackendSourceFind((fun (value : PsVerifiedIrDeclaration) => psStringEq(value.name, name)), module.declarations)) with {
  | Option.none => Except.error((cat((_root_.List.cons("PSC1_PYTHON_PUBLIC_DECLARATION_MISSING: ", (_root_.List.cons(name, _root_.List.nil)))))))
  | Option.some value => Except.ok(value)
})
  let resultType <- (scalarType(declaration.resultType))
  if (psListIsEmpty(declaration.parameters)) {
  let force : String := (if (calls) { cat((_root_.List.cons("_psc_run(", (_root_.List.cons((valueName(name)), (_root_.List.cons(")", _root_.List.nil))))))) } else { cat((_root_.List.cons((valueName(name)), (_root_.List.cons("()", _root_.List.nil))))) })
  let _psc_step_49 <- (line((cat((_root_.List.cons(name, (_root_.List.cons(" = ", (_root_.List.cons(force, _root_.List.nil)))))))), state))
  let state := _psc_step_49.snd
  (emitPublics(module, ioAbi, calls, rest, (List.cons(name, seen)), (List.cons((cat((_root_.List.cons(name, (_root_.List.cons(": ", (_root_.List.cons(resultType, _root_.List.nil)))))))), stubsRev)), state))
} else {
  let _psc_step_50 <- (helper("builtins", state))
  let state := _psc_step_50.snd
  let parameters <- (psListMapExcept((publicParameter(ioAbi)), (psBackendSourceZipIndex(declaration.parameters))))
  let signature : String := (psTextJoin(", ", (psListMap((fun (parameter : Prod(String, (Prod(String, PsVerifiedIrType)))) => cat((_root_.List.cons(parameter.fst, (_root_.List.cons(": ", (_root_.List.cons(parameter.snd.fst, _root_.List.nil)))))))), parameters))))
  let _psc_step_51 <- (line((cat((_root_.List.cons("def ", (_root_.List.cons(name, (_root_.List.cons("(", (_root_.List.cons(signature, (_root_.List.cons(") -> ", (_root_.List.cons(resultType, (_root_.List.cons(":", _root_.List.nil)))))))))))))))), state))
  let state := _psc_step_51.snd
  let _psc_step_52 <- (withIndent((emitPublicFunction(name, parameters, ioAbi, calls)), state))
  let state := _psc_step_52.snd
  let _psc_step_53 <- (line("", state))
  let state := _psc_step_53.snd
  (emitPublics(module, ioAbi, calls, rest, (List.cons(name, seen)), (List.cons((cat((_root_.List.cons("def ", (_root_.List.cons(name, (_root_.List.cons("(", (_root_.List.cons(signature, (_root_.List.cons(") -> ", (_root_.List.cons(resultType, (_root_.List.cons(": ...", _root_.List.nil)))))))))))))))), stubsRev)), state))
}
}
}
end PsPython

namespace PsPython
def emitModuleBodyWithTailLoops(module : PsVerifiedIrModule, publicNames : List(String), ioAbi : Bool, tailLoops : Bool) : Emit(String) := fun (state : EmitState) => do {
  if ((!psListIsEmpty(module.imports))) {
  (Except.error("PSC1_PYTHON_FOREIGN_IMPORT_UNSUPPORTED"))
}
  let _psc_step_54 <- (psBackendSourceForState((fun (declaration : PsVerifiedIrDeclaration) => emitDeclarationWithTailLoops(module, declaration, tailLoops)), module.declarations, state))
  let state := _psc_step_54.snd
  let calls : Bool := (psBackendNameSeen("calls", state.helpers))
  let _psc_step_55 <- (line("from typing import Callable", state))
  let state := _psc_step_55.snd
  let _psc_step_56 <- (line("", state))
  let state := _psc_step_56.snd
  let stubs : List(String) := (_root_.List.cons("# Generated PSC1 scalar API; Nat values are nonnegative Python int.", (_root_.List.cons("import builtins as _psc_b", (_root_.List.cons("from typing import Callable", (_root_.List.cons("", _root_.List.nil))))))))
  let _psc_step_57 <- (emitPublics(module, ioAbi, calls, publicNames, List.nil, (psListReverse(stubs)), state))
  let stubs := _psc_step_57.fst
  let state := _psc_step_57.snd
  let _psc_step_58 <- (line((cat((_root_.List.cons("__all__ = [", (_root_.List.cons((psTextJoin(", ", (psListMap(psJsonQuote, publicNames)))), (_root_.List.cons("]", _root_.List.nil)))))))), state))
  let state := _psc_step_58.snd
  (Except.ok((Prod.mk((cat((_root_.List.cons((psTextJoin("\n", stubs)), (_root_.List.cons("\n", _root_.List.nil)))))), state))))
}
end PsPython

namespace PsPython
def emitModuleBody(module : PsVerifiedIrModule, publicNames : List(String), ioAbi : Bool) : Emit(String) := emitModuleBodyWithTailLoops(module, publicNames, ioAbi, false)
end PsPython

namespace PsPython
def countNewlines(chars : List(Char), count : Nat) : Nat := match chars with {
  | List.nil => count
  | List.cons char rest => countNewlines(rest, (if (Nat.beq((Char.toNat(char)), 10)) { Nat.succ(count) } else { count }))
}
end PsPython

def psPythonEmitModuleWithIoAndOptimizations(validated : PsValidatedIrModule, publicNames : List(String), ioAbi : Bool, directCalls : Bool, tailLoops : Bool) : Except(String, PsPythonOutput) := do {
  (match (psStrictValidateModule(validated.raw)) with {
  | Except.error _ => Except.error("PSC1_PYTHON_IR_VALIDATION_FAILED")
  | Except.ok _ => Except.ok(Unit.unit)
})
  let directNames : PsStringSet := (if (directCalls) { psBackendDirectCallNames(validated.raw.declarations) } else { PsStringSet.empty })
  let initial : PsPython.EmitState := (PsPython.EmitState.mk(List.nil, 0, 0, 0, List.nil, List.nil, directNames, Option.none))
  let _psc_step_59 <- (PsPython.emitModuleBodyWithTailLoops(validated.raw, publicNames, ioAbi, tailLoops, initial))
  let stub := _psc_step_59.fst
  let state := _psc_step_59.snd
  let selected : List(String) := (psPythonRuntimeClosure(state.helpers))
  let runtime : String := (psPythonRuntimeSource(selected))
  let header : String := "# Generated by PSC1 DirectPython; requires Python >= 3.14.\n# Logical admission does not certify backend preservation.\n\n"
  let sourcePrefix : String := (PsPython.cat((_root_.List.cons(header, (_root_.List.cons(runtime, _root_.List.nil))))))
  let offset : Nat := (PsPython.countNewlines((psJsonStringToChars(sourcePrefix)), 0))
  (Except.ok((PsPythonOutput.mk((PsPython.cat((_root_.List.cons(sourcePrefix, (_root_.List.cons((psTextJoin("\n", (psListReverse(state.linesRev)))), (_root_.List.cons("\n", _root_.List.nil)))))))), stub, runtime, selected, (psListMap((fun (pair : Prod(String, Nat)) => Prod.mk(pair.fst, (Nat.add(pair.snd, offset)))), (psListReverse(state.originsRev))))))))
}

def psPythonEmitModuleWithIoAndDirectCalls(validated : PsValidatedIrModule, publicNames : List(String), ioAbi : Bool, directCalls : Bool) : Except(String, PsPythonOutput) := psPythonEmitModuleWithIoAndOptimizations(validated, publicNames, ioAbi, directCalls, false)

-- One emitter; the disabled policy is retained for exact output regression.
def psPythonEmitModuleWithIo(validated : PsValidatedIrModule, publicNames : List(String), ioAbi : Bool) : Except(String, PsPythonOutput) := psPythonEmitModuleWithIoAndOptimizations(validated, publicNames, ioAbi, true, true)
