import Ps.CompilerIr.Validate
import Ps.Bridge.Json
import Ps.BackendPython.Runtime
import Ps.BackendCommon.Plan
import Ps.BackendCommon.Source
import Ps.BackendCommon.DirectCalls

structure PsPythonOutput where {
  source : String
  stub : String
  runtimeSource : String
  runtimeHelpers : List(String)
  declarationLines : List((Prod(String, Nat)))
}

namespace PsPython
def cat(parts : List(String)) : String := psTextJoin("", parts)
end PsPython

namespace PsPython
def decimal(value : Nat) : String := Int.repr((Int.ofNat(value)))
end PsPython

namespace PsPython
def asciiLetter(code : Nat) : Bool := ((Nat.ble(65, code) && Nat.ble(code, 90)) || (Nat.ble(97, code) && Nat.ble(code, 122)))
end PsPython

namespace PsPython
def asciiDigit(code : Nat) : Bool := (Nat.ble(48, code) && Nat.ble(code, 57))
end PsPython

namespace PsPython
def encodePartAcc(chars : List(Char), builder : PsTextBuilder) : String := match chars with {
  | List.nil => psTextBuilderFinish(builder)
  | List.cons char rest => let code : Nat := (Char.toNat(char))
let part : String := (if (Nat.beq(code, 95)) { "__" } else { if ((asciiLetter(code) || asciiDigit(code))) { String.singleton(char) } else { cat((_root_.List.cons("_u", (_root_.List.cons((decimal(code)), (_root_.List.cons("_", _root_.List.nil))))))) } })
encodePartAcc(rest, (psTextBuilderAppend(builder, part)))
}
end PsPython

namespace PsPython
def encodePart(name : String) : String := encodePartAcc((psJsonStringToChars(name)), psTextBuilderEmpty)
end PsPython

namespace PsPython
def globalName(name : String) : String := cat((_root_.List.cons("_psc_g_", (_root_.List.cons((encodePart(name)), _root_.List.nil)))))
end PsPython

namespace PsPython
def valueName(name : String) : String := cat((_root_.List.cons("_psc_value_", (_root_.List.cons((encodePart(name)), _root_.List.nil)))))
end PsPython

namespace PsPython
def reservedPrefix(chars : List(Char)) : Bool := match chars with {
  | List.nil => false
  | List.cons a rest => match rest with {
  | List.nil => false
  | List.cons b rest => match rest with {
  | List.nil => false
  | List.cons c rest => match rest with {
  | List.nil => false
  | List.cons d rest => match rest with {
  | List.nil => false
  | List.cons e _ => ((((Nat.beq((Char.toNat(a)), 95) && Nat.beq((Char.toNat(b)), 112)) && Nat.beq((Char.toNat(c)), 115)) && Nat.beq((Char.toNat(d)), 99)) && Nat.beq((Char.toNat(e)), 95))
}
}
}
}
}
end PsPython

namespace PsPython
def publicNameAllowed(name : String) : Bool := let chars : List(Char) := (psJsonStringToChars(name))
let keywords : List(String) := (_root_.List.cons("False", (_root_.List.cons("None", (_root_.List.cons("True", (_root_.List.cons("and", (_root_.List.cons("as", (_root_.List.cons("assert", (_root_.List.cons("async", (_root_.List.cons("await", (_root_.List.cons("break", (_root_.List.cons("class", (_root_.List.cons("continue", (_root_.List.cons("def", (_root_.List.cons("del", (_root_.List.cons("elif", (_root_.List.cons("else", (_root_.List.cons("except", (_root_.List.cons("finally", (_root_.List.cons("for", (_root_.List.cons("from", (_root_.List.cons("global", (_root_.List.cons("if", (_root_.List.cons("import", (_root_.List.cons("in", (_root_.List.cons("is", (_root_.List.cons("lambda", (_root_.List.cons("nonlocal", (_root_.List.cons("not", (_root_.List.cons("or", (_root_.List.cons("pass", (_root_.List.cons("raise", (_root_.List.cons("return", (_root_.List.cons("try", (_root_.List.cons("while", (_root_.List.cons("with", (_root_.List.cons("yield", _root_.List.nil))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
if (((reservedPrefix(chars) || psStringEq(name, "__all__")) || psBackendNameSeen(name, keywords))) { false } else { match chars with {
  | List.nil => false
  | List.cons char rest => ((Nat.beq((Char.toNat(char)), 95) || asciiLetter((Char.toNat(char)))) && psBackendSourceAll((fun (other : Char) => let code : Nat := (Char.toNat(other))
((Nat.beq(code, 95) || asciiLetter(code)) || asciiDigit(code))), rest))
} }
end PsPython

namespace PsPython
def scalarType(type : PsVerifiedIrType) : Except(String, String) := match type with {
  | PsVerifiedIrType.primitive scalar => match scalar with {
  | PsVerifiedIrPrimitiveType.nat => Except.ok("_psc_b.int")
  | PsVerifiedIrPrimitiveType.int => Except.ok("_psc_b.int")
  | PsVerifiedIrPrimitiveType.bool => Except.ok("_psc_b.bool")
  | PsVerifiedIrPrimitiveType.char => Except.ok("_psc_b.str")
  | PsVerifiedIrPrimitiveType.string => Except.ok("_psc_b.str")
  | PsVerifiedIrPrimitiveType.unit => Except.ok("None")
  | _ => Except.error("PSC1_PYTHON_PUBLIC_ABI_UNSUPPORTED: expected Nat, Int, Bool, Char, String or Unit")
}
  | _ => Except.error("PSC1_PYTHON_PUBLIC_ABI_UNSUPPORTED: expected Nat, Int, Bool, Char, String or Unit")
}
end PsPython

namespace PsPython
def checkType(fuel : Nat) : (_ : PsVerifiedIrType) -> Except(String, Unit) := match fuel with {
  | Nat.zero => fun (_type : PsVerifiedIrType) => Except.error("PSC1_PYTHON_TYPE_BUDGET")
  | Nat.succ remaining => fun (type : PsVerifiedIrType) => let check : (_ : PsVerifiedIrType) -> Except(String, Unit) := (checkType(remaining))
match type with {
  | PsVerifiedIrType.primitive scalar => if (psBackendActivePrimitive(scalar)) { Except.ok(Unit.unit) } else { Except.error("PSC1_PYTHON_CAPABILITY_UNSUPPORTED: unresolved, generic or machine/float type") }
  | PsVerifiedIrType.function parameters result => do {
  (psBackendSourceForExcept(check, parameters))
  (check(result))
}
  | PsVerifiedIrType.named _ arguments => psBackendSourceForExcept(check, arguments)
  | _ => Except.error("PSC1_PYTHON_CAPABILITY_UNSUPPORTED: unresolved, generic or machine/float type")
}
}
end PsPython

namespace PsPython
def hexDigits(fuel : Nat) : (_ : Nat) -> (_ : String) -> String := match fuel with {
  | Nat.zero => fun (_value : Nat) (acc : String) => acc
  | Nat.succ remaining => fun (value : Nat) (acc : String) => if (Nat.beq(value, 0)) { acc } else { let smaller : (_ : Nat) -> (_ : String) -> String := (hexDigits(remaining))
smaller((Nat.div(value, 16)), (cat((_root_.List.cons((psJsonHexDigit((Nat.mod(value, 16)))), (_root_.List.cons(acc, _root_.List.nil))))))) }
}
end PsPython

namespace PsPython
def naturalLiteral(value : Nat) : String := let text : String := (decimal(value))
if (Nat.blt((String.utf8ByteSize(text)), 600)) { text } else { cat((_root_.List.cons("0x", (_root_.List.cons((hexDigits((Nat.succ((String.utf8ByteSize(text)))), value, "")), _root_.List.nil))))) }
end PsPython

namespace PsPython
def magnitudeChars(chars : List(Char), acc : Nat) : Nat := match chars with {
  | List.nil => acc
  | List.cons char rest => magnitudeChars(rest, (Nat.add((Nat.mul(acc, 10)), (Nat.sub((Char.toNat(char)), 48)))))
}
end PsPython

namespace PsPython
def integerMagnitude(value : Int) : Prod(Bool, Nat) := let chars : List(Char) := (psJsonStringToChars((Int.repr(value))))
match chars with {
  | List.nil => Prod.mk(false, 0)
  | List.cons first rest => if (Nat.beq((Char.toNat(first)), 45)) { Prod.mk(true, (magnitudeChars(rest, 0))) } else { Prod.mk(false, (magnitudeChars(chars, 0))) }
}
end PsPython

namespace PsPython
def literal(value : PsVerifiedIrLiteral) : Except(String, String) := match value with {
  | PsVerifiedIrLiteral.natural number => Except.ok((naturalLiteral(number)))
  | PsVerifiedIrLiteral.integer number => let parts : Prod(Bool, Nat) := (integerMagnitude(number))
Except.ok((cat((_root_.List.cons((if (parts.fst) { "-" } else { "" }), (_root_.List.cons((naturalLiteral(parts.snd)), _root_.List.nil)))))))
  | PsVerifiedIrLiteral.string text => Except.ok((psJsonQuote(text)))
  | PsVerifiedIrLiteral.bool flag => Except.ok((if (flag) { "True" } else { "False" }))
  | PsVerifiedIrLiteral.unit => Except.ok("None")
  | PsVerifiedIrLiteral.machineInteger _ _ => Except.error("PSC1_PYTHON_SCALAR_CAPABILITY_UNQUALIFIED")
}
end PsPython

namespace PsPython
structure EmitState where {
  linesRev : List(String)
  lineCount : Nat
  indent : Nat
  nextIndex : Nat
  helpers : List(String)
  originsRev : List((Prod(String, Nat)))
  directNames : PsStringSet
  tailLoop : Option((Prod(String, (List(String)))))
}
end PsPython

namespace PsPython
def initialState : EmitState := EmitState.mk(List.nil, 0, 0, 0, List.nil, List.nil, PsStringSet.empty, Option.none)
end PsPython

namespace PsPython
def Emit(Value : Type) : Type := PsBackendStateExcept(EmitState, String, Value)
end PsPython

namespace PsPython
def Scope : Type := List((Prod(String, String)))
end PsPython

namespace PsPython
def padding(count : Nat, builder : PsTextBuilder) : String := match count with {
  | Nat.zero => psTextBuilderFinish(builder)
  | Nat.succ remaining => padding(remaining, (psTextBuilderAppend(builder, "    ")))
}
end PsPython

namespace PsPython
def line(text : String) : Emit(Unit) := psBackendStateModify((fun (state : EmitState) => EmitState.mk((List.cons((cat((_root_.List.cons((padding(state.indent, psTextBuilderEmpty)), (_root_.List.cons(text, _root_.List.nil)))))), state.linesRev)), (Nat.succ(state.lineCount)), state.indent, state.nextIndex, state.helpers, state.originsRev, state.directNames, state.tailLoop)))
end PsPython

namespace PsPython
def fresh(hint : String) : Emit(String) := psBackendStateBind((psBackendStateGet(Unit.unit)), (fun (state : EmitState) => psBackendStateBind((psBackendStateSet((EmitState.mk(state.linesRev, state.lineCount, state.indent, (Nat.succ(state.nextIndex)), state.helpers, state.originsRev, state.directNames, state.tailLoop)))), (fun (_unit : Unit) => psBackendStatePure((cat((_root_.List.cons("_psc_l", (_root_.List.cons((decimal(state.nextIndex)), (_root_.List.cons("_", (_root_.List.cons((encodePart(hint)), _root_.List.nil)))))))))))))))
end PsPython

namespace PsPython
def helper(name : String) : Emit(Unit) := psBackendStateModify((fun (state : EmitState) => EmitState.mk(state.linesRev, state.lineCount, state.indent, state.nextIndex, (if (psBackendNameSeen(name, state.helpers)) { state.helpers } else { psListAppend(state.helpers, (_root_.List.cons(name, _root_.List.nil))) }), state.originsRev, state.directNames, state.tailLoop)))
end PsPython

namespace PsPython
def shiftIndent(increase : Bool) : Emit(Unit) := psBackendStateModify((fun (state : EmitState) => EmitState.mk(state.linesRev, state.lineCount, (if (increase) { Nat.succ(state.indent) } else { Nat.sub(state.indent, 1) }), state.nextIndex, state.helpers, state.originsRev, state.directNames, state.tailLoop)))
end PsPython

namespace PsPython
def withIndent {Value : Type}(action : Emit(Value)) : Emit(Value) := psBackendStateBind((shiftIndent(true)), (fun (_unit : Unit) => psBackendStateBind(action, (fun (value : Value) => psBackendStateBind((shiftIndent(false)), (fun (_unit : Unit) => psBackendStatePure(value)))))))
end PsPython

namespace PsPython
def bindValue(value : String) : Emit(String) := psBackendStateBind((fresh("tmp")), (fun (name : String) => psBackendStateBind((line((cat((_root_.List.cons(name, (_root_.List.cons(" = ", (_root_.List.cons(value, _root_.List.nil)))))))))), (fun (_unit : Unit) => psBackendStatePure(name)))))
end PsPython

namespace PsPython
def tuple(values : List(String)) : String := match values with {
  | List.nil => "()"
  | List.cons value rest => if (psListIsEmpty(rest)) { cat((_root_.List.cons("(", (_root_.List.cons(value, (_root_.List.cons(",)", _root_.List.nil))))))) } else { cat((_root_.List.cons("(", (_root_.List.cons((psTextJoin(", ", values)), (_root_.List.cons(")", _root_.List.nil))))))) }
}
end PsPython

namespace PsPython
def setTailLoop(context : Option((Prod(String, (List(String)))))) : Emit(Unit) := psBackendStateModify((fun (state : EmitState) => EmitState.mk(state.linesRev, state.lineCount, state.indent, state.nextIndex, state.helpers, state.originsRev, state.directNames, context)))
end PsPython

namespace PsPython
-- Reusing a Python frame is safe only when this body creates no lexical
-- closures. Exhaustion conservatively retains the original scheduler.
def noLambdaWithFuel(fuel : Nat) : (_ : PsVerifiedIrExpr) -> Bool := match fuel with {
  | Nat.zero => fun (_expr : PsVerifiedIrExpr) => false
  | Nat.succ remaining => fun (expr : PsVerifiedIrExpr) => let visit : (_ : PsVerifiedIrExpr) -> Bool := (noLambdaWithFuel(remaining))
match expr with {
  | PsVerifiedIrExpr.literal _ => true
  | PsVerifiedIrExpr.var _ => true
  | PsVerifiedIrExpr.lambda _ _ _ => false
  | PsVerifiedIrExpr.call fn _ arguments => (visit(fn) && psBackendSourceAll(visit, arguments))
  | PsVerifiedIrExpr.intrinsic _ _ arguments => psBackendSourceAll(visit, arguments)
  | PsVerifiedIrExpr.letE _ _ value body => (visit(value) && visit(body))
  | PsVerifiedIrExpr.ifE condition yes no => ((visit(condition) && visit(yes)) && visit(no))
  | PsVerifiedIrExpr.record _ _ fields => psBackendSourceAll((fun (field : Prod(String, PsVerifiedIrExpr)) => visit(field.snd)), fields)
  | PsVerifiedIrExpr.projection _ _ target _ => visit(target)
  | PsVerifiedIrExpr.constructor _ _ _ fields => psBackendSourceAll((fun (field : Prod(String, PsVerifiedIrExpr)) => visit(field.snd)), fields)
  | PsVerifiedIrExpr.matchE _ _ target alternatives => (visit(target) && psBackendSourceAll((fun (alternative : Prod(String, (Prod((List(PsVerifiedIrMatchBinding)), PsVerifiedIrExpr)))) => visit(alternative.snd.snd)), alternatives))
}
}
end PsPython

namespace PsPython
def exactSelfCall(name : String, arity : Nat, bound : List(String), expr : PsVerifiedIrExpr) : Bool := match expr with {
  | PsVerifiedIrExpr.call fn types arguments => match fn with {
  | PsVerifiedIrExpr.var target => (((psStringEq(name, target) && (!psBackendNameSeen(target, bound))) && psListIsEmpty(types)) && Nat.beq(arity, (psListLength(arguments))))
  | _ => false
}
  | _ => false
}
end PsPython

namespace PsPython
def hasSelfTailWithFuel(name : String, arity : Nat, fuel : Nat) : (_ : List(String)) -> (_ : PsVerifiedIrExpr) -> Bool := match fuel with {
  | Nat.zero => fun (_bound : List(String)) (_expr : PsVerifiedIrExpr) => false
  | Nat.succ remaining => fun (bound : List(String)) (expr : PsVerifiedIrExpr) => let smaller : (_ : List(String)) -> (_ : PsVerifiedIrExpr) -> Bool := (hasSelfTailWithFuel(name, arity, remaining))
if (exactSelfCall(name, arity, bound, expr)) { true } else { match expr with {
  | PsVerifiedIrExpr.letE binder _ _ body => smaller((List.cons(binder, bound)), body)
  | PsVerifiedIrExpr.ifE _ yes no => (smaller(bound, yes) || smaller(bound, no))
  | PsVerifiedIrExpr.matchE _ _ _ alternatives => psListAny((fun (alternative : Prod(String, (Prod((List(PsVerifiedIrMatchBinding)), PsVerifiedIrExpr)))) => smaller((psListAppend((psListMap((fun (binding : PsVerifiedIrMatchBinding) => binding.name), alternative.snd.fst)), bound)), alternative.snd.snd)), alternatives)
  | _ => false
} }
}
end PsPython

namespace PsPython
def selfLoopParameters(context : Option((Prod(String, (List(String))))), scope : Scope, expr : PsVerifiedIrExpr, tail : Bool) : Option((List(String))) := if ((!tail)) { Option.none } else { match context with {
  | Option.none => Option.none
  | Option.some pair => if (exactSelfCall(pair.fst, (psListLength(pair.snd)), (psListMap((fun (entry : Prod(String, String)) => entry.fst), scope)), expr)) { Option.some(pair.snd) } else { Option.none }
} }
end PsPython

namespace PsPython
-- Preserve the saved callee, argument evaluation order and fresh-name sequence.
-- The one temporary that held the old tail result now snapshots all arguments.
def emitSelfLoop(parameters : List(String), values : List(String)) : Emit(String) := psBackendStateBind((helper("calls")), (fun (_unit : Unit) => psBackendStateBind((bindValue((tuple(values)))), (fun (snapshot : String) => psBackendStateBind((line((cat((_root_.List.cons((tuple(parameters)), (_root_.List.cons(" = ", (_root_.List.cons(snapshot, _root_.List.nil)))))))))), (fun (_unit : Unit) => psBackendStateBind((line("continue")), (fun (_unit : Unit) => psBackendStatePure(snapshot)))))))))
end PsPython

namespace PsPython
def emitCall(fn : String, args : List(String), tail : Bool) : Emit(String) := psBackendStateBind((helper("calls")), (fun (_unit : Unit) => bindValue((cat((_root_.List.cons("(yield (", (_root_.List.cons(fn, (_root_.List.cons(", ", (_root_.List.cons((tuple(args)), (_root_.List.cons(", ", (_root_.List.cons((if (tail) { "True" } else { "False" }), (_root_.List.cons("))", _root_.List.nil)))))))))))))))))))
end PsPython

namespace PsPython
def emitHelper(id : String, name : String, args : List(String)) : Emit(String) := psBackendStateBind((helper(id)), (fun (_unit : Unit) => bindValue((cat((_root_.List.cons(name, (_root_.List.cons("(", (_root_.List.cons((psTextJoin(", ", args)), (_root_.List.cons(")", _root_.List.nil)))))))))))))
end PsPython

namespace PsPython
def binary(args : List(String), symbol : String) : Emit(String) := psBackendSourceArgs2((fun (a : String) (b : String) => bindValue((cat((_root_.List.cons("(", (_root_.List.cons(a, (_root_.List.cons(" ", (_root_.List.cons(symbol, (_root_.List.cons(" ", (_root_.List.cons(b, (_root_.List.cons(")", _root_.List.nil)))))))))))))))))), (psBackendStateThrow("PSC1_PYTHON_INTRINSIC_ARITY")), args)
end PsPython

namespace PsPython
def unary(args : List(String), before : String, after : String) : Emit(String) := psBackendSourceArgs1((fun (a : String) => bindValue((cat((_root_.List.cons(before, (_root_.List.cons(a, (_root_.List.cons(after, _root_.List.nil)))))))))), (psBackendStateThrow("PSC1_PYTHON_INTRINSIC_ARITY")), args)
end PsPython

namespace PsPython
def emitIntrinsic(operation : PsVerifiedIrIntrinsic, args : List(String), tail : Bool) : Emit(String) := match operation with {
  | PsVerifiedIrIntrinsic.natAdd => binary(args, "+")
  | PsVerifiedIrIntrinsic.intAdd => binary(args, "+")
  | PsVerifiedIrIntrinsic.stringPush => binary(args, "+")
  | PsVerifiedIrIntrinsic.stringAppend => binary(args, "+")
  | PsVerifiedIrIntrinsic.natMul => binary(args, "*")
  | PsVerifiedIrIntrinsic.intMul => binary(args, "*")
  | PsVerifiedIrIntrinsic.intSub => binary(args, "-")
  | PsVerifiedIrIntrinsic.natEq => binary(args, "==")
  | PsVerifiedIrIntrinsic.intEq => binary(args, "==")
  | PsVerifiedIrIntrinsic.boolEq => binary(args, "==")
  | PsVerifiedIrIntrinsic.stringEq => binary(args, "==")
  | PsVerifiedIrIntrinsic.natNe => binary(args, "!=")
  | PsVerifiedIrIntrinsic.boolNe => binary(args, "!=")
  | PsVerifiedIrIntrinsic.natLe => binary(args, "<=")
  | PsVerifiedIrIntrinsic.intLe => binary(args, "<=")
  | PsVerifiedIrIntrinsic.natLt => binary(args, "<")
  | PsVerifiedIrIntrinsic.intLt => binary(args, "<")
  | PsVerifiedIrIntrinsic.natSub => psBackendSourceArgs2((fun (a : String) (b : String) => bindValue((cat((_root_.List.cons("(", (_root_.List.cons(a, (_root_.List.cons(" - ", (_root_.List.cons(b, (_root_.List.cons(" if ", (_root_.List.cons(a, (_root_.List.cons(" >= ", (_root_.List.cons(b, (_root_.List.cons(" else 0)", _root_.List.nil)))))))))))))))))))))), (psBackendStateThrow("PSC1_PYTHON_INTRINSIC_ARITY")), args)
  | PsVerifiedIrIntrinsic.natDiv => psBackendSourceArgs2((fun (a : String) (b : String) => bindValue((cat((_root_.List.cons("(0 if ", (_root_.List.cons(b, (_root_.List.cons(" == 0 else ", (_root_.List.cons(a, (_root_.List.cons(" // ", (_root_.List.cons(b, (_root_.List.cons(")", _root_.List.nil)))))))))))))))))), (psBackendStateThrow("PSC1_PYTHON_INTRINSIC_ARITY")), args)
  | PsVerifiedIrIntrinsic.natMod => psBackendSourceArgs2((fun (a : String) (b : String) => bindValue((cat((_root_.List.cons("(", (_root_.List.cons(a, (_root_.List.cons(" if ", (_root_.List.cons(b, (_root_.List.cons(" == 0 else ", (_root_.List.cons(a, (_root_.List.cons(" % ", (_root_.List.cons(b, (_root_.List.cons(")", _root_.List.nil)))))))))))))))))))))), (psBackendStateThrow("PSC1_PYTHON_INTRINSIC_ARITY")), args)
  | PsVerifiedIrIntrinsic.intOfNat => psBackendSourceArgs1((fun (a : String) => psBackendStatePure(a)), (psBackendStateThrow("PSC1_PYTHON_INTRINSIC_ARITY")), args)
  | PsVerifiedIrIntrinsic.stringSingleton => psBackendSourceArgs1((fun (a : String) => psBackendStatePure(a)), (psBackendStateThrow("PSC1_PYTHON_INTRINSIC_ARITY")), args)
  | PsVerifiedIrIntrinsic.intNeg => unary(args, "(-", ")")
  | PsVerifiedIrIntrinsic.intNegSucc => unary(args, "(-(", " + 1))")
  | PsVerifiedIrIntrinsic.intRepr => emitHelper("int-repr", "_psc_int_repr", args)
  | PsVerifiedIrIntrinsic.boolNot => unary(args, "(not ", ")")
  | PsVerifiedIrIntrinsic.boolAnd => psBackendStateThrow("PSC1_PYTHON_SHORT_CIRCUIT_LOWERING")
  | PsVerifiedIrIntrinsic.boolOr => psBackendStateThrow("PSC1_PYTHON_SHORT_CIRCUIT_LOWERING")
  | PsVerifiedIrIntrinsic.charOfNat => emitHelper("char-of-nat", "_psc_char_of_nat", args)
  | PsVerifiedIrIntrinsic.charToNat => psBackendStateBind((helper("builtins")), (fun (_unit : Unit) => unary(args, "_psc_b.ord(", ")")))
  | PsVerifiedIrIntrinsic.stringLength => psBackendStateBind((helper("builtins")), (fun (_unit : Unit) => unary(args, "_psc_b.len(", ")")))
  | PsVerifiedIrIntrinsic.arraySize => psBackendStateBind((helper("builtins")), (fun (_unit : Unit) => unary(args, "_psc_b.len(", ")")))
  | PsVerifiedIrIntrinsic.stringUtf8ByteSize => psBackendStateBind((helper("builtins")), (fun (_unit : Unit) => unary(args, "_psc_b.len(_psc_utf8(", "))")))
  | PsVerifiedIrIntrinsic.stringGet => emitHelper("string-get", "_psc_string_get", args)
  | PsVerifiedIrIntrinsic.stringNext => emitHelper("string-next", "_psc_string_next", args)
  | PsVerifiedIrIntrinsic.stringExtract => emitHelper("string-extract", "_psc_string_extract", args)
  | PsVerifiedIrIntrinsic.stringAtEnd => psBackendStateBind((helper("builtins")), (fun (_unit : Unit) => psBackendSourceArgs2((fun (source : String) (position : String) => bindValue((cat((_root_.List.cons("(", (_root_.List.cons(position, (_root_.List.cons(" >= _psc_b.len(_psc_utf8(", (_root_.List.cons(source, (_root_.List.cons(")))", _root_.List.nil)))))))))))))), (psBackendStateThrow("PSC1_PYTHON_INTRINSIC_ARITY")), args)))
  | PsVerifiedIrIntrinsic.arrayEmptyWithCapacity => bindValue("()")
  | PsVerifiedIrIntrinsic.arrayPush => psBackendSourceArgs2((fun (array : String) (value : String) => bindValue((cat((_root_.List.cons(array, (_root_.List.cons(" + (", (_root_.List.cons(value, (_root_.List.cons(",)", _root_.List.nil)))))))))))), (psBackendStateThrow("PSC1_PYTHON_INTRINSIC_ARITY")), args)
  | PsVerifiedIrIntrinsic.arrayGet => emitHelper("array-get", "_psc_array_get", args)
  | PsVerifiedIrIntrinsic.arrayGetD => emitHelper("array-get-d", "_psc_array_get_d", args)
  | PsVerifiedIrIntrinsic.arraySet => emitHelper("array-set", "_psc_array_set", args)
  | PsVerifiedIrIntrinsic.arraySetIfInBounds => emitHelper("array-set-if", "_psc_array_set_if", args)
  | PsVerifiedIrIntrinsic.arrayMap => psBackendStateBind((helper("array-map")), (fun (_unit : Unit) => emitCall("_psc_array_map", args, tail)))
  | PsVerifiedIrIntrinsic.arrayFoldl => psBackendStateBind((helper("array-foldl")), (fun (_unit : Unit) => emitCall("_psc_array_foldl", args, tail)))
  | _ => psBackendStateThrow("PSC1_PYTHON_INTRINSIC_CAPABILITY_UNQUALIFIED")
}
end PsPython

namespace PsPython
def structureFields(module : PsVerifiedIrModule, name : String) : Except(String, (List(String))) := match (psBackendSourceFind((fun (info : PsVerifiedIrStructure) => psStringEq(info.name, name)), module.structures)) with {
  | Option.none => Except.error((cat((_root_.List.cons("PSC1_PYTHON_STRUCTURE_MISSING: ", (_root_.List.cons(name, _root_.List.nil)))))))
