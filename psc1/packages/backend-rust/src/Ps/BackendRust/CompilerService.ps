import Ps.Compiler.Service
import Ps.BackendRust.Module

namespace Ps.Internal.RustCompilerService
def emit(module : PsValidatedIrModule, publicNames : List(String)) : Except(Ps.Internal.CompilerService.Error, (Prod(String, (List(String))))) := match (psRustEmitSelectedValidatedModule(module, publicNames, _root_.List.nil)) with {
  | Except.error code => Except.error((Ps.Internal.CompilerService.failure("rust-lowering", code)))
  | Except.ok source => let runtime : PsRustRuntimePlan := (psRustPlanRuntime(module.raw))
Except.ok((Prod.mk(source, runtime.requirements)))
}
end Ps.Internal.RustCompilerService

def psCompilerRustServiceCandidate(input : String) : String := Ps.Internal.CompilerService.candidate(PsBackendTarget.rust, Ps.Internal.RustCompilerService.emit, input)
