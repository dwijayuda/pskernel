import Ps.Compiler.Service
import Ps.BackendTs.Module

namespace Ps.Internal.TsCompilerService
def emit(module : PsValidatedIrModule, publicNames : List(String)) : Except(Ps.Internal.CompilerService.Error, (Prod(String, (List(String))))) := let raw : PsVerifiedIrModule := module.raw
let brands : List((Prod(String, String))) := (psTsBuildBrandMap(raw))
let tags : List((Prod(String, String))) := (psTsBuildTagMap(raw))
match (psListMapExcept((psTsEmitStructureWithVisibility(false, brands)), raw.structures)) with {
  | Except.error _ => Except.error((Ps.Internal.CompilerService.failure("ts-printing", "structure-refused")))
  | Except.ok structures => match (psListMapExcept((psTsEmitInductiveWithVisibility(false, tags)), raw.inductives)) with {
  | Except.error _ => Except.error((Ps.Internal.CompilerService.failure("ts-printing", "inductive-refused")))
  | Except.ok inductives => match (psListMapExcept((fun (declaration : PsVerifiedIrDeclaration) => psTsEmitDeclarationWithVisibility((psBackendNameSeen(declaration.name, publicNames)), brands, tags, declaration)), raw.declarations)) with {
  | Except.error _ => Except.error((Ps.Internal.CompilerService.failure("ts-printing", "declaration-refused")))
  | Except.ok declarations => let lines : List(String) := (psTsFlattenLines((_root_.List.cons((_root_.List.cons("// PSC1 shared checked compiler service.", (_root_.List.cons((psTsSelectedRuntimeSource(raw)), _root_.List.nil)))), (_root_.List.cons((psListMap(psTsEmitImport, raw.imports)), (_root_.List.cons((psTsFlattenLines(structures)), (_root_.List.cons((psTsFlattenLines(inductives)), (_root_.List.cons(declarations, _root_.List.nil))))))))))))
Except.ok((Prod.mk((String.Internal.append((psTsJoin("\n", lines)), (if (psListIsEmpty(publicNames)) { "\nexport {};\n" } else { "\n" }))), (psTsSelectedRuntimeRequirements(raw)))))
}
}
}
end Ps.Internal.TsCompilerService

def psCompilerTsServiceCandidate(input : String) : String := Ps.Internal.CompilerService.candidate(PsBackendTarget.ts, Ps.Internal.TsCompilerService.emit, input)
