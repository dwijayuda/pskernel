import Ps.BackendTs.Type

def psTsLookupApplied(entries : List((_root_.Prod(String, String))), name : String) : Option(String) := match entries with {
  | List.nil => Option.none
  | List.cons entry rest => match entry with {
  | Prod.mk key value => if (psStringEq(key, name)) { Option.some(value) } else { psTsLookupApplied(rest, name) }
}
}

def psTsLookup(entries : List((_root_.Prod(String, String)))) : (_ : String) -> Option(String) := fun (name : String) => psTsLookupApplied(entries, name)

def psTsExprUsesNameWithFuelWorker(fuel : Nat, expr : PsVerifiedIrExpr, name : String) : Bool := match fuel with {
  | Nat.zero => true
  | Nat.succ remaining => match expr with {
  | literal _ => false
  | var value => psStringEq(value, name)
  | intrinsic _ _ arguments => psListAny((fun (value : PsVerifiedIrExpr) => psTsExprUsesNameWithFuelWorker(remaining, value, name)), arguments)
  | lambda parameters _ body => if (psListAny((fun (parameter : PsVerifiedIrParameter) => psStringEq(parameter.name, name)), parameters)) { true } else { psTsExprUsesNameWithFuelWorker(remaining, body, name) }
  | call fn _ arguments => if (psTsExprUsesNameWithFuelWorker(remaining, fn, name)) { true } else { psListAny((fun (value : PsVerifiedIrExpr) => psTsExprUsesNameWithFuelWorker(remaining, value, name)), arguments) }
  | letE localName _ value body => if (psStringEq(localName, name)) { true } else { if (psTsExprUsesNameWithFuelWorker(remaining, value, name)) { true } else { psTsExprUsesNameWithFuelWorker(remaining, body, name) } }
  | ifE condition thenBranch elseBranch => if (psTsExprUsesNameWithFuelWorker(remaining, condition, name)) { true } else { if (psTsExprUsesNameWithFuelWorker(remaining, thenBranch, name)) { true } else { psTsExprUsesNameWithFuelWorker(remaining, elseBranch, name) } }
  | record _ _ fields => psListAny((fun (field : _root_.Prod(String, PsVerifiedIrExpr)) => match field with {
  | Prod.mk _ value => psTsExprUsesNameWithFuelWorker(remaining, value, name)
}), fields)
  | projection _ _ target _ => psTsExprUsesNameWithFuelWorker(remaining, target, name)
  | constructor _ _ _ fields => psListAny((fun (field : _root_.Prod(String, PsVerifiedIrExpr)) => match field with {
  | Prod.mk _ value => psTsExprUsesNameWithFuelWorker(remaining, value, name)
}), fields)
  | matchE _ _ scrutinee alternatives => if (psTsExprUsesNameWithFuelWorker(remaining, scrutinee, name)) { true } else { psListAny((fun (alternative : _root_.Prod(String, (_root_.Prod((List(PsVerifiedIrMatchBinding)), PsVerifiedIrExpr)))) => match alternative with {
  | Prod.mk _ detail => match detail with {
  | Prod.mk bindings body => if (psListAny((fun (binding : PsVerifiedIrMatchBinding) => psStringEq(binding.name, name)), bindings)) { true } else { psTsExprUsesNameWithFuelWorker(remaining, body, name) }
}
}), alternatives) }
}
}

def psTsExprUsesNameWithFuel(fuel : Nat) : (_ : PsVerifiedIrExpr) -> (_ : String) -> Bool := fun (expr : PsVerifiedIrExpr) (name : String) => psTsExprUsesNameWithFuelWorker(fuel, expr, name)

def psTsFreshMatchTempWorker(expr : PsVerifiedIrExpr, attempts : Nat, index : Nat) : String := match attempts with {
  | Nat.zero => "__ps$match$overflow"
  | Nat.succ remaining => let candidate := (String.Internal.append("__ps$match$", (psNatToString(index))))
if (psTsExprUsesNameWithFuel(4096, expr, candidate)) { psTsFreshMatchTempWorker(expr, remaining, (Nat.succ(index))) } else { candidate }
}

def psTsFreshMatchTempLoop(expr : PsVerifiedIrExpr, index : Nat, attempts : Nat) : String := psTsFreshMatchTempWorker(expr, attempts, index)

def psTsFreshMatchTemp(expr : PsVerifiedIrExpr) : String := psTsFreshMatchTempLoop(expr, 0, 4096)

def psTsEmitTypeArguments(arguments : List(PsVerifiedIrType)) : Except(PsTsEmitError, String) := match (psListMapExcept(psTsEmitType, arguments)) with {
  | Except.error error => Except.error(error)
  | Except.ok printed => if (psListIsEmpty(printed)) { Except.ok("") } else { Except.ok((psTsJoin("", (_root_.List.cons("<", (_root_.List.cons((psTsJoin(", ", printed)), (_root_.List.cons(">", _root_.List.nil))))))))) }
}

def psTsNormalizeMachineInteger(type : PsVerifiedIrMachineIntegerType, value : String) : Except(PsTsEmitError, String) := match type with {
  | uint8 => Except.ok((psTsJoin("", (_root_.List.cons("((", (_root_.List.cons(value, (_root_.List.cons(") & 255)", _root_.List.nil)))))))))
  | uint16 => Except.ok((psTsJoin("", (_root_.List.cons("((", (_root_.List.cons(value, (_root_.List.cons(") & 65535)", _root_.List.nil)))))))))
  | uint32 => Except.ok((psTsJoin("", (_root_.List.cons("((", (_root_.List.cons(value, (_root_.List.cons(") >>> 0)", _root_.List.nil)))))))))
  | int8 => Except.ok((psTsJoin("", (_root_.List.cons("(((", (_root_.List.cons(value, (_root_.List.cons(") << 24) >> 24)", _root_.List.nil)))))))))
  | int16 => Except.ok((psTsJoin("", (_root_.List.cons("(((", (_root_.List.cons(value, (_root_.List.cons(") << 16) >> 16)", _root_.List.nil)))))))))
  | int32 => Except.ok((psTsJoin("", (_root_.List.cons("((", (_root_.List.cons(value, (_root_.List.cons(") | 0)", _root_.List.nil)))))))))
  | uint64 => Except.ok((psTsJoin("", (_root_.List.cons("BigInt.asUintN(64, (", (_root_.List.cons(value, (_root_.List.cons("))", _root_.List.nil)))))))))
  | int64 => Except.ok((psTsJoin("", (_root_.List.cons("BigInt.asIntN(64, (", (_root_.List.cons(value, (_root_.List.cons("))", _root_.List.nil)))))))))
  | usize => Except.error(PsTsEmitError.targetWordSizeRequired)
  | isize => Except.error(PsTsEmitError.targetWordSizeRequired)
}

def psTsMachineIntegerBinaryRaw(type : PsVerifiedIrMachineIntegerType, operation : PsVerifiedIrIntegerBinaryOp, left : String, right : String) : String := match operation with {
  | add => psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" + ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | sub => psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" - ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | mul => match type with {
  | uint8 => psTsJoin("", (_root_.List.cons("Math.imul(", (_root_.List.cons(left, (_root_.List.cons(", ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | uint16 => psTsJoin("", (_root_.List.cons("Math.imul(", (_root_.List.cons(left, (_root_.List.cons(", ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | uint32 => psTsJoin("", (_root_.List.cons("Math.imul(", (_root_.List.cons(left, (_root_.List.cons(", ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | int8 => psTsJoin("", (_root_.List.cons("Math.imul(", (_root_.List.cons(left, (_root_.List.cons(", ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | int16 => psTsJoin("", (_root_.List.cons("Math.imul(", (_root_.List.cons(left, (_root_.List.cons(", ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | int32 => psTsJoin("", (_root_.List.cons("Math.imul(", (_root_.List.cons(left, (_root_.List.cons(", ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | _ => psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" * ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
}
  | bitAnd => psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" & ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | bitOr => psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" | ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | bitXor => psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" ^ ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
}

def psTsEmitMachineIntegerBinary(type : PsVerifiedIrMachineIntegerType, operation : PsVerifiedIrIntegerBinaryOp, left : String, right : String) : Except(PsTsEmitError, String) := psTsNormalizeMachineInteger(type, (psTsMachineIntegerBinaryRaw(type, operation, left, right)))

def psTsEmitMachineIntegerCompare(operation : PsVerifiedIrIntegerCompareOp, left : String, right : String) : String := match operation with {
  | eq => psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" === ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | ne => psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" !== ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | lt => psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" < ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | le => psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" <= ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | gt => psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" > ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | ge => psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" >= ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
}

def psTsEmitFloatBinary(type : PsVerifiedIrFloatingType, operation : PsVerifiedIrFloatBinaryOp, left : String, right : String) : String := let raw : String := (match operation with {
  | add => psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" + ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | sub => psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" - ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | mul => psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" * ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | div => psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" / ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
})
match type with {
  | float => raw
  | float32 => psTsJoin("", (_root_.List.cons("Math.fround(", (_root_.List.cons(raw, (_root_.List.cons(")", _root_.List.nil)))))))
}

def psTsEmitFloatCompare(operation : PsVerifiedIrFloatCompareOp, left : String, right : String) : String := match operation with {
  | eq => psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" === ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | ne => psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" !== ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | lt => psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" < ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | le => psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" <= ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | gt => psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" > ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
  | ge => psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" >= ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil)))))))))))
}

def psTsPrinted1(emit : (_ : String) -> Except(PsTsEmitError, String), arguments : List(String)) : Except(PsTsEmitError, String) := match arguments with {
  | List.nil => Except.error(PsTsEmitError.intrinsicArity)
  | List.cons arg0 rest0 => match rest0 with {
  | List.nil => emit(arg0)
  | List.cons _ _ => Except.error(PsTsEmitError.intrinsicArity)
}
}

def psTsPrinted2(emit : (_ : String) -> (_ : String) -> Except(PsTsEmitError, String), arguments : List(String)) : Except(PsTsEmitError, String) := match arguments with {
  | List.nil => Except.error(PsTsEmitError.intrinsicArity)
  | List.cons arg0 rest0 => match rest0 with {
  | List.nil => Except.error(PsTsEmitError.intrinsicArity)
  | List.cons arg1 rest1 => match rest1 with {
  | List.nil => emit(arg0, arg1)
  | List.cons _ _ => Except.error(PsTsEmitError.intrinsicArity)
}
}
}

def psTsPrinted3(emit : (_ : String) -> (_ : String) -> (_ : String) -> Except(PsTsEmitError, String), arguments : List(String)) : Except(PsTsEmitError, String) := match arguments with {
  | List.nil => Except.error(PsTsEmitError.intrinsicArity)
  | List.cons arg0 rest0 => match rest0 with {
  | List.nil => Except.error(PsTsEmitError.intrinsicArity)
  | List.cons arg1 rest1 => match rest1 with {
  | List.nil => Except.error(PsTsEmitError.intrinsicArity)
  | List.cons arg2 rest2 => match rest2 with {
  | List.nil => emit(arg0, arg1, arg2)
  | List.cons _ _ => Except.error(PsTsEmitError.intrinsicArity)
}
}
}
}

def psTsPrinted5(emit : (_ : String) -> (_ : String) -> (_ : String) -> (_ : String) -> (_ : String) -> Except(PsTsEmitError, String), arguments : List(String)) : Except(PsTsEmitError, String) := match arguments with {
  | List.nil => Except.error(PsTsEmitError.intrinsicArity)
  | List.cons arg0 rest0 => match rest0 with {
  | List.nil => Except.error(PsTsEmitError.intrinsicArity)
  | List.cons arg1 rest1 => match rest1 with {
  | List.nil => Except.error(PsTsEmitError.intrinsicArity)
  | List.cons arg2 rest2 => match rest2 with {
  | List.nil => Except.error(PsTsEmitError.intrinsicArity)
  | List.cons arg3 rest3 => match rest3 with {
  | List.nil => Except.error(PsTsEmitError.intrinsicArity)
  | List.cons arg4 rest4 => match rest4 with {
  | List.nil => emit(arg0, arg1, arg2, arg3, arg4)
  | List.cons _ _ => Except.error(PsTsEmitError.intrinsicArity)
}
}
}
}
}
}

def psTsEmitIntrinsicFromPrinted(operation : PsVerifiedIrIntrinsic, arguments : List(String)) : Except(PsTsEmitError, String) := match operation with {
  | machineIntBinary type integerOperation => let emit : (_ : String) -> (_ : String) -> Except(PsTsEmitError, String) := (fun (left : String) (right : String) => psTsEmitMachineIntegerBinary(type, integerOperation, left, right))
psTsPrinted2(emit, arguments)
  | machineIntCompare _ integerOperation => let emit : (_ : String) -> (_ : String) -> Except(PsTsEmitError, String) := (fun (left : String) (right : String) => Except.ok((psTsEmitMachineIntegerCompare(integerOperation, left, right))))
psTsPrinted2(emit, arguments)
  | floatBinary type floatOperation => let emit : (_ : String) -> (_ : String) -> Except(PsTsEmitError, String) := (fun (left : String) (right : String) => Except.ok((psTsEmitFloatBinary(type, floatOperation, left, right))))
psTsPrinted2(emit, arguments)
  | floatCompare _ floatOperation => let emit : (_ : String) -> (_ : String) -> Except(PsTsEmitError, String) := (fun (left : String) (right : String) => Except.ok((psTsEmitFloatCompare(floatOperation, left, right))))
psTsPrinted2(emit, arguments)
  | natAdd => let emit : (_ : String) -> (_ : String) -> Except(PsTsEmitError, String) := (fun (left : String) (right : String) => Except.ok((psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" + ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil))))))))))))))
psTsPrinted2(emit, arguments)
  | natSub => let emit : (_ : String) -> (_ : String) -> Except(PsTsEmitError, String) := (fun (left : String) (right : String) => Except.ok((psTsJoin("", (_root_.List.cons("((__ps_a: bigint, __ps_b: bigint) => ", (_root_.List.cons("(__ps_a >= __ps_b ? __ps_a - __ps_b : 0n))(", (_root_.List.cons(left, (_root_.List.cons(", ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil))))))))))))))))
psTsPrinted2(emit, arguments)
  | natMul => let emit : (_ : String) -> (_ : String) -> Except(PsTsEmitError, String) := (fun (left : String) (right : String) => Except.ok((psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" * ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil))))))))))))))
psTsPrinted2(emit, arguments)
  | natDiv => let emit : (_ : String) -> (_ : String) -> Except(PsTsEmitError, String) := (fun (left : String) (right : String) => Except.ok((psTsJoin("", (_root_.List.cons("((__ps_a: bigint, __ps_b: bigint) => ", (_root_.List.cons("(__ps_b === 0n ? 0n : __ps_a / __ps_b))(", (_root_.List.cons(left, (_root_.List.cons(", ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil))))))))))))))))
psTsPrinted2(emit, arguments)
  | natMod => let emit : (_ : String) -> (_ : String) -> Except(PsTsEmitError, String) := (fun (left : String) (right : String) => Except.ok((psTsJoin("", (_root_.List.cons("((__ps_a: bigint, __ps_b: bigint) => ", (_root_.List.cons("(__ps_b === 0n ? __ps_a : __ps_a % __ps_b))(", (_root_.List.cons(left, (_root_.List.cons(", ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil))))))))))))))))
psTsPrinted2(emit, arguments)
  | natEq => let emit : (_ : String) -> (_ : String) -> Except(PsTsEmitError, String) := (fun (left : String) (right : String) => Except.ok((psTsJoin("", (_root_.List.cons("(((", (_root_.List.cons(left, (_root_.List.cons(") as bigint) === ((", (_root_.List.cons(right, (_root_.List.cons(") as bigint))", _root_.List.nil))))))))))))))
psTsPrinted2(emit, arguments)
  | natNe => let emit : (_ : String) -> (_ : String) -> Except(PsTsEmitError, String) := (fun (left : String) (right : String) => Except.ok((psTsJoin("", (_root_.List.cons("(((", (_root_.List.cons(left, (_root_.List.cons(") as bigint) !== ((", (_root_.List.cons(right, (_root_.List.cons(") as bigint))", _root_.List.nil))))))))))))))
psTsPrinted2(emit, arguments)
  | natLe => let emit : (_ : String) -> (_ : String) -> Except(PsTsEmitError, String) := (fun (left : String) (right : String) => Except.ok((psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" <= ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil))))))))))))))
psTsPrinted2(emit, arguments)
  | natLt => let emit : (_ : String) -> (_ : String) -> Except(PsTsEmitError, String) := (fun (left : String) (right : String) => Except.ok((psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" < ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil))))))))))))))
psTsPrinted2(emit, arguments)
  | intOfNat => let emit : (_ : String) -> Except(PsTsEmitError, String) := (fun (value : String) => Except.ok(value))
psTsPrinted1(emit, arguments)
  | intRepr => let emit : (_ : String) -> Except(PsTsEmitError, String) := (fun (value : String) => Except.ok((psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(value, (_root_.List.cons(").toString()", _root_.List.nil))))))))))
psTsPrinted1(emit, arguments)
  | intNegSucc => let emit : (_ : String) -> Except(PsTsEmitError, String) := (fun (value : String) => Except.ok((psTsJoin("", (_root_.List.cons("(-(", (_root_.List.cons(value, (_root_.List.cons(" + 1n))", _root_.List.nil))))))))))
psTsPrinted1(emit, arguments)
  | intNeg => let emit : (_ : String) -> Except(PsTsEmitError, String) := (fun (value : String) => Except.ok((psTsJoin("", (_root_.List.cons("(-(", (_root_.List.cons(value, (_root_.List.cons("))", _root_.List.nil))))))))))
psTsPrinted1(emit, arguments)
  | intAdd => let emit : (_ : String) -> (_ : String) -> Except(PsTsEmitError, String) := (fun (left : String) (right : String) => Except.ok((psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" + ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil))))))))))))))
psTsPrinted2(emit, arguments)
  | intSub => let emit : (_ : String) -> (_ : String) -> Except(PsTsEmitError, String) := (fun (left : String) (right : String) => Except.ok((psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" - ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil))))))))))))))
psTsPrinted2(emit, arguments)
  | intMul => let emit : (_ : String) -> (_ : String) -> Except(PsTsEmitError, String) := (fun (left : String) (right : String) => Except.ok((psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" * ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil))))))))))))))
psTsPrinted2(emit, arguments)
  | intEq => let emit : (_ : String) -> (_ : String) -> Except(PsTsEmitError, String) := (fun (left : String) (right : String) => Except.ok((psTsJoin("", (_root_.List.cons("(((", (_root_.List.cons(left, (_root_.List.cons(") as bigint) === ((", (_root_.List.cons(right, (_root_.List.cons(") as bigint))", _root_.List.nil))))))))))))))
psTsPrinted2(emit, arguments)
  | intLe => let emit : (_ : String) -> (_ : String) -> Except(PsTsEmitError, String) := (fun (left : String) (right : String) => Except.ok((psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" <= ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil))))))))))))))
psTsPrinted2(emit, arguments)
  | intLt => let emit : (_ : String) -> (_ : String) -> Except(PsTsEmitError, String) := (fun (left : String) (right : String) => Except.ok((psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" < ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil))))))))))))))
psTsPrinted2(emit, arguments)
  | boolNot => let emit : (_ : String) -> Except(PsTsEmitError, String) := (fun (value : String) => Except.ok((psTsJoin("", (_root_.List.cons("(!", (_root_.List.cons(value, (_root_.List.cons(")", _root_.List.nil))))))))))
psTsPrinted1(emit, arguments)
  | boolAnd => let emit : (_ : String) -> (_ : String) -> Except(PsTsEmitError, String) := (fun (left : String) (right : String) => Except.ok((psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" && ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil))))))))))))))
psTsPrinted2(emit, arguments)
  | boolOr => let emit : (_ : String) -> (_ : String) -> Except(PsTsEmitError, String) := (fun (left : String) (right : String) => Except.ok((psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(left, (_root_.List.cons(" || ", (_root_.List.cons(right, (_root_.List.cons(")", _root_.List.nil))))))))))))))
psTsPrinted2(emit, arguments)
  | boolEq => let emit : (_ : String) -> (_ : String) -> Except(PsTsEmitError, String) := (fun (left : String) (right : String) => Except.ok((psTsJoin("", (_root_.List.cons("(((", (_root_.List.cons(left, (_root_.List.cons(") as boolean) === ((", (_root_.List.cons(right, (_root_.List.cons(") as boolean))", _root_.List.nil))))))))))))))
psTsPrinted2(emit, arguments)
