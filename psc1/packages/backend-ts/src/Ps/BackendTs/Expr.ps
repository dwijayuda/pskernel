def psTsEmitLetStatementsWithResult(emit : (_ : PsVerifiedIrExpr) -> Except(PsTsEmitError, String), emitResult : (_ : PsVerifiedIrExpr) -> Except(PsTsEmitError, String), expr : PsVerifiedIrExpr) : Except(PsTsEmitError, String) := match expr with {
  | PsVerifiedIrExpr.letE name type value body => match (psTsEmitType(type)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedType => match (emit(value)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedValue => match (psTsEmitLetStatementsWithResult(emit, emitResult, body)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedBody => if (psTsExprUsesNameWithFuel(4096, value, name)) { Except.ok((psTsJoin("", (_root_.List.cons("return yield* (function*(", (_root_.List.cons(name, (_root_.List.cons(": ", (_root_.List.cons(printedType, (_root_.List.cons(") { ", (_root_.List.cons(printedBody, (_root_.List.cons(" })(", (_root_.List.cons(printedValue, (_root_.List.cons(");", _root_.List.nil))))))))))))))))))))) } else { Except.ok((psTsJoin("", (_root_.List.cons("{ const ", (_root_.List.cons(name, (_root_.List.cons(": ", (_root_.List.cons(printedType, (_root_.List.cons(" = ", (_root_.List.cons(printedValue, (_root_.List.cons("; ", (_root_.List.cons(printedBody, (_root_.List.cons(" }", _root_.List.nil))))))))))))))))))))) }
}
}
}
  | _ => match (emitResult(expr)) with {
  | Except.error error => Except.error(error)
  | Except.ok printed => Except.ok((psTsJoin("", (_root_.List.cons("return ", (_root_.List.cons(printed, (_root_.List.cons(";", _root_.List.nil)))))))))
}
}

def psTsEmitLetStatements(emit : (_ : PsVerifiedIrExpr) -> Except(PsTsEmitError, String), expr : PsVerifiedIrExpr) : Except(PsTsEmitError, String) := psTsEmitLetStatementsWithResult(emit, emit, expr)

-- Result annotations come from checked IR, never from a guessed dynamic type.
def psTsGeneratorResultAnnotation(enabled : Bool, expected : Option(PsVerifiedIrType)) : Except(PsTsEmitError, String) := if (enabled) { match expected with {
  | Option.none => Except.ok("")
  | Option.some type => match (psTsEmitType(type)) with {
  | Except.error error => Except.error(error)
  | Except.ok printed => Except.ok((psTsJoin("", (_root_.List.cons(": __ps$Computation<", (_root_.List.cons(printed, (_root_.List.cons(">", _root_.List.nil)))))))))
}
} } else { Except.ok("") }

def psTsEmitTypedLetStatementsWithResult(emit : (_ : PsVerifiedIrType) -> (_ : PsVerifiedIrExpr) -> Except(PsTsEmitError, String), emitResult : (_ : PsVerifiedIrExpr) -> Except(PsTsEmitError, String), annotation : String, expr : PsVerifiedIrExpr) : Except(PsTsEmitError, String) := match expr with {
  | PsVerifiedIrExpr.letE name type value body => match (psTsEmitType(type)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedType => match (emit(type, value)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedValue => match (psTsEmitTypedLetStatementsWithResult(emit, emitResult, annotation, body)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedBody => if (psTsExprUsesNameWithFuel(4096, value, name)) { Except.ok((psTsJoin("", (_root_.List.cons("return yield* (function*(", (_root_.List.cons(name, (_root_.List.cons(": ", (_root_.List.cons(printedType, (_root_.List.cons(")", (_root_.List.cons(annotation, (_root_.List.cons(" { ", (_root_.List.cons(printedBody, (_root_.List.cons(" })(", (_root_.List.cons(printedValue, (_root_.List.cons(");", _root_.List.nil))))))))))))))))))))))))) } else { Except.ok((psTsJoin("", (_root_.List.cons("{ const ", (_root_.List.cons(name, (_root_.List.cons(": ", (_root_.List.cons(printedType, (_root_.List.cons(" = ", (_root_.List.cons(printedValue, (_root_.List.cons("; ", (_root_.List.cons(printedBody, (_root_.List.cons(" }", _root_.List.nil))))))))))))))))))))) }
}
}
}
  | _ => match (emitResult(expr)) with {
  | Except.error error => Except.error(error)
  | Except.ok printed => Except.ok((psTsJoin("", (_root_.List.cons("return ", (_root_.List.cons(printed, (_root_.List.cons(";", _root_.List.nil)))))))))
}
}

def psTsEmitTypedExprContextWithFuel(brands : List((_root_.Prod(String, String))), tags : List((_root_.Prod(String, String))), annotate : Bool, fuel : Nat) : (_ : Option(PsVerifiedIrType)) -> (_ : Bool) -> (_ : PsVerifiedIrExpr) -> Except(PsTsEmitError, String) := match fuel with {
  | Nat.zero => fun (_expected : Option(PsVerifiedIrType)) (_tail : Bool) (_expr : PsVerifiedIrExpr) => Except.error(PsTsEmitError.fuelExhausted)
  | Nat.succ remaining => fun (expected : Option(PsVerifiedIrType)) (tail : Bool) (expr : PsVerifiedIrExpr) => let recur : (_ : Option(PsVerifiedIrType)) -> (_ : Bool) -> (_ : PsVerifiedIrExpr) -> Except(PsTsEmitError, String) := (psTsEmitTypedExprContextWithFuel(brands, tags, annotate, remaining))
let untyped : (_ : Bool) -> (_ : PsVerifiedIrExpr) -> Except(PsTsEmitError, String) := (recur(Option.none))
let smaller : (_ : PsVerifiedIrExpr) -> Except(PsTsEmitError, String) := (untyped(false))
let result : (_ : PsVerifiedIrExpr) -> Except(PsTsEmitError, String) := (recur(expected, tail))
let owned : (_ : PsVerifiedIrExpr) -> Except(PsTsEmitError, String) := (untyped(true))
match (psTsGeneratorResultAnnotation(annotate, expected)) with {
  | Except.error error => Except.error(error)
  | Except.ok annotation => match expr with {
  | literal literal => psTsEmitLiteral(literal)
  | var name => Except.ok(name)
  | intrinsic operation _ arguments => match (psListMapExcept(smaller, arguments)) with {
  | Except.error error => Except.error(error)
  | Except.ok printed => psTsEmitIntrinsicFromPrinted(operation, printed)
}
  | lambda parameters resultType body => let printParameter : (_ : PsVerifiedIrParameter) -> Except(PsTsEmitError, String) := (fun (parameter : PsVerifiedIrParameter) => match (psTsEmitType(parameter.type)) with {
  | Except.error error => Except.error(error)
  | Except.ok type => Except.ok((psTsJoin("", (_root_.List.cons(parameter.name, (_root_.List.cons(": ", (_root_.List.cons(type, _root_.List.nil)))))))))
})
match (psListMapExcept(printParameter, parameters)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedParameters => match (if (annotate) { recur((Option.some(resultType)), true, body) } else { owned(body) }) with {
  | Except.error error => Except.error(error)
  | Except.ok printedBody => match (psTsEmitType(resultType)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedResult => Except.ok((psTsJoin("", (_root_.List.cons("__ps$wrap(function*(", (_root_.List.cons((psTsJoin(", ", printedParameters)), (_root_.List.cons("): __ps$Computation<", (_root_.List.cons(printedResult, (_root_.List.cons("> { return ", (_root_.List.cons(printedBody, (_root_.List.cons("; })", _root_.List.nil)))))))))))))))))
}
}
}
  | call fn typeArguments arguments => match (smaller(fn)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedFn => let callable : String := (match fn with {
  | PsVerifiedIrExpr.lambda _ _ _ => psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(printedFn, (_root_.List.cons(")", _root_.List.nil)))))))
  | _ => printedFn
})
match (psTsEmitTypeArguments(typeArguments)) with {
  | Except.error error => Except.error(error)
  | Except.ok generic => match (psListMapExcept(smaller, arguments)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedArguments => let suffix := (if (psListIsEmpty(printedArguments)) { "" } else { psTsJoin("", (_root_.List.cons(", ", (_root_.List.cons((psTsJoin(", ", printedArguments)), _root_.List.nil))))) })
Except.ok((psTsJoin("", (_root_.List.cons("(yield* ", (_root_.List.cons((if (tail) { "__ps$tail" } else { "__ps$invoke" }), (_root_.List.cons("(", (_root_.List.cons(callable, (_root_.List.cons(generic, (_root_.List.cons(suffix, (_root_.List.cons("))", _root_.List.nil)))))))))))))))))
}
}
}
  | letE _ _ _ _ => match (if (annotate) { psTsEmitTypedLetStatementsWithResult((fun (type : PsVerifiedIrType) (value : PsVerifiedIrExpr) => recur((Option.some(type)), false, value)), result, annotation, expr) } else { psTsEmitLetStatementsWithResult(smaller, result, expr) }) with {
  | Except.error error => Except.error(error)
  | Except.ok statements => Except.ok((if (annotate) { psTsJoin("", (_root_.List.cons("(yield* (function*()", (_root_.List.cons(annotation, (_root_.List.cons(" { ", (_root_.List.cons(statements, (_root_.List.cons(" })())", _root_.List.nil))))))))))) } else { psTsJoin("", (_root_.List.cons("(yield* (function*() { ", (_root_.List.cons(statements, (_root_.List.cons(" })())", _root_.List.nil))))))) }))
}
  | ifE condition thenBranch elseBranch => match (smaller(condition)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedCondition => match (result(thenBranch)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedThen => match (result(elseBranch)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedElse => Except.ok((psTsJoin("", (_root_.List.cons("(", (_root_.List.cons(printedCondition, (_root_.List.cons(" ? ", (_root_.List.cons(printedThen, (_root_.List.cons(" : ", (_root_.List.cons(printedElse, (_root_.List.cons(")", _root_.List.nil)))))))))))))))))
}
}
}
  | record structureName _ fields => match (psTsLookup(brands, structureName)) with {
  | Option.none => Except.error((PsTsEmitError.unknownStructure(structureName)))
  | Option.some brand => let printField : (_ : _root_.Prod(String, PsVerifiedIrExpr)) -> Except(PsTsEmitError, String) := (fun (field : _root_.Prod(String, PsVerifiedIrExpr)) => match field with {
  | Prod.mk fieldName fieldValue => match (smaller(fieldValue)) with {
  | Except.error error => Except.error(error)
  | Except.ok value => Except.ok((psTsJoin("", (_root_.List.cons("[", (_root_.List.cons((psJsonQuote(fieldName)), (_root_.List.cons("]: ", (_root_.List.cons(value, _root_.List.nil)))))))))))
}
})
match (psListMapExcept(printField, fields)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedFields => let suffix := (if (psListIsEmpty(printedFields)) { "" } else { psTsJoin("", (_root_.List.cons(", ", (_root_.List.cons((psTsJoin(", ", printedFields)), _root_.List.nil))))) })
Except.ok((psTsJoin("", (_root_.List.cons("({ [", (_root_.List.cons(brand, (_root_.List.cons("]: true as const", (_root_.List.cons(suffix, (_root_.List.cons(" })", _root_.List.nil)))))))))))))
}
}
  | projection _ _ target field => match (smaller(target)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedTarget => Except.ok((psTsJoin("", (_root_.List.cons(printedTarget, (_root_.List.cons(".", (_root_.List.cons(field, _root_.List.nil)))))))))
}
  | constructor inductiveName constructorName typeArguments fields => match (psTsLookup(tags, inductiveName)) with {
  | Option.none => Except.error((PsTsEmitError.unknownInductive(inductiveName)))
  | Option.some _ => match (psTsEmitTypeArguments(typeArguments)) with {
  | Except.error error => Except.error(error)
  | Except.ok generic => let access := (psTsJoin("", (_root_.List.cons(inductiveName, (_root_.List.cons("[", (_root_.List.cons((psJsonQuote(constructorName)), (_root_.List.cons("]", _root_.List.nil))))))))))
let printField : (_ : _root_.Prod(String, PsVerifiedIrExpr)) -> Except(PsTsEmitError, String) := (fun (field : _root_.Prod(String, PsVerifiedIrExpr)) => match field with {
  | Prod.mk fieldName fieldValue => smaller(fieldValue)
})
match (psListMapExcept(printField, fields)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedFields => if (if (psListIsEmpty(typeArguments)) { psListIsEmpty(fields) } else { false }) { Except.ok(access) } else { Except.ok((psTsJoin("", (_root_.List.cons(access, (_root_.List.cons(generic, (_root_.List.cons("(", (_root_.List.cons((psTsJoin(", ", printedFields)), (_root_.List.cons(")", _root_.List.nil))))))))))))) }
}
}
}
  | matchE inductiveName _ scrutinee alternatives => match (psTsLookup(tags, inductiveName)) with {
  | Option.none => Except.error((PsTsEmitError.unknownInductive(inductiveName)))
  | Option.some tag => if (psListIsEmpty(alternatives)) { match (smaller(scrutinee)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedScrutinee => Except.ok((psTsJoin("", (_root_.List.cons("(yield* (function*(): __ps$Computation<never> { void (", (_root_.List.cons(printedScrutinee, (_root_.List.cons("); throw new Error(", (_root_.List.cons((psJsonQuote("unreachable empty ProofScript match")), (_root_.List.cons("); })())", _root_.List.nil)))))))))))))
} } else { let temp := (psTsFreshMatchTemp(expr))
let printAlternative : (_ : _root_.Prod(String, (_root_.Prod((List(PsVerifiedIrMatchBinding)), PsVerifiedIrExpr)))) -> Except(PsTsEmitError, String) := (fun (alternative : _root_.Prod(String, (_root_.Prod((List(PsVerifiedIrMatchBinding)), PsVerifiedIrExpr)))) => match alternative with {
  | Prod.mk constructorName detail => match detail with {
  | Prod.mk bindings body => match (result(body)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedBody => if (psListIsEmpty(bindings)) { Except.ok((psTsJoin("", (_root_.List.cons("case ", (_root_.List.cons((psJsonQuote(constructorName)), (_root_.List.cons(": return ", (_root_.List.cons(printedBody, (_root_.List.cons(";", _root_.List.nil))))))))))))) } else { let printBinding : (_ : PsVerifiedIrMatchBinding) -> Except(PsTsEmitError, String) := (fun (binding : PsVerifiedIrMatchBinding) => match (psTsEmitType(binding.type)) with {
  | Except.error error => Except.error(error)
  | Except.ok type => Except.ok((psTsJoin("", (_root_.List.cons("const ", (_root_.List.cons(binding.name, (_root_.List.cons(": ", (_root_.List.cons(type, (_root_.List.cons(" = ", (_root_.List.cons(temp, (_root_.List.cons(".", (_root_.List.cons(binding.field, (_root_.List.cons(";", _root_.List.nil)))))))))))))))))))))
})
match (psListMapExcept(printBinding, bindings)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedBindings => Except.ok((psTsJoin("", (_root_.List.cons("case ", (_root_.List.cons((psJsonQuote(constructorName)), (_root_.List.cons(": { ", (_root_.List.cons((psTsJoin(" ", printedBindings)), (_root_.List.cons(" return ", (_root_.List.cons(printedBody, (_root_.List.cons("; }", _root_.List.nil)))))))))))))))))
} }
}
}
})
match (psListMapExcept(printAlternative, alternatives)) with {
  | Except.error error => Except.error(error)
  | Except.ok cases => match (smaller(scrutinee)) with {
  | Except.error error => Except.error(error)
  | Except.ok printedScrutinee => Except.ok((if (annotate) { psTsJoin("", (_root_.List.cons("(yield* (function*()", (_root_.List.cons(annotation, (_root_.List.cons(" { const ", (_root_.List.cons(temp, (_root_.List.cons(" = ", (_root_.List.cons(printedScrutinee, (_root_.List.cons("; switch (", (_root_.List.cons(temp, (_root_.List.cons("[", (_root_.List.cons(tag, (_root_.List.cons("]) { ", (_root_.List.cons((psTsJoin(" ", cases)), (_root_.List.cons(" } throw new Error(", (_root_.List.cons((psJsonQuote("invalid ProofScript constructor tag")), (_root_.List.cons("); })())", _root_.List.nil))))))))))))))))))))))))))))))) } else { psTsJoin("", (_root_.List.cons("(yield* (function*() { const ", (_root_.List.cons(temp, (_root_.List.cons(" = ", (_root_.List.cons(printedScrutinee, (_root_.List.cons("; switch (", (_root_.List.cons(temp, (_root_.List.cons("[", (_root_.List.cons(tag, (_root_.List.cons("]) { ", (_root_.List.cons((psTsJoin(" ", cases)), (_root_.List.cons(" } throw new Error(", (_root_.List.cons((psJsonQuote("invalid ProofScript constructor tag")), (_root_.List.cons("); })())", _root_.List.nil))))))))))))))))))))))))))) }))
}
} }
}
}
}
}

-- Existing expression consumers keep exact legacy rendering and fuel behavior.
def psTsEmitExprContextWithFuel(brands : List((_root_.Prod(String, String))), tags : List((_root_.Prod(String, String))), fuel : Nat) : (_ : Bool) -> (_ : PsVerifiedIrExpr) -> Except(PsTsEmitError, String) := psTsEmitTypedExprContextWithFuel(brands, tags, false, fuel, Option.none)

def psTsEmitTypedTailExpr(brands : List((_root_.Prod(String, String))), tags : List((_root_.Prod(String, String))), resultType : PsVerifiedIrType, expr : PsVerifiedIrExpr) : Except(PsTsEmitError, String) := psTsEmitTypedExprContextWithFuel(brands, tags, true, 4096, (Option.some(resultType)), true, expr)

-- Ordinary expression consumers preserve their surrounding continuation.
def psTsEmitExprWithFuel(brands : List((_root_.Prod(String, String))), tags : List((_root_.Prod(String, String))), fuel : Nat) : (_ : PsVerifiedIrExpr) -> Except(PsTsEmitError, String) := psTsEmitExprContextWithFuel(brands, tags, fuel, false)

-- Only complete function/value results may replace the current driver frame.
def psTsEmitTailExpr(brands : List((_root_.Prod(String, String))), tags : List((_root_.Prod(String, String))), expr : PsVerifiedIrExpr) : Except(PsTsEmitError, String) := psTsEmitExprContextWithFuel(brands, tags, 4096, true, expr)

def psTsEmitExpr(brands : List((_root_.Prod(String, String))), tags : List((_root_.Prod(String, String))), expr : PsVerifiedIrExpr) : Except(PsTsEmitError, String) := psTsEmitExprWithFuel(brands, tags, 4096, expr)
