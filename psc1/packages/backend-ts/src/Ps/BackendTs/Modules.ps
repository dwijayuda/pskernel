import Ps.BackendCommon.Modules
import Ps.BackendTs.Module

namespace Ps.Internal.ModularTs
/-! One complete brand/tag map is built from the checked graph. Types, symbols,
UTF-8 caches and the implementation WeakMap are emitted exactly once. -/
def helpers : List(String) := _root_.List.cons("__ps$implementations", (_root_.List.cons("__ps$run", (_root_.List.cons("__ps$wrap", (_root_.List.cons("__ps$invoke", (_root_.List.cons("__ps$tail", (_root_.List.cons("__ps$utf8Width", (_root_.List.cons("__ps$utf8", (_root_.List.cons("__ps$stringGet", (_root_.List.cons("__ps$stringNext", (_root_.List.cons("__ps$utf8Known", (_root_.List.cons("__ps$stringGetView", (_root_.List.cons("__ps$stringNextView", (_root_.List.cons("__ps$stringUtf8Size", (_root_.List.cons("__ps$stringExtract", (_root_.List.cons("__ps$cohort", _root_.List.nil)))))))))))))))))))))))))))))
end Ps.Internal.ModularTs

namespace Ps.Internal.ModularTs
def importText(item : PsModuleImport) : String := psTextJoin("", (_root_.List.cons("import ", (_root_.List.cons((if (item.typeOnly) { "type " } else { "" }), (_root_.List.cons("{ ", (_root_.List.cons((psTextJoin(", ", item.names)), (_root_.List.cons(" } from ", (_root_.List.cons((psJsonQuote(item.source)), (_root_.List.cons(";\n", _root_.List.nil)))))))))))))))
end Ps.Internal.ModularTs

namespace Ps.Internal.ModularTs
def importedNames(imports : List(PsModuleOwner), index : Nat) : List(String) := psListMap((fun (item : PsModuleOwner) => item.name), (Ps.Internal.ModuleGraph.filter((fun (item : PsModuleOwner) => Nat.beq(item.unit, index)), imports)))
end Ps.Internal.ModularTs

namespace Ps.Internal.ModularTs
def printedDeclaration(brands : List((_root_.Prod(String, String))), tags : List((_root_.Prod(String, String))), declaration : PsVerifiedIrDeclaration) : Except(String, String) := match (psTsEmitDeclarationWithVisibility(true, brands, tags, declaration)) with {
  | Except.error _ => Except.error((String.Internal.append("PSC1_MODULE_TS_PRINT:", declaration.name)))
  | Except.ok printed => Except.ok(printed)
}
end Ps.Internal.ModularTs

namespace Ps.Internal.ModularTs
def renderUnit(plan : PsModulePlan, digest : String, brands : List((_root_.Prod(String, String))), tags : List((_root_.Prod(String, String))), unit : PsModuleUnit) : Except(String, PsModuleArtifact) := let runtimeTypes := (psListAppend((_root_.List.cons("__ps$Request", (_root_.List.cons("__ps$Computation", (_root_.List.cons("__ps$Utf8View", _root_.List.nil)))))), (psListMap((fun (info : PsVerifiedIrStructure) => info.name), plan.raw.structures))))
let symbolNames : (_ : List((Prod(String, String)))) -> List(String) := (fun (entries : List((Prod(String, String)))) => psListMap((fun (entry : Prod(String, String)) => entry.snd), entries))
let symbols := (psListAppend((symbolNames(brands)), (symbolNames(tags))))
let constructors := (psListMap((fun (info : PsVerifiedIrInductive) => info.name), plan.raw.inductives))
let runtimeValues := (psListAppend(helpers, (psListAppend(symbols, (psListAppend(constructors, (importedNames(unit.imports, 0))))))))
let sourceImport : (_ : Nat) -> Option(PsModuleImport) := (fun (index : Nat) => let names := (importedNames(unit.imports, index))
if (psListIsEmpty(names)) { Option.none } else { Option.some((PsModuleImport.mk((psModuleSpecifierFor(plan, index, true)), names, false))) })
let imports : List(PsModuleImport) := (if (Nat.beq(unit.index, 0)) { _root_.List.nil } else { psListAppend((_root_.List.cons((PsModuleImport.mk((psModuleSpecifierFor(plan, 0, true)), runtimeValues, false)), (_root_.List.cons((PsModuleImport.mk((psModuleSpecifierFor(plan, 0, true)), runtimeTypes, true)), _root_.List.nil)))), (Ps.Internal.ModuleGraph.filterMap(sourceImport, (psModuleSourceIndices(plan))))) })
let structureResult : Except(String, (List((List(String))))) := (if (Nat.beq(unit.index, 0)) { Ps.Internal.ModuleGraph.mapError((fun (_error : PsTsEmitError) => "PSC1_MODULE_TS_STRUCTURE"), (psListMapExcept((psTsEmitStructure(brands)), plan.raw.structures))) } else { Except.ok(_root_.List.nil) })
match structureResult with {
  | Except.error error => Except.error(error)
  | Except.ok structures => let inductiveResult : Except(String, (List((List(String))))) := (if (Nat.beq(unit.index, 0)) { Ps.Internal.ModuleGraph.mapError((fun (_error : PsTsEmitError) => "PSC1_MODULE_TS_INDUCTIVE"), (psListMapExcept((psTsEmitInductive(tags)), plan.raw.inductives))) } else { Except.ok(_root_.List.nil) })
match inductiveResult with {
  | Except.error error => Except.error(error)
  | Except.ok inductives => match (psListMapExcept((printedDeclaration(brands, tags)), unit.declarations)) with {
  | Except.error error => Except.error(error)
  | Except.ok declarations => let ordinaryHelpers := (Ps.Internal.ModuleGraph.filter((fun (name : String) => if (psStringEq(name, "__ps$cohort")) { false } else { true }), helpers))
let header := (if (Nat.beq(unit.index, 0)) { psTextJoin("", (_root_.List.cons(psTsRuntimeSupport, (_root_.List.cons("\nexport const __ps$cohort = ", (_root_.List.cons((psJsonQuote((psModuleCohortFor(plan, digest, true)))), (_root_.List.cons(";\n", (_root_.List.cons("export { ", (_root_.List.cons((psTextJoin(", ", (psListAppend(ordinaryHelpers, symbols)))), (_root_.List.cons(" };\n", (_root_.List.cons("export type { __ps$Request, __ps$Computation, __ps$Utf8View };\n", _root_.List.nil))))))))))))))))) } else { psTextJoin("", (_root_.List.cons((psTextJoin("", (psListMap(importText, imports)))), (_root_.List.cons("if (__ps$cohort !== ", (_root_.List.cons((psJsonQuote((psModuleCohortFor(plan, digest, true)))), (_root_.List.cons(") throw new Error(\"PSC1_MODULE_RUNTIME_COHORT\");\n", _root_.List.nil))))))))) })
let typeNames := (psModuleTypeNames(plan.raw))
let typeExports := (if (Nat.beq(unit.index, 0)) { "" } else { if (psListIsEmpty(typeNames)) { "" } else { psTextJoin("", (_root_.List.cons("export type { ", (_root_.List.cons((psTextJoin(", ", typeNames)), (_root_.List.cons(" } from ", (_root_.List.cons((psJsonQuote((psModuleSpecifierFor(plan, 0, true)))), (_root_.List.cons(";\n", _root_.List.nil))))))))))) } })
let typeLines := (psListAppend((Ps.Internal.ModuleGraph.flatten(structures)), (Ps.Internal.ModuleGraph.flatten(inductives))))
let exports := (psListAppend((if (Nat.beq(unit.index, 0)) { psListAppend(helpers, (psListAppend(symbols, constructors))) } else { _root_.List.nil }), (psListMap((fun (declaration : PsVerifiedIrDeclaration) => declaration.name), unit.declarations))))
Except.ok((PsModuleArtifact.mk(unit.index, (psTextJoin("", (_root_.List.cons(header, (_root_.List.cons((psTextJoin("\n", typeLines)), (_root_.List.cons("\n", (_root_.List.cons(typeExports, (_root_.List.cons((psTextJoin("\n", declarations)), (_root_.List.cons("\n", _root_.List.nil)))))))))))))), "", imports, exports)))
}
}
}
end Ps.Internal.ModularTs

def psEmitTsModules(plan : PsModulePlan, digest : String) : Except(String, (List(PsModuleArtifact))) := match (psPlanModulesWithPackages(plan.raw, plan.owners, plan.packages, plan.protocol)) with {
  | Except.error error => Except.error(error)
  | Except.ok rechecked => let brands := (psTsBuildBrandMap(rechecked.raw))
let tags := (psTsBuildTagMap(rechecked.raw))
psListMapExcept((Ps.Internal.ModularTs.renderUnit(rechecked, digest, brands, tags)), rechecked.units)
}
