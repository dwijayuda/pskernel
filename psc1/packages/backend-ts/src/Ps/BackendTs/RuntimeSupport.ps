import Ps.BackendTs.Type

-- Each recursive call suspends its generator; the host loop owns the work stack.
-- Public functions remain synchronous and retain their ordinary TypeScript types.
-- Tail requests replace only a complete logical function result; non-tail
-- requests retain the existing continuation. Generated owners have no JS finally.
def psTsStackRuntimeSupport : String := "type __ps$Request = { readonly fn: Function; readonly args: unknown[]; readonly tail: boolean };\ntype __ps$Computation<R> = Generator<__ps$Request, R, unknown>;\nconst __ps$implementations = new WeakMap<Function, Function>();\nfunction __ps$run<R>(root: __ps$Computation<R>): R {\n  const pending: __ps$Computation<unknown>[] = [root];\n  let value: unknown = undefined;\n  while (pending.length !== 0) {\n    const next = pending[pending.length - 1].next(value);\n    if (next.done) { pending.pop(); value = next.value; }\n    else {\n      const { fn, args, tail } = next.value;\n      const implementation = __ps$implementations.get(fn);\n      if (tail) pending.pop();\n      if (implementation) { pending.push(Reflect.apply(implementation, undefined, args)); value = undefined; }\n      else value = Reflect.apply(fn, undefined, args);\n    }\n  }\n  return value as R;\n}\nfunction __ps$wrap<A extends unknown[], R>(implementation: (...args: A) => __ps$Computation<R>): (...args: A) => R {\n  const fn = (...args: A): R => __ps$run(implementation(...args));\n  __ps$implementations.set(fn, implementation);\n  return fn;\n}\nfunction* __ps$invoke<A extends unknown[], R>(fn: (...args: A) => R, ...args: A): __ps$Computation<R> {\n  return (yield { fn, args, tail: false }) as R;\n}\nfunction* __ps$tail<A extends unknown[], R>(fn: (...args: A) => R, ...args: A): __ps$Computation<R> {\n  return (yield { fn, args, tail: true }) as R;\n}"

-- Cache two immutable strings so pairwise comparisons reuse both byte indexes.
-- Retention is bounded; character access remains exact at UTF-8 boundaries.
def psTsUtf8RuntimeSupport : String := "type __ps$Utf8View = { readonly token: symbol; readonly text: string; readonly size: bigint; readonly positions: Uint32Array };\nlet __ps$lastUtf8: __ps$Utf8View | undefined;\nlet __ps$previousUtf8: __ps$Utf8View | undefined;\nfunction __ps$utf8Width(code: number): number { return code <= 0x7f ? 1 : code <= 0x7ff ? 2 : code <= 0xffff ? 3 : 4; }\nfunction __ps$utf8(text: string): __ps$Utf8View {\n  if (__ps$lastUtf8?.text === text) return __ps$lastUtf8;\n  if (__ps$previousUtf8?.text === text) return __ps$previousUtf8;\n  let size = 0;\n  for (const char of text) size += __ps$utf8Width(char.codePointAt(0) ?? 0);\n  const positions = new Uint32Array(size + 1);\n  let byte = 0, index = 0;\n  for (const char of text) {\n    positions[byte] = index + 1;\n    const __ps_w = __ps$utf8Width(char.codePointAt(0) ?? 0);\n    byte += __ps_w; index += char.length;\n  }\n  positions[size] = text.length + 1;\n  __ps$previousUtf8 = __ps$lastUtf8;\n  return __ps$lastUtf8 = { token: Symbol(), text, size: BigInt(size), positions };\n}\nfunction __ps$stringGet(text: string, position: bigint): string {\n  const view = __ps$utf8(text);\n  if (position < 0n || position >= view.size) return \"A\";\n  const index = view.positions[Number(position)];\n  return index === 0 ? \"A\" : String.fromCodePoint(text.codePointAt(index - 1) ?? 65);\n}\nfunction __ps$stringNext(text: string, position: bigint): bigint {\n  const view = __ps$utf8(text);\n  if (position < 0n || position >= view.size) return position + 1n;\n  const index = view.positions[Number(position)];\n  return index === 0 ? position + 1n : position + BigInt(__ps$utf8Width(text.codePointAt(index - 1) ?? 0));\n}\nfunction __ps$utf8Known(text: string, token: symbol | undefined): __ps$Utf8View {\n  if (token !== undefined) {\n    if (__ps$lastUtf8?.token === token) return __ps$lastUtf8;\n    if (__ps$previousUtf8?.token === token) return __ps$previousUtf8;\n  }\n  return __ps$utf8(text);\n}\nfunction __ps$stringGetView(view: __ps$Utf8View, position: bigint): string {\n  if (position < 0n || position >= view.size) return \"A\";\n  const index = view.positions[Number(position)];\n  return index === 0 ? \"A\" : String.fromCodePoint(view.text.codePointAt(index - 1) ?? 65);\n}\nfunction __ps$stringNextView(view: __ps$Utf8View, position: bigint): bigint {\n  if (position < 0n || position >= view.size) return position + 1n;\n  const index = view.positions[Number(position)];\n  return index === 0 ? position + 1n : position + BigInt(__ps$utf8Width(view.text.codePointAt(index - 1) ?? 0));\n}\n\nfunction __ps$stringUtf8Size(text: string): bigint {\n  if (__ps$lastUtf8?.text === text) return __ps$lastUtf8.size;\n  if (__ps$previousUtf8?.text === text) return __ps$previousUtf8.size;\n  let size = 0;\n  for (const char of text) size += __ps$utf8Width(char.codePointAt(0) ?? 0);\n  return BigInt(size);\n}\nfunction __ps$stringExtract(text: string, start: bigint, stop: bigint): string {\n  if (start >= stop) return \"\";\n  const view = __ps$lastUtf8?.text === text ? __ps$lastUtf8 :\n    __ps$previousUtf8?.text === text ? __ps$previousUtf8 : undefined;\n  if (view !== undefined && start >= 0n && stop <= view.size) {\n    const first = view.positions[Number(start)], last = view.positions[Number(stop)];\n    if (first > 0 && last > 0) return text.slice(first - 1, last - 1);\n  }\n  // Exact retained scan for cold views and invalid/interior/out-of-range offsets.\n  let position = 0n, started = false, output = \"\";\n  for (const char of text) {\n    const code = char.codePointAt(0) ?? 0;\n    const width = BigInt(code <= 0x7f ? 1 : code <= 0x7ff ? 2 : code <= 0xffff ? 3 : 4);\n    if (!started) {\n      if (position === start) started = true;\n      else { position += width; continue; }\n    }\n    if (position === stop) return output;\n    output += char; position += width;\n  }\n  return output;\n}\n"

def psTsRuntimeSupport : String := psTsJoin("\n", (_root_.List.cons(psTsStackRuntimeSupport, (_root_.List.cons(psTsUtf8RuntimeSupport, _root_.List.nil)))))
