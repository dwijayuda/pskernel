namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeStorageType(structures : List(PsWasmStructType), arrays : List(PsWasmArrayType), type : PsWasmStorageType) : Except(PsWasmEncodeError, (List(Nat))) := match type with {
  | packedI8 => Except.ok((_root_.List.cons((psWasmByte(120)), _root_.List.nil)))
  | packedI16 => Except.ok((_root_.List.cons((psWasmByte(119)), _root_.List.nil)))
  | value valueType => psWasmEncodeValueType(structures, arrays, valueType)
}
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeStructField(structures : List(PsWasmStructType), arrays : List(PsWasmArrayType), field : PsWasmStructField) : Except(PsWasmEncodeError, (List(Nat))) := match (psWasmEncodeStorageType(structures, arrays, field.storageType)) with {
  | Except.error error => Except.error(error)
  | Except.ok storage => Except.ok((psListAppend(storage, (_root_.List.cons((psWasmByte(0)), _root_.List.nil)))))
