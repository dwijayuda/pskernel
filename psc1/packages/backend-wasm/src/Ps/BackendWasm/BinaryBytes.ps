  | Option.none => Except.error((PsWasmEncodeError.unknownStructure(sourceType)))
  | Option.some sourceIndex => Except.ok((psListAppend((_root_.List.cons((psWasmByte(251)), _root_.List.nil)), (psListAppend((psWasmEncodeUleb(17)), (psListAppend((psWasmEncodeUleb(destinationIndex)), (psWasmEncodeUleb(sourceIndex)))))))))
