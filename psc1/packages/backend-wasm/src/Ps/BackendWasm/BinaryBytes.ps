namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeFunctionTypeIndicesLoop(structures : List(PsWasmStructType), arrays : List(PsWasmArrayType), functionTypes : List(PsWasmFunctionType), functionIndex : Nat, functions : List(PsWasmFunction)) : Except(PsWasmEncodeError, (List(Nat))) := psWasmEncodeFunctionTypeIndicesWorker(structures, arrays, functionTypes, functions, functionIndex)
