namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeFunctionBody(structures : List(PsWasmStructType), arrays : List(PsWasmArrayType), functionTypes : List(PsWasmFunctionType), functions : List(PsWasmFunction), function : PsWasmFunction) : Except(PsWasmEncodeError, (List(Nat))) := match (psWasmEncodeLocalDeclarations(structures, arrays, function.locals)) with {
