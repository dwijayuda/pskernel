namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeStructFields(structures : List(PsWasmStructType), arrays : List(PsWasmArrayType), fields : List(PsWasmStructField)) : Except(PsWasmEncodeError, (List(Nat))) := psListFlatMapExcept((psWasmEncodeStructField(structures, arrays)), fields)
