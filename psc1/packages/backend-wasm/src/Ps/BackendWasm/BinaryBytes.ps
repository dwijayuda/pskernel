namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeInstructions(structures : List(PsWasmStructType), arrays : List(PsWasmArrayType), functionTypes : List(PsWasmFunctionType), functions : List(PsWasmFunction), instructions : List(PsWasmInstruction)) : Except(PsWasmEncodeError, (List(Nat))) := psListFlatMapExcept((psWasmEncodeInstruction(structures, arrays, functionTypes, functions)), instructions)
