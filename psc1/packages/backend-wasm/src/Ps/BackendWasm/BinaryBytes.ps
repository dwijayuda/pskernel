namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeArrayType(structures : List(PsWasmStructType), arrays : List(PsWasmArrayType), arrayType : PsWasmArrayType) : Except(PsWasmEncodeError, (List(Nat))) := match (psWasmEncodeStorageType(structures, arrays, arrayType.elementType)) with {
