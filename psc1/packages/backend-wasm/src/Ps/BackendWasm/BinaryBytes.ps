end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeFunctionRefIndex(functions : List(PsWasmFunction), name : String) : Except(PsWasmEncodeError, (List(Nat))) := match (psWasmFindFunctionIndex(functions, name)) with {
  | Option.none => Except.error((PsWasmEncodeError.unknownFunction(name)))
  | Option.some index => Except.ok((psWasmEncodeUleb(index)))
}
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeFunctionRefIndices(functions : List(PsWasmFunction), names : List(String)) : Except(PsWasmEncodeError, (List(Nat))) := psListFlatMapExcept((psWasmEncodeFunctionRefIndex(functions)), names)
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeDeclarativeFunctionRefs(functions : List(PsWasmFunction), functionRefs : List(String)) : Except(PsWasmEncodeError, (List(Nat))) := match functionRefs with {
  | _root_.List.nil => Except.ok(_root_.List.nil)
  | _ => match (psWasmEncodeFunctionRefIndices(functions, functionRefs)) with {
  | Except.error error => Except.error(error)
  | Except.ok indices => let segment := (psListAppend((psWasmEncodeUleb(3)), (psListAppend((_root_.List.cons((psWasmByte(0)), _root_.List.nil)), (psWasmEncodeVector(indices, (psListLength(functionRefs))))))))
Except.ok((psWasmEncodeVector(segment, 1)))
}
}
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeExport(functions : List(PsWasmFunction), exportItem : Prod(String, String)) : Except(PsWasmEncodeError, (List(Nat))) := match (psWasmFindFunctionIndex(functions, (Prod.snd(exportItem)))) with {
  | Option.none => Except.error((PsWasmEncodeError.unknownFunction((Prod.snd(exportItem)))))
  | Option.some index => Except.ok((psListAppend((psWasmEncodeName((Prod.fst(exportItem)))), (List.cons((psWasmByte(0)), (psWasmEncodeUleb(index)))))))
}
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeExports(functions : List(PsWasmFunction), exports : List((_root_.Prod(String, String)))) : Except(PsWasmEncodeError, (List(Nat))) := psListFlatMapExcept((psWasmEncodeExport(functions)), exports)
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeSection(sectionId : Nat, payload : List(Nat)) : List(Nat) := psListAppend((_root_.List.cons((psWasmByte(sectionId)), _root_.List.nil)), (psListAppend((psWasmEncodeUleb((psListLength(payload)))), payload)))
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeTypeSectionPayload(encodedTypes : List(Nat), typeCount : Nat) : List(Nat) := if (Nat.beq(typeCount, 0)) { psWasmEncodeVector(List.nil, 0) } else { let recursiveGroup : List(Nat) := (psListAppend((_root_.List.cons((psWasmByte(78)), _root_.List.nil)), (psWasmEncodeVector(encodedTypes, typeCount))))
psWasmEncodeVector(recursiveGroup, 1) }
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
-- Indexed value/storage references resolve only into structures ++ arrays.
-- Keep that prefix mutually recursive. Function composites refer backward to
-- the heap prefix, never to later function types, so each can be a singleton
-- group. Flattened type indices stay unchanged; scalar ABI signatures no
-- longer inherit unrelated heap types' recursive-group identity.
def psWasmEncodeGroupedTypeSectionPayload(encodedHeapTypes : List(Nat), heapTypeCount : Nat, encodedFunctionTypes : List(Nat), functionTypeCount : Nat) : List(Nat) := if (Nat.beq(heapTypeCount, 0)) { psWasmEncodeVector(encodedFunctionTypes, functionTypeCount) } else { let recursiveGroup : List(Nat) := (psListAppend((List.cons((psWasmByte(78)), List.nil)), (psWasmEncodeVector(encodedHeapTypes, heapTypeCount))))
psWasmEncodeVector((psListAppend(recursiveGroup, encodedFunctionTypes)), (Nat.succ(functionTypeCount))) }
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeAbiImport(module : PsWasmModule, index : Nat, value : PsWasmFunctionImport) : Except(PsWasmEncodeError, (List(Nat))) := match (psWasmFunctionTypeIndex(module.structures, module.arrays, module.functionTypes, index, value.function)) with {
  | Except.error error => Except.error(error)
  | Except.ok typeIndex => Except.ok((psWasmEncodeByteChunks((_root_.List.cons((psWasmEncodeName(value.moduleName)), (_root_.List.cons((psWasmEncodeName(value.importName)), (_root_.List.cons((_root_.List.cons((psWasmByte(0)), _root_.List.nil)), (_root_.List.cons((psWasmEncodeUleb(typeIndex)), _root_.List.nil)))))))))))
}
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
-- Ordered, fully applied traversal preserves imported function type indices.
def psWasmEncodeAbiImportsWorker(module : PsWasmModule, index : Nat, imports : List(PsWasmFunctionImport)) : Except(PsWasmEncodeError, (List(Nat))) := match imports with {
  | List.nil => Except.ok(_root_.List.nil)
  | List.cons value rest => match (psWasmEncodeAbiImport(module, index, value)) with {
  | Except.error error => Except.error(error)
  | Except.ok first => match (psWasmEncodeAbiImportsWorker(module, (Nat.add(index, 1)), rest)) with {
  | Except.error error => Except.error(error)
  | Except.ok other => Except.ok((psListAppend(first, other)))
}
}
}
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeAbiImports(module : PsWasmModule) : Except(PsWasmEncodeError, (List(Nat))) := match (psWasmEncodeAbiImportsWorker(module, 0, module.functionImports)) with {
  | Except.error error => Except.error(error)
  | Except.ok encoded => let memoryImports := (if (module.abiMemoryImports) { psWasmEncodeByteChunks((_root_.List.cons((psWasmEncodeName("psc1:abi")), (_root_.List.cons((psWasmEncodeName("memory")), (_root_.List.cons((_root_.List.cons((psWasmByte(2)), (_root_.List.cons((psWasmByte(1)), _root_.List.nil)))), (_root_.List.cons((psWasmEncodeUleb(256)), (_root_.List.cons((psWasmEncodeUleb(256)), (_root_.List.cons((psWasmEncodeName("psc1:abi")), (_root_.List.cons((psWasmEncodeName("heap")), (_root_.List.cons((_root_.List.cons((psWasmByte(3)), (_root_.List.cons((psWasmByte(127)), (_root_.List.cons((psWasmByte(1)), _root_.List.nil)))))), (_root_.List.cons((psWasmEncodeName("psc1:abi")), (_root_.List.cons((psWasmEncodeName("busy")), (_root_.List.cons((_root_.List.cons((psWasmByte(3)), (_root_.List.cons((psWasmByte(127)), (_root_.List.cons((psWasmByte(1)), _root_.List.nil)))))), _root_.List.nil))))))))))))))))))))))) } else { _root_.List.nil })
Except.ok((psWasmEncodeVector((psListAppend(encoded, memoryImports)), ((psListLength(module.functionImports) + (if (module.abiMemoryImports) { 3 } else { 0 }))))))
}
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeModule(module : PsWasmModule) : Except(PsWasmEncodeError, (List(Nat))) := match (psWasmEncodeAbiImports(module)) with {
  | Except.error error => Except.error(error)
  | Except.ok encodedImports => let allFunctions := (psWasmAllFunctions(module))
match (psWasmEncodeStructTypes(module.structures, module.arrays, module.structures)) with {
  | Except.error error => Except.error(error)
