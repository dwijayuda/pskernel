namespace Ps.Internal.WasmBinaryBytes
def psWasmFunctionTypeIndex(structures : List(PsWasmStructType), arrays : List(PsWasmArrayType), functionTypes : List(PsWasmFunctionType), functionIndex : Nat, function : PsWasmFunction) : Except(PsWasmEncodeError, Nat) := match function.typeName with {
