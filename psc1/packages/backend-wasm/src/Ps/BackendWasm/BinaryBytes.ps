namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeLocalDeclaration(structures : List(PsWasmStructType), arrays : List(PsWasmArrayType), type : PsWasmValueType) : Except(PsWasmEncodeError, (List(Nat))) := match (psWasmEncodeValueType(structures, arrays, type)) with {
