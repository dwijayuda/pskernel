namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeStructCompositeType(structures : List(PsWasmStructType), arrays : List(PsWasmArrayType), structType : PsWasmStructType) : Except(PsWasmEncodeError, (List(Nat))) := match (psWasmEncodeStructFields(structures, arrays, structType.fields)) with {
