import Ps.BackendWasm.Model
import Ps.BackendWasm.IntUtil
import Ps.Foundation.Name
import Ps.Foundation.List

-- Ordered, fail-closed concatenation for encoded instruction lists.
inductive PsWasmEncodeError where {
  | unsupportedValueType
  | unsupportedInstruction
  | negativeIntegerConstant
  | unknownFunction(name : String)
  | unknownFunctionType(name : String)
  | unknownStructure(name : String)
}

namespace Ps.Internal.WasmBinaryBytes
-- Portable owned bytes use the already-qualified Nat carrier; every new byte
-- is normalized modulo 256. Native UInt8 conversion is a separate boundary.
def psListFlatMapExceptAcc {α : Type} {β : Type} {ε : Type}(convert : (_ : α) -> Except(ε, (List(β))), values : List(α), reversed : List(β)) : Except(ε, (List(β))) := match values with {
  | List.nil => Except.ok((psListReverse(reversed)))
  | List.cons value rest => match (convert(value)) with {
  | Except.error error => Except.error(error)
  | Except.ok first => psListFlatMapExceptAcc(convert, rest, (psListReverseAcc(first, reversed)))
}
}
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psListFlatMapExcept {α : Type} {β : Type} {ε : Type}(convert : (_ : α) -> Except(ε, (List(β))), values : List(α)) : Except(ε, (List(β))) := psListFlatMapExceptAcc(convert, values, List.nil)
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeByteChunksAcc(chunks : List((List(Nat))), reversed : List(Nat)) : List(Nat) := match chunks with {
  | List.nil => psListReverse(reversed)
  | List.cons chunk rest => psWasmEncodeByteChunksAcc(rest, (psListReverseAcc(chunk, reversed)))
}
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeByteChunks(chunks : List((List(Nat)))) : List(Nat) := psWasmEncodeByteChunksAcc(chunks, List.nil)
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmByte(value : Nat) : Nat := Nat.mod(value, 256)
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeUlebWithFuel(remainingFuel : Nat) : (_ : Nat) -> List(Nat) := match remainingFuel with {
  | _root_.Nat.zero => fun (_value : Nat) => List.nil
  | _root_.Nat.succ fuel => fun (value : Nat) => let smaller : (_ : Nat) -> List(Nat) := (psWasmEncodeUlebWithFuel(fuel))
let low := (Nat.mod(value, 128))
let rest := (Nat.div(value, 128))
if (Nat.beq(rest, 0)) { _root_.List.cons((psWasmByte(low)), _root_.List.nil) } else { List.cons((psWasmByte((Nat.add(low, 128)))), (smaller(rest))) }
}
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeUleb(value : Nat) : List(Nat) := psWasmEncodeUlebWithFuel(16, value)
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeSlebWithFuel(remainingFuel : Nat) : (_ : Int) -> List(Nat) := match remainingFuel with {
  | _root_.Nat.zero => fun (_value : Int) => List.nil
  | _root_.Nat.succ fuel => fun (value : Int) => let smaller : (_ : Int) -> List(Nat) := (psWasmEncodeSlebWithFuel(fuel))
let lowInt := (psWasmIntEModNat(value, 128))
let low := (psWasmIntToNat(lowInt))
let rest := (psWasmIntEDivNat(value, 128))
let signSet := (Nat.ble(64, low))
let donePositive := (if (psWasmIntIsZero(rest)) { if (signSet) { false } else { true } } else { false })
let doneNegative := (if (psWasmIntIsNegativeOne(rest)) { signSet } else { false })
if (donePositive) { _root_.List.cons((psWasmByte(low)), _root_.List.nil) } else { if (doneNegative) { _root_.List.cons((psWasmByte(low)), _root_.List.nil) } else { List.cons((psWasmByte((Nat.add(low, 128)))), (smaller(rest))) } }
}
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeSleb(value : Int) : List(Nat) := psWasmEncodeSlebWithFuel(16, value)
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmNormalizeI32Immediate(value : Int) : Int := let reduced := (psWasmIntEModNat(value, 4294967296))
if (Nat.ble(2147483648, (psWasmIntToNat(reduced)))) { Int.sub(reduced, (Int.ofNat(4294967296))) } else { reduced }
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmNormalizeI64Immediate(value : Int) : Int := let reduced := (psWasmIntEModNat(value, 18446744073709551616))
if (Nat.ble(9223372036854775808, (psWasmIntToNat(reduced)))) { Int.sub(reduced, (Int.ofNat(18446744073709551616))) } else { reduced }
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeI32Constant(value : Int) : List(Nat) := psWasmEncodeSleb((psWasmNormalizeI32Immediate(value)))
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeI64Constant(value : Int) : List(Nat) := psWasmEncodeSleb((psWasmNormalizeI64Immediate(value)))
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmStringToListFromWithFuel(remainingFuel : Nat) : (_ : String) -> (_ : Nat) -> List(Char) := match remainingFuel with {
  | Nat.zero => fun (_source : String) => fun (_position : Nat) => List.nil
  | Nat.succ fuel => fun (source : String) => fun (position : Nat) => let smaller : (_ : String) -> (_ : Nat) -> List(Char) := (psWasmStringToListFromWithFuel(fuel))
if (String.Internal.atEnd(source, (String.Pos.Raw.mk(position)))) { List.nil } else { let char : Char := (String.Internal.get(source, (String.Pos.Raw.mk(position))))
let nextPosition : Nat := (String.Pos.Raw.byteIdx((String.Internal.next(source, (String.Pos.Raw.mk(position))))))
List.cons(char, (smaller(source, nextPosition))) }
}
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmStringToListFrom(source : String, position : Nat) : List(Char) := psWasmStringToListFromWithFuel((Nat.succ((String.utf8ByteSize(source)))), source, position)
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmStringToList(source : String) : List(Char) := psWasmStringToListFrom(source, 0)
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeUtf8Char(char : Char) : List(Nat) := let value := (Char.toNat(char))
if (Nat.ble(value, 127)) { _root_.List.cons((psWasmByte(value)), _root_.List.nil) } else { if (Nat.ble(value, 2047)) { _root_.List.cons((psWasmByte((Nat.add(192, (Nat.div(value, 64)))))), (_root_.List.cons((psWasmByte((Nat.add(128, (Nat.mod(value, 64)))))), _root_.List.nil))) } else { if (Nat.ble(value, 65535)) { _root_.List.cons((psWasmByte((Nat.add(224, (Nat.div(value, 4096)))))), (_root_.List.cons((psWasmByte((Nat.add(128, (Nat.mod((Nat.div(value, 64)), 64)))))), (_root_.List.cons((psWasmByte((Nat.add(128, (Nat.mod(value, 64)))))), _root_.List.nil))))) } else { _root_.List.cons((psWasmByte((Nat.add(240, (Nat.div(value, 262144)))))), (_root_.List.cons((psWasmByte((Nat.add(128, (Nat.mod((Nat.div(value, 4096)), 64)))))), (_root_.List.cons((psWasmByte((Nat.add(128, (Nat.mod((Nat.div(value, 64)), 64)))))), (_root_.List.cons((psWasmByte((Nat.add(128, (Nat.mod(value, 64)))))), _root_.List.nil))))))) } } }
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeUtf8CharsAcc(chars : List(Char), reversed : List(Nat)) : List(Nat) := match chars with {
  | List.nil => psListReverse(reversed)
  | List.cons char rest => psWasmEncodeUtf8CharsAcc(rest, (psListReverseAcc((psWasmEncodeUtf8Char(char)), reversed)))
}
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeUtf8Chars(chars : List(Char)) : List(Nat) := psWasmEncodeUtf8CharsAcc(chars, List.nil)
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeName(name : String) : List(Nat) := let bytes := (psWasmEncodeUtf8Chars((psWasmStringToList(name))))
psListAppend((psWasmEncodeUleb((psListLength(bytes)))), bytes)
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmFindStructureIndexWorker(name : String, structures : List(PsWasmStructType)) : (_ : Nat) -> Option(Nat) := match structures with {
  | List.nil => fun (_index : Nat) => Option.none
  | List.cons structType rest => fun (index : Nat) => let smaller : (_ : Nat) -> Option(Nat) := (psWasmFindStructureIndexWorker(name, rest))
if (psStringEq(structType.name, name)) { Option.some(index) } else { smaller((Nat.add(index, 1))) }
}
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmFindStructureIndexLoop(name : String, index : Nat, structures : List(PsWasmStructType)) : Option(Nat) := psWasmFindStructureIndexWorker(name, structures, index)
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmFindStructureIndex(structures : List(PsWasmStructType), name : String) : Option(Nat) := psWasmFindStructureIndexLoop(name, 0, structures)
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmFindArrayIndexWorker(name : String, arrays : List(PsWasmArrayType)) : (_ : Nat) -> Option(Nat) := match arrays with {
  | List.nil => fun (_index : Nat) => Option.none
  | List.cons arrayType rest => fun (index : Nat) => let smaller : (_ : Nat) -> Option(Nat) := (psWasmFindArrayIndexWorker(name, rest))
if (psStringEq(arrayType.name, name)) { Option.some(index) } else { smaller((Nat.add(index, 1))) }
}
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmFindArrayIndexLoop(name : String, index : Nat, arrays : List(PsWasmArrayType)) : Option(Nat) := psWasmFindArrayIndexWorker(name, arrays, index)
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmFindArrayIndex(arrays : List(PsWasmArrayType), name : String) : Option(Nat) := psWasmFindArrayIndexLoop(name, 0, arrays)
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmFindHeapTypeIndex(structures : List(PsWasmStructType), arrays : List(PsWasmArrayType), name : String) : Option(Nat) := match (psWasmFindStructureIndex(structures, name)) with {
  | Option.some index => Option.some(index)
  | Option.none => match (psWasmFindArrayIndex(arrays, name)) with {
  | Option.none => Option.none
  | Option.some index => Option.some((Nat.add((psListLength(structures)), index)))
}
}
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeValueType(structures : List(PsWasmStructType), arrays : List(PsWasmArrayType), type : PsWasmValueType) : Except(PsWasmEncodeError, (List(Nat))) := match type with {
  | i32 => Except.ok((_root_.List.cons((psWasmByte(127)), _root_.List.nil)))
  | i64 => Except.ok((_root_.List.cons((psWasmByte(126)), _root_.List.nil)))
  | f32 => Except.ok((_root_.List.cons((psWasmByte(125)), _root_.List.nil)))
  | f64 => Except.ok((_root_.List.cons((psWasmByte(124)), _root_.List.nil)))
  | refT name => match (psWasmFindHeapTypeIndex(structures, arrays, name)) with {
  | Option.none => Except.error((PsWasmEncodeError.unknownStructure(name)))
  | Option.some index => Except.ok((psListAppend((_root_.List.cons((psWasmByte(100)), _root_.List.nil)), (psWasmEncodeSleb((Int.ofNat(index)))))))
}
  | funcRef => Except.ok((_root_.List.cons((psWasmByte(112)), _root_.List.nil)))
  | noValue => Except.error(PsWasmEncodeError.unsupportedValueType)
}
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeValueTypes(structures : List(PsWasmStructType), arrays : List(PsWasmArrayType), types : List(PsWasmValueType)) : Except(PsWasmEncodeError, (List(Nat))) := psListFlatMapExcept((psWasmEncodeValueType(structures, arrays)), types)
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeVector(bytes : List(Nat), count : Nat) : List(Nat) := psListAppend((psWasmEncodeUleb(count)), bytes)
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmFindFunctionTypeIndexWorker(name : String, functionTypes : List(PsWasmFunctionType)) : (_ : Nat) -> Option(Nat) := match functionTypes with {
  | List.nil => fun (_index : Nat) => Option.none
  | List.cons functionType rest => fun (index : Nat) => let smaller : (_ : Nat) -> Option(Nat) := (psWasmFindFunctionTypeIndexWorker(name, rest))
if (psStringEq(functionType.name, name)) { Option.some(index) } else { smaller((Nat.add(index, 1))) }
}
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmFindFunctionTypeIndexLoop(name : String, index : Nat, functionTypes : List(PsWasmFunctionType)) : Option(Nat) := psWasmFindFunctionTypeIndexWorker(name, functionTypes, index)
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmFindFunctionTypeIndex(structures : List(PsWasmStructType), arrays : List(PsWasmArrayType), functionTypes : List(PsWasmFunctionType), name : String) : Option(Nat) := match (psWasmFindFunctionTypeIndexLoop(name, 0, functionTypes)) with {
  | Option.none => Option.none
  | Option.some index => Option.some((Nat.add((Nat.add((psListLength(structures)), (psListLength(arrays)))), index)))
}
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeNamedFunctionType(structures : List(PsWasmStructType), arrays : List(PsWasmArrayType), functionType : PsWasmFunctionType) : Except(PsWasmEncodeError, (List(Nat))) := match (psWasmEncodeValueTypes(structures, arrays, functionType.parameters)) with {
  | Except.error error => Except.error(error)
  | Except.ok parameters => match (psWasmEncodeValueTypes(structures, arrays, functionType.results)) with {
  | Except.error error => Except.error(error)
  | Except.ok results => Except.ok((psListAppend((_root_.List.cons((psWasmByte(96)), _root_.List.nil)), (psListAppend((psWasmEncodeVector(parameters, (psListLength(functionType.parameters)))), (psWasmEncodeVector(results, (psListLength(functionType.results)))))))))
}
}
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeNamedFunctionTypes(structures : List(PsWasmStructType), arrays : List(PsWasmArrayType), functionTypesToEncode : List(PsWasmFunctionType)) : Except(PsWasmEncodeError, (List(Nat))) := psListFlatMapExcept((psWasmEncodeNamedFunctionType(structures, arrays)), functionTypesToEncode)
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeFunctionType(structures : List(PsWasmStructType), arrays : List(PsWasmArrayType), function : PsWasmFunction) : Except(PsWasmEncodeError, (List(Nat))) := match (psWasmEncodeValueTypes(structures, arrays, function.parameters)) with {
  | Except.error error => Except.error(error)
  | Except.ok parameters => match (psWasmEncodeValueTypes(structures, arrays, function.results)) with {
  | Except.error error => Except.error(error)
  | Except.ok results => Except.ok((psListAppend((_root_.List.cons((psWasmByte(96)), _root_.List.nil)), (psListAppend((psWasmEncodeVector(parameters, (psListLength(function.parameters)))), (psWasmEncodeVector(results, (psListLength(function.results)))))))))
}
}
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeFunctionTypes(structures : List(PsWasmStructType), arrays : List(PsWasmArrayType), functionsToEncode : List(PsWasmFunction)) : Except(PsWasmEncodeError, (List(Nat))) := psListFlatMapExcept((psWasmEncodeFunctionType(structures, arrays)), functionsToEncode)
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmFindFunctionIndexWorker(name : String, functions : List(PsWasmFunction)) : (_ : Nat) -> Option(Nat) := match functions with {
  | List.nil => fun (_index : Nat) => Option.none
  | List.cons function rest => fun (index : Nat) => let smaller : (_ : Nat) -> Option(Nat) := (psWasmFindFunctionIndexWorker(name, rest))
if (psStringEq(function.name, name)) { Option.some(index) } else { smaller((Nat.add(index, 1))) }
}
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmFindFunctionIndexLoop(name : String, index : Nat, functions : List(PsWasmFunction)) : Option(Nat) := psWasmFindFunctionIndexWorker(name, functions, index)
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmFindFunctionIndex(functions : List(PsWasmFunction), name : String) : Option(Nat) := psWasmFindFunctionIndexLoop(name, 0, functions)
end Ps.Internal.WasmBinaryBytes

namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeInstruction(structures : List(PsWasmStructType), arrays : List(PsWasmArrayType), functionTypes : List(PsWasmFunctionType), functions : List(PsWasmFunction), instruction : PsWasmInstruction) : Except(PsWasmEncodeError, (List(Nat))) := match instruction with {
  | i32Load offset => Except.ok((psListAppend((_root_.List.cons((psWasmByte(40)), (_root_.List.cons((psWasmByte(2)), _root_.List.nil)))), (psWasmEncodeUleb(offset)))))
  | i32Store offset => Except.ok((psListAppend((_root_.List.cons((psWasmByte(54)), (_root_.List.cons((psWasmByte(2)), _root_.List.nil)))), (psWasmEncodeUleb(offset)))))
  | i32Load8U => Except.ok((_root_.List.cons((psWasmByte(45)), (_root_.List.cons((psWasmByte(0)), (_root_.List.cons((psWasmByte(0)), _root_.List.nil)))))))
  | i32Store8 => Except.ok((_root_.List.cons((psWasmByte(58)), (_root_.List.cons((psWasmByte(0)), (_root_.List.cons((psWasmByte(0)), _root_.List.nil)))))))
  | abiHeapGet => Except.ok((_root_.List.cons((psWasmByte(35)), (_root_.List.cons((psWasmByte(0)), _root_.List.nil)))))
  | abiHeapSet => Except.ok((_root_.List.cons((psWasmByte(36)), (_root_.List.cons((psWasmByte(0)), _root_.List.nil)))))
  | abiBusyGet => Except.ok((_root_.List.cons((psWasmByte(35)), (_root_.List.cons((psWasmByte(1)), _root_.List.nil)))))
  | abiBusySet => Except.ok((_root_.List.cons((psWasmByte(36)), (_root_.List.cons((psWasmByte(1)), _root_.List.nil)))))
  | localGet index => Except.ok((List.cons((psWasmByte(32)), (psWasmEncodeUleb(index)))))
  | localSet index => Except.ok((List.cons((psWasmByte(33)), (psWasmEncodeUleb(index)))))
  | drop => Except.ok((_root_.List.cons((psWasmByte(26)), _root_.List.nil)))
  | unreachable => Except.ok((_root_.List.cons((psWasmByte(0)), _root_.List.nil)))
  | call name => match (psWasmFindFunctionIndex(functions, name)) with {
  | Option.none => Except.error((PsWasmEncodeError.unknownFunction(name)))
  | Option.some index => Except.ok((List.cons((psWasmByte(16)), (psWasmEncodeUleb(index)))))
}
  | returnCall name => match (psWasmFindFunctionIndex(functions, name)) with {
  | Option.none => Except.error((PsWasmEncodeError.unknownFunction(name)))
  | Option.some index => Except.ok((List.cons((psWasmByte(18)), (psWasmEncodeUleb(index)))))
}
  | return_ => Except.ok((_root_.List.cons((psWasmByte(15)), _root_.List.nil)))
  | ifStart result => match result with {
  | Option.none => Except.ok((_root_.List.cons((psWasmByte(4)), (_root_.List.cons((psWasmByte(64)), _root_.List.nil)))))
  | Option.some valueType => match (psWasmEncodeValueType(structures, arrays, valueType)) with {
  | Except.error error => Except.error(error)
  | Except.ok encodedType => Except.ok((psListAppend((_root_.List.cons((psWasmByte(4)), _root_.List.nil)), encodedType)))
}
}
  | else_ => Except.ok((_root_.List.cons((psWasmByte(5)), _root_.List.nil)))
  | end_ => Except.ok((_root_.List.cons((psWasmByte(11)), _root_.List.nil)))
  | i32Const value => Except.ok((List.cons((psWasmByte(65)), (psWasmEncodeI32Constant(value)))))
  | i64Const value => Except.ok((List.cons((psWasmByte(66)), (psWasmEncodeI64Constant(value)))))
  | i32Add => Except.ok((_root_.List.cons((psWasmByte(106)), _root_.List.nil)))
  | i32Sub => Except.ok((_root_.List.cons((psWasmByte(107)), _root_.List.nil)))
  | i32Mul => Except.ok((_root_.List.cons((psWasmByte(108)), _root_.List.nil)))
  | i32And => Except.ok((_root_.List.cons((psWasmByte(113)), _root_.List.nil)))
  | i32Or => Except.ok((_root_.List.cons((psWasmByte(114)), _root_.List.nil)))
  | i32Xor => Except.ok((_root_.List.cons((psWasmByte(115)), _root_.List.nil)))
  | i32ShrU => Except.ok((_root_.List.cons((psWasmByte(118)), _root_.List.nil)))
  | i32Extend8S => Except.ok((_root_.List.cons((psWasmByte(192)), _root_.List.nil)))
  | i32Extend16S => Except.ok((_root_.List.cons((psWasmByte(193)), _root_.List.nil)))
  | i32Eq => Except.ok((_root_.List.cons((psWasmByte(70)), _root_.List.nil)))
  | i32Ne => Except.ok((_root_.List.cons((psWasmByte(71)), _root_.List.nil)))
  | i32LtS => Except.ok((_root_.List.cons((psWasmByte(72)), _root_.List.nil)))
  | i32LtU => Except.ok((_root_.List.cons((psWasmByte(73)), _root_.List.nil)))
  | i32GtS => Except.ok((_root_.List.cons((psWasmByte(74)), _root_.List.nil)))
  | i32GtU => Except.ok((_root_.List.cons((psWasmByte(75)), _root_.List.nil)))
  | i32LeS => Except.ok((_root_.List.cons((psWasmByte(76)), _root_.List.nil)))
  | i32LeU => Except.ok((_root_.List.cons((psWasmByte(77)), _root_.List.nil)))
  | i32GeS => Except.ok((_root_.List.cons((psWasmByte(78)), _root_.List.nil)))
  | i32GeU => Except.ok((_root_.List.cons((psWasmByte(79)), _root_.List.nil)))
  | i64Add => Except.ok((_root_.List.cons((psWasmByte(124)), _root_.List.nil)))
  | i64Sub => Except.ok((_root_.List.cons((psWasmByte(125)), _root_.List.nil)))
  | i64Mul => Except.ok((_root_.List.cons((psWasmByte(126)), _root_.List.nil)))
  | i64And => Except.ok((_root_.List.cons((psWasmByte(131)), _root_.List.nil)))
  | i64Or => Except.ok((_root_.List.cons((psWasmByte(132)), _root_.List.nil)))
  | i64Xor => Except.ok((_root_.List.cons((psWasmByte(133)), _root_.List.nil)))
  | i64Eq => Except.ok((_root_.List.cons((psWasmByte(81)), _root_.List.nil)))
  | i64Ne => Except.ok((_root_.List.cons((psWasmByte(82)), _root_.List.nil)))
  | i64LtS => Except.ok((_root_.List.cons((psWasmByte(83)), _root_.List.nil)))
  | i64LtU => Except.ok((_root_.List.cons((psWasmByte(84)), _root_.List.nil)))
  | i64GtS => Except.ok((_root_.List.cons((psWasmByte(85)), _root_.List.nil)))
  | i64GtU => Except.ok((_root_.List.cons((psWasmByte(86)), _root_.List.nil)))
  | i64LeS => Except.ok((_root_.List.cons((psWasmByte(87)), _root_.List.nil)))
  | i64LeU => Except.ok((_root_.List.cons((psWasmByte(88)), _root_.List.nil)))
  | i64GeS => Except.ok((_root_.List.cons((psWasmByte(89)), _root_.List.nil)))
  | i64GeU => Except.ok((_root_.List.cons((psWasmByte(90)), _root_.List.nil)))
  | f32Eq => Except.ok((_root_.List.cons((psWasmByte(91)), _root_.List.nil)))
  | f32Ne => Except.ok((_root_.List.cons((psWasmByte(92)), _root_.List.nil)))
  | f32Lt => Except.ok((_root_.List.cons((psWasmByte(93)), _root_.List.nil)))
  | f32Gt => Except.ok((_root_.List.cons((psWasmByte(94)), _root_.List.nil)))
  | f32Le => Except.ok((_root_.List.cons((psWasmByte(95)), _root_.List.nil)))
  | f32Ge => Except.ok((_root_.List.cons((psWasmByte(96)), _root_.List.nil)))
  | f64Eq => Except.ok((_root_.List.cons((psWasmByte(97)), _root_.List.nil)))
  | f64Ne => Except.ok((_root_.List.cons((psWasmByte(98)), _root_.List.nil)))
  | f64Lt => Except.ok((_root_.List.cons((psWasmByte(99)), _root_.List.nil)))
  | f64Gt => Except.ok((_root_.List.cons((psWasmByte(100)), _root_.List.nil)))
  | f64Le => Except.ok((_root_.List.cons((psWasmByte(101)), _root_.List.nil)))
  | f64Ge => Except.ok((_root_.List.cons((psWasmByte(102)), _root_.List.nil)))
  | f32Add => Except.ok((_root_.List.cons((psWasmByte(146)), _root_.List.nil)))
  | f32Sub => Except.ok((_root_.List.cons((psWasmByte(147)), _root_.List.nil)))
  | f32Mul => Except.ok((_root_.List.cons((psWasmByte(148)), _root_.List.nil)))
  | f32Div => Except.ok((_root_.List.cons((psWasmByte(149)), _root_.List.nil)))
  | f64Add => Except.ok((_root_.List.cons((psWasmByte(160)), _root_.List.nil)))
  | f64Sub => Except.ok((_root_.List.cons((psWasmByte(161)), _root_.List.nil)))
  | f64Mul => Except.ok((_root_.List.cons((psWasmByte(162)), _root_.List.nil)))
  | f64Div => Except.ok((_root_.List.cons((psWasmByte(163)), _root_.List.nil)))
  | structNew typeName => match (psWasmFindStructureIndex(structures, typeName)) with {
  | Option.none => Except.error((PsWasmEncodeError.unknownStructure(typeName)))
  | Option.some typeIndex => Except.ok((psListAppend((_root_.List.cons((psWasmByte(251)), _root_.List.nil)), (psListAppend((psWasmEncodeUleb(0)), (psWasmEncodeUleb(typeIndex)))))))
}
  | structGet typeName fieldIndex => match (psWasmFindStructureIndex(structures, typeName)) with {
  | Option.none => Except.error((PsWasmEncodeError.unknownStructure(typeName)))
  | Option.some typeIndex => Except.ok((psListAppend((_root_.List.cons((psWasmByte(251)), _root_.List.nil)), (psListAppend((psWasmEncodeUleb(2)), (psListAppend((psWasmEncodeUleb(typeIndex)), (psWasmEncodeUleb(fieldIndex)))))))))
}
  | structGetS typeName fieldIndex => match (psWasmFindStructureIndex(structures, typeName)) with {
  | Option.none => Except.error((PsWasmEncodeError.unknownStructure(typeName)))
  | Option.some typeIndex => Except.ok((psListAppend((_root_.List.cons((psWasmByte(251)), _root_.List.nil)), (psListAppend((psWasmEncodeUleb(3)), (psListAppend((psWasmEncodeUleb(typeIndex)), (psWasmEncodeUleb(fieldIndex)))))))))
}
  | structGetU typeName fieldIndex => match (psWasmFindStructureIndex(structures, typeName)) with {
  | Option.none => Except.error((PsWasmEncodeError.unknownStructure(typeName)))
  | Option.some typeIndex => Except.ok((psListAppend((_root_.List.cons((psWasmByte(251)), _root_.List.nil)), (psListAppend((psWasmEncodeUleb(4)), (psListAppend((psWasmEncodeUleb(typeIndex)), (psWasmEncodeUleb(fieldIndex)))))))))
}
  | arrayNew typeName => match (psWasmFindHeapTypeIndex(structures, arrays, typeName)) with {
  | Option.none => Except.error((PsWasmEncodeError.unknownStructure(typeName)))
  | Option.some typeIndex => Except.ok((psListAppend((_root_.List.cons((psWasmByte(251)), _root_.List.nil)), (psListAppend((psWasmEncodeUleb(6)), (psWasmEncodeUleb(typeIndex)))))))
}
  | arrayNewDefault typeName => match (psWasmFindHeapTypeIndex(structures, arrays, typeName)) with {
  | Option.none => Except.error((PsWasmEncodeError.unknownStructure(typeName)))
  | Option.some typeIndex => Except.ok((psListAppend((_root_.List.cons((psWasmByte(251)), _root_.List.nil)), (psListAppend((psWasmEncodeUleb(7)), (psWasmEncodeUleb(typeIndex)))))))
}
  | arrayNewFixed typeName length => match (psWasmFindHeapTypeIndex(structures, arrays, typeName)) with {
  | Option.none => Except.error((PsWasmEncodeError.unknownStructure(typeName)))
  | Option.some typeIndex => Except.ok((psListAppend((_root_.List.cons((psWasmByte(251)), _root_.List.nil)), (psListAppend((psWasmEncodeUleb(8)), (psListAppend((psWasmEncodeUleb(typeIndex)), (psWasmEncodeUleb(length)))))))))
}
  | arrayGet typeName => match (psWasmFindHeapTypeIndex(structures, arrays, typeName)) with {
  | Option.none => Except.error((PsWasmEncodeError.unknownStructure(typeName)))
  | Option.some typeIndex => Except.ok((psListAppend((_root_.List.cons((psWasmByte(251)), _root_.List.nil)), (psListAppend((psWasmEncodeUleb(11)), (psWasmEncodeUleb(typeIndex)))))))
}
  | arrayGetS typeName => match (psWasmFindHeapTypeIndex(structures, arrays, typeName)) with {
  | Option.none => Except.error((PsWasmEncodeError.unknownStructure(typeName)))
  | Option.some typeIndex => Except.ok((psListAppend((_root_.List.cons((psWasmByte(251)), _root_.List.nil)), (psListAppend((psWasmEncodeUleb(12)), (psWasmEncodeUleb(typeIndex)))))))
}
  | arrayGetU typeName => match (psWasmFindHeapTypeIndex(structures, arrays, typeName)) with {
  | Option.none => Except.error((PsWasmEncodeError.unknownStructure(typeName)))
  | Option.some typeIndex => Except.ok((psListAppend((_root_.List.cons((psWasmByte(251)), _root_.List.nil)), (psListAppend((psWasmEncodeUleb(13)), (psWasmEncodeUleb(typeIndex)))))))
}
  | arraySet typeName => match (psWasmFindHeapTypeIndex(structures, arrays, typeName)) with {
  | Option.none => Except.error((PsWasmEncodeError.unknownStructure(typeName)))
  | Option.some typeIndex => Except.ok((psListAppend((_root_.List.cons((psWasmByte(251)), _root_.List.nil)), (psListAppend((psWasmEncodeUleb(14)), (psWasmEncodeUleb(typeIndex)))))))
}
  | arrayLen => Except.ok((psListAppend((_root_.List.cons((psWasmByte(251)), _root_.List.nil)), (psWasmEncodeUleb(15)))))
  | arrayCopy destinationType sourceType => match (psWasmFindHeapTypeIndex(structures, arrays, destinationType)) with {
  | Option.none => Except.error((PsWasmEncodeError.unknownStructure(destinationType)))
