namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeLocalDeclarations(structures : List(PsWasmStructType), arrays : List(PsWasmArrayType), types : List(PsWasmValueType)) : Except(PsWasmEncodeError, (List(Nat))) := psListFlatMapExcept((psWasmEncodeLocalDeclaration(structures, arrays)), types)
