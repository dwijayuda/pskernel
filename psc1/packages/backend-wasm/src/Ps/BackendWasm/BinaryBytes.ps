  | returnCallRef typeName => match (psWasmFindFunctionTypeIndex(structures, arrays, functionTypes, typeName)) with {
  | Option.none => Except.error((PsWasmEncodeError.unknownFunctionType(typeName)))
  | Option.some typeIndex => Except.ok((psListAppend((_root_.List.cons((psWasmByte(21)), _root_.List.nil)), (psWasmEncodeUleb(typeIndex)))))
