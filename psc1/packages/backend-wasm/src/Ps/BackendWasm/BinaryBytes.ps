namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeFunctionBodies(structures : List(PsWasmStructType), arrays : List(PsWasmArrayType), functionTypes : List(PsWasmFunctionType), functions : List(PsWasmFunction), functionsToEncode : List(PsWasmFunction)) : Except(PsWasmEncodeError, (List(Nat))) := psListFlatMapExcept((psWasmEncodeFunctionBody(structures, arrays, functionTypes, functions)), functionsToEncode)
