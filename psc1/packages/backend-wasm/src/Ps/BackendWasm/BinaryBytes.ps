namespace Ps.Internal.WasmBinaryBytes
def psWasmEncodeArrayTypes(structures : List(PsWasmStructType), arrays : List(PsWasmArrayType), arrayTypes : List(PsWasmArrayType)) : Except(PsWasmEncodeError, (List(Nat))) := psListFlatMapExcept((psWasmEncodeArrayType(structures, arrays)), arrayTypes)
