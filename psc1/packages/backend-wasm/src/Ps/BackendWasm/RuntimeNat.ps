def psWasmNatLiteralInstructionsWithFuel(remainingFuel : Nat) : (_ : Nat) -> List(PsWasmInstruction) := match remainingFuel with {
  | _root_.Nat.zero => fun (_value : Nat) => _root_.List.cons((PsWasmInstruction.structNew(psWasmNatZeroName)), _root_.List.nil)
  | _root_.Nat.succ fuel => fun (value : Nat) => let smaller : (_ : Nat) -> List(PsWasmInstruction) := (psWasmNatLiteralInstructionsWithFuel(fuel))
if (Nat.beq(value, 0)) { _root_.List.cons((PsWasmInstruction.structNew(psWasmNatZeroName)), _root_.List.nil) } else { let half := (Nat.div(value, 2))
let low := (Nat.mod(value, 2))
let suffix := (if (Nat.beq(low, 0)) { _root_.List.cons((PsWasmInstruction.structNew(psWasmNatBit0Name)), _root_.List.nil) } else { _root_.List.cons((PsWasmInstruction.call(psWasmNatBit1Fn)), _root_.List.nil) })
psListAppend((smaller(half)), suffix) }
}

def psWasmNatLiteralInstructions(value : Nat) : List(PsWasmInstruction) := psWasmNatLiteralInstructionsWithFuel((Nat.add(value, 1)), value)
