import Ps.BackendWasm.RuntimeString
import Ps.BackendWasm.RuntimeInt
import Ps.BackendCommon.Plan

-- Explicit self-host transport only. No imports, native callbacks or compiler
-- semantics cross this boundary; opaque GC values stay owned by WebAssembly.
def psWasmServiceFunction(name : String, parameters : List(PsWasmValueType), results : List(PsWasmValueType), locals : List(PsWasmValueType), body : List(PsWasmInstruction)) : PsWasmFunction := PsWasmFunction.mk(name, Option.none, parameters, results, locals, body)

def psWasmServiceStringFunctions : List(PsWasmFunction) := _root_.List.cons((psWasmServiceFunction("__psc1_service_string_new", (_root_.List.cons(PsWasmValueType.i32, _root_.List.nil)), (_root_.List.cons(psWasmStringCharsRef, _root_.List.nil)), _root_.List.nil, (_root_.List.cons((PsWasmInstruction.localGet(0)), (_root_.List.cons((PsWasmInstruction.arrayNewDefault(psWasmStringCharsName)), _root_.List.nil)))))), (_root_.List.cons((psWasmServiceFunction("__psc1_service_string_set", (_root_.List.cons(psWasmStringCharsRef, (_root_.List.cons(PsWasmValueType.i32, (_root_.List.cons(PsWasmValueType.i32, _root_.List.nil)))))), _root_.List.nil, _root_.List.nil, (_root_.List.cons((PsWasmInstruction.localGet(2)), (_root_.List.cons((PsWasmInstruction.call(psWasmCharUtf8WidthFn)), (_root_.List.cons(PsWasmInstruction.drop, (_root_.List.cons((PsWasmInstruction.localGet(0)), (_root_.List.cons((PsWasmInstruction.localGet(1)), (_root_.List.cons((PsWasmInstruction.localGet(2)), (_root_.List.cons((PsWasmInstruction.arraySet(psWasmStringCharsName)), _root_.List.nil)))))))))))))))), (_root_.List.cons((psWasmServiceFunction("__psc1_service_string_finish", (_root_.List.cons(psWasmStringCharsRef, _root_.List.nil)), (_root_.List.cons(psWasmStringRef, _root_.List.nil)), _root_.List.nil, (_root_.List.cons((PsWasmInstruction.localGet(0)), (_root_.List.cons((PsWasmInstruction.call(psWasmStringFromCharsFn)), _root_.List.nil)))))), (_root_.List.cons((psWasmServiceFunction("__psc1_service_string_size", (_root_.List.cons(psWasmStringRef, _root_.List.nil)), (_root_.List.cons(PsWasmValueType.i32, _root_.List.nil)), _root_.List.nil, (_root_.List.cons((PsWasmInstruction.localGet(0)), (_root_.List.cons((PsWasmInstruction.structGet(psWasmStringName, 0)), (_root_.List.cons(PsWasmInstruction.arrayLen, _root_.List.nil)))))))), (_root_.List.cons((psWasmServiceFunction("__psc1_service_string_byte", (_root_.List.cons(psWasmStringRef, (_root_.List.cons(PsWasmValueType.i32, _root_.List.nil)))), (_root_.List.cons(PsWasmValueType.i32, _root_.List.nil)), _root_.List.nil, (_root_.List.cons((PsWasmInstruction.localGet(0)), (_root_.List.cons((PsWasmInstruction.structGet(psWasmStringName, 0)), (_root_.List.cons((PsWasmInstruction.localGet(1)), (_root_.List.cons((PsWasmInstruction.arrayGetU(psWasmStringBytesName)), _root_.List.nil)))))))))), _root_.List.nil)))))))))

def psWasmServiceNatFunctions : List(PsWasmFunction) := _root_.List.cons((psWasmServiceFunction("__psc1_service_nat_is_zero", (_root_.List.cons(psWasmNatRef, _root_.List.nil)), (_root_.List.cons(PsWasmValueType.i32, _root_.List.nil)), _root_.List.nil, (_root_.List.cons((PsWasmInstruction.localGet(0)), (_root_.List.cons((PsWasmInstruction.refTest(psWasmNatZeroName)), _root_.List.nil)))))), _root_.List.nil)

def psWasmServiceIntFunctions : List(PsWasmFunction) := _root_.List.cons((psWasmServiceFunction("__psc1_service_int_sign", (_root_.List.cons(psWasmIntRef, _root_.List.nil)), (_root_.List.cons(PsWasmValueType.i32, _root_.List.nil)), _root_.List.nil, (_root_.List.cons((PsWasmInstruction.localGet(0)), (_root_.List.cons((PsWasmInstruction.structGet(psWasmIntName, 0)), _root_.List.nil)))))), (_root_.List.cons((psWasmServiceFunction("__psc1_service_int_magnitude", (_root_.List.cons(psWasmIntRef, _root_.List.nil)), (_root_.List.cons(psWasmNatRef, _root_.List.nil)), _root_.List.nil, (_root_.List.cons((PsWasmInstruction.localGet(0)), (_root_.List.cons((PsWasmInstruction.structGet(psWasmIntName, 1)), _root_.List.nil)))))), _root_.List.nil)))

def psWasmServiceHasType(name : String, module : PsWasmModule) : Bool := psListAny((fun (type : PsWasmStructType) => psStringEq(type.name, name)), module.structures)

def psWasmServiceSelectExports(publicNames : List(String), exports : List((Prod(String, String)))) : List((Prod(String, String))) := match exports with {
  | List.nil => _root_.List.nil
  | List.cons entry rest => if (psBackendNameSeen(entry.fst, publicNames)) { List.cons(entry, (psWasmServiceSelectExports(publicNames, rest))) } else { psWasmServiceSelectExports(publicNames, rest) }
}

def psWasmServiceTransport(module : PsWasmModule, publicNames : List(String)) : PsWasmModule := let nat := (psWasmServiceHasType(psWasmNatName, module))
let functions := (psListAppend((if (nat) { psWasmServiceNatFunctions } else { _root_.List.nil }), (psListAppend((if (psWasmServiceHasType(psWasmStringName, module)) { psWasmServiceStringFunctions } else { _root_.List.nil }), (if (psWasmServiceHasType(psWasmIntName, module)) { psWasmServiceIntFunctions } else { _root_.List.nil })))))
let helperExports := (psListMap((fun (function : PsWasmFunction) => Prod.mk(function.name, function.name)), functions))
let intExports := (if (psWasmServiceHasType(psWasmIntName, module)) { _root_.List.cons((Prod.mk("__psc1_service_int_of_nat", psWasmIntOfNatFn)), (_root_.List.cons((Prod.mk("__psc1_service_int_neg", psWasmIntNegFn)), _root_.List.nil))) } else { _root_.List.nil })
let natExports := (if (nat) { _root_.List.cons((Prod.mk("__psc1_service_nat_half", psWasmNatHalfFn)), (_root_.List.cons((Prod.mk("__psc1_service_nat_low", psWasmNatLowFn)), (_root_.List.cons((Prod.mk("__psc1_service_nat_of_u32", psWasmNatOfU32Fn)), (_root_.List.cons((Prod.mk("__psc1_service_nat_bit0", psWasmNatMkBit0Fn)), (_root_.List.cons((Prod.mk("__psc1_service_nat_bit1", psWasmNatBit1Fn)), _root_.List.nil))))))))) } else { _root_.List.nil })
let exports := (psWasmServiceSelectExports(publicNames, module.exports))
{ structures := module.structures, arrays := module.arrays, functionTypes := module.functionTypes, functions := psListAppend(module.functions, functions), functionRefs := module.functionRefs, exports := psListAppend(exports, (psListAppend(helperExports, (psListAppend(natExports, intExports))))), abiMemory := module.abiMemory, abiMemoryImports := module.abiMemoryImports, abiGlobalsExport := module.abiGlobalsExport, functionImports := module.functionImports }
