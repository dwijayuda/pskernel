{
  "name": "@proofscript/compiler",
  "version": "0.1.0-psc1.13",
  "description": "ProofScript PSC1 qualified shared compiler and checked API",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.23.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwijayuda/pskernel.git",
    "directory": "psc1/packages/compiler"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./sources": "./dist/source-manifest.json",
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.js"
    },
    "./io": {
      "types": "./dist/implementation/host-tools/typed-io.d.ts",
      "import": "./dist/implementation/host-tools/typed-io.mjs"
    },
    "./metadata": "./dist/implementation/UNIVERSAL_DISTRIBUTION.json"
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "proofscript": {
    "npmArchitecture": "psc1-existing-packages-compiler-owner/1",
    "implementationOwner": "@proofscript/compiler",
    "internalCompilerModules": false,
    "packageKind": "qualified-shared-compiler",
    "canonicalSources": "src/**/*.ps",
    "sourceVariants": [
      "ps",
      "lean"
    ],
    "publishingRequiresQualification": true,
    "compilerInputGrammars": [
      "lean",
      "ps"
    ],
    "canonicalGrammar": "ps",
    "sourceOwnership": {
      "role": "canonical-editable-proofscript",
      "manifest": "dist/source-manifest.json",
      "repositoryManifest": "psc1/CANONICAL_SOURCES.json"
    },
    "bootstrapReferences": {
      "grammar": "lean",
      "role": "immutable-checked-bootstrap-reference",
      "manifest": "dist/source-manifest.json"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs build --package compiler",
    "clean": "node ../../scripts/build-packages.mjs clean --package compiler"
  },
  "dependencies": {
    "@proofscript/pskernel-lean-wasm": "4.35.0-psc1.13"
  },
  "peerDependencies": {
    "@proofscript/pskernel-lean": "4.35.0-psc1.13",
    "@proofscript/compiler-rust-linux-x64": "0.1.0-psc1.11",
    "@proofscript/compiler-wasm": "0.1.0-psc1.11",
    "@proofscript/wasm-component-tools-linux-x64": "0.1.0-psc1.11",
    "typescript": "7.0.2",
    "@proofscript/rust-target-consumer-linux-x64": "0.1.0-psc1.6"
  },
  "peerDependenciesMeta": {
    "@proofscript/pskernel-lean": {
      "optional": true
    },
    "@proofscript/compiler-rust-linux-x64": {
      "optional": true
    },
    "@proofscript/compiler-wasm": {
      "optional": true
    },
    "@proofscript/wasm-component-tools-linux-x64": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "@proofscript/rust-target-consumer-linux-x64": {
      "optional": true
    }
  }
}
