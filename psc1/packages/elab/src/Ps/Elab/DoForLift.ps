import Ps.Elab.DoLoopLift
import Ps.Environment.Control

-- Specialize finite Nat iteration before admission. Helpers remain total
-- Nat.rec definitions; erased theorems require official conversion equality.
def psElabDoForLiftName(owner : PsName, index : Nat) : PsName := PsName.num((PsName.str(owner, "_psc1ForBody")), index)

def psElabDoForIsLiftedName(name : PsName) : Bool := match name with {
  | PsName.num parent _ => match parent with {
  | PsName.str _ segment => psStringEq(segment, "_psc1ForBody")
  | _ => false
}
  | PsName.str parent segment => (psStringEq(segment, "_psc1ForEquivalence") && psElabDoForIsLiftedName(parent))
  | _ => false
}

def psElabDoForLiftEta(fuel : Nat, environment : PsEnvironment, locals : PsLocalContext, type : PsExpr, value : PsExpr) : Except(PsElabError, PsExpr) := match fuel with {
  | Nat.zero => Except.error(PsElabError.fuelExhausted)
  | Nat.succ remaining => match (psWhnf(environment, psMetaEmpty, locals, type)) with {
  | PsExpr.forallE name domain body binder => let pushed := (psLocalPushBinding(locals, name, domain, binder))
let id := pushed.id
match (psElabDoForLiftEta(remaining, environment, pushed.context, (psExprInstantiate1(body, (PsExpr.fvar(id)))), (PsExpr.app(value, (PsExpr.fvar(id)))))) with {
  | Except.error error => Except.error(error)
  | Except.ok nested => Except.ok((PsExpr.lam(name, domain, (psExprAbstractFVar(id, nested)), binder)))
}
  | _ => Except.ok(value)
}
}

def psElabDoForLiftMinor(step : PsExpr, index : PsExpr, rest : PsExpr, placeholder : PsName) : Except(PsElabError, PsExpr) := match step with {
  | PsExpr.lam _ _ first _ => match (psExprInstantiate1(first, index)) with {
  | PsExpr.lam _ _ second _ => match (psElabDoLoopNormalize(4096, placeholder, (psExprInstantiate1(second, rest)))) with {
  | Except.error error => Except.error(error)
  | Except.ok body => Except.ok(body)
}
  | _ => Except.error(PsElabError.unsupportedTerm)
}
  | _ => Except.error(PsElabError.unsupportedTerm)
}

-- Expanding a known local lambda duplicates only an evaluated closure value.
-- Calls and other strict computations stay in their original source lets.
def psElabDoForBaseLambda(fuel : Nat, locals : PsLocalContext, term : PsExpr) : PsExpr := match fuel with {
  | Nat.zero => term
  | Nat.succ remaining => match term with {
  | PsExpr.fvar id => match (psLocalFindById(locals, id)) with {
  | Option.some declaration => match declaration with {
  | PsLocalDecl.letDecl _ _ _ value => match value with {
  | PsExpr.lam _ _ _ _ => value
  | PsExpr.fvar _ => let expanded : PsExpr := (psElabDoForBaseLambda(remaining, locals, value))
match expanded with {
  | PsExpr.lam _ _ _ _ => expanded
  | _ => term
}
  | _ => term
}
  | _ => term
}
  | Option.none => term
}
  | _ => term
}
}

def psElabDoForSpecialize(owner : PsName, ownerType : PsExpr, locals : PsLocalContext, work : PsElabDoLoopLiftState, resultType : PsExpr, base : PsExpr, step : PsExpr, count : PsExpr) : Except(PsElabError, PsElabDoLoopLiftResult) := let base : PsExpr := (psElabDoForBaseLambda(64, locals, base))
let name := (psElabDoForLiftName(owner, work.nextIndex))
let placeholder := (PsName.str(name, "_psc1Induction"))
let capturesRev := (psElabDoLoopCaptures((_root_.List.cons(resultType, (_root_.List.cons(base, (_root_.List.cons(step, _root_.List.nil)))))), locals.declarations))
let captures := (psListReverse(capturesRev))
let captureArguments := (psElabDoLoopCaptureArguments(captures))
let natType := (PsExpr.constE(psNatName, _root_.List.nil))
let countId := locals.nextId
let indexId := (Nat.succ(countId))
let restId := (Nat.succ(indexId))
let sourceId := (Nat.succ(restId))
let predicateId := (Nat.succ(sourceId))
let witnessId := (Nat.succ(predicateId))
let countName := (psRootName("_psc1ForCount"))
let bindersRev := (List.cons((Prod.mk(countId, (Prod.mk(countName, natType)))), (psElabDoLoopCaptureBinders(capturesRev))))
let closedType := (psElabDoLoopCloseType(bindersRev, resultType))
let captureSource := (((psElabDoLoopOccurs(owner, closedType) || psElabDoLoopOccurs(owner, step)) || psElabDoLoopOccurs(owner, base)))
let sourceName := (psRootName("_psc1SourceFunction"))
let closeSourceType : (_ : PsExpr) -> PsExpr := (fun (term : PsExpr) => if (captureSource) { PsExpr.forallE(sourceName, ownerType, (psExprAbstractFVar(sourceId, (psElabDoLoopReplaceOwner(owner, (PsExpr.fvar(sourceId)), term)))), PsBinderInfo.explicit) } else { term })
let closeSourceValue : (_ : PsExpr) -> PsExpr := (fun (term : PsExpr) => if (captureSource) { PsExpr.lam(sourceName, ownerType, (psExprAbstractFVar(sourceId, (psElabDoLoopReplaceOwner(owner, (PsExpr.fvar(sourceId)), term)))), PsBinderInfo.explicit) } else { term })
let helperType := (closeSourceType(closedType))
let sourceArguments := (if (captureSource) { _root_.List.cons((PsExpr.constE(owner, _root_.List.nil)), _root_.List.nil) } else { _root_.List.nil })
let argumentPrefix := (psListAppend(sourceArguments, captureArguments))
let withCount := (psLocalPushBinding(locals, countName, natType, PsBinderInfo.explicit))
let withIndex := (psLocalPushBinding(withCount.context, (psRootName("_psc1ForIndex")), natType, PsBinderInfo.explicit))
let withRest := (psLocalPushBinding(withIndex.context, (psRootName("_psc1ForRest")), resultType, PsBinderInfo.explicit))
match (psElabDoForLiftEta(4096, work.environment, withRest.context, resultType, base)) with {
  | Except.error error => Except.error(error)
  | Except.ok etaBase => let deferred := (PsExpr.lam((psRootName("_unit")), (PsExpr.constE(psUnitName, _root_.List.nil)), (PsExpr.constE(placeholder, _root_.List.nil)), PsBinderInfo.explicit))
match (psElabDoForLiftMinor(step, (PsExpr.fvar(indexId)), deferred, placeholder)) with {
  | Except.error error => Except.error(error)
  | Except.ok body => let body := (psElabDoLoopReplaceOwner(placeholder, (PsExpr.fvar(restId)), body))
let minor := (PsExpr.lam((psRootName("_psc1ForIndex")), natType, (psExprAbstractFVar(indexId, (PsExpr.lam((psRootName("_psc1ForRest")), resultType, (psExprAbstractFVar(restId, body)), PsBinderInfo.explicit)))), PsBinderInfo.explicit))
let motive := (PsExpr.lam((psRootName("_major")), natType, (psExprLiftBVars(1, 0, resultType)), PsBinderInfo.explicit))
let value := (psExprApplyMany((PsExpr.constE(psNatRecName, (_root_.List.cons((PsLevel.succ(PsLevel.zero)), _root_.List.nil)))), (_root_.List.cons(motive, (_root_.List.cons(etaBase, (_root_.List.cons(minor, (_root_.List.cons((PsExpr.fvar(countId)), _root_.List.nil))))))))))
let helperValue := (closeSourceValue((psElabDoLoopCloseValue(bindersRev, value))))
let declaration := (PsDeclaration.definitionDecl(name, _root_.List.nil, helperType, helperValue))
match (psEnvironmentAdd(work.environment, declaration)) with {
  | Option.none => Except.error((PsElabError.duplicateDeclaration(name)))
  | Option.some environment => match (psElabDoLoopCheck(environment, psLocalEmpty, helperValue, helperType)) with {
  | Except.error error => Except.error(error)
  | Except.ok _ => let original := (psExprApplyMany((PsExpr.constE(psControlLazyNatFoldName, _root_.List.nil)), (_root_.List.cons(resultType, (_root_.List.cons(base, (_root_.List.cons(step, (_root_.List.cons((PsExpr.fvar(countId)), _root_.List.nil))))))))))
let replacement := (psExprApplyMany((PsExpr.constE(name, _root_.List.nil)), (psListAppend(argumentPrefix, (_root_.List.cons((PsExpr.fvar(countId)), _root_.List.nil))))))
let predicateType := (PsExpr.forallE((psRootName("_value")), resultType, (PsExpr.sortE(PsLevel.zero)), PsBinderInfo.explicit))
let proofBinders := (psListAppend((_root_.List.cons((Prod.mk(witnessId, (Prod.mk((psRootName("_h")), (PsExpr.app((PsExpr.fvar(predicateId)), original)))))), (_root_.List.cons((Prod.mk(predicateId, (Prod.mk((psRootName("_P")), predicateType)))), _root_.List.nil)))), bindersRev))
let proofType := (closeSourceType((psElabDoLoopCloseType(proofBinders, (PsExpr.app((PsExpr.fvar(predicateId)), replacement))))))
let proofValue := (closeSourceValue((psElabDoLoopCloseValue(proofBinders, (PsExpr.fvar(witnessId))))))
let proof := (PsDeclaration.theoremDecl((PsName.str(name, "_psc1ForEquivalence")), _root_.List.nil, proofType, proofValue))
let call := (psExprApplyMany((PsExpr.constE(name, _root_.List.nil)), (psListAppend(argumentPrefix, (_root_.List.cons(count, _root_.List.nil))))))
match (psElabDoLoopCheck(environment, locals, call, resultType)) with {
  | Except.error error => Except.error(error)
  | Except.ok _ => let state := (PsElabDoLoopLiftState.mk(environment, (List.cons(proof, (List.cons(declaration, work.declarationsRev)))), (Nat.succ(work.nextIndex))))
Except.ok((PsElabDoLoopLiftResult.mk(call, state)))
}
}
}
}
}

structure PsElabDoForLiftCall where {
  resultType : PsExpr
  base : PsExpr
  step : PsExpr
  count : PsExpr
}

def psElabDoForLiftApplication(term : PsExpr) : Option(PsElabDoForLiftCall) := let view := (psExprAppView(term))
match view.head with {
  | PsExpr.constE name levels => if ((psNameEq(name, psControlLazyNatFoldName) && psListIsEmpty(levels))) { match view.args with {
  | List.nil => Option.none
  | List.cons resultType a => match a with {
  | List.nil => Option.none
  | List.cons base b => match b with {
  | List.nil => Option.none
  | List.cons step c => match c with {
  | List.nil => Option.none
  | List.cons count rest => match rest with {
  | List.nil => Option.some((PsElabDoForLiftCall.mk(resultType, base, step, count)))
  | _ => Option.none
}
}
}
}
} } else { Option.none }
  | _ => Option.none
}

def psElabDoForLiftExprWorker(fuel : Nat, owner : PsName, ownerType : PsExpr) : (_ : PsLocalContext) -> (_ : PsElabDoLoopLiftState) -> (_ : PsExpr) -> Except(PsElabError, PsElabDoLoopLiftResult) := match fuel with {
  | _root_.Nat.zero => fun (locals : PsLocalContext) (work : PsElabDoLoopLiftState) (term : PsExpr) => if (psElabDoLoopOccurs(psControlLazyNatFoldName, term)) { Except.error(PsElabError.fuelExhausted) } else { Except.ok((PsElabDoLoopLiftResult.mk(term, work))) }
  | _root_.Nat.succ remaining => fun (locals : PsLocalContext) (work : PsElabDoLoopLiftState) (term : PsExpr) => if ((!psElabDoLoopOccurs(psControlLazyNatFoldName, term))) { Except.ok((PsElabDoLoopLiftResult.mk(term, work))) } else { let smaller : (_ : PsLocalContext) -> (_ : PsElabDoLoopLiftState) -> (_ : PsExpr) -> Except(PsElabError, PsElabDoLoopLiftResult) := (psElabDoForLiftExprWorker(remaining, owner, ownerType))
match term with {
  | PsExpr.app fn argument => match (psElabDoForLiftApplication(term)) with {
  | Option.some call => match (smaller(locals, work, call.base)) with {
  | Except.error error => Except.error(error)
  | Except.ok base => match (smaller(locals, base.state, call.step)) with {
  | Except.error error => Except.error(error)
  | Except.ok step => match (smaller(locals, step.state, call.count)) with {
  | Except.error error => Except.error(error)
  | Except.ok count => psElabDoForSpecialize(owner, ownerType, locals, count.state, call.resultType, base.term, step.term, count.term)
}
}
}
  | Option.none => match (smaller(locals, work, fn)) with {
  | Except.error error => Except.error(error)
  | Except.ok fn => match (smaller(locals, fn.state, argument)) with {
  | Except.error error => Except.error(error)
  | Except.ok argument => Except.ok((PsElabDoLoopLiftResult.mk((PsExpr.app(fn.term, argument.term)), argument.state)))
}
}
}
  | PsExpr.lam name type body binder => if (psElabDoLoopOccurs(psControlLazyNatFoldName, type)) { Except.error(PsElabError.doWhileUnsupportedBody) } else { let pushed := (psLocalPushBinding(locals, name, type, binder))
match (smaller(pushed.context, work, (psExprInstantiate1(body, (PsExpr.fvar(pushed.id)))))) with {
  | Except.error error => Except.error(error)
  | Except.ok body => Except.ok((PsElabDoLoopLiftResult.mk((PsExpr.lam(name, type, (psExprAbstractFVar(pushed.id, body.term)), binder)), body.state)))
} }
  | PsExpr.letE name type value body => if (psElabDoLoopOccurs(psControlLazyNatFoldName, type)) { Except.error(PsElabError.doWhileUnsupportedBody) } else { match (smaller(locals, work, value)) with {
  | Except.error error => Except.error(error)
  | Except.ok value => let pushed := (psLocalPushLet(locals, name, type, value.term))
match (smaller(pushed.context, value.state, (psExprInstantiate1(body, (PsExpr.fvar(pushed.id)))))) with {
  | Except.error error => Except.error(error)
  | Except.ok body => Except.ok((PsElabDoLoopLiftResult.mk((PsExpr.letE(name, type, value.term, (psExprAbstractFVar(pushed.id, body.term)))), body.state)))
}
} }
  | PsExpr.proj name index value => match (smaller(locals, work, value)) with {
  | Except.error error => Except.error(error)
  | Except.ok value => Except.ok((PsElabDoLoopLiftResult.mk((PsExpr.proj(name, index, value.term)), value.state)))
}
  | _ => Except.error(PsElabError.doWhileUnsupportedBody)
} }
}

def psElabDoForLiftDeclaration(environment : PsEnvironment, declaration : PsDeclaration) : Except(PsElabError, (List(PsDeclaration))) := let owner := (psDeclarationName(declaration))
let type := (psDeclarationType(declaration))
match (psDeclarationValue(declaration)) with {
  | Option.none => Except.ok((_root_.List.cons(declaration, _root_.List.nil)))
  | Option.some value => if ((!psElabDoLoopOccurs(psControlLazyNatFoldName, value))) { Except.ok((_root_.List.cons(declaration, _root_.List.nil))) } else { let levels := (psDeclarationLevelParams(declaration))
if ((!psListIsEmpty(levels))) { Except.ok((_root_.List.cons(declaration, _root_.List.nil))) } else { match (psElabDoLoopAddHeader(environment, owner, type)) with {
  | Except.error error => Except.error(error)
  | Except.ok environment => let work := (PsElabDoLoopLiftState.mk(environment, _root_.List.nil, 0))
match (psElabDoForLiftExprWorker(4096, owner, type, psLocalEmpty, work, value)) with {
  | Except.error error => Except.error(error)
  | Except.ok lifted => let result : PsDeclaration := (match declaration with {
  | PsDeclaration.definitionDecl name levels type _ => PsDeclaration.definitionDecl(name, levels, type, lifted.term)
  | PsDeclaration.partialDecl name levels type _ => PsDeclaration.partialDecl(name, levels, type, lifted.term)
  | PsDeclaration.theoremDecl name levels type _ => PsDeclaration.theoremDecl(name, levels, type, lifted.term)
  | _ => declaration
})
Except.ok((psListAppend((psListReverse(lifted.state.declarationsRev)), (_root_.List.cons(result, _root_.List.nil)))))
}
} } }
}

def psElabDoForLiftInsert(declarations : List(PsDeclaration), environment : PsEnvironment) : Except(PsElabError, PsEnvironment) := match declarations with {
  | List.nil => Except.ok(environment)
  | List.cons declaration rest => match (psEnvironmentAdd(environment, declaration)) with {
  | Option.none => Except.error((PsElabError.duplicateDeclaration((psDeclarationName(declaration)))))
  | Option.some next => psElabDoForLiftInsert(rest, next)
}
}

def psElabDoForLiftDeclarations(environment : PsEnvironment, declarations : List(PsDeclaration)) : Except(PsElabError, (List(PsDeclaration))) := match declarations with {
  | List.nil => Except.ok(_root_.List.nil)
  | List.cons declaration rest => match (psElabDoForLiftDeclaration(environment, declaration)) with {
  | Except.error error => Except.error(error)
  | Except.ok lifted => match (psElabDoForLiftInsert(lifted, environment)) with {
  | Except.error error => Except.error(error)
  | Except.ok next => match (psElabDoForLiftDeclarations(next, rest)) with {
  | Except.error error => Except.error(error)
  | Except.ok tail => Except.ok((psListAppend(lifted, tail)))
}
}
}
}
