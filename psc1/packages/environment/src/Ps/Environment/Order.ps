import Ps.Environment.Control

-- Recursive mathematical order, not a Bool equality. Every definition below is
-- replayed by the independent pinned kernel. Decisions are total Nat/Int folds;
-- runtime lowering uses the existing exact comparison intrinsics.
def psOrderFalseName : PsName := psRootName("_psc1OrderFalse")

def psOrderTrueName : PsName := psRootName("_psc1OrderTrue")

def psOrderIntroName : PsName := psNameAppendStr(psOrderTrueName, "intro")

def psOrderIsFalseName : PsName := psNameAppendStr(psDecidableName, "isFalse")

def psOrderIsTrueName : PsName := psNameAppendStr(psDecidableName, "isTrue")

def psOrderFalseDeclaration : PsDeclaration := PsDeclaration.inductiveDecl((PsInductiveInfo.mk(psOrderFalseName, _root_.List.nil, psPreludePropType, 0, 0, _root_.List.nil, false)))

def psOrderTrueDeclaration : PsDeclaration := PsDeclaration.inductiveDecl((PsInductiveInfo.mk(psOrderTrueName, _root_.List.nil, psPreludePropType, 0, 0, (_root_.List.cons(psOrderIntroName, _root_.List.nil)), false)))

def psOrderIntroDeclaration : PsDeclaration := PsDeclaration.constructorDecl((PsConstructorInfo.mk(psOrderIntroName, _root_.List.nil, (PsExpr.constE(psOrderTrueName, _root_.List.nil)), psOrderTrueName, 0, 0, 0, _root_.List.nil)))

def psOrderDecisionDeclaration : PsDeclaration := PsDeclaration.inductiveDecl((PsInductiveInfo.mk(psDecidableName, _root_.List.nil, psPreludeDecidableType, 1, 0, (_root_.List.cons(psOrderIsFalseName, (_root_.List.cons(psOrderIsTrueName, _root_.List.nil)))), false)))

def psOrderDecisionConstructor(positive : Bool) : PsDeclaration := let proposition := (PsExpr.fvar(0))
let falseType := (PsExpr.constE(psOrderFalseName, _root_.List.nil))
let proofType : PsExpr := (if (positive) { proposition } else { psControlClose(false, (_root_.List.cons((PsControlBinder.mk(2, (psRootName("proof")), proposition)), _root_.List.nil)), falseType) })
let type := (psControlClose(false, (_root_.List.cons((PsControlBinder.mk(0, (psRootName("proposition")), psPreludePropType)), (_root_.List.cons((PsControlBinder.mk(1, (psRootName("proof")), proofType)), _root_.List.nil)))), (PsExpr.app((PsExpr.constE(psDecidableName, _root_.List.nil)), proposition))))
let name : PsName := (if (positive) { psOrderIsTrueName } else { psOrderIsFalseName })
let tag : Nat := (if (positive) { 1 } else { 0 })
PsDeclaration.constructorDecl((PsConstructorInfo.mk(name, _root_.List.nil, type, psDecidableName, tag, 1, 1, _root_.List.nil)))

-- The conditional has a constructive logical implementation as well as the
-- established runtime lowering. Decidable is a checked data inductive.
def psOrderDecisionRecName : PsName := psNameAppendStr(psDecidableName, "rec")

def psOrderDecisionRecDeclaration : PsDeclaration := let proposition := (PsExpr.fvar(0))
let motive := (PsExpr.fvar(1))
let decisionType := (PsExpr.app((PsExpr.constE(psDecidableName, _root_.List.nil)), proposition))
let motiveType := (psControlClose(false, (_root_.List.cons((PsControlBinder.mk(5, (psRootName("major")), decisionType)), _root_.List.nil)), (PsExpr.sortE((PsLevel.param(psPreludeUName))))))
let failureProof := (psControlClose(false, (_root_.List.cons((PsControlBinder.mk(6, (psRootName("proof")), proposition)), _root_.List.nil)), (PsExpr.constE(psOrderFalseName, _root_.List.nil))))
let failureType := (psControlClose(false, (_root_.List.cons((PsControlBinder.mk(5, (psRootName("proof")), failureProof)), _root_.List.nil)), (PsExpr.app(motive, (psControlApply((PsExpr.constE(psOrderIsFalseName, _root_.List.nil)), (_root_.List.cons(proposition, (_root_.List.cons((PsExpr.fvar(5)), _root_.List.nil))))))))))
let successType := (psControlClose(false, (_root_.List.cons((PsControlBinder.mk(5, (psRootName("proof")), proposition)), _root_.List.nil)), (PsExpr.app(motive, (psControlApply((PsExpr.constE(psOrderIsTrueName, _root_.List.nil)), (_root_.List.cons(proposition, (_root_.List.cons((PsExpr.fvar(5)), _root_.List.nil))))))))))
let type := (psControlClose(false, (_root_.List.cons((PsControlBinder.mk(0, (psRootName("proposition")), psPreludePropType)), (_root_.List.cons((PsControlBinder.mk(1, (psRootName("motive")), motiveType)), (_root_.List.cons((PsControlBinder.mk(2, (psRootName("failure")), failureType)), (_root_.List.cons((PsControlBinder.mk(3, (psRootName("success")), successType)), (_root_.List.cons((PsControlBinder.mk(4, (psRootName("major")), decisionType)), _root_.List.nil)))))))))), (PsExpr.app(motive, (PsExpr.fvar(4))))))
PsDeclaration.recursorDecl((PsRecursorInfo.mk(psOrderDecisionRecName, (_root_.List.cons(psPreludeUName, _root_.List.nil)), type, (_root_.List.cons(psDecidableName, _root_.List.nil)), 1, 0, 1, 2)))

