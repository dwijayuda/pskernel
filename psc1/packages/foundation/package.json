{
  "name": "@proofscript/foundation",
  "version": "0.1.0-psc1.12",
  "description": "ProofScript PSC1 foundation: source package",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.23.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwijayuda/pskernel.git",
    "directory": "psc1/packages/foundation"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./sources": "./dist/source-manifest.json",
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.js"
    }
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "proofscript": "0.1.0-psc1.12"
  },
  "proofscript": {
    "npmArchitecture": "psc1-existing-packages-shared-root/1",
    "implementationOwner": "proofscript",
    "internalCompilerModules": false,
    "packageKind": "source-only",
    "canonicalSources": "src",
    "sourceVariants": [
      "lean"
    ],
    "publishingRequiresQualification": true,
    "compilerInputGrammars": [
      "lean",
      "ps"
    ]
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs build --package foundation",
    "clean": "node ../../scripts/build-packages.mjs clean --package foundation"
  }
}
