{
  "name": "@proofscript/pskernel-lean-wasm",
  "version": "4.35.0",
  "description": "PSC1 independent official Lean4.35.0 C++ kernel compiled with Emscripten into linear-memory WebAssembly",
  "type": "module",
  "private": false,
  "main": "./index.mjs",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.23.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwijayuda/pskernel.git",
    "directory": "psc1/packages/pskernel-lean-wasm"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./metadata/lean": "./LEAN_SOURCE_PIN.json",
    "./metadata/emscripten": "./EMSCRIPTEN_PIN.json",
    "./metadata/kernel-source": "./KERNEL_SOURCE_MANIFEST.json",
    "./metadata/prebuilt": "./PREBUILT_WASM_MANIFEST.json",
    "./metadata/proofscript-source": "./PROOFSCRIPT_SOURCE_MANIFEST.json",
    "./package.json": "./package.json",
    "./distribution": "./dist/index.js"
  },
  "files": [
    "index.mjs",
    "host/",
    "wasm/",
    "provider/",
    "kernel/",
    "source/",
    "scripts/",
    "patches/",
    "LEAN_LICENSE",
    "*.json",
    "README.md",
    "BUILDING.md",
    "prebuilt/",
    "PREBUILT_MANIFEST.json",
    "index.d.ts",
    "LICENSE",
    "NOTICE",
    "dist/"
  ],
  "proofscript": {
    "npmArchitecture": "psc1-independent-kernel-provider/1",
    "sourceVariants": [
      "ps",
      "lean"
    ],
    "publishingRequiresBuild": true,
    "nonPortableProviderSources": true,
    "leanSemanticVersion": "4.35.0",
    "canonicalAdmissionsVersion": 2,
    "kernelMemoryModel": "linear",
    "packageBuild": "qualified-prebuilt-reuse; no kernel source compilation"
  },
  "scripts": {
    "build:kernel": "bash scripts/build-wasm.sh && node scripts/write-prebuilt-manifest.mjs",
    "verify:prebuilt": "node host/verify-prebuilt.mjs",
    "build": "node ../../scripts/build-packages.mjs build --package pskernel-lean-wasm",
    "clean": "node ../../scripts/build-packages.mjs clean --package pskernel-lean-wasm"
  },
  "types": "./index.d.ts"
}
