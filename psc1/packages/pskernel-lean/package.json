{
  "name": "@proofscript/pskernel-lean",
  "version": "4.35.0",
  "description": "PSC1 independent official Lean4.35.0 native C++ kernel provider",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.23.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwijayuda/pskernel.git",
    "directory": "psc1/packages/pskernel-lean"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": "./dist/implementation/host/node-provider.mjs",
    "./metadata": "./dist/implementation/LEAN_SOURCE_PIN.json",
    "./package.json": "./package.json",
    "./distribution": "./dist/index.js"
  },
  "files": [
    "index.mjs",
    "host/",
    "wasm/",
    "provider/",
    "kernel/",
    "source/",
    "scripts/",
    "patches/",
    "LEAN_LICENSE",
    "*.json",
    "README.md",
    "BUILDING.md",
    "prebuilt/",
    "PREBUILT_MANIFEST.json",
    "index.d.ts",
    "LICENSE",
    "NOTICE",
    "dist/"
  ],
  "proofscript": {
    "npmArchitecture": "psc1-independent-kernel-provider/1",
    "sourceVariants": [
      "ps",
      "lean"
    ],
    "publishingRequiresBuild": true,
    "nonPortableProviderSources": true,
    "leanSemanticVersion": "4.35.0",
    "canonicalAdmissionsVersion": 2,
    "kernelMemoryModel": "native",
    "packageBuild": "qualified-prebuilt-reuse; no kernel source compilation"
  },
  "scripts": {
    "build:kernel": "node scripts/build-native-slim.mjs",
    "build": "node ../../scripts/build-packages.mjs build --package pskernel-lean",
    "clean": "node ../../scripts/build-packages.mjs clean --package pskernel-lean"
  },
  "types": "./dist/index.d.ts"
}
