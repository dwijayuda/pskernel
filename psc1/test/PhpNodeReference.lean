-- Exact retained node helper before readonly direct-slot access; test data only.
def psPhpNodeReferenceRuntime : String := "    // Compact immutable inductives; reclaim dead descendants without recursive Zend array destruction.\n    $__ps_nodes = static function (string $tag, mixed ...$fields): \\ArrayAccess {\n        return new class($tag, $fields) implements \\ArrayAccess {\n            private string $tag;\n            private int $count;\n            private mixed $first;\n            private mixed $second;\n            private array $rest;\n            public function __construct(string $tag, array $fields) {\n                $this->tag = $tag;\n                $this->count = count($fields);\n                $this->first = $fields[0] ?? null;\n                $this->second = $fields[1] ?? null;\n                $this->rest = count($fields) > 2 ? array_slice($fields, 2) : [];\n            }\n            public function offsetExists(mixed $offset): bool {\n                return is_int($offset) && $offset >= 0 && $offset <= $this->count;\n            }\n            public function offsetGet(mixed $offset): mixed {\n                if (!$this->offsetExists($offset)) {\n                    throw new \\UnexpectedValueException('PSC1_PHP_CONSTRUCTOR_FIELD');\n                }\n                if ($offset === 0) return $this->tag;\n                if ($offset === 1) return $this->first;\n                if ($offset === 2) return $this->second;\n                return $this->rest[$offset - 3];\n            }\n            public function offsetSet(mixed $offset, mixed $value): void {\n                throw new \\LogicException('PSC1_PHP_IMMUTABLE_CONSTRUCTOR');\n            }\n            public function offsetUnset(mixed $offset): void {\n                throw new \\LogicException('PSC1_PHP_IMMUTABLE_CONSTRUCTOR');\n            }\n            public function __destruct() {\n                static $draining = false;\n                static $pending = [];\n                // Only this already-dead node is cleared. A queued child that\n                // still has other owners remains live and is never modified.\n                foreach ([$this->rest, $this->second, $this->first] as $value) {\n                    if (is_object($value) || (is_array($value) && $value !== [])) {\n                        $pending[] = $value;\n                    }\n                }\n                unset($value);\n                $this->first = null;\n                $this->second = null;\n                $this->rest = [];\n                if ($draining) return;\n                $draining = true;\n                try {\n                    while ($pending !== []) {\n                        $value = array_pop($pending);\n                        unset($value);\n                    }\n                } finally {\n                    $draining = false;\n                }\n            }\n        };\n    };\n"
