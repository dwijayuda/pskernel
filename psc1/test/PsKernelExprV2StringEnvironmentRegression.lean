import Lean
import Ps.KernelCore.API.Dag
import Ps.KernelCore.Research.ExprV2PagedImport

/- T01F authentic Lean 4.35 declaration closure. This test-only transport reads
   ConstantInfo from the pinned official environment, but installs no metadata.
   Every declaration is admitted independently from an empty PSKernel session.
   Constructor/recursor records are generated by that admission, never copied.
   The minimal String fixture and its qualification remain separate. -/

namespace PsKernelExprV2StringEnvironmentRegression

private def require (label : String) (ok : Bool) : IO Unit := do
  unless ok do throw (IO.userError ("PSC1_T01F_FAILED " ++ label))

private def errorText : PsKernelError → String
  | .rejectedInvalid message => "rejectedInvalid: " ++ message
  | .declinedUnsupported message => "declinedUnsupported: " ++ message
  | .resourceExhausted _ message => "resourceExhausted: " ++ message
  | .internalError message => "internalError: " ++ message

private def expectPublic {α : Type} (label : String) : Except PsKernelError α → IO α
  | .ok value => pure value
  | .error error => throw (IO.userError (label ++ ": " ++ errorText error))

private def plain {α : Type} (label : String) : Except String α → IO α
  | .ok value => pure value
  | .error error => throw (IO.userError (label ++ ": " ++ error))

private def direct {α : Type} (label : String) : Option (Except String α) → IO α
  | none => throw (IO.userError (label ++ ": direct path declined"))
  | some value => plain label value

private def name : Lean.Name → PsKernelName
  | .anonymous => .anonymous
  | .str parent text => .str (name parent) text
  | .num parent number => .num (name parent) number

private def level : Lean.Level → PsKernelLevel
  | .zero => .zero
  | .succ value => .succ (level value)
  | .max left right => .max (level left) (level right)
  | .imax left right => .imax (level left) (level right)
  | .param value => .param (name value)
  | .mvar value => .mvar (name value.name)

private def binder : Lean.BinderInfo → PsKernelBinderInfo
  | .default => .default
  | .implicit => .implicit
  | .strictImplicit => .strictImplicit
  | .instImplicit => .instImplicit

private def expr : Lean.Expr → PsKernelExpr
  | .bvar index => .bvar index
  | .fvar value => .fvar (name value.name)
  | .mvar value => .mvar (name value.name)
  | .sort value => .sort (level value)
  | .const value levels => .const (name value) (levels.map level)
  | .app fn arg => .app (expr fn) (expr arg)
  | .lam value domain body bi => .lam (name value) (expr domain) (expr body) (binder bi)
  | .forallE value domain body bi => .forallE (name value) (expr domain) (expr body) (binder bi)
  | .letE value type valueExpr body nondep =>
      .letE (name value) (expr type) (expr valueExpr) (expr body) nondep
  | .lit (.natVal value) => .lit (.nat value)
  | .lit (.strVal value) => .lit (.str value)
  | .mdata _ body => expr body
  | .proj value index body => .proj (name value) index (expr body)

private def deps (value : Lean.Expr) (found : List Lean.Name := []) : List Lean.Name :=
  match value with
  | .const n _ => if found.contains n then found else n :: found
  | .app f a => deps a (deps f found)
  | .lam _ d b _ | .forallE _ d b _ => deps b (deps d found)
  | .letE _ t v b _ => deps b (deps v (deps t found))
  | .mdata _ b => deps b found
  | .proj n _ b => deps b (if found.contains n then found else n :: found)
  | .lit (.natVal _) => if found.contains `Nat then found else `Nat :: found
  | .lit (.strVal _) => if found.contains `String then found else `String :: found
  | _ => found

private def base (info : Lean.ConstantInfo) : PsKernelConstantBase :=
  { name := name info.name, levelParams := info.levelParams.map name, type := expr info.type }

private def hints : Lean.ReducibilityHints → PsKernelReducibilityHints
  | .opaque => .opaqueHint
  | .abbrev => .abbrevHint
  | .regular height => .regular height.toNat

private def safety : Lean.DefinitionSafety → PsKernelDefinitionSafety
  | .safe => .safe
  | .unsafe => .unsafeDef
  | .partial => .partialDef

private structure Imported where
  session : PsKernelKernelSession
  requests : Nat := 0
  roots : List Lean.Name := []

private def info (source : Lean.Environment) (n : Lean.Name) : IO Lean.ConstantInfo := do
  match source.find? n with
  | some value => pure value
  | none => throw (IO.userError ("T01F source declaration missing: " ++ toString n))

private def verifyHeader (source : Lean.Environment) (state : Imported) (n : Lean.Name) : IO Unit := do
  let original ← info source n
  let some checked := psKernelEnvironmentFind state.session.environment (name n)
    | throw (IO.userError ("T01F checked declaration missing: " ++ toString n))
  require ("authentic-header-" ++ toString n)
    (psKernelExprEqual (psKernelConstantInfoType checked) (expr original.type))
  require ("authentic-levels-" ++ toString n)
    (psKernelNameListsEq (psKernelConstantInfoLevelParams checked) (original.levelParams.map name))

private def install (state : IO.Ref Imported) (n : Lean.Name)
    (request : PsKernelDeclarationRequest) : IO Unit := do
  let current ← state.get
  IO.println ("PSC1_T01F_ADMIT_BEGIN " ++ toString current.requests ++ " " ++ toString n)
  let result ← expectPublic ("T01F admission " ++ toString n)
    (psKernelV1AdmitDeclaration current.session request)
  state.set { current with session := result.session, requests := current.requests + 1,
    roots := current.roots ++ [n] }
  IO.println ("PSC1_T01F_ADMIT_PASS " ++ toString n)

/- Recursion is test-host traversal, not a new admission implementation.
   Explicit visiting guards reject non-inductive dependency cycles. -/
private partial def admitName (source : Lean.Environment) (state : IO.Ref Imported)
    (visiting : List Lean.Name) (n : Lean.Name) : IO Unit := do
  let current ← state.get
  if psKernelEnvironmentContains current.session.environment (name n) then
    verifyHeader source current n
    return
  if visiting.contains n then
    throw (IO.userError ("T01F unexpected dependency cycle: " ++ toString n))
  let original ← info source n
  match original with
  | .ctorInfo value =>
      admitName source state visiting value.induct
  | .recInfo value =>
      let some family := value.all.head?
        | throw (IO.userError ("T01F recursor without family: " ++ toString n))
      admitName source state visiting family
  | .quotInfo _ =>
      admitName source state (n :: visiting) `Eq
      install state n .quot
  | .inductInfo value =>
      let families ← value.all.mapM (fun family => do
        let .inductInfo found ← info source family
          | throw (IO.userError ("T01F non-inductive family: " ++ toString family))
        pure found)
      let mut types : List PsKernelSimpleMutualTypeDecl := []
      let mut dependencies : List Lean.Name := []
      for family in families do
        dependencies := deps family.type dependencies
        let mut ctors : List PsKernelSimpleConstructorDecl := []
        for ctor in family.ctors do
          let .ctorInfo ctorInfo ← info source ctor
            | throw (IO.userError ("T01F source constructor missing: " ++ toString ctor))
          dependencies := deps ctorInfo.type dependencies
          ctors := ctors ++ [{ name := name ctor, type := expr ctorInfo.type }]
        types := types ++ [{ name := name family.name, type := expr family.type, ctors := ctors }]
      for dependency in dependencies.reverse do
        unless value.all.contains dependency do
          admitName source state (value.all ++ visiting) dependency
      let group : PsKernelSimpleMutualInductiveDecl :=
        { levelParams := value.levelParams.map name, numParams := value.numParams,
          types := types, isUnsafe := value.isUnsafe }
      match types with
      | [single] =>
          if value.numNested == 0 then
            install state n (.ordinaryInductive {
              levelParams := group.levelParams, name := single.name, type := single.type,
              ctors := single.ctors, isUnsafe := group.isUnsafe, numParams := group.numParams })
          else install state n (.nestedInductive group)
      | _ =>
          if value.numNested == 0 then install state n (.mutualInductive group)
          else install state n (.nestedInductive group)
      let completed ← state.get
      for family in families do
        verifyHeader source completed family.name
        for ctor in family.ctors do verifyHeader source completed ctor
  | _ =>
      let body := match original with
        | .defnInfo value => some value.value
        | .thmInfo value => some value.value
        | .opaqueInfo value => some value.value
        | _ => none
      let dependencies := match body with
        | some value => deps value (deps original.type)
        | none => deps original.type
      for dependency in dependencies.reverse do
        admitName source state (n :: visiting) dependency
      let request ← match original with
        | .axiomInfo value => do
            IO.println ("PSC1_T01F_SOURCE_AXIOM " ++ toString n)
            pure (.axiomDecl { base := base original, isUnsafe := value.isUnsafe })
        | .defnInfo value => pure (.definitionDecl {
            base := base original, value := expr value.value,
            hints := hints value.hints, safety := safety value.safety })
        | .thmInfo value => pure (.theoremDecl { base := base original, value := expr value.value })
        | .opaqueInfo value => pure (.opaqueDecl {
            base := base original, value := expr value.value, isUnsafe := value.isUnsafe })
        | _ => throw (IO.userError ("T01F unhandled declaration: " ++ toString n))
      install state n request
  verifyHeader source (← state.get) n

private def officialName : PsKernelName → Lean.Name
  | .anonymous => .anonymous
  | .str parent value => .str (officialName parent) value
  | .num parent value => .num (officialName parent) value

private def officialLevel : PsKernelLevel → Lean.Level
  | .zero => .zero
  | .succ value => .succ (officialLevel value)
  | .max a b => .max (officialLevel a) (officialLevel b)
  | .imax a b => .imax (officialLevel a) (officialLevel b)
  | .param n => .param (officialName n)
  | .mvar n => .mvar ⟨officialName n⟩

private def officialBinder : PsKernelBinderInfo → Lean.BinderInfo
  | .default => .default | .implicit => .implicit
  | .strictImplicit => .strictImplicit | .instImplicit => .instImplicit

private def officialExpr : PsKernelExpr → Lean.Expr
  | .bvar n => .bvar n
  | .fvar n => .fvar ⟨officialName n⟩
  | .mvar n => .mvar ⟨officialName n⟩
  | .sort u => .sort (officialLevel u)
  | .const n us => .const (officialName n) (us.map officialLevel)
  | .app f a => .app (officialExpr f) (officialExpr a)
  | .lam n d b bi => .lam (officialName n) (officialExpr d) (officialExpr b) (officialBinder bi)
  | .forallE n d b bi => .forallE (officialName n) (officialExpr d) (officialExpr b) (officialBinder bi)
  | .letE n t v b nd => .letE (officialName n) (officialExpr t) (officialExpr v) (officialExpr b) nd
  | .lit (.nat n) => .lit (.natVal n)
  | .lit (.str s) => .lit (.strVal s)
  | .mdata _ b => officialExpr b
  | .proj n i b => .proj (officialName n) i (officialExpr b)

private def decode (arena : PsKernelExprV2PagedArena) (root : Nat) : IO PsKernelExpr := do
  let built ← plain "decode" (psKernelExprV2DecodeChecked arena)
  plain "decode-root" (psKernelExprV2DecodedRequire built root)

private def charList (characters : List Char) : PsKernelExpr :=
  let char := PsKernelExpr.const (name `Char) []
  let zero := PsKernelLevel.zero
  characters.foldr (fun character tail =>
    psKernelApplyArgs (.const (name `List.cons) [zero])
      [char, .app (.const (name `Char.ofNat) []) (.lit (.nat character.toNat)), tail])
    (.app (.const (name `List.nil) [zero]) char)

private def byteList (bytes : List UInt8) : PsKernelExpr :=
  let byte := PsKernelExpr.const (name `UInt8) []
  let zero := PsKernelLevel.zero
  bytes.foldr (fun value tail =>
    psKernelApplyArgs (.const (name `List.cons) [zero])
      [byte, .app (.const (name `UInt8.ofNat) []) (.lit (.nat value.toNat)), tail])
    (.app (.const (name `List.nil) [zero]) byte)

private def checkCase (source : Lean.Environment) (session : PsKernelKernelSession)
    (text : String) : IO Unit := do
  let literal := PsKernelExpr.lit (.str text)
  let expanded := PsKernelExpr.app (.const (name `String.ofList) []) (charList text.toList)
  let bytes := PsKernelExpr.proj (name `Array) 0
    (.proj (name `ByteArray) 0 (.proj (name `String) 0 literal))
  let expectedBytes := byteList text.toUTF8.data.toList
  let proof := PsKernelExpr.proj (name `String) 1 literal
  let mut arena := psKernelExprV2PagedEmpty
  let mut pairs : List (String × PsKernelExpr × PsKernelExpr × Nat × Nat) := []
  for (label, left, right) in
      [("string",literal,expanded), ("utf8",bytes,expectedBytes), ("validity",proof,proof)] do
    IO.println ("PSC1_T01F_QUERY_BEGIN " ++ label ++ " " ++ reprStr text)
    let (next,leftId) ← plain "import-left" (psKernelExprV2PagedImportIntoChecked arena left)
    let (next,rightId) ← plain "import-right" (psKernelExprV2PagedImportIntoChecked next right)
    arena := next
    pairs := pairs ++ [(label,left,right,leftId,rightId)]
    require ("official-check-" ++ label)
      (match Lean.Kernel.check source {} (officialExpr left) with | .ok _ => true | _ => false)
    require ("official-defeq-" ++ label)
      (match Lean.Kernel.isDefEq source {} (officialExpr left) (officialExpr right) with
       | .ok true => true | _ => false)
    let _ ← expectPublic ("v1-check-" ++ label) (psKernelV1CheckExpression session [] .safe left)
    require ("v1-defeq-" ++ label)
      (← expectPublic ("v1-defeq-" ++ label) (psKernelV1IsDefEq session [] .safe left right))
  let built ← plain "input-decode" (psKernelExprV2DecodeChecked arena)
  let owners ← plain "session-owners" (psKernelDagGeneratedFromSession session arena built)
  let context := (psKernelKernelSessionChecker session [] .safe).context
  for (label,left,_,leftId,rightId) in pairs do
    let _ ← direct ("direct-check-" ++ label)
      (psKernelExprV2TryCheckWithDeclarationsFuel 4096 context owners.arena owners.declarations leftId)
    let normalized ← direct ("direct-whnf-" ++ label)
      (psKernelExprV2TryWhnfOwnedWithDeclarationsFuel 4096 context owners.arena owners.declarations leftId)
    let normalizedValue ← decode normalized.fst normalized.snd
    require ("official-direct-whnf-" ++ label)
      (match Lean.Kernel.isDefEq source {} (officialExpr left) (officialExpr normalizedValue) with
       | .ok true => true | _ => false)
    require ("direct-defeq-" ++ label)
      (← direct ("direct-defeq-" ++ label)
        (psKernelExprV2TryDefEqWithDeclarationsFuel 4096 context owners.arena owners.declarations leftId rightId))
    let first ← expectPublic ("public-first-" ++ label)
      (psKernelV1RunDag session [] .safe arena [.check leftId,.whnf leftId,.isDefEq leftId rightId])
    let second ← expectPublic ("public-reuse-" ++ label)
      (psKernelV1RunDag first.session [] .safe arena [.check leftId,.whnf leftId,.isDefEq leftId rightId])
    for result in [first,second] do
      require ("public-replies-" ++ label)
        (match result.replies with | [.checked _,.normalized _,.equal true] => true | _ => false)
  for bad in [PsKernelExpr.proj (name `String) 2 literal,
      PsKernelExpr.app (.const (name `String.ofList) []) (.lit (.nat 0))] do
    require "official-invalid-rejects"
      (match Lean.Kernel.check source {} (officialExpr bad) with | .error _ => true | _ => false)
    require "independent-invalid-rejects"
      (match psKernelV1CheckExpression session [] .safe bad with
       | .error (.rejectedInvalid _) => true | _ => false)
  IO.println ("PSC1_T01F_CASE_PASS " ++ reprStr text)

def regression : IO Unit := do
  let source ← Lean.importModules #[{ module := `Init }] {}
  let empty ← expectPublic "empty-session"
    (psKernelKernelSessionEmpty psKernelResourcePolicyDefault psKernelProviderDefault)
  require "fuel4096" (empty.resources.fuel == 4096)
  let state ← IO.mkRef ({ session := empty } : Imported)
  for root in [`String.ofList,`Char.ofNat,`UInt8.ofNat] do
    admitName source state [] root
  let imported ← state.get
  IO.println ("PSC1_T01F_CLOSURE_PASS requests=" ++ toString imported.requests ++
    " declarations=" ++ toString (psKernelEnvironmentSize imported.session.environment))
  for text in ["", "a", "é", "€", "😀", "Aé€😀"] do
    checkCase source imported.session text
  require "original-session-stays-empty" (psKernelEnvironmentSize empty.environment == 0)
  IO.println "PSC1_T01F_FULL_STRING: PASS authenticClosure=true independentAdmission=true fuel=4096"

end PsKernelExprV2StringEnvironmentRegression

def main : IO Unit := PsKernelExprV2StringEnvironmentRegression.regression

