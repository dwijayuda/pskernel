  | PsKernelEnumTask.constructors pending current reversed count => match pending with {
  | PsKernelList.nil => psKernelEnumNext(env, declaration, PsKernelEnumTask.recursorName(current, reversed, count, PsKernelLookupState.search(psKernelUnitRecursorName(name), current)));
