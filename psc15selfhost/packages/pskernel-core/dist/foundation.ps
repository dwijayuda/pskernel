  | PsKernelUnitTask.constructorResult levels current => match psKernelConversionStep(current) with {
  | PsKernelConversionStep.next next => psKernelUnitNext(env, declaration, PsKernelUnitTask.constructorResult(levels, next));
  | PsKernelConversionStep.final result => match result with {
