{
  "name": "@proofscript/pskernel-core",
  "version": "0.1.0-design.0",
  "private": true,
  "description": "Independent PSC kernel design scaffold; no proof checker is implemented or exported",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/metadata.d.ts",
      "import": "./src/metadata.mjs"
    }
  },
  "files": [
    "src/metadata.mjs",
    "src/metadata.d.ts",
    "README.md",
    "ARCHITECTURE.md"
  ],
  "scripts": {
    "test": "node --test test/package.test.mjs"
  },
  "dependencies": {},
  "proofscript": {
    "bootstrap": false,
    "portable": false,
    "targetPortable": true,
    "sourceRoots": ["src"],
    "testRoots": ["test"],
    "outDir": "dist",
    "role": "independent-kernel-design",
    "authoritative": false
  }
}
