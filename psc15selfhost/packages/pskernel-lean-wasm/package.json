{
  "name": "@proofscript/pskernel-lean-wasm",
  "version": "4.34.0",
  "description": "WebAssembly execution provider for the ProofScript Lean 4.34 kernel assurance path",
  "type": "module",
  "private": false,
  "exports": {
    ".": "./index.mjs",
    "./metadata/lean": "./LEAN_SOURCE_PIN.json",
    "./metadata/emscripten": "./EMSCRIPTEN_PIN.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "host/",
    "wasm/",
    "LEAN_SOURCE_PIN.json",
    "EMSCRIPTEN_PIN.json",
    "README.md",
    "BUILDING.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "proofscript": {
    "bootstrap": false,
    "portable": false,
    "sourceRoots": [
      "provider"
    ],
    "testRoots": [
      "provider-test"
    ],
    "outDir": "dist",
    "role": "external-lean-kernel-provider-wasm"
  }
}
