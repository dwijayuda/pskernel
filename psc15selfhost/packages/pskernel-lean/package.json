{
  "name": "@proofscript/pskernel-lean",
  "version": "4.34.0",
  "description": "Official Lean kernel provider for ProofScript PSC2, pinned to Lean 4.34.0 semantics",
  "type": "module",
  "private": false,
  "exports": {
    ".": "./index.mjs",
    "./node": "./host/node-provider.mjs",
    "./metadata": "./LEAN_SOURCE_PIN.json",
    "./metadata/kernel-source": "./KERNEL_SOURCE_MANIFEST.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "host/node-provider.mjs",
    "host/prebuilt.mjs",
    "provider/",
    "kernel/",
    "LEAN_LICENSE",
    "KERNEL_SOURCE_MANIFEST.json",
    "LEAN_SOURCE_PIN.json",
    "PREBUILT_MANIFEST.json",
    "prebuilt/",
    "README.md",
    "BUILDING.md",
    "INTEGRATION.md",
    "NPM_PACKAGE.md"
  ],
  "scripts": {
    "verify:source": "node host/source-distribution.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "proofscript": {
    "bootstrap": false,
    "portable": false,
    "sourceRoots": [
      "provider"
    ],
    "testRoots": [
      "provider-test"
    ],
    "outDir": "dist",
    "role": "external-lean-kernel-provider"
  }
}
