import Ps.BackendJs.Module


def jsJ3ExprDecl (name : String) (type : PsVerifiedIrPrimitiveType)
    (body : PsVerifiedIrExpr) : PsVerifiedIrDeclaration :=
  { name := name, typeParameters := [], parameters := [],
    resultType := .primitive type, body := body }


def jsJ3Nat (value : Nat) : PsVerifiedIrExpr :=
  .literal (.natural value)


def jsJ3Int (value : Int) : PsVerifiedIrExpr :=
  .literal (.integer value)


def jsJ3Bool (value : Bool) : PsVerifiedIrExpr :=
  .literal (.bool value)


def jsJ3NatBinaryDecl
    (name : String)
    (resultType : PsVerifiedIrPrimitiveType)
    (operation : PsVerifiedIrIntrinsic)
    (left right : Nat) : PsVerifiedIrDeclaration :=
  jsJ3ExprDecl name resultType
    (.intrinsic operation [] [jsJ3Nat left, jsJ3Nat right])


def jsJ3IntUnaryDecl
    (name : String)
    (resultType : PsVerifiedIrPrimitiveType)
    (operation : PsVerifiedIrIntrinsic)
    (value : Int) : PsVerifiedIrDeclaration :=
  jsJ3ExprDecl name resultType
    (.intrinsic operation [] [jsJ3Int value])


def jsJ3IntBinaryDecl
    (name : String)
    (resultType : PsVerifiedIrPrimitiveType)
    (operation : PsVerifiedIrIntrinsic)
    (left right : Int) : PsVerifiedIrDeclaration :=
  jsJ3ExprDecl name resultType
    (.intrinsic operation [] [jsJ3Int left, jsJ3Int right])


def jsJ3BoolUnaryDecl
    (name : String)
    (operation : PsVerifiedIrIntrinsic)
    (value : Bool) : PsVerifiedIrDeclaration :=
  jsJ3ExprDecl name .bool
    (.intrinsic operation [] [jsJ3Bool value])


def jsJ3BoolBinaryDecl
    (name : String)
    (operation : PsVerifiedIrIntrinsic)
    (left right : Bool) : PsVerifiedIrDeclaration :=
  jsJ3ExprDecl name .bool
    (.intrinsic operation [] [jsJ3Bool left, jsJ3Bool right])


def jsJ3NatModule : PsVerifiedIrModule :=
  { psVerifiedIrModuleEmpty with declarations := [
      jsJ3NatBinaryDecl "natAdd" .nat .natAdd 41 1,
      jsJ3NatBinaryDecl "natSub" .nat .natSub 3 5,
      jsJ3NatBinaryDecl "natMul" .nat .natMul 6 7,
      jsJ3NatBinaryDecl "natDiv" .nat .natDiv 9 0,
      jsJ3NatBinaryDecl "natMod" .nat .natMod 9 0,
      jsJ3NatBinaryDecl "natEq" .bool .natEq 7 7,
      jsJ3NatBinaryDecl "natNe" .bool .natNe 7 8,
      jsJ3NatBinaryDecl "natLe" .bool .natLe 7 8,
      jsJ3NatBinaryDecl "natLt" .bool .natLt 7 8
    ] }


def jsJ3IntBoolModule : PsVerifiedIrModule :=
  { psVerifiedIrModuleEmpty with declarations := [
      jsJ3ExprDecl "intOfNat" .int (.intrinsic .intOfNat [] [jsJ3Nat 41]),
      jsJ3ExprDecl "intNegSucc" .int (.intrinsic .intNegSucc [] [jsJ3Nat 2]),
      jsJ3IntUnaryDecl "intNeg" .int .intNeg 7,
      jsJ3IntBinaryDecl "intAdd" .int .intAdd (-2) 5,
      jsJ3IntBinaryDecl "intSub" .int .intSub 3 5,
      jsJ3IntBinaryDecl "intMul" .int .intMul (-3) 4,
      jsJ3IntBinaryDecl "intEq" .bool .intEq (-7) (-7),
      jsJ3IntBinaryDecl "intLe" .bool .intLe (-8) 7,
      jsJ3IntBinaryDecl "intLt" .bool .intLt (-8) 7,
      jsJ3IntUnaryDecl "intRepr" .string .intRepr (-42),
      jsJ3BoolUnaryDecl "boolNot" .boolNot true,
      jsJ3BoolBinaryDecl "boolAnd" .boolAnd true false,
      jsJ3BoolBinaryDecl "boolOr" .boolOr false true,
      jsJ3BoolBinaryDecl "boolEq" .boolEq true true,
      jsJ3BoolBinaryDecl "boolNe" .boolNe true false
    ] }


