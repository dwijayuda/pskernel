  "const __psc_js_2 = (6n * 7n);\nexport { __psc_js_2 as natMul };\n" ++
  "const __psc_js_3 = ((__psc_a, __psc_b) => (__psc_b === 0n ? 0n : __psc_a / __psc_b))(9n, 0n);\nexport { __psc_js_3 as natDiv };\n" ++
  "const __psc_js_4 = ((__psc_a, __psc_b) => (__psc_b === 0n ? __psc_a : __psc_a % __psc_b))(9n, 0n);\nexport { __psc_js_4 as natMod };\n" ++
  "const __psc_js_5 = (7n === 7n);\nexport { __psc_js_5 as natEq };\n" ++
