def psBackendJsJ3NatEmissionTest : Bool :=
  match psJsEmitModule jsJ3NatModule with
  | .error _ => false
  | .ok source => source == jsJ3ExpectedNatSource


def psBackendJsJ3IntBoolEmissionTest : Bool :=
  match psJsEmitModule jsJ3IntBoolModule with
  | .error _ => false
  | .ok source => source == jsJ3ExpectedIntBoolSource


#guard psBackendJsJ3NatEmissionTest
#guard psBackendJsJ3IntBoolEmissionTest
