def psBackendJsSelectiveStackModule : PsJsIrModule :=
  {
    imports := []
    declarations := [
      {
        name := "helper"
        parameters := [{ name := "x" }]
        body := PsJsIrExpr.var "x"
      },
      {
        name := "recur"
        parameters := [{ name := "n" }]
        body :=
          PsJsIrExpr.call
            (PsJsIrExpr.var "helper")
            [
              PsJsIrExpr.call
                (PsJsIrExpr.var "recur")
                [PsJsIrExpr.var "n"]
            ]
      }
    ]
  }

def psTestBackendJsSelectiveStackSafety : Bool :=
  match psJsPrintModuleStackSafe psBackendJsSelectiveStackModule with
  | Except.error _ => false
  | Except.ok output =>
      let recursionSafe : Bool :=
        output.contains "__ps$invoke(recur, n)"
          || output.contains "while (true)";
      let helperNotTrampolined : Bool :=
        !output.contains "__ps$impl$helper";
      recursionSafe && helperNotTrampolined

