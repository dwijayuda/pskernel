def psDecimalDigitValue(char : Char) : Option(Nat) :=
  match char with {
    | '0' => Option.some(0);
    | '1' => Option.some(1);
    | '2' => Option.some(2);
    | '3' => Option.some(3);
    | '4' => Option.some(4);
    | '5' => Option.some(5);
    | '6' => Option.some(6);
    | '7' => Option.some(7);
    | '8' => Option.some(8);
    | '9' => Option.some(9);
    | _ => Option.none;
  };

/* Natural-text folding is authoritative in Literal.lean during bootstrap and
   will be regenerated once the PSC1 frontend owns this recursive library slice. */
