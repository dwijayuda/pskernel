import Ps.Foundation.Name
import Ps.Core.Declaration

def psDeclarationName(declaration : PsDeclaration) : PsName :=
  match declaration with {
    | .axiomDecl name levelParams type => name;
    | .definitionDecl name levelParams type value => name;
    | .theoremDecl name levelParams type value => name;
    | .opaqueDecl name levelParams type value => name;
  };


def psDeclarationLevelParams(declaration : PsDeclaration) : List(PsName) :=
  match declaration with {
    | .axiomDecl name levelParams type => levelParams;
    | .definitionDecl name levelParams type value => levelParams;
    | .theoremDecl name levelParams type value => levelParams;
    | .opaqueDecl name levelParams type value => levelParams;
  };

def psDeclarationType(declaration : PsDeclaration) : PsExpr :=
  match declaration with {
    | .axiomDecl name levelParams type => type;
    | .definitionDecl name levelParams type value => type;
    | .theoremDecl name levelParams type value => type;
    | .opaqueDecl name levelParams type value => type;
  };

def psDeclarationValue(declaration : PsDeclaration) : Option(PsExpr) :=
  match declaration with {
    | .definitionDecl name levelParams type value => Option.some(value);
    | _ => Option.none;
  };

structure PsEnvironment where {
  declarations : List(PsDeclaration);
};

def psEnvironmentEmpty : PsEnvironment :=
  { declarations := [] };

def psEnvironmentFindInList(name : PsName, declarations : List(PsDeclaration)) : Option(PsDeclaration) :=
  match declarations with {
    | .nil => Option.none;
    | .cons declaration rest =>
      if (psNameEq(name, psDeclarationName(declaration))) {
        Option.some(declaration)
      } else {
        psEnvironmentFindInList(name, rest)
      };
  };

def psEnvironmentFind(environment : PsEnvironment, name : PsName) : Option(PsDeclaration) :=
  psEnvironmentFindInList(name, environment.declarations);

def psEnvironmentContains(environment : PsEnvironment, name : PsName) : Bool :=
  match psEnvironmentFind(environment, name) with {
    | .none => false;
    | .some declaration => true;
  };

def psEnvironmentAdd(environment : PsEnvironment, declaration : PsDeclaration) : Option(PsEnvironment) :=
  if (psEnvironmentContains(environment, psDeclarationName(declaration))) {
    Option.none
  } else {
    Option.some({ declarations := List.cons(declaration, environment.declarations) })
  };
