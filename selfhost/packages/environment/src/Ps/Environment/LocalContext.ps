import Ps.Foundation.Name
import Ps.Core.Expr

inductive PsLocalDecl where {
  | binding(id : Nat, userName : PsName, type : PsExpr, binder : PsBinderInfo);
  | letDecl(id : Nat, userName : PsName, type : PsExpr, value : PsExpr);
};

structure PsLocalContext where {
  nextId : Nat;
  declarations : List(PsLocalDecl);
};

structure PsLocalPushResult where {
  context : PsLocalContext;
  id : Nat;
};

def psLocalEmpty : PsLocalContext :=
  { nextId := 0, declarations := [] };

def psLocalDeclId(declaration : PsLocalDecl) : Nat :=
  match declaration with {
    | .binding id userName type binder => id;
    | .letDecl id userName type value => id;
  };


def psLocalDeclType(declaration : PsLocalDecl) : PsExpr :=
  match declaration with {
    | .binding id userName type binder => type;
    | .letDecl id userName type value => type;
  };

def psLocalDeclUserName(declaration : PsLocalDecl) : PsName :=
  match declaration with {
    | .binding id userName type binder => userName;
    | .letDecl id userName type value => userName;
  };

def psLocalFindByIdInList(id : Nat, declarations : List(PsLocalDecl)) : Option(PsLocalDecl) :=
  match declarations with {
    | .nil => Option.none;
    | .cons declaration rest =>
      if (psLocalDeclId(declaration) == id) {
        Option.some(declaration)
      } else {
        psLocalFindByIdInList(id, rest)
      };
  };

def psLocalFindById(context : PsLocalContext, id : Nat) : Option(PsLocalDecl) :=
  psLocalFindByIdInList(id, context.declarations);

def psLocalContainsId(context : PsLocalContext, id : Nat) : Bool :=
  match psLocalFindById(context, id) with {
    | .none => false;
    | .some declaration => true;
  };

def psLocalFindUserInList(userName : PsName, declarations : List(PsLocalDecl)) : Option(PsLocalDecl) :=
  match declarations with {
    | .nil => Option.none;
    | .cons declaration rest =>
      if (psNameEq(userName, psLocalDeclUserName(declaration))) {
        Option.some(declaration)
      } else {
        psLocalFindUserInList(userName, rest)
      };
  };

def psLocalFindUser(context : PsLocalContext, userName : PsName) : Option(PsLocalDecl) :=
  psLocalFindUserInList(userName, context.declarations);

def psLocalPushBinding(
  context : PsLocalContext,
  userName : PsName,
  type : PsExpr,
  binder : PsBinderInfo
) : PsLocalPushResult :=
  let id : Nat := context.nextId;
  let declaration : PsLocalDecl := PsLocalDecl.binding(id, userName, type, binder);
  {
    context := {
      nextId := id + 1,
      declarations := List.cons(declaration, context.declarations)
    },
    id := id
  };

def psLocalPushLet(
  context : PsLocalContext,
  userName : PsName,
  type : PsExpr,
  value : PsExpr
) : PsLocalPushResult :=
  let id : Nat := context.nextId;
  let declaration : PsLocalDecl := PsLocalDecl.letDecl(id, userName, type, value);
  {
    context := {
      nextId := id + 1,
      declarations := List.cons(declaration, context.declarations)
    },
    id := id
  };
