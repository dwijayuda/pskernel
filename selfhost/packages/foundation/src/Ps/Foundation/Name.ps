inductive PsName where {
  | anonymous;
  | str(parent : PsName, value : String);
  | num(parent : PsName, value : Nat);
};

def psNameDepth(name : PsName) : Nat :=
  match name with {
    | .anonymous => 0;
    | .str parent value => psNameDepth(parent) + 1;
    | .num parent value => psNameDepth(parent) + 1;
  };

def psNameEq(left : PsName, right : PsName) : Bool :=
  match left with {
    | .anonymous =>
      match right with {
        | .anonymous => true;
        | .str parent value => false;
        | .num parent value => false;
      };
    | .str leftPrefix leftValue =>
      match right with {
        | .anonymous => false;
        | .str rightPrefix rightValue =>
          psNameEq(leftPrefix, rightPrefix) && leftValue == rightValue;
        | .num parent value => false;
      };
    | .num leftPrefix leftValue =>
      match right with {
        | .anonymous => false;
        | .str parent value => false;
        | .num rightPrefix rightValue =>
          psNameEq(leftPrefix, rightPrefix) && leftValue == rightValue;
      };
  };

def psNameAppendStr(parent : PsName, value : String) : PsName :=
  PsName.str(parent, value);

def psNameAppendNum(parent : PsName, value : Nat) : PsName :=
  PsName.num(parent, value);
