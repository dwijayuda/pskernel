inductive PsName where {
  | anonymous;
  | str(prefix : PsName, value : String);
  | num(prefix : PsName, value : Nat);
};

def psNameDepth(name : PsName) : Nat :=
  match name with {
    | .anonymous => 0;
    | .str prefix value => psNameDepth(prefix) + 1;
    | .num prefix value => psNameDepth(prefix) + 1;
  };

def psNameEq(left : PsName, right : PsName) : Bool :=
  match left with {
    | .anonymous =>
      match right with {
        | .anonymous => true;
        | .str prefix value => false;
        | .num prefix value => false;
      };
    | .str leftPrefix leftValue =>
      match right with {
        | .anonymous => false;
        | .str rightPrefix rightValue =>
          psNameEq(leftPrefix, rightPrefix) && leftValue == rightValue;
        | .num prefix value => false;
      };
    | .num leftPrefix leftValue =>
      match right with {
        | .anonymous => false;
        | .str prefix value => false;
        | .num rightPrefix rightValue =>
          psNameEq(leftPrefix, rightPrefix) && leftValue == rightValue;
      };
  };

def psNameAppendStr(prefix : PsName, value : String) : PsName :=
  PsName.str(prefix, value);

def psNameAppendNum(prefix : PsName, value : Nat) : PsName :=
  PsName.num(prefix, value);
