import Ps.Foundation.Name

structure PsModuleNode where {
  name : PsName;
  imports : List(PsName);
};

inductive PsProjectError where {
  | duplicateModule(name : PsName);
  | missingImport(owner : PsName, dependency : PsName);
  | dependencyCycle;
};

structure PsBuildPlan where {
  order : List(PsName);
};

def psNameListContains(names : List(PsName), target : PsName) : Bool :=
  match names with {
    | .nil => false;
    | .cons name rest =>
      if (psNameEq(name, target)) {
        true
      } else {
        psNameListContains(rest, target)
      };
  };

def psFindModuleInList(target : PsName, nodes : List(PsModuleNode)) : Option(PsModuleNode) :=
  match nodes with {
    | .nil => Option.none;
    | .cons node rest =>
      if (psNameEq(node.name, target)) {
        Option.some(node)
      } else {
        psFindModuleInList(target, rest)
      };
  };

def psValidateUniqueModules(seen : List(PsName), nodes : List(PsModuleNode)) : Except(PsProjectError, Unit) :=
  match nodes with {
    | .nil => Except.ok(());
    | .cons node rest =>
      if (psNameListContains(seen, node.name)) {
        Except.error(PsProjectError.duplicateModule(node.name))
      } else {
        psValidateUniqueModules(List.cons(node.name, seen), rest)
      };
  };

def psValidateImportList(
  allNodes : List(PsModuleNode),
  owner : PsName,
  imports : List(PsName)
) : Except(PsProjectError, Unit) :=
  match imports with {
    | .nil => Except.ok(());
    | .cons dependency rest =>
      match psFindModuleInList(dependency, allNodes) with {
        | .none => Except.error(PsProjectError.missingImport(owner, dependency));
        | .some node => psValidateImportList(allNodes, owner, rest);
      };
  };

def psValidateImports(
  allNodes : List(PsModuleNode),
  nodes : List(PsModuleNode)
) : Except(PsProjectError, Unit) :=
  match nodes with {
    | .nil => Except.ok(());
    | .cons node rest =>
      match psValidateImportList(allNodes, node.name, node.imports) with {
        | .error error => Except.error(error);
        | .ok value => psValidateImports(allNodes, rest);
      };
  };

def psImportsReady(ordered : List(PsName), imports : List(PsName)) : Bool :=
  match imports with {
    | .nil => true;
    | .cons dependency rest =>
      psNameListContains(ordered, dependency) && psImportsReady(ordered, rest);
  };

def psSelectReadyModule(
  ordered : List(PsName),
  nodes : List(PsModuleNode)
) : Option(PsModuleNode) :=
  match nodes with {
    | .nil => Option.none;
    | .cons node rest =>
      if (psImportsReady(ordered, node.imports)) {
        Option.some(node)
      } else {
        psSelectReadyModule(ordered, rest)
      };
  };

def psRemoveModule(target : PsName, nodes : List(PsModuleNode)) : List(PsModuleNode) :=
  match nodes with {
    | .nil => [];
    | .cons node rest =>
      if (psNameEq(node.name, target)) {
        rest
      } else {
        List.cons(node, psRemoveModule(target, rest))
      };
  };
