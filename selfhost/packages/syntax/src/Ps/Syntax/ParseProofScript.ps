import Ps.Syntax.Lexer
import Ps.Syntax.ParseCommon

inductive PsProofScriptFrontendError where {
  | lex(error : PsLexError);
  | parse(error : PsParseError);
};

/* ParseProofScript.lean is the authoritative bootstrap spelling until the
   self-hosted PSC1 frontend can regenerate this implementation as .ps. */
