inductive PsOption(α : Type) where {
  | none;
  | some(value : α);
};

function optionMap {α : Type}{β : Type}
(f : α -> β, value : PsOption(α)) : PsOption(β) :=
  match value with {
    | .none => PsOption.none;
    | .some x => PsOption.some(f(x));
  };

function optionGetOrElse {α : Type}
(value : PsOption(α), fallback : α) : α :=
  match value with {
    | .none => fallback;
    | .some x => x;
  };

function optionOrElse {α : Type}
(value : PsOption(α), fallback : PsOption(α)) : PsOption(α) :=
  match value with {
    | .none => fallback;
    | .some x => PsOption.some(x);
  };

function optionIsSome {α : Type}(value : PsOption(α)) : Bool :=
  match value with {
    | .none => false;
    | .some x => true;
  };

function optionBind {α : Type}{β : Type}
(value : PsOption(α), f : α -> PsOption(β)) : PsOption(β) :=
  match value with {
    | .none => PsOption.none;
    | .some x => f(x);
  };

theorem optionRefl {α : Type}
(value : PsOption(α)) : value = value := by rfl;

theorem optionOrElseNone {α : Type}
(fallback : PsOption(α)) :
optionOrElse(PsOption.none, fallback) = fallback := by rfl;

theorem optionOrElseNoneSymm {α : Type}
(fallback : PsOption(α)) :
fallback = optionOrElse(PsOption.none, fallback) := by exact?;

theorem optionGetOrElseSome {α : Type}
(value : α, fallback : α) :
optionGetOrElse(PsOption.some(value), fallback) = value := by rfl;

theorem optionOrElseNoneRight {α : Type}
(value : PsOption(α)) :
optionOrElse(value, PsOption.none) = value :=
  by cases value; rfl; rfl;

theorem optionMapOrElse {α : Type}{β : Type}
(f : α -> β, value : PsOption(α), fallback : PsOption(α)) :
optionMap(f, optionOrElse(value, fallback)) =
optionOrElse(optionMap(f, value), optionMap(f, fallback)) :=
  by cases value; rfl; rfl;

theorem optionGetOrElseOrElse {α : Type}
(value : PsOption(α), fallback : PsOption(α), default : α) :
optionGetOrElse(optionOrElse(value, fallback), default) =
optionGetOrElse(value, optionGetOrElse(fallback, default)) :=
  by cases value; rfl; rfl;

theorem optionGetOrElseMap {α : Type}{β : Type}
(f : α -> β, value : PsOption(α), fallback : α) :
optionGetOrElse(optionMap(f, value), f(fallback)) =
f(optionGetOrElse(value, fallback)) :=
  by cases value; rfl; rfl;

theorem optionBindNone {α : Type}{β : Type}
(f : α -> PsOption(β)) :
optionBind(PsOption.none, f) = PsOption.none := by rfl;

theorem optionBindSome {α : Type}{β : Type}
(value : α, f : α -> PsOption(β)) :
optionBind(PsOption.some(value), f) = f(value) := by rfl;
