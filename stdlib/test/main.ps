import ProofScript.Data.List
import ProofScript.Data.Result
import ProofScript.Data.Array
import ProofScript.Data.Product
import ProofScript.Data.Ordering
import ProofScript.Data.Map
import ProofScript.Data.Set
import ProofScript.Text.Lexer

function inc(x : Nat) : Nat := x + 1;

function asResult(x : Nat) : PsResult(Nat, Nat) :=
  PsResult.ok(x);

function asOption(x : Nat) : PsOption(Nat) :=
  PsOption.some(x);

function isNonZero(x : Nat) : Bool :=
  x != 0;

function isOne(x : Nat) : Bool :=
  x == 1;

function main(x : Nat) : Nat :=
  let mapped : PsResult(Nat, Nat) :=
    resultMap(inc, asResult(x));
  let reboundResult : PsResult(Nat, Nat) :=
    resultBind(mapped, asResult);
  let mappedError : PsResult(Nat, Nat) :=
    resultMapError(inc, reboundResult);
  let roundTrippedResult : PsResult(Nat, Nat) :=
    resultFromOption(resultToOption(mappedError), 0);
  let resultValue : Nat :=
    if (resultIsOk(roundTrippedResult)) {
      resultGetOrElse(roundTrippedResult, 0)
    } else {
      0
    };
  let option : PsOption(Nat) :=
    resultToOption(mapped);
  let rebound : PsOption(Nat) :=
    optionBind(option, asOption);
  let chosen : PsOption(Nat) :=
    optionOrElse(rebound, PsOption.some(0));
  let xs : PsList(Nat) :=
    PsList.cons(x, PsList.cons(x, PsList.nil));
  let empty : PsList(Nat) :=
    PsList.nil;
  let extended : PsList(Nat) :=
    listAppend(listMap(inc, xs), empty);
  let listValue : Nat :=
    if (listIsEmpty(extended)) { 0 } else { listLength(extended) };
  let optionValue : Nat :=
    optionGetOrElse(chosen, 0);
  let headValue : Nat :=
    listHeadOrElse(extended, 0);
  let selectedValue : Nat :=
    if (optionIsSome(chosen)) { optionValue } else { headValue };
  let firstSpan : SourceSpan :=
    nextSpan("𝒫x", rawPos(0));
  let lexeme : String :=
    sliceSpan("𝒫x", firstSpan);
  let identifierSpan : SourceSpan :=
    scanIdentifier2("Az!", rawPos(0));
  let identifierLexeme : String :=
    sliceSpan("Az!", identifierSpan);
  let lexerOk : Bool :=
    isAsciiIdentifierStart('A') &&
    isAsciiIdentifierRest('9') &&
    isAsciiWhitespace(' ') &&
    String.Internal.length(identifierLexeme) == 2 &&
    spanByteLength(identifierSpan) == 2;
  let lexerPenalty : Nat :=
    if (lexerOk) { String.Internal.length(lexeme) - 1 } else { 1 };
  let arrayValues : Array(Nat) :=
    arrayPush(arrayPush(arrayEmptyWithCapacity(2), x), 1);
  let emptyArray : Array(Nat) :=
    arrayEmptyWithCapacity(0);
  let arrayAtOne : PsOption(Nat) :=
    arrayGet?(arrayValues, 1);
  let arrayFoundOne : PsOption(Nat) :=
    arrayFind?(isOne, arrayValues);
  let arraysOk : Bool :=
    arraySize(emptyArray) == 0 &&
    arrayAny(isNonZero, arrayValues) &&
    arrayAll(isNonZero, arrayValues) &&
    optionGetOrElse(arrayAtOne, 0) == 1 &&
    optionGetOrElse(arrayFoundOne, 0) == 1;
  let arrayPenalty : Nat :=
    if (arraysOk) { 0 } else { 1 };
  let pair : Prod(Nat, Nat) :=
    product(x, 1);
  let productOk : Bool :=
    productFst(pair) == x &&
    productSnd(pair) == 1;
  let mapValues : PsMap(Nat, Nat) :=
    mapInsert(
      compareNat,
      2,
      20,
      mapInsert(compareNat, 1, 10, PsMap.empty)
    );
  let mapOk : Bool :=
    mapContains(compareNat, 1, mapValues) &&
    optionGetOrElse(mapGet?(compareNat, 2, mapValues), 0) == 20;
  let setValues : PsSet(Nat) :=
    setInsert(
      compareNat,
      2,
      setInsert(compareNat, 1, PsSet.empty)
    );
  let setOk : Bool :=
    setContains(compareNat, 1, setValues) &&
    setContains(compareNat, 2, setValues);
  let collectionPenalty : Nat :=
    if (productOk && mapOk && setOk) { 0 } else { 1 };
  resultValue +
    selectedValue +
    listValue +
    lexerPenalty +
    arrayPenalty +
    collectionPenalty;
