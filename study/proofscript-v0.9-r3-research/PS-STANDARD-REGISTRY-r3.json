    "additionalDependencyTacticsBecomeStandard": false
  },
  "languageCapabilityProfile": "psc2-language-v1",
  "standardLanguageProfile": "psc2-standard-language-v1",
  "leanCompatibilityProfile": "lean-subset-psc2-v1",
  "patternProfile": "psc2-pattern-v1",
  "basicDoProfile": {
    "required": true,
    "semantics": "selected native Bind/Pure sequencing",
    "requiredForms": [
      "term-statement",
      "simple-let",
      "identifier-or-wildcard-monadic-bind",
      "return-or-pure-completion"
