{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofscript.dev/schema/interface-ir-v1.json",
  "title": "ProofScript InterfaceIR v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "bindingIdentity",
    "package",
    "resolution",
    "declarations"
  ],
  "properties": {
    "format": {
      "const": "psc-interface-ir-v1"
    },
    "bindingIdentity": {
      "$ref": "#/$defs/sha256"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "packageJsonSha256",
        "installIdentity"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "packageJsonSha256": {
          "$ref": "#/$defs/sha256"
        },
        "installIdentity": {
          "type": "string",
          "minLength": 1
        },
        "lockfileSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolverProfile",
        "exportSubpath",
        "runtime",
        "types",
        "typescriptProfile",
        "targetProfile"
      ],
      "properties": {
        "resolverProfile": {
          "const": "psc-node-exports-v1"
        },
        "exportSubpath": {
          "type": "string",
          "minLength": 1
        },
        "targetProfile": {
          "type": "string",
          "minLength": 1
        },
        "typescriptProfile": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "$ref": "#/$defs/resolvedEntry"
        },
        "types": {
          "$ref": "#/$defs/resolvedEntry"
        }
      }
    },
    "declarations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/declaration"
      }
    },
    "externalAssumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resolvedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "path",
        "sha256",
        "conditionTrace"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "esm-import",
            "commonjs-require",
            "bundler-esm",
            "browser-esm",
            "types",
            "other"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "conditionTrace": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mediaType": {
          "type": "string"
        }
      }
    },
    "bindingStatus": {
      "type": "string",
      "enum": [
        "raw-unverified",
        "runtime-validated",
        "modeled-external",
        "verified-adapter",
        "trusted-assumption",
        "unsupported"
      ]
    },
    "presencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing",
        "undefined",
        "null"
      ],
      "properties": {
        "missing": {
          "type": "string",
          "enum": [
            "preserve",
            "none",
            "error",
            "unsupported"
          ]
        },
        "undefined": {
          "type": "string",
          "enum": [
            "preserve",
            "none",
            "error",
            "unsupported"
          ]
        },
        "null": {
          "type": "string",
          "enum": [
            "preserve",
            "none",
            "error",
            "unsupported"
          ]
        },
        "lossy": {
          "type": "boolean"
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/type"
        },
        "kind": {
          "type": "string",
          "enum": [
            "required",
            "optional",
            "defaulted",
            "rest",
            "this"
          ]
        },
        "defaultSourceKnown": {
          "type": "boolean"
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "optional",
        "readonly"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/type"
        },
        "optional": {
          "type": "boolean"
        },
        "readonly": {
          "type": "boolean"
        },
        "presencePolicy": {
          "$ref": "#/$defs/presencePolicy"
        }
      }
    },
    "type": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "unit",
                "bool",
                "string",
                "number",
                "bigint",
                "foreign-value",
                "never"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "literal"
            },
            "value": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "element"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "element": {
              "$ref": "#/$defs/type"
            },
            "mutability": {
              "type": "string",
              "enum": [
                "readonly",
                "mutable",
                "unknown"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "tuple"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/type"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "fields"
          ],
          "properties": {
            "kind": {
              "const": "record"
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/field"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "cases"
          ],
          "properties": {
            "kind": {
              "const": "variant"
            },
            "cases": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/type"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "parameters",
            "result"
          ],
          "properties": {
            "kind": {
              "enum": [
                "function",
                "callback"
              ]
            },
            "parameters": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/parameter"
              }
            },
            "result": {
              "$ref": "#/$defs/type"
            },
            "receiver": {
              "$ref": "#/$defs/type"
            },
            "syncKind": {
              "type": "string",
              "enum": [
                "sync",
                "promise",
                "unknown"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "promise"
            },
            "value": {
              "$ref": "#/$defs/type"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "identity"
          ],
          "properties": {
            "kind": {
              "const": "handle"
            },
            "identity": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "type-param"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "head",
            "args"
          ],
          "properties": {
            "kind": {
              "const": "generic-application"
            },
            "head": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/type"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "description"
          ],
          "properties": {
            "kind": {
              "const": "opaque"
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbolId",
        "exportName",
        "kind",
        "status",
        "sourceDeclarationSha256"
      ],
      "properties": {
        "symbolId": {
          "type": "string",
          "minLength": 1
        },
        "exportName": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "constant",
            "function",
            "constructor",
            "record",
            "variant",
            "class-handle",
            "type-alias",
            "generic",
            "namespace",
            "unsupported"
          ]
        },
        "status": {
          "$ref": "#/$defs/bindingStatus"
        },
        "type": {
          "$ref": "#/$defs/type"
        },
        "overloads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/type"
          }
        },
        "sourceDeclarationSha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtimeArtifactSha256": {
          "$ref": "#/$defs/sha256"
        },
        "validationPolicy": {
          "type": "string"
        },
        "logicalModelIdentity": {
          "type": "string"
        },
        "externalAssumptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
