{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofscript.dev/schema/psc-semantic-bundle-v1.json",
  "title": "ProofScript Semantic Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "logicalModule",
    "leanSemantics",
    "producer",
    "declarations",
    "dependencies",
    "assumptions",
    "effects"
  ],
  "properties": {
    "format": {
      "const": "psc-semantic-bundle-v1"
    },
    "logicalModule": {
      "type": "string",
      "minLength": 1
    },
    "leanSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "commit"
      ],
      "properties": {
        "version": {
          "const": "4.34.0"
        },
        "commit": {
          "const": "293d5d0c0c3f3dded4688b3ccd6a33939ac5102b"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageName",
        "packageVersion",
        "sourceProfile",
        "producerRevision"
      ],
      "properties": {
        "packageName": {
          "type": "string",
          "minLength": 1
        },
        "packageVersion": {
          "type": "string",
          "minLength": 1
        },
        "sourceProfile": {
          "type": "string",
          "enum": [
            "ps-standard",
            "ps-lean-extensible",
            ".lean"
          ]
        },
        "producerRevision": {
          "type": "string",
          "minLength": 1
        },
        "sourceIdentity": {
          "type": "string"
        }
      }
    },
    "declarations": {
      "$ref": "#/$defs/artifact"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "logicalModule",
          "bundleSha256"
        ],
        "properties": {
          "logicalModule": {
            "type": "string",
            "minLength": 1
          },
          "bundleSha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      },
      "uniqueItems": true
    },
    "assumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical",
        "runtime"
      ],
      "properties": {
        "logical": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "runtime": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "syntaxEffects",
        "metaRegistrationEffects",
        "hostBuildEffects"
      ],
      "properties": {
        "syntaxEffects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "metaRegistrationEffects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "hostBuildEffects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "runtimeExports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "targetProfile",
          "runtimeAbi",
          "artifact",
          "preservationStatus",
          "externalAssumptions"
        ],
        "properties": {
          "targetProfile": {
            "type": "string",
            "minLength": 1
          },
          "runtimeAbi": {
            "type": "string",
            "minLength": 1
          },
          "artifact": {
            "$ref": "#/$defs/artifact"
          },
          "exportIdentity": {
            "type": "string"
          },
          "primitiveManifestSha256": {
            "$ref": "#/$defs/sha256"
          },
          "preservationStatus": {
            "type": "string",
            "enum": [
              "not-established",
              "tested",
              "translation-validated",
              "proved-fragment",
              "assumed"
            ]
          },
          "externalAssumptions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grammarIdentity": {
          "type": "string"
        },
        "canonicalLeanSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceMapSha256": {
          "$ref": "#/$defs/sha256"
        },
        "generatorIdentity": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mediaType",
        "moduleFormatVersion",
        "sha256",
        "byteLength"
      ],
      "properties": {
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "moduleFormatVersion": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
